---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdminEditFab from '../components/AdminEditFab.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  beschreibung?: string;
  ogBild?: string;
  /** Pfad zur Quelldatei dieser Seite relativ zum Repo-Root, z.B. "src/content/blog/foo.md". Wenn nicht gesetzt, wird automatisch aus der URL ableitet. */
  editPath?: string;
}

const {
  title,
  beschreibung = 'Mathe-Didaktik, Aufgaben und diagnostische Fragen für Lehrkräfte – inspiriert von Forschung und Praxis.',
  ogBild = '/og-default.png',
  editPath,
} = Astro.props;

const seitentitel = title === 'mathematik-unterrichten' ? title : `${title} – mathematik-unterrichten`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// GitHub-Edit-URL für den Admin-FAB ableiten. Dynamische Seiten setzen editPath explizit;
// für statische Seiten wird der Pfad aus dem URL-Pfadnamen rekonstruiert.
const GITHUB_REPO = 'MichaelGlaubitz/mathematik-unterrichten';
const GITHUB_BRANCH = 'main';
function derivedEditPath(pathname: string): string {
  const p = pathname.replace(/\/$/, '');
  if (p === '' || p === '/') return 'src/pages/index.astro';
  // Index-Seiten der Sammlungen (Ordner-Routen):
  if (['/blog', '/aufgaben', '/quizzes'].includes(p)) {
    return `src/pages${p}/index.astro`;
  }
  // Sonstige statische Seiten:
  return `src/pages${p}.astro`;
}
const resolvedEditPath = editPath ?? derivedEditPath(Astro.url.pathname);
const editUrl = `https://github.com/${GITHUB_REPO}/edit/${GITHUB_BRANCH}/${resolvedEditPath}`;
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    {/* No-Flash-Bootstrap: setzt Dark/Light direkt vor dem ersten Paint */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('mu-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var dark = stored === 'dark' || (stored === null && prefersDark);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:image" content={new URL(ogBild, Astro.site)} />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seitentitel} />
    <meta name="twitter:description" content={beschreibung} />

    <!-- KaTeX für mathematische Formeln -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />
    <!-- KaTeX-Browser-Renderer: rendert $...$ und $$...$$ in zur Laufzeit eingefügtem Text (z.B. Quiz-Optionen aus JSON) -->
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
      onload="renderMathInElement(document.body, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$',  right: '$',  display: false },
          { left: '\\(', right: '\\)', display: false },
          { left: '\\[', right: '\\]', display: true }
        ],
        throwOnError: false
      });"
    ></script>
  </head>
  <body class="min-h-screen bg-ink-50 text-ink-800 antialiased font-sans dark:bg-ink-900 dark:text-ink-200">
    <a
      href="#hauptinhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white dark:focus:bg-ink-800 dark:focus:text-ink-50 focus:px-4 focus:py-2 focus:rounded focus:shadow"
    >
      Zum Hauptinhalt springen
    </a>

    <Header />

    <main id="hauptinhalt" class="min-h-[60vh]">
      <slot />
    </main>

    <Footer />

    <AdminEditFab editUrl={editUrl} />
  </body>
</html>
