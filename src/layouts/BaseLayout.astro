---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  beschreibung?: string;
  ogBild?: string;
  /** Relativer Pfad zur Page-Datei im Repo, z. B. `src/pages/index.astro` (für Strg+Shift+E). */
  sourceFile: string;
  /**
   * Optional: andere Quelle als die Page-Datei (z. B. `src/content/blog/…md` statt `[slug].astro`).
   */
  githubEditPath?: string;
}

const {
  title,
  beschreibung = 'Mathe-Didaktik, Aufgaben und diagnostische Fragen für Lehrkräfte – inspiriert von Forschung und Praxis.',
  ogBild = '/og-default.png',
  sourceFile,
  githubEditPath: githubEditPathProp,
} = Astro.props;

const explicitPath = githubEditPathProp?.trim();
const githubEditPath = explicitPath || sourceFile?.trim();

const seitentitel = title === 'mathematik-unterrichten' ? title : `${title} – mathematik-unterrichten`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
/** Öffentliches Repo für „Auf GitHub bearbeiten“ (Strg+Shift+E). Forks: `PUBLIC_GITHUB_REPO` setzen. */
const githubRepo =
  (import.meta.env.PUBLIC_GITHUB_REPO as string | undefined)?.trim() ||
  'MichaelGlaubitz/mathematik-unterrichten';
const githubBranch = (import.meta.env.PUBLIC_GITHUB_BRANCH as string | undefined)?.trim() || 'main';
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
    />

    {/* No-Flash-Bootstrap: setzt Dark/Light direkt vor dem ersten Paint */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('mu-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var dark = stored === 'dark' || (stored === null && prefersDark);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:image" content={new URL(ogBild, Astro.site)} />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seitentitel} />
    <meta name="twitter:description" content={beschreibung} />

    {githubEditPath && githubEditPath.length > 0 && (
      <meta name="mu-github-source-path" content={githubEditPath} />
    )}

    <!-- KaTeX für mathematische Formeln (optional, lädt nur wenn benutzt) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />

    {/* Google Analytics (nur aktiv, wenn PUBLIC_GA_ID konfiguriert ist) */}
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
          try {
            // Falls ?no-track=1 aufgerufen wird, dauerhaft im Browser deaktivieren
            if (window.location.search.includes('no-track=1')) {
              localStorage.setItem('mu-no-track', 'true');
              alert('Analytics wurde auf diesem Gerät deaktiviert.');
            }
            // Falls ?no-track=0 aufgerufen wird, wieder aktivieren
            if (window.location.search.includes('no-track=0')) {
              localStorage.removeItem('mu-no-track');
              alert('Analytics wurde auf diesem Gerät wieder aktiviert.');
            }

            if (localStorage.getItem('mu-no-track') === 'true') {
              window['ga-disable-' + gaId] = true;
            } else {
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', gaId);
            }
          } catch (e) {
            // Fallback für Browser, die den Zugriff auf LocalStorage verbieten
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', gaId);
          }
        </script>
      </>
    )}

  </head>

  <body
    class="min-h-screen mu-page-bg text-ink-800 antialiased font-sans dark:text-ink-200"
    data-gh-repo={githubRepo}
    data-gh-branch={githubBranch}
  >
    <a
      href="#hauptinhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface dark:focus:bg-slate-800 dark:focus:text-ink-50 focus:px-4 focus:py-2 focus:rounded focus:shadow"
    >
      Zum Hauptinhalt springen
    </a>

    <Header />

    <main id="hauptinhalt" class="min-h-[60vh]">
      <slot />
    </main>

    <Footer />

    {/* KaTeX Auto-Render: rendert $...$ und $$...$$ im fertigen DOM (auch in dynamisch eingefuegtem Quiz-Inhalt). */}
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
      integrity="sha384-7zkQWkzuo3B5mTepMUcHkMB5jZaolc2xDwL6VFqjFALcbeS9Ggm/Yr2r3Dy4lfFg"
      crossorigin="anonymous"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
      integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk"
      crossorigin="anonymous"
      onload="renderMathInElement(document.body, {
        delimiters: [
          {left: '$$', right: '$$', display: true},
          {left: '$',  right: '$',  display: false}
        ],
        ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option'],
        ignoredClasses: ['katex', 'mu-katex-skip'],
        throwOnError: false
      });"
    ></script>

    <script is:inline>
      // Re-Render nach Quiz-Interaktionen (Optionen-Auswahl, Reset, etc.):
      // Die Quiz-Komponente fuegt Inhalt dynamisch ein - KaTeX muss dann erneut laufen.
      document.addEventListener('quiz:rerender', () => {
        if (typeof window.renderMathInElement === 'function') {
          window.renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$',  right: '$',  display: false }
            ],
            ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option'],
            ignoredClasses: ['katex', 'mu-katex-skip'],
            throwOnError: false
          });
        }
      });
    </script>

    <script>
      import { registerGithubSourceShortcut } from '../lib/githubSourceShortcut';
      registerGithubSourceShortcut();
    </script>
  </body>
</html>
