---
/**
 * Gerüst für die Rückmeldebretter /mr und /fr.
 *
 * WARUM NICHT BaseLayout: Die Bretter sind das einzige auf dieser Seite, das
 * SCHÜLER benutzen, nicht Lehrkräfte. Kopf- und Fußzeile der Website führen in
 * den Werkzeugkasten, ins Blog, in die Handreichungen — nichts davon geht die
 * 7b etwas an, und auf einem iPad-Bildschirm steht es der eigentlichen Sache
 * im Weg. Mitgeschleppt käme außerdem KaTeX, das Analytics-Skript, die
 * Autoren-Strukturdaten und der Redaktions-Shortcut: alles ohne Zweck hier.
 *
 * Geblieben ist, was die Seite trotzdem braucht: Schriften, Farbschema samt
 * Dunkelmodus ohne Aufblitzen, und unten die zwei Pflichtlinks. Ein
 * Impressum muss von jeder Seite aus erreichbar sein, auch von dieser.
 *
 * `noindex`: Das Brett ist offen lesbar, aber es gehört nicht in die
 * Suchmaschine. Was Schüler über ihren Unterricht schreiben, soll auffindbar
 * sein, wer die Adresse kennt — nicht, wer den Namen googelt.
 */
import '../styles/global.css';

export interface Props {
  title: string;
  beschreibung: string;
}
const { title, beschreibung } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
    />

    {/* Dunkel oder hell vor dem ersten Zeichnen entscheiden, sonst blitzt es weiß auf. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('mu-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (stored === null && prefersDark))
            document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={beschreibung} />
  </head>

  <body class="min-h-screen mu-page-bg text-ink-800 antialiased font-sans dark:text-ink-200">
    <main>
      <slot />
    </main>

    <footer class="container-wide pb-10 pt-4">
      <p class="border-t border-ink-200/80 pt-4 text-xs text-ink-500 dark:border-slate-600/40 dark:text-ink-400">
        <a href="/" class="hover:text-ink-800 dark:hover:text-ink-200">mathematik-unterrichten.de</a>
        <span aria-hidden="true"> · </span>
        <a href="/impressum" class="hover:text-ink-800 dark:hover:text-ink-200">Impressum</a>
        <span aria-hidden="true"> · </span>
        <a href="/datenschutz" class="hover:text-ink-800 dark:hover:text-ink-200">Datenschutz</a>
      </p>
    </footer>
  </body>
</html>
