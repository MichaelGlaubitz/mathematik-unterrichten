---
/**
 * Richtungswahl für „Bruch · Dezimal · Prozent“ auf der Themenseite (gleiche Kartenlogik wie in der Massenübung).
 */
import { BDP_CARD_GROUPS, BDP_WB_STOR_KEY } from '../lib/bruchDezimalProzentUmwandlung';
import { BDP_UMWANDLUNG_GENERATOR_IDS } from '../lib/uebungPracticeGenerators';
---

<div
  class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-3"
  id="mu-wb-bdp-karten-root"
  data-bdp-stor-key={BDP_WB_STOR_KEY}
>
  {
    BDP_CARD_GROUPS.map((card) => (
      <article class="flex flex-col rounded-xl border border-ink-200 bg-ink-50/80 p-4 shadow-sm dark:border-slate-600/45 dark:bg-slate-950/40 md:p-5">
        <h2 class="text-center font-serif text-base font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">
          {card.title}
        </h2>
        <div class="mt-4 flex flex-col gap-3">
          {card.directions.map((d) => {
            const gid = `bdp_${d.id}`;
            return (
              <button
                type="button"
                class="mu-wb-bdp-dir flex w-full items-center justify-center gap-2 rounded-lg border border-accent-600/35 bg-surface px-3 py-2.5 text-left text-xs font-semibold text-accent-800 shadow-sm transition hover:border-accent-600 hover:bg-accent-50 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 dark:border-accent-400/30 dark:bg-slate-900/60 dark:text-accent-50 dark:hover:border-accent-300 dark:hover:bg-slate-800/80 dark:focus:ring-offset-slate-900 sm:text-sm"
                data-mu-bdp-gen={gid}
                aria-pressed="true"
              >
                {d.label}
              </button>
            );
          })}
        </div>
        <div class="my-3 border-t border-dashed border-ink-200/90 dark:border-slate-600/55" />
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            class="mu-wb-bdp-bulk rounded-md border border-dashed border-ink-300/90 bg-surface px-2 py-2 text-[11px] font-semibold text-ink-800 hover:bg-ink-100 dark:border-slate-500 dark:bg-slate-900/70 dark:text-ink-200 dark:hover:bg-slate-800 sm:text-xs"
            data-mu-bdp-bulk="all"
          >
            Alle
          </button>
          <button
            type="button"
            class="mu-wb-bdp-bulk rounded-md border border-dashed border-ink-300/90 bg-surface px-2 py-2 text-[11px] font-semibold text-ink-800 hover:bg-ink-100 dark:border-slate-500 dark:bg-slate-900/70 dark:text-ink-200 dark:hover:bg-slate-800 sm:text-xs"
            data-mu-bdp-bulk="none"
          >
            Keine
          </button>
        </div>
      </article>
    ))
  }
</div>

<script define:vars={{ BDP_WB_STOR_KEY, BDP_UMWANDLUNG_GENERATOR_IDS }}>
  const BDP_ALLOWED = new Set(BDP_UMWANDLUNG_GENERATOR_IDS);

  function readSel() {
    try {
      const raw = JSON.parse(sessionStorage.getItem(BDP_WB_STOR_KEY) || 'null');
      if (Array.isArray(raw) && raw.length > 0 && raw.every((x) => typeof x === 'string')) {
        const filtered = raw.filter((id) => BDP_ALLOWED.has(id));
        if (filtered.length > 0) return new Set(filtered);
      }
    } catch {
      /* */
    }
    return new Set(BDP_UMWANDLUNG_GENERATOR_IDS);
  }

  function writeSel(set) {
    try {
      sessionStorage.setItem(BDP_WB_STOR_KEY, JSON.stringify([...set]));
    } catch {
      /* */
    }
  }

  function syncUi(root) {
    const sel = readSel();
    root.querySelectorAll('.mu-wb-bdp-dir').forEach((node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      const id = node.dataset.muBdpGen;
      if (!id) return;
      const on = sel.has(id);
      node.setAttribute('aria-pressed', on ? 'true' : 'false');
      node.classList.toggle('mu-wb-bdp-dir--an', on);
    });
  }

  function boot() {
    const root = document.getElementById('mu-wb-bdp-karten-root');
    if (!root || root.dataset.muBdpBound === '1') return;
    root.dataset.muBdpBound = '1';
    syncUi(root);
    root.addEventListener('click', (ev) => {
      const t = ev.target;
      const fromEl = t instanceof Element ? t : t instanceof Node ? t.parentElement : null;
      const bulk = fromEl && fromEl.closest ? fromEl.closest('[data-mu-bdp-bulk]') : null;
      if (bulk && root.contains(bulk)) {
        const mode = bulk.getAttribute('data-mu-bdp-bulk');
        const card = bulk.closest('article');
        if (!card) return;
        const sel = readSel();
        if (mode === 'all') {
          card.querySelectorAll('.mu-wb-bdp-dir').forEach((node) => {
            if (!(node instanceof HTMLButtonElement)) return;
            const id = node.dataset.muBdpGen;
            if (id) sel.add(id);
          });
        } else {
          card.querySelectorAll('.mu-wb-bdp-dir').forEach((node) => {
            if (!(node instanceof HTMLButtonElement)) return;
            const id = node.dataset.muBdpGen;
            if (id) sel.delete(id);
          });
        }
        writeSel(sel);
        syncUi(root);
        return;
      }
      const btn = fromEl && fromEl.closest ? fromEl.closest('button.mu-wb-bdp-dir') : null;
      if (!(btn instanceof HTMLButtonElement) || !root.contains(btn)) return;
      const id = btn.dataset.muBdpGen;
      if (!id) return;
      const sel = readSel();
      if (sel.has(id)) sel.delete(id);
      else sel.add(id);
      writeSel(sel);
      syncUi(root);
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style is:global>
  /* define:vars-Skripte werden nicht transpiliert — kein TS in diesem Block */
  button.mu-wb-bdp-dir.mu-wb-bdp-dir--an {
    border-color: rgb(91 33 182) !important;
    background-color: rgb(91 33 182) !important;
    color: #fff !important;
    opacity: 1 !important;
  }
  html.dark button.mu-wb-bdp-dir.mu-wb-bdp-dir--an {
    border-color: rgb(167 139 250) !important;
    background-color: rgb(167 139 250) !important;
    color: rgb(15 23 42) !important;
  }
  button.mu-wb-bdp-dir:not(.mu-wb-bdp-dir--an) {
    opacity: 0.72;
  }
</style>
