---
/**
 * Richtungswahl für „Bruch · Dezimal · Prozent“ auf der Themenseite (gleiche Kartenlogik wie in der Massenübung).
 */
import { BDP_CARD_GROUPS, BDP_WB_STOR_KEY } from '../lib/bruchDezimalProzentUmwandlung';
import { BDP_UMWANDLUNG_GENERATOR_IDS } from '../lib/uebungPracticeGenerators';
---

<div
  class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-3"
  id="mu-wb-bdp-karten-root"
  data-bdp-stor-key={BDP_WB_STOR_KEY}
>
  {
    BDP_CARD_GROUPS.map((card) => (
      <article class="flex flex-col rounded-2xl border border-ink-200 bg-white p-5 shadow-sm dark:border-slate-600 dark:bg-slate-900/80">
        <h4 class="text-center text-sm font-bold uppercase tracking-wide text-violet-600 dark:text-violet-300">
          {card.title}
        </h4>
        <div class="mt-4 flex flex-col gap-3">
          {card.directions.map((d) => {
            const gid = `bdp_${d.id}`;
            return (
              <button
                type="button"
                class="mu-wb-bdp-dir flex w-full items-center justify-center gap-2 rounded-xl bg-violet-600 px-3 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-violet-400 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
                data-mu-bdp-gen={gid}
                aria-pressed="true"
              >
                {d.label}
              </button>
            );
          })}
        </div>
        <div class="my-4 border-t border-dashed border-ink-200 dark:border-slate-600" />
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            class="mu-wb-bdp-bulk rounded-lg border border-ink-300 bg-white px-2 py-2 text-xs font-semibold text-ink-700 hover:bg-ink-50 dark:border-slate-600 dark:bg-slate-900 dark:text-ink-200 dark:hover:bg-slate-800"
            data-mu-bdp-bulk="all"
          >
            Alle
          </button>
          <button
            type="button"
            class="mu-wb-bdp-bulk rounded-lg border border-ink-300 bg-white px-2 py-2 text-xs font-semibold text-ink-700 hover:bg-ink-50 dark:border-slate-600 dark:bg-slate-900 dark:text-ink-200 dark:hover:bg-slate-800"
            data-mu-bdp-bulk="none"
          >
            Keine
          </button>
        </div>
      </article>
    ))
  }
</div>

<script define:vars={{ BDP_WB_STOR_KEY, BDP_UMWANDLUNG_GENERATOR_IDS }}>
  const BDP_ALLOWED = new Set(BDP_UMWANDLUNG_GENERATOR_IDS);

  function readSel() {
    try {
      const raw = JSON.parse(sessionStorage.getItem(BDP_WB_STOR_KEY) || 'null');
      if (Array.isArray(raw) && raw.length > 0 && raw.every((x) => typeof x === 'string')) {
        const filtered = raw.filter((id) => BDP_ALLOWED.has(id));
        if (filtered.length > 0) return new Set(filtered);
      }
    } catch {
      /* */
    }
    return new Set(BDP_UMWANDLUNG_GENERATOR_IDS);
  }

  function writeSel(set) {
    try {
      sessionStorage.setItem(BDP_WB_STOR_KEY, JSON.stringify([...set]));
    } catch {
      /* */
    }
  }

  function syncUi(root) {
    const sel = readSel();
    root.querySelectorAll<HTMLButtonElement>('.mu-wb-bdp-dir').forEach((b) => {
      const id = b.dataset.muBdpGen;
      if (!id) return;
      const on = sel.has(id);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
      b.classList.toggle('ring-2', on);
      b.classList.toggle('ring-violet-300', on);
      b.classList.toggle('ring-offset-2', on);
      b.classList.toggle('opacity-60', !on);
    });
  }

  function boot() {
    const root = document.getElementById('mu-wb-bdp-karten-root');
    if (!root || root.dataset.muBdpBound === '1') return;
    root.dataset.muBdpBound = '1';
    syncUi(root);
    root.addEventListener('click', (ev) => {
      const bulk = (ev.target as HTMLElement | null)?.closest?.('[data-mu-bdp-bulk]');
      if (bulk && root.contains(bulk)) {
        const mode = bulk.getAttribute('data-mu-bdp-bulk');
        const card = bulk.closest('article');
        if (!card) return;
        const sel = readSel();
        if (mode === 'all') {
          card.querySelectorAll<HTMLButtonElement>('.mu-wb-bdp-dir').forEach((b) => {
            const id = b.dataset.muBdpGen;
            if (id) sel.add(id);
          });
        } else {
          card.querySelectorAll<HTMLButtonElement>('.mu-wb-bdp-dir').forEach((b) => {
            const id = b.dataset.muBdpGen;
            if (id) sel.delete(id);
          });
        }
        writeSel(sel);
        syncUi(root);
        return;
      }
      const btn = (ev.target as HTMLElement | null)?.closest?.('button.mu-wb-bdp-dir');
      if (!btn || !root.contains(btn)) return;
      const id = btn.dataset.muBdpGen;
      if (!id) return;
      const sel = readSel();
      if (sel.has(id)) sel.delete(id);
      else sel.add(id);
      writeSel(sel);
      syncUi(root);
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
