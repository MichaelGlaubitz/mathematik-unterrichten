---
export interface Props {
  href: string;
  titel: string;
  teaser: string;
  meta?: string;
  badges?: string[];
  datum?: Date;
  /** Optional: macht die Karte für Kategorie-Filter adressierbar (data-kategorie) */
  kategorie?: string;
  /**
   * Überschriftenstufe der Kartenüberschrift. Voreinstellung 3 – passend,
   * wenn die Karten unter einer h2-Gruppenüberschrift stehen. Folgen sie
   * direkt auf die h1, muss 2 gesetzt werden, sonst entsteht ein Sprung.
   */
  stufe?: 2 | 3 | 4;
}
const { href, titel, teaser, meta, badges = [], datum, kategorie, stufe = 3 } = Astro.props;
const Titel = `h${stufe}` as 'h2' | 'h3' | 'h4';
const datumString = datum
  ? new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(datum)
  : '';
---

<a href={href} class="card flex flex-col gap-3 group" data-kategorie={kategorie}>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    {badges.map((b) => (
      <span class="badge-accent">{b}</span>
    ))}
    {datum && <time class="text-ink-500 dark:text-ink-400" datetime={datum.toISOString()}>{datumString}</time>}
  </div>

  <Titel class="font-serif text-xl font-semibold text-ink-900 group-hover:text-accent-700 transition-colors dark:text-ink-50 dark:group-hover:text-accent-100">
    {titel}
  </Titel>

  <p class="text-ink-700 leading-relaxed text-[0.95rem] dark:text-ink-300">{teaser}</p>

  {meta && <p class="text-xs text-ink-500 mt-auto dark:text-ink-400">{meta}</p>}
</a>
