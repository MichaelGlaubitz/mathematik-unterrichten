---
export interface Props {
  href: string;
  titel: string;
  teaser: string;
  meta?: string;
  badges?: string[];
  datum?: Date;
}
const { href, titel, teaser, meta, badges = [], datum } = Astro.props;
const datumString = datum
  ? new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(datum)
  : '';
---

<a href={href} class="card flex flex-col gap-3 group">
  <div class="flex flex-wrap items-center gap-2 text-xs">
    {badges.map((b) => (
      <span class="badge-accent">{b}</span>
    ))}
    {datum && <time class="text-slate-500 dark:text-slate-400" datetime={datum.toISOString()}>{datumString}</time>}
  </div>

  <h3 class="font-serif text-xl font-semibold text-slate-900 group-hover:text-violet-700 transition-colors dark:text-slate-50 dark:group-hover:text-violet-200">
    {titel}
  </h3>

  <p class="text-slate-700 leading-relaxed text-[0.95rem] dark:text-slate-300">{teaser}</p>

  {meta && <p class="text-xs text-slate-500 mt-auto dark:text-slate-400">{meta}</p>}
</a>
