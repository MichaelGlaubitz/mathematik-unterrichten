---
import sitePkg from '../../package.json';

const siteVersion = sitePkg.version;

const navItems = [
  { href: '/', label: 'Start' },
  { href: '/themen', label: 'Themen' },
  { href: '/aufgaben', label: 'Aufgaben' },
  { href: '/quizzes', label: 'Diagnose-Fragen' },
  { href: '/blog', label: 'Blog' },
  { href: '/ueber', label: 'Über' },
  { href: '/kontakt', label: 'Kontakt' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-ink-200/80 bg-white/80 shadow-sm backdrop-blur-md dark:border-violet-500/25 dark:bg-gradient-to-r dark:from-ink-900/92 dark:via-ink-900/88 dark:to-violet-950/35 dark:shadow-[0_8px_32px_-8px_rgba(0,0,0,0.55)] dark:backdrop-blur-md">
  <div class="container-wide py-4 flex items-center justify-between gap-6">
    <a href="/" class="font-serif text-xl sm:text-2xl font-semibold text-ink-900 tracking-tight dark:text-ink-50">
      mathematik-unterrichten<span class="bg-gradient-to-r from-accent-600 via-teal-600 to-violet-600 bg-clip-text font-bold text-transparent dark:from-sky-300 dark:via-teal-300 dark:to-fuchsia-300">.de</span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-2 text-sm">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={[
                'rounded-full px-3 py-1.5 transition-colors',
                isActive(item.href)
                  ? 'bg-gradient-to-r from-accent-600/15 via-teal-600/10 to-violet-600/15 text-accent-800 ring-1 ring-accent-300/60 dark:from-accent-500/20 dark:via-teal-500/15 dark:to-violet-500/20 dark:text-accent-100 dark:ring-accent-400/40 font-semibold'
                  : 'text-ink-700 hover:bg-ink-100/80 hover:text-accent-700 dark:text-ink-300 dark:hover:bg-ink-800 dark:hover:text-accent-100',
              ].join(' ')}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-ink-600 hover:bg-ink-100 hover:text-ink-900 transition-colors dark:text-teal-200/90 dark:hover:bg-violet-500/20 dark:hover:text-teal-50 focus:outline-none focus:ring-2 focus:ring-teal-500"
        aria-label="Hell-/Dunkelmodus wechseln"
        title="Hell-/Dunkelmodus wechseln"
      >
        {/* Sonne (sichtbar im Dark Mode -> "zu hell wechseln") */}
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        {/* Mond (sichtbar im Light Mode -> "zu dunkel wechseln") */}
        <svg class="block h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <span
        class="select-none text-xs tabular-nums text-ink-500 dark:text-ink-400"
        title={`Website-Version ${siteVersion}`}
      >
        v{siteVersion}
      </span>

      <button
        id="mobile-menu-toggle"
        class="md:hidden inline-flex items-center justify-center rounded p-2 text-ink-700 hover:bg-ink-100 dark:text-ink-200 dark:hover:bg-ink-800"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Menü öffnen</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    class="h-1 w-full bg-gradient-to-r from-accent-500 via-teal-500 to-violet-500 opacity-90 dark:opacity-100 dark:saturate-125 dark:from-sky-400 dark:via-teal-400 dark:to-fuchsia-400"
    aria-hidden="true"
  ></div>

  <nav id="mobile-menu" aria-label="Mobile Navigation" class="md:hidden hidden border-t border-ink-200/80 bg-white/90 dark:border-violet-500/25 dark:bg-ink-900/95 dark:backdrop-blur-md">
    <ul class="container-wide py-3 flex flex-col gap-2 text-sm">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={[
              'block rounded-md px-2 py-2 transition-colors',
              isActive(item.href)
                ? 'bg-accent-500/10 text-accent-800 font-semibold dark:bg-gradient-to-r dark:from-sky-500/25 dark:to-teal-500/20 dark:text-teal-50'
                : 'text-ink-700 dark:text-ink-300 dark:hover:bg-violet-500/15',
            ].join(' ')}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Mobiles Menü
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Hell/Dunkel-Schalter
  const themeBtn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const setzeAriaPressed = () => {
    if (themeBtn) themeBtn.setAttribute('aria-pressed', root.classList.contains('dark') ? 'true' : 'false');
  };
  setzeAriaPressed();

  themeBtn?.addEventListener('click', () => {
    const willDark = !root.classList.contains('dark');
    root.classList.toggle('dark', willDark);
    try {
      localStorage.setItem('mu-theme', willDark ? 'dark' : 'light');
    } catch (e) {}
    setzeAriaPressed();
  });

  // Wenn der Nutzer noch nichts gewählt hat, dem System folgen
  try {
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener?.('change', (event) => {
      if (localStorage.getItem('mu-theme') === null) {
        root.classList.toggle('dark', event.matches);
        setzeAriaPressed();
      }
    });
  } catch (e) {}
</script>
