---
const navItems = [
  { href: '/', label: 'Start' },
  { href: '/blog', label: 'Blog' },
  { href: '/aufgaben', label: 'Aufgaben' },
  { href: '/quizzes', label: 'Diagnose-Fragen' },
  { href: '/ueber', label: 'Über' },
  { href: '/kontakt', label: 'Kontakt' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="border-b border-ink-200 bg-white/80 backdrop-blur sticky top-0 z-40">
  <div class="container-wide py-4 flex items-center justify-between gap-6">
    <a href="/" class="font-serif text-xl sm:text-2xl font-semibold text-ink-900 tracking-tight">
      mathematik-unterrichten<span class="text-accent-600">.de</span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={[
                'hover:text-accent-700 transition-colors',
                isActive(item.href) ? 'text-accent-700 font-semibold' : 'text-ink-700',
              ].join(' ')}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="mobile-menu-toggle"
      class="md:hidden inline-flex items-center justify-center rounded p-2 text-ink-700 hover:bg-ink-100"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Menü öffnen</span>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile Navigation" class="md:hidden hidden border-t border-ink-200">
    <ul class="container-wide py-3 flex flex-col gap-2 text-sm">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={[
              'block py-2',
              isActive(item.href) ? 'text-accent-700 font-semibold' : 'text-ink-700',
            ].join(' ')}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
