---
/**
 * Kompakte WB-Algebra-Ansicht auf /themen (ohne die vollständige Stichwort-Matrix aus algebra.json).
 */
import { ALG_WB_STICHWORT_TO_IDS, sortAlgAbStichworte } from '../lib/algebraWbKeywordMap';

interface Props {
  generatorUebungHref: string;
}

const { generatorUebungHref } = Astro.props;
const stichworteMitUebung = sortAlgAbStichworte(Object.keys(ALG_WB_STICHWORT_TO_IDS));
const autoHref = generatorUebungHref.includes('?')
  ? `${generatorUebungHref}&muAuto=1`
  : `${generatorUebungHref}?muAuto=1`;
---

<div class="space-y-5">
  <div
    class="rounded-xl border-2 border-accent-500/55 bg-accent-50/95 p-5 shadow-sm dark:border-accent-400/40 dark:bg-accent-950/35"
  >
    <h5 class="font-serif text-xl font-semibold text-ink-900 dark:text-ink-50 mb-2">
      Zufallsaufgaben (Whiteboard & Arbeitsblatt)
    </h5>
    <p class="text-sm text-ink-700 leading-relaxed mb-4 max-w-2xl dark:text-ink-200">
      Hier geht es direkt in die interaktive Übung: Aufgaben wählen, Anzahl und Darstellung wie auf der
      Übungsseite — inklusive kurzer Sachkontexte zur Bedeutung von Variablen und den übrigen bereits
      angebundenen Algebra-Stichworten.
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <a
        href={generatorUebungHref}
        class="inline-flex items-center justify-center rounded-lg bg-accent-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-accent-700 dark:bg-accent-500 dark:hover:bg-accent-600"
      >
        WB Algebra öffnen
      </a>
      <a
        href={autoHref}
        class="inline-flex items-center justify-center rounded-lg border border-accent-600 bg-surface px-4 py-2.5 text-sm font-semibold text-accent-800 transition hover:bg-accent-50 dark:border-accent-400 dark:bg-slate-900/70 dark:text-accent-100 dark:hover:bg-slate-800/90"
        title="Übernimmt Anzahl, Layout und Grafik-Option aus der Leiste unten"
      >
        Direkt starten
      </a>
    </div>
  </div>

  <div>
    <p class="text-xs font-medium uppercase tracking-wide text-accent-700 dark:text-accent-100 mb-2">
      Stichworte mit Aufgaben
    </p>
    <p class="text-xs text-ink-600 dark:text-ink-300 mb-3 max-w-2xl leading-snug">
      Nur Themen, für die bereits Generatoren existieren. Weitere Stichwörter aus dem Lehrplan folgen nach und nach
      auf der Übungsseite.
    </p>
    <ul class="m-0 flex list-none flex-wrap gap-2 p-0" role="list">
      {
        stichworteMitUebung.map((p) => (
          <li>
            <button
              type="button"
              class="mu-wb-thema-kw inline-block max-w-full rounded-lg border border-accent-600/35 bg-surface px-2.5 py-1 text-left text-xs font-medium text-accent-800 shadow-sm transition hover:border-accent-600 hover:bg-accent-50 dark:border-accent-400/30 dark:bg-slate-900/60 dark:text-accent-50 dark:hover:border-accent-300 dark:hover:bg-slate-800/80"
              data-stichwort={p}
              aria-pressed="false"
            >
              {p}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>
