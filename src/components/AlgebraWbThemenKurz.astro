---
/**
 * WB-Algebra auf /themen: Stichwort-Pills nach Unterthemen-Clustern (ohne separaten „Zufallsaufgaben“-Kasten).
 */
import { algWbStichwortPillsNachCluster } from '../lib/algebraWbKeywordMap';

const clusters = algWbStichwortPillsNachCluster();
---

<div class="space-y-6">
  <div>
    <p class="text-xs font-medium uppercase tracking-wide text-accent-700 dark:text-accent-100 mb-2">
      Stichworte mit Aufgaben
    </p>
    <p class="text-xs text-ink-600 dark:text-ink-300 mb-4 max-w-2xl leading-snug">
      Nach Unterthemen gruppiert (wie im Lehrplanüberblick). Aktivierbare Stichworte haben bereits zufallsgenerierte Übungen. Inaktive Stichworte zeigen die inhaltliche Vollständigkeit des Lehrplans.
    </p>
  </div>
  {
    clusters.map((cluster, idx) => (
      <section aria-labelledby={`mu-alg-cluster-${idx}`}>
        <div
          class="mu-wb-kw-cluster rounded-lg border border-ink-200/90 bg-ink-50/90 p-4 shadow-sm dark:border-slate-600/50 dark:bg-slate-950/50"
        >
          <div class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
            <h5
              id={`mu-alg-cluster-${idx}`}
              class="text-sm font-semibold text-ink-900 dark:text-ink-50 min-w-0"
            >
              {cluster.titel}
            </h5>
            <div
              class="flex shrink-0 flex-wrap gap-1.5"
              role="group"
              aria-label={`Stichwort-Auswahl: ${cluster.titel}`}
            >
              <button
                type="button"
                class="mu-wb-kw-bulk rounded-md px-2 py-0.5 text-[11px] font-semibold shadow-sm transition-colors sm:px-2.5 sm:text-xs"
                data-mu-wb-kw-bulk="cluster-select"
                aria-label={`Alle Stichwörter in „${cluster.titel}“ auswählen`}
              >
                Alle
              </button>
              <button
                type="button"
                class="mu-wb-kw-bulk rounded-md px-2 py-0.5 text-[11px] font-semibold shadow-sm transition-colors sm:px-2.5 sm:text-xs"
                data-mu-wb-kw-bulk="cluster-clear"
                aria-label={`Alle Stichwörter in „${cluster.titel}“ abwählen`}
              >
                Keins
              </button>
            </div>
          </div>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0" role="list">
            {cluster.stichworte.map((p) => (
              <li>
                {p.hatUebung ? (
                  <button
                    type="button"
                    class="mu-wb-thema-kw inline-block max-w-full rounded-lg border border-accent-600/35 bg-surface px-2.5 py-1 text-left text-xs font-medium text-accent-800 shadow-sm transition hover:border-accent-600 hover:bg-accent-50 dark:border-accent-400/30 dark:bg-slate-900/60 dark:text-accent-50 dark:hover:border-accent-300 dark:hover:bg-slate-800/80"
                    data-stichwort={p.name}
                    aria-pressed="false"
                  >
                    {p.name}
                  </button>
                ) : (
                  <span
                    class="inline-block max-w-full rounded-lg border border-ink-200/60 bg-ink-100/30 px-2.5 py-1 text-left text-xs font-medium text-ink-400/70 dark:border-slate-800/70 dark:bg-slate-900/20 dark:text-slate-500/70 cursor-not-allowed select-none"
                    title="Noch kein Generator für dieses Unterthema verfügbar"
                  >
                    {p.name}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</div>
