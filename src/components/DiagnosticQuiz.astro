---
// Diagnostische MC-Frage im Stil von Craig Bartons "Diagnostic Questions":
// Jede falsche Antwort enthält einen typischen Denkfehler -
// und für jede Option (auch die richtige) gibt es eine Erklärung.
//
// Verwendung:
// import DiagnosticQuiz from '../components/DiagnosticQuiz.astro';
// <DiagnosticQuiz fragen={...} />

export interface Option {
  text: string;
  korrekt: boolean;
  erklaerung: string;
}

export interface Frage {
  frage: string;
  kontext?: string;
  optionen: Option[];
}

export interface Props {
  fragen: Frage[];
  id?: string;
}

const { fragen, id = 'quiz' } = Astro.props;

// Plickers-Export: pro Frage eine Zeile mit "Frage X: ...", dann pro Antwort eine Zeile
// (korrekte Antwort zuerst, keine A/B/C/D-Praefixe). Mathe in $$...$$.
function toPlickersMath(s: string): string {
  // Einfache $...$ -> $$...$$ (doppelte $$ bleiben unangetastet)
  let result = s.replace(/(?<!\$)\$([^$\n]+)\$(?!\$)/g, (_m, inner) => `$$${inner}$$`);
  // Markdown-Inline-Code `expr` -> $$expr$$ (in Quizfragen sind das immer Variablen wie f(t))
  result = result.replace(/`([^`\n]+)`/g, (_m, inner) => `$$${inner}$$`);
  return result;
}
const plickersText = fragen.map((f, fi) => {
  const frageZeile = `Frage ${fi + 1}: ${toPlickersMath(f.frage)}`;
  const sortiert = [...f.optionen].sort((a, b) => Number(b.korrekt) - Number(a.korrekt));
  const antwortZeilen = sortiert.map((o) => toPlickersMath(o.text));
  return [frageZeile, ...antwortZeilen].join('\n');
}).join('\n');
---

<section
  class="not-prose my-8 rounded-xl border border-ink-200 bg-white p-6 shadow-sm dark:border-ink-700 dark:bg-ink-800 dark:shadow-black/30"
  data-quiz
  data-quiz-id={id}
>
  {fragen.map((f, fi) => (
    <article
      class="quiz-frage"
      data-frage-index={fi}
      data-anzahl-fragen={fragen.length}
      style={fi === 0 ? '' : 'display:none;'}
    >
      <header class="mb-4 flex items-center justify-between gap-3">
        <p class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">
          Frage <span class="font-semibold">{fi + 1}</span> von {fragen.length}
        </p>
        <div class="h-1 flex-1 rounded-full bg-ink-100 ml-4 overflow-hidden dark:bg-ink-700">
          <div
            class="h-full bg-accent-500 transition-all"
            style={`width:${((fi) / fragen.length) * 100}%`}
            data-fortschritt
          ></div>
        </div>
      </header>

      {f.kontext && (
        <p class="mb-3 text-sm text-ink-600 italic dark:text-ink-300">{f.kontext}</p>
      )}

      <h3 class="font-serif text-xl font-semibold text-ink-900 mb-5 leading-snug dark:text-ink-50">
        {f.frage}
      </h3>

      <ul class="grid gap-2.5" role="radiogroup" aria-label="Antwortoptionen">
        {f.optionen.map((opt, oi) => (
          <li>
            <button
              type="button"
              class="quiz-option group w-full text-left rounded-lg border border-ink-200 bg-white px-4 py-3 hover:border-accent-500 hover:bg-accent-50/50 focus:outline-none focus:ring-2 focus:ring-accent-500 transition dark:border-ink-700 dark:bg-ink-900 dark:hover:border-accent-500 dark:hover:bg-accent-700/20"
              data-korrekt={opt.korrekt ? 'true' : 'false'}
              data-option-index={oi}
              data-erklaerung={opt.erklaerung}
              role="radio"
              aria-checked="false"
            >
              <span class="flex items-start gap-3">
                <span
                  class="quiz-letter mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ink-300 text-xs font-semibold text-ink-700 group-hover:border-accent-500 group-hover:text-accent-700 dark:border-ink-600 dark:text-ink-200 dark:group-hover:border-accent-300 dark:group-hover:text-accent-100"
                  aria-hidden="true"
                >
                  {String.fromCharCode(65 + oi)}
                </span>
                <span class="quiz-option-text text-ink-800 dark:text-ink-100">{opt.text}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>

      <div
        class="quiz-erklaerung mt-5 hidden rounded-lg border-l-4 p-4"
        role="status"
        aria-live="polite"
      ></div>

      <footer class="mt-5 flex items-center justify-between">
        <button
          type="button"
          class="quiz-show-all text-sm text-ink-600 hover:text-accent-700 underline-offset-2 hover:underline hidden dark:text-ink-300 dark:hover:text-accent-100"
        >
          Alle Antworten erklären
        </button>
        <button
          type="button"
          class="quiz-next ml-auto inline-flex items-center gap-1 rounded-md bg-accent-600 px-4 py-2 text-sm font-medium text-white hover:bg-accent-700 disabled:opacity-40 disabled:cursor-not-allowed dark:bg-accent-500 dark:hover:bg-accent-600"
          disabled
        >
          Weiter
          <span aria-hidden="true">→</span>
        </button>
      </footer>
    </article>
  ))}

  <article
    class="quiz-zusammenfassung"
    style="display:none;"
    aria-live="polite"
  >
    <h3 class="font-serif text-2xl font-semibold text-ink-900 mb-3 dark:text-ink-50">
      Diagnose abgeschlossen
    </h3>
    <p class="text-ink-700 mb-4 dark:text-ink-200">
      Du hast <span class="quiz-richtig font-semibold">0</span> von
      <span class="quiz-gesamt">{fragen.length}</span> Fragen richtig beantwortet.
    </p>
    <p class="text-sm text-ink-600 dark:text-ink-300">
      Diagnostische Fragen sind nicht zum „Punkten" da – die Verteilung der gewählten
      Distraktoren verrät oft mehr über das Verständnis als die richtige Lösung selbst.
      Nutze die Erklärungen, um typische Denkmuster im Unterricht zu adressieren.
    </p>
    <button
      type="button"
      class="quiz-restart mt-5 rounded-md border border-ink-300 px-4 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100 dark:border-ink-600 dark:text-ink-200 dark:hover:bg-ink-700"
    >
      Quiz neu starten
    </button>
  </article>
</section>

<details class="plickers-export not-prose mt-4 rounded-xl border border-ink-200 bg-white shadow-sm dark:border-ink-700 dark:bg-ink-800 dark:shadow-black/30">
  <summary class="cursor-pointer select-none px-6 py-4 text-sm font-medium text-ink-700 hover:bg-ink-50 dark:text-ink-200 dark:hover:bg-ink-700/40 rounded-xl">
    <span class="inline-flex items-center gap-2">
      <svg class="plickers-logo h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true">
        <!-- Hintergrund-Karte (heller Blauton, leicht versetzt) -->
        <rect x="10" y="10" width="20" height="20" rx="3.5" fill="#A8C7FA"/>
        <!-- Vordergrund-Karte (Plickers-Blau) -->
        <rect x="2" y="2" width="22" height="22" rx="4" fill="#2563EB"/>
        <!-- Weisses Haekchen -->
        <path d="M6.5 13.5 L11.5 18.5 L18.5 9" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Für Plickers-Import (Code)
    </span>
  </summary>
  <div class="border-t border-ink-200 px-6 py-4 dark:border-ink-700">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <p class="text-xs text-ink-500 dark:text-ink-400">
        Korrekte Antwort steht jeweils oben. Mathe-Ausdrücke sind in <code class="text-[0.7rem]">$$…$$</code>.
      </p>
      <div class="flex items-center gap-2">
        <a
          href="https://www.plickers.com/seteditor/newSet"
          target="_blank"
          rel="noopener noreferrer"
          class="plickers-link inline-flex items-center gap-1.5 rounded-md bg-[#2563EB] px-3 py-1.5 text-xs font-medium text-white hover:bg-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:ring-offset-2 dark:focus:ring-offset-ink-800"
          aria-label="Neues Set bei Plickers anlegen (oeffnet in neuem Tab)"
          title="Neues Set bei Plickers anlegen"
        >
          <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="10" y="10" width="20" height="20" rx="3.5" fill="#fff" fill-opacity="0.45"/>
            <rect x="2" y="2" width="22" height="22" rx="4" fill="#fff" fill-opacity="0.95"/>
            <path d="M6.5 13.5 L11.5 18.5 L18.5 9" fill="none" stroke="#2563EB" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="plickers-link-label">Neues Set in Plickers anlegen</span>
          <svg class="h-3 w-3 shrink-0 opacity-90" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/>
            <path d="M7 7h10v10"/>
          </svg>
        </a>
        <button
          type="button"
          class="plickers-copy inline-flex items-center gap-1.5 rounded-md border border-ink-300 bg-white px-3 py-1.5 text-xs font-medium text-ink-700 hover:bg-ink-50 focus:outline-none focus:ring-2 focus:ring-accent-500 dark:border-ink-600 dark:bg-ink-900 dark:text-ink-200 dark:hover:bg-ink-700"
          aria-label="Block in die Zwischenablage kopieren"
          title="In Zwischenablage kopieren"
        >
          <svg class="plickers-copy-icon h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="plickers-copy-label">Kopieren</span>
        </button>
      </div>
    </div>
    <pre class="plickers-code overflow-x-auto rounded-md bg-ink-50 p-4 text-xs leading-relaxed text-ink-800 dark:bg-ink-900 dark:text-ink-100"><code>{plickersText}</code></pre>
  </div>
</details>

<script>
  type QuizState = {
    aktuell: number;
    richtig: number;
    beantwortet: Set<number>;
  };

  const OPTION_BASE_CLASS =
    'quiz-option group w-full text-left rounded-lg border border-ink-200 bg-white px-4 py-3 hover:border-accent-500 hover:bg-accent-50/50 focus:outline-none focus:ring-2 focus:ring-accent-500 transition dark:border-ink-700 dark:bg-ink-900 dark:hover:border-accent-500 dark:hover:bg-accent-700/20';
  const LETTER_BASE_CLASS =
    'quiz-letter mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ink-300 text-xs font-semibold text-ink-700 group-hover:border-accent-500 group-hover:text-accent-700 dark:border-ink-600 dark:text-ink-200 dark:group-hover:border-accent-300 dark:group-hover:text-accent-100';

  // Rendert $...$/$$...$$/\(...\)/\[...\] in einem Element nach Einfuegen dynamischer Inhalte.
  // Das auto-render-Skript aus dem CDN setzt renderMathInElement auf window; falls noch nicht geladen,
  // probieren wir es kurz spaeter erneut.
  const renderMathIn = (el: HTMLElement) => {
    const w = window as unknown as { renderMathInElement?: (el: HTMLElement, opts?: unknown) => void };
    if (typeof w.renderMathInElement === 'function') {
      w.renderMathInElement(el, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$',  right: '$',  display: false },
          { left: '\\(', right: '\\)', display: false },
          { left: '\\[', right: '\\]', display: true },
        ],
        throwOnError: false,
      });
    } else {
      setTimeout(() => renderMathIn(el), 120);
    }
  };

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const fragen = Array.from(quiz.querySelectorAll<HTMLElement>('.quiz-frage'));
    const zusammenfassung = quiz.querySelector<HTMLElement>('.quiz-zusammenfassung');
    const richtigAnzeige = quiz.querySelector<HTMLElement>('.quiz-richtig');
    const fortschrittsbalken = quiz.querySelectorAll<HTMLElement>('[data-fortschritt]');
    const state: QuizState = { aktuell: 0, richtig: 0, beantwortet: new Set() };
    const gesamt = fragen.length;

    const aktualisiereFortschritt = (index: number) => {
      fortschrittsbalken.forEach((bar) => {
        bar.style.width = `${(index / gesamt) * 100}%`;
      });
    };

    const zeigeFrage = (index: number) => {
      fragen.forEach((f, i) => {
        f.style.display = i === index ? '' : 'none';
      });
      aktualisiereFortschritt(index);
    };

    const beantworteFrage = (frageEl: HTMLElement, klickedButton: HTMLButtonElement) => {
      const optionen = frageEl.querySelectorAll<HTMLButtonElement>('.quiz-option');
      const erklaerungBox = frageEl.querySelector<HTMLElement>('.quiz-erklaerung');
      const weiterBtn = frageEl.querySelector<HTMLButtonElement>('.quiz-next');
      const alleAntwortenBtn = frageEl.querySelector<HTMLButtonElement>('.quiz-show-all');
      const istKorrekt = klickedButton.dataset.korrekt === 'true';
      const erklaerung = klickedButton.dataset.erklaerung || '';

      // Markiere alle Optionen visuell
      optionen.forEach((opt) => {
        opt.disabled = true;
        opt.setAttribute('aria-checked', opt === klickedButton ? 'true' : 'false');
        opt.classList.remove(
          'hover:border-accent-500',
          'hover:bg-accent-50/50',
          'dark:hover:border-accent-500',
          'dark:hover:bg-accent-700/20'
        );
        if (opt.dataset.korrekt === 'true') {
          opt.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-900/30', 'dark:border-emerald-400');
          opt.querySelector('.quiz-letter')?.classList.add('border-emerald-500', 'text-emerald-700', 'dark:border-emerald-400', 'dark:text-emerald-200');
        } else if (opt === klickedButton) {
          opt.classList.add('border-rose-400', 'bg-rose-50', 'dark:bg-rose-900/30', 'dark:border-rose-400');
          opt.querySelector('.quiz-letter')?.classList.add('border-rose-400', 'text-rose-700', 'dark:border-rose-400', 'dark:text-rose-200');
        } else {
          opt.classList.add('opacity-60');
        }
      });

      if (erklaerungBox) {
        erklaerungBox.innerHTML = `
          <p class="text-xs font-semibold uppercase tracking-wide ${istKorrekt ? 'text-emerald-700 dark:text-emerald-200' : 'text-rose-700 dark:text-rose-200'} mb-1">
            ${istKorrekt ? 'Richtig' : 'Typischer Fehler'}
          </p>
          <p class="text-ink-800 text-sm leading-relaxed dark:text-ink-100">${erklaerung}</p>
        `;
        erklaerungBox.classList.remove('hidden');
        erklaerungBox.classList.add(
          istKorrekt ? 'border-emerald-500' : 'border-rose-400',
          istKorrekt ? 'bg-emerald-50/40' : 'bg-rose-50/40',
          istKorrekt ? 'dark:bg-emerald-900/20' : 'dark:bg-rose-900/20'
        );
        renderMathIn(erklaerungBox);
      }

      if (alleAntwortenBtn) {
        alleAntwortenBtn.classList.remove('hidden');
        alleAntwortenBtn.onclick = () => {
          let html = '<dl class="space-y-3 mt-4 text-sm">';
          optionen.forEach((opt) => {
            const ok = opt.dataset.korrekt === 'true';
            const text = opt.querySelector('.quiz-option-text')?.textContent ?? '';
            const erkl = opt.dataset.erklaerung || '';
            html += `
              <div>
                <dt class="font-semibold ${ok ? 'text-emerald-700 dark:text-emerald-200' : 'text-ink-700 dark:text-ink-200'}">
                  ${ok ? '✓' : '✗'} ${text}
                </dt>
                <dd class="text-ink-600 mt-0.5 dark:text-ink-300">${erkl}</dd>
              </div>`;
          });
          html += '</dl>';
          if (erklaerungBox) {
            erklaerungBox.insertAdjacentHTML('beforeend', html);
            alleAntwortenBtn.classList.add('hidden');
            renderMathIn(erklaerungBox);
          }
        };
      }

      if (weiterBtn) {
        weiterBtn.disabled = false;
        weiterBtn.textContent = state.aktuell === gesamt - 1 ? 'Auswertung anzeigen' : 'Weiter';
        weiterBtn.append(Object.assign(document.createElement('span'), { textContent: ' →', ariaHidden: 'true' }));
      }

      const frageIndex = Number(frageEl.dataset.frageIndex);
      if (!state.beantwortet.has(frageIndex)) {
        state.beantwortet.add(frageIndex);
        if (istKorrekt) state.richtig += 1;
      }
    };

    const zeigeZusammenfassung = () => {
      fragen.forEach((f) => (f.style.display = 'none'));
      if (zusammenfassung) zusammenfassung.style.display = '';
      if (richtigAnzeige) richtigAnzeige.textContent = String(state.richtig);
      aktualisiereFortschritt(gesamt);
    };

    const restart = () => {
      state.aktuell = 0;
      state.richtig = 0;
      state.beantwortet.clear();
      // alle Fragen zurücksetzen
      fragen.forEach((f) => {
        const optionen = f.querySelectorAll<HTMLButtonElement>('.quiz-option');
        const erklaerungBox = f.querySelector<HTMLElement>('.quiz-erklaerung');
        const weiterBtn = f.querySelector<HTMLButtonElement>('.quiz-next');
        const alleAntwortenBtn = f.querySelector<HTMLButtonElement>('.quiz-show-all');
        optionen.forEach((opt) => {
          opt.disabled = false;
          opt.setAttribute('aria-checked', 'false');
          opt.className = OPTION_BASE_CLASS;
          const letter = opt.querySelector('.quiz-letter');
          if (letter) letter.className = LETTER_BASE_CLASS;
        });
        erklaerungBox?.classList.add('hidden');
        if (erklaerungBox) erklaerungBox.innerHTML = '';
        if (weiterBtn) {
          weiterBtn.disabled = true;
          weiterBtn.innerHTML = 'Weiter <span aria-hidden="true">→</span>';
        }
        alleAntwortenBtn?.classList.add('hidden');
      });
      if (zusammenfassung) zusammenfassung.style.display = 'none';
      zeigeFrage(0);
    };

    // Event-Bindings
    fragen.forEach((frageEl) => {
      frageEl.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((opt) => {
        opt.addEventListener('click', () => beantworteFrage(frageEl, opt));
      });
      frageEl.querySelector<HTMLButtonElement>('.quiz-next')?.addEventListener('click', () => {
        if (state.aktuell < gesamt - 1) {
          state.aktuell += 1;
          zeigeFrage(state.aktuell);
        } else {
          zeigeZusammenfassung();
        }
      });
    });
    quiz.querySelector<HTMLButtonElement>('.quiz-restart')?.addEventListener('click', restart);
  });

  // Plickers-Export: Text aus dem zugehoerigen Codeblock in die Zwischenablage kopieren.
  const copyPlickersBlock = (host: HTMLElement): boolean => {
    const codeEl = host.querySelector<HTMLElement>('.plickers-code code');
    const text = codeEl?.textContent ?? '';
    if (!text) return false;
    try {
      // Bevorzugte API
      navigator.clipboard?.writeText(text).catch(() => {});
    } catch {}
    // Synchroner Fallback fuer aeltere Browser
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    } catch {}
    return true;
  };

  // Kopier-Button
  document.querySelectorAll<HTMLButtonElement>('.plickers-copy').forEach((btn) => {
    btn.addEventListener('click', () => {
      const details = btn.closest('details');
      if (!details) return;
      const label = btn.querySelector<HTMLElement>('.plickers-copy-label');
      const originalLabel = label?.textContent ?? 'Kopieren';
      const ok = copyPlickersBlock(details);
      if (label) label.textContent = ok ? 'Kopiert ✓' : 'Fehler';
      setTimeout(() => { if (label) label.textContent = originalLabel; }, 1800);
    });
  });

  // "Neues Set in Plickers anlegen": erst Codeblock kopieren, dann Plickers oeffnen
  document.querySelectorAll<HTMLAnchorElement>('.plickers-link').forEach((link) => {
    link.addEventListener('click', () => {
      const details = link.closest('details');
      if (!details) return;
      // Synchron kopieren, bevor der Browser in den neuen Tab navigiert
      copyPlickersBlock(details);
      // Kurze visuelle Rueckmeldung im aktuellen Tab (sichtbar wenn Nutzer zurueckkommt)
      const label = link.querySelector<HTMLElement>('.plickers-link-label');
      const originalLabel = label?.textContent ?? 'Neues Set in Plickers anlegen';
      if (label) label.textContent = 'Kopiert – im neuen Tab einfügen ✓';
      setTimeout(() => { if (label) label.textContent = originalLabel; }, 4000);
    });
  });
</script>
