---
// Diagnostische MC-Frage im Stil von Craig Bartons "Diagnostic Questions":
// Jede falsche Antwort enthält einen typischen Denkfehler -
// und für jede Option (auch die richtige) gibt es eine Erklärung.
//
// Verwendung:
// import DiagnosticQuiz from '../components/DiagnosticQuiz.astro';
// <DiagnosticQuiz fragen={...} />

export interface Option {
  text: string;
  korrekt: boolean;
  erklaerung: string;
}

export interface Frage {
  frage: string;
  kontext?: string;
  optionen: Option[];
}

export interface Props {
  fragen: Frage[];
  id?: string;
}

const { fragen, id = 'quiz' } = Astro.props;
const headingId = `diagnostische-fragen-${id}`;
---

<section
  class="not-prose my-8 rounded-xl border border-ink-200 bg-surface p-6 shadow-sm mu-dark-glass-panel"
  data-quiz
  data-quiz-id={id}
  aria-labelledby={headingId}
>
  <h2
    id={headingId}
    class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50 mb-6"
  >
    Diagnostische Fragen
  </h2>

  {fragen.map((f, fi) => (
    <article
      class="quiz-frage"
      data-frage-index={fi}
      data-anzahl-fragen={fragen.length}
      style={fi === 0 ? '' : 'display:none;'}
    >
      <header class="mb-4 flex items-center justify-between gap-3">
        <p class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">
          Frage <span class="font-semibold">{fi + 1}</span> von {fragen.length}
        </p>
        <div class="h-1 flex-1 rounded-full bg-ink-100 ml-4 overflow-hidden dark:bg-ink-700">
          <div
            class="h-full bg-accent-500 transition-all"
            style={`width:${((fi) / fragen.length) * 100}%`}
            data-fortschritt
          ></div>
        </div>
      </header>

      {f.kontext && (
        <p class="mb-3 text-sm text-ink-600 italic dark:text-ink-300">{f.kontext}</p>
      )}

      <h3
        class="quiz-frage-titel font-serif text-xl font-semibold text-ink-900 mb-5 leading-snug scroll-mt-28 dark:text-ink-50"
        tabindex="-1"
        data-quiz-frage-scroll-target
      >
        {f.frage}
      </h3>

      <ul class="grid gap-2.5" role="radiogroup" aria-label="Antwortoptionen">
        {f.optionen.map((opt, oi) => (
          <li class="quiz-option-block">
            <button
              type="button"
              class="quiz-option group w-full text-left rounded-lg border border-ink-200 bg-surface px-4 py-3 hover:border-accent-500 hover:bg-accent-50/50 focus:outline-none focus:ring-2 focus:ring-accent-500 transition dark:border-slate-600/50 dark:bg-slate-950/55 dark:ring-1 dark:ring-inset dark:ring-sky-400/10 dark:hover:border-teal-400/45 dark:hover:bg-violet-950/35"
              data-korrekt={opt.korrekt ? 'true' : 'false'}
              data-option-index={oi}
              data-erklaerung={opt.erklaerung}
              role="radio"
              aria-checked="false"
            >
              <span class="flex items-start gap-3">
                <span
                  class="quiz-letter mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ink-300 text-xs font-semibold text-ink-700 group-hover:border-accent-500 group-hover:text-accent-700 dark:border-ink-600 dark:text-ink-200 dark:group-hover:border-accent-300 dark:group-hover:text-accent-100"
                  aria-hidden="true"
                >
                  {String.fromCharCode(65 + oi)}
                </span>
                <span class="quiz-option-text text-ink-800 dark:text-ink-100">{opt.text}</span>
              </span>
            </button>
            <div
              class="quiz-option-feedback hidden mt-2 ml-9 rounded-md border px-3 py-2.5 text-sm leading-relaxed"
              data-option-feedback
              aria-hidden="true"
            ></div>
          </li>
        ))}
      </ul>

      <footer class="mt-5 flex flex-wrap items-center justify-between gap-3">
        <button
          type="button"
          class="quiz-show-all text-sm text-ink-600 hover:text-accent-700 underline-offset-2 hover:underline hidden dark:text-ink-300 dark:hover:text-accent-100"
        >
          Alle Antworten erklären
        </button>
        <button
          type="button"
          class="quiz-next ml-auto inline-flex items-center gap-1 rounded-md bg-accent-600 px-4 py-2 text-sm font-medium text-white hover:bg-accent-700 disabled:opacity-40 disabled:cursor-not-allowed dark:bg-accent-500 dark:hover:bg-accent-600"
          disabled
        >
          Weiter
          <span aria-hidden="true">→</span>
        </button>
      </footer>
    </article>
  ))}

  <article
    class="quiz-zusammenfassung"
    style="display:none;"
    aria-live="polite"
  >
    <h3
      class="font-serif text-2xl font-semibold text-ink-900 mb-3 scroll-mt-28 dark:text-ink-50"
      tabindex="-1"
      data-quiz-zusammenfassung-scroll
    >
      Diagnose abgeschlossen
    </h3>
    <p class="text-ink-700 mb-4 dark:text-ink-200">
      Du hast <span class="quiz-richtig font-semibold">0</span> von
      <span class="quiz-gesamt">{fragen.length}</span> Fragen richtig beantwortet.
    </p>
    <p class="text-sm text-ink-600 dark:text-ink-300">
      Diagnostische Fragen sind nicht zum „Punkten" da – die Verteilung der gewählten
      Distraktoren verrät oft mehr über das Verständnis als die richtige Lösung selbst.
      Nutze die Erklärungen, um typische Denkmuster im Unterricht zu adressieren.
    </p>
    <button
      type="button"
      class="quiz-restart mt-5 rounded-md border border-ink-300 px-4 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100 dark:border-slate-600/50 dark:bg-slate-950/50 dark:text-ink-200 dark:hover:bg-slate-800/70"
    >
      Quiz neu starten
    </button>
  </article>
</section>

<script>
  type QuizState = {
    aktuell: number;
    richtig: number;
    beantwortet: Set<number>;
  };

  const OPTION_BASE_CLASS =
    'quiz-option group w-full text-left rounded-lg border border-ink-200 bg-surface px-4 py-3 hover:border-accent-500 hover:bg-accent-50/50 focus:outline-none focus:ring-2 focus:ring-accent-500 transition dark:border-slate-600/50 dark:bg-slate-950/55 dark:ring-1 dark:ring-inset dark:ring-sky-400/10 dark:hover:border-teal-400/45 dark:hover:bg-violet-950/35';
  const LETTER_BASE_CLASS =
    'quiz-letter mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ink-300 text-xs font-semibold text-ink-700 group-hover:border-accent-500 group-hover:text-accent-700 dark:border-ink-600 dark:text-ink-200 dark:group-hover:border-accent-300 dark:group-hover:text-accent-100';

  // KaTeX-Helper: rendert $...$ und $$...$$ in einem konkreten Element nach,
  // sobald das CDN-Skript geladen ist. Wird nach jedem dynamischen innerHTML-Setzen
  // aufgerufen, damit Math-Notation auch in Erklaerungen erscheint.
  const renderKatex = (el: HTMLElement | null) => {
    if (!el) return;
    // @ts-ignore - renderMathInElement kommt vom KaTeX-Auto-Render-CDN-Skript
    const fn = (window as any).renderMathInElement;
    if (typeof fn === 'function') {
      fn(el, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
        ],
        ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option'],
        ignoredClasses: ['katex'],
        throwOnError: false,
      });
    } else {
      // Skript noch nicht geladen - kurz warten und nochmal versuchen.
      setTimeout(() => renderKatex(el), 150);
    }
  };

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const fragen = Array.from(quiz.querySelectorAll<HTMLElement>('.quiz-frage'));
    const zusammenfassung = quiz.querySelector<HTMLElement>('.quiz-zusammenfassung');
    const richtigAnzeige = quiz.querySelector<HTMLElement>('.quiz-richtig');
    const fortschrittsbalken = quiz.querySelectorAll<HTMLElement>('[data-fortschritt]');
    const state: QuizState = { aktuell: 0, richtig: 0, beantwortet: new Set() };
    const gesamt = fragen.length;

    /** Mischt die Antwortoptionen (Fisher–Yates), damit die richtige Antwort nicht immer an erster Stelle steht. */
    const mischeOptionenInFrage = (frageEl: HTMLElement) => {
      const ul = frageEl.querySelector<HTMLUListElement>('ul[role="radiogroup"]');
      if (!ul) return;
      const items = Array.from(ul.querySelectorAll<HTMLLIElement>(':scope > li.quiz-option-block'));
      if (items.length < 2) return;
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
      items.forEach((li) => {
        ul.appendChild(li);
      });
      items.forEach((li, oi) => {
        const letter = li.querySelector('.quiz-letter');
        if (letter) {
          letter.textContent = String.fromCharCode(65 + oi);
          letter.className = LETTER_BASE_CLASS;
        }
        const btn = li.querySelector<HTMLButtonElement>('.quiz-option');
        if (btn) btn.dataset.optionIndex = String(oi);
      });
    };

    fragen.forEach(mischeOptionenInFrage);

    const aktualisiereFortschritt = (index: number) => {
      fortschrittsbalken.forEach((bar) => {
        bar.style.width = `${(index / gesamt) * 100}%`;
      });
    };

    const scrollZuFrage = (index: number) => {
      const ziel = fragen[index]?.querySelector<HTMLElement>('[data-quiz-frage-scroll-target]');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (!ziel) return;
          ziel.focus({ preventScroll: true });
          ziel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    };

    const scrollZuZusammenfassung = () => {
      const ziel = zusammenfassung?.querySelector<HTMLElement>('[data-quiz-zusammenfassung-scroll]');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (!ziel) return;
          ziel.focus({ preventScroll: true });
          ziel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    };

    const leereOptionFeedback = (frageEl: HTMLElement) => {
      frageEl.querySelectorAll<HTMLElement>('[data-option-feedback]').forEach((fb) => {
        fb.innerHTML = '';
        fb.className =
          'quiz-option-feedback hidden mt-2 ml-9 rounded-md border px-3 py-2.5 text-sm leading-relaxed';
        fb.setAttribute('aria-hidden', 'true');
      });
    };

    const zeigeFrage = (index: number) => {
      fragen.forEach((f, i) => {
        f.style.display = i === index ? '' : 'none';
      });
      aktualisiereFortschritt(index);
    };

    const fuelleFeedbackHtml = (
      opt: HTMLButtonElement,
      feedback: HTMLElement,
      kastenModus: 'emerald' | 'rose' | 'neutral'
    ) => {
      const ok = opt.dataset.korrekt === 'true';
      const erkl = opt.dataset.erklaerung || '';
      const label = ok ? 'Richtig' : 'Typischer Fehler';
      const labelClass =
        kastenModus === 'emerald'
          ? 'text-emerald-700 dark:text-emerald-200'
          : kastenModus === 'rose'
            ? 'text-rose-700 dark:text-rose-200'
            : 'text-ink-700 dark:text-ink-200';
      let boxClass =
        'border-ink-200 bg-ink-50/50 text-ink-800 dark:border-slate-600/60 dark:bg-slate-900/40 dark:text-ink-100';
      if (kastenModus === 'emerald') {
        boxClass =
          'border-emerald-500 bg-emerald-50/50 text-ink-800 dark:border-emerald-400 dark:bg-emerald-900/25 dark:text-ink-100';
      } else if (kastenModus === 'rose') {
        boxClass =
          'border-rose-400 bg-rose-50/50 text-ink-800 dark:border-rose-400 dark:bg-rose-900/25 dark:text-ink-100';
      }
      feedback.className =
        `quiz-option-feedback mt-2 ml-9 rounded-md border px-3 py-2.5 text-sm leading-relaxed ${boxClass}`;
      feedback.innerHTML = `
        <p class="text-xs font-semibold uppercase tracking-wide ${labelClass} mb-1">${label}</p>
        <p class="whitespace-pre-line text-ink-800 dark:text-ink-100">${erkl}</p>
      `;
      feedback.classList.remove('hidden');
      feedback.setAttribute('aria-hidden', 'false');
    };

    const zeigeTeilFeedbacks = (frageEl: HTMLElement, klickedButton: HTMLButtonElement) => {
      leereOptionFeedback(frageEl);
      const optionen = frageEl.querySelectorAll<HTMLButtonElement>('.quiz-option');
      const richtigBtn = Array.from(optionen).find((o) => o.dataset.korrekt === 'true');

      optionen.forEach((opt) => {
        const feedback = opt.closest('.quiz-option-block')?.querySelector<HTMLElement>('[data-option-feedback]');
        if (!feedback) return;
        const ok = opt.dataset.korrekt === 'true';
        const gewaehlt = opt === klickedButton;
        if (gewaehlt) {
          fuelleFeedbackHtml(opt, feedback, ok ? 'emerald' : 'rose');
        } else if (ok && !gewaehlt && klickedButton !== richtigBtn) {
          fuelleFeedbackHtml(opt, feedback, 'emerald');
        }
      });
    };

    const zeigeAlleFeedbacks = (frageEl: HTMLElement) => {
      const optionen = frageEl.querySelectorAll<HTMLButtonElement>('.quiz-option');
      optionen.forEach((opt) => {
        const feedback = opt.closest('.quiz-option-block')?.querySelector<HTMLElement>('[data-option-feedback]');
        if (!feedback) return;
        const ok = opt.dataset.korrekt === 'true';
        const gewaehlt = opt.getAttribute('aria-checked') === 'true';
        const modus: 'emerald' | 'rose' | 'neutral' = ok ? 'emerald' : gewaehlt ? 'rose' : 'neutral';
        fuelleFeedbackHtml(opt, feedback, modus);
      });
    };

    const beantworteFrage = (frageEl: HTMLElement, klickedButton: HTMLButtonElement) => {
      const optionen = frageEl.querySelectorAll<HTMLButtonElement>('.quiz-option');
      const weiterBtn = frageEl.querySelector<HTMLButtonElement>('.quiz-next');
      const alleAntwortenBtn = frageEl.querySelector<HTMLButtonElement>('.quiz-show-all');
      const istKorrekt = klickedButton.dataset.korrekt === 'true';

      // Markiere alle Optionen visuell
      optionen.forEach((opt) => {
        opt.disabled = true;
        opt.setAttribute('aria-checked', opt === klickedButton ? 'true' : 'false');
        opt.classList.remove(
          'hover:border-accent-500',
          'hover:bg-accent-50/50',
          'dark:hover:border-accent-500',
          'dark:hover:bg-accent-700/20'
        );
        if (opt.dataset.korrekt === 'true') {
          opt.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-900/30', 'dark:border-emerald-400');
          opt.querySelector('.quiz-letter')?.classList.add('border-emerald-500', 'text-emerald-700', 'dark:border-emerald-400', 'dark:text-emerald-200');
        } else if (opt === klickedButton) {
          opt.classList.add('border-rose-400', 'bg-rose-50', 'dark:bg-rose-900/30', 'dark:border-rose-400');
          opt.querySelector('.quiz-letter')?.classList.add('border-rose-400', 'text-rose-700', 'dark:border-rose-400', 'dark:text-rose-200');
        } else {
          opt.classList.add('opacity-60');
        }
      });

      zeigeTeilFeedbacks(frageEl, klickedButton);
      renderKatex(frageEl);

      if (alleAntwortenBtn) {
        alleAntwortenBtn.classList.remove('hidden');
        alleAntwortenBtn.onclick = () => {
          zeigeAlleFeedbacks(frageEl);
          alleAntwortenBtn.classList.add('hidden');
          renderKatex(frageEl);
        };
      }

      if (weiterBtn) {
        weiterBtn.disabled = false;
        weiterBtn.textContent = state.aktuell === gesamt - 1 ? 'Auswertung anzeigen' : 'Weiter';
        weiterBtn.append(Object.assign(document.createElement('span'), { textContent: ' →', ariaHidden: 'true' }));
      }

      const frageIndex = Number(frageEl.dataset.frageIndex);
      if (!state.beantwortet.has(frageIndex)) {
        state.beantwortet.add(frageIndex);
        if (istKorrekt) state.richtig += 1;
      }
    };

    const zeigeZusammenfassung = () => {
      fragen.forEach((f) => (f.style.display = 'none'));
      if (zusammenfassung) zusammenfassung.style.display = '';
      if (richtigAnzeige) richtigAnzeige.textContent = String(state.richtig);
      aktualisiereFortschritt(gesamt);
      scrollZuZusammenfassung();
    };

    const restart = () => {
      state.aktuell = 0;
      state.richtig = 0;
      state.beantwortet.clear();
      // alle Fragen zurücksetzen
      fragen.forEach((f) => {
        const optionen = f.querySelectorAll<HTMLButtonElement>('.quiz-option');
        const weiterBtn = f.querySelector<HTMLButtonElement>('.quiz-next');
        const alleAntwortenBtn = f.querySelector<HTMLButtonElement>('.quiz-show-all');
        optionen.forEach((opt) => {
          opt.disabled = false;
          opt.setAttribute('aria-checked', 'false');
          opt.className = OPTION_BASE_CLASS;
          const letter = opt.querySelector('.quiz-letter');
          if (letter) letter.className = LETTER_BASE_CLASS;
        });
        leereOptionFeedback(f);
        if (weiterBtn) {
          weiterBtn.disabled = true;
          weiterBtn.innerHTML = 'Weiter <span aria-hidden="true">→</span>';
        }
        if (alleAntwortenBtn) {
          alleAntwortenBtn.classList.add('hidden');
          alleAntwortenBtn.onclick = null;
        }
        mischeOptionenInFrage(f);
      });
      if (zusammenfassung) zusammenfassung.style.display = 'none';
      zeigeFrage(0);
      scrollZuFrage(0);
    };

    // Event-Bindings
    fragen.forEach((frageEl) => {
      frageEl.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((opt) => {
        opt.addEventListener('click', () => beantworteFrage(frageEl, opt));
      });
      frageEl.querySelector<HTMLButtonElement>('.quiz-next')?.addEventListener('click', () => {
        if (state.aktuell < gesamt - 1) {
          state.aktuell += 1;
          zeigeFrage(state.aktuell);
          scrollZuFrage(state.aktuell);
        } else {
          zeigeZusammenfassung();
        }
      });
    });
    quiz.querySelector<HTMLButtonElement>('.quiz-restart')?.addEventListener('click', restart);
  });
</script>
