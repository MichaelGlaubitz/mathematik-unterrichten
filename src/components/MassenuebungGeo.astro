---
import {
  BINOMISCHE_FORMELN_GENERATOR_IDS,
  ALGEBRA_GENERATOR_IDS,
  BRUCHRECHNUNG_GENERATOR_IDS,
  CIRCLE_GEOMETRY_GENERATOR_IDS,
  EXPONENTIALFUNKTIONEN_GENERATOR_IDS,
  FRACTION_EQUATION_GENERATOR_IDS,
  LINEARE_FUNKTIONEN_GENERATOR_IDS,
  LINEARE_GLEICHUNGEN_GENERATOR_IDS,
  LINEARE_GLEICHUNGSSYSTEME_GENERATOR_IDS,
  LOGARITHMEN_GENERATOR_IDS,
  NEGATIVE_ZAHLEN_GENERATOR_IDS,
  PROZENTRECHNUNG_GENERATOR_IDS,
  PYTHAGORAS_GENERATOR_IDS,
  QUADRATIC_EQUATIONS_GENERATOR_IDS,
  QUADRATIC_FUNCTION_GENERATOR_IDS,
  ROOT_GENERATOR_IDS,
  STOCHASTIK_GENERATOR_IDS,
  STRAHLENSATZ_GENERATOR_IDS,
  TERMUMFORMUNGEN_GENERATOR_IDS,
  TRIGONOMETRY_GENERATOR_IDS,
} from '../lib/uebungPracticeGenerators';

export interface Props {
  variant:
    | 'pythagoras'
    | 'trigonometrie'
    | 'strahlensaetze'
    | 'quadratische-funktionen'
    | 'quadratische-gleichungen'
    | 'bruchgleichungen'
    | 'bruchrechnung'
    | 'negative-zahlen'
    | 'algebra'
    | 'lineare-gleichungen'
    | 'prozentrechnung'
    | 'stochastik'
    | 'binomische-formeln'
    | 'lineare-funktionen'
    | 'lineare-gleichungssysteme'
    | 'termumformungen'
    | 'exponentialfunktionen'
    | 'logarithmen'
    | 'wurzelrechnung'
    | 'kreisgeometrie';
  backHref: string;
  h1: string;
}

const { variant, backHref, h1 } = Astro.props;
const allowedIds =
  variant === 'pythagoras'
    ? PYTHAGORAS_GENERATOR_IDS
    : variant === 'trigonometrie'
      ? TRIGONOMETRY_GENERATOR_IDS
      : variant === 'quadratische-funktionen'
        ? QUADRATIC_FUNCTION_GENERATOR_IDS
        : variant === 'quadratische-gleichungen'
          ? QUADRATIC_EQUATIONS_GENERATOR_IDS
          : variant === 'bruchgleichungen'
            ? FRACTION_EQUATION_GENERATOR_IDS
            : variant === 'bruchrechnung'
              ? BRUCHRECHNUNG_GENERATOR_IDS
              : variant === 'negative-zahlen'
                ? NEGATIVE_ZAHLEN_GENERATOR_IDS
                : variant === 'algebra'
                  ? ALGEBRA_GENERATOR_IDS
                : variant === 'lineare-gleichungen'
                  ? LINEARE_GLEICHUNGEN_GENERATOR_IDS
                : variant === 'prozentrechnung'
                  ? PROZENTRECHNUNG_GENERATOR_IDS
                : variant === 'stochastik'
                  ? STOCHASTIK_GENERATOR_IDS
                : variant === 'binomische-formeln'
                  ? BINOMISCHE_FORMELN_GENERATOR_IDS
                : variant === 'lineare-funktionen'
                  ? LINEARE_FUNKTIONEN_GENERATOR_IDS
                : variant === 'lineare-gleichungssysteme'
                  ? LINEARE_GLEICHUNGSSYSTEME_GENERATOR_IDS
                : variant === 'termumformungen'
                  ? TERMUMFORMUNGEN_GENERATOR_IDS
                : variant === 'exponentialfunktionen'
                  ? EXPONENTIALFUNKTIONEN_GENERATOR_IDS
                : variant === 'logarithmen'
                  ? LOGARITHMEN_GENERATOR_IDS
                : variant === 'wurzelrechnung'
                ? ROOT_GENERATOR_IDS
                : variant === 'kreisgeometrie'
                  ? CIRCLE_GEOMETRY_GENERATOR_IDS
                  : STRAHLENSATZ_GENERATOR_IDS;
const ugMassenAllowedJson = JSON.stringify([...allowedIds]);
const wbLabelByVariant = {
  pythagoras: 'WB Pythagoras',
  trigonometrie: 'WB Trigonometrie',
  strahlensaetze: 'WB Strahlensaetze',
  'quadratische-funktionen': 'WB Quadratische Funktionen',
  'quadratische-gleichungen': 'WB Quadratische Gleichungen',
  bruchgleichungen: 'WB Bruchgleichungen',
  bruchrechnung: 'WB Bruchrechnung',
  'negative-zahlen': 'WB Negative Zahlen',
  algebra: 'WB Algebra',
  'lineare-gleichungen': 'WB Lineare Gleichungen',
  prozentrechnung: 'WB Prozentrechnung',
  stochastik: 'WB Stochastik',
  'binomische-formeln': 'WB Binomische Formeln',
  'lineare-funktionen': 'WB Lineare Funktionen',
  'lineare-gleichungssysteme': 'WB Lineare Gleichungssysteme',
  termumformungen: 'WB Termumformungen',
  exponentialfunktionen: 'WB Exponentialfunktionen',
  logarithmen: 'WB Logarithmen',
  wurzelrechnung: 'WB Wurzelrechnung',
  kreisgeometrie: 'WB Kreisgeometrie',
} as const;
const wbLabel = wbLabelByVariant[variant];
const wbLabelByHref: Record<string, string> = {
  '/uebung/pythagoras': 'WB Pythagoras',
  '/uebung/trigonometrie': 'WB Trigonometrie',
  '/uebung/strahlensaetze': 'WB Strahlensaetze',
  '/uebung/quadratische-funktionen': 'WB Quadratische Funktionen',
  '/uebung/quadratische-gleichungen': 'WB Quadratische Gleichungen',
  '/uebung/bruchgleichungen': 'WB Bruchgleichungen',
  '/uebung/bruchrechnung': 'WB Bruchrechnung',
  '/uebung/negative-zahlen': 'WB Negative Zahlen',
  '/uebung/algebra': 'WB Algebra',
  '/uebung/lineare-gleichungen': 'WB Lineare Gleichungen',
  '/uebung/prozentrechnung': 'WB Prozentrechnung',
  '/uebung/stochastik': 'WB Stochastik',
  '/uebung/binomische-formeln': 'WB Binomische Formeln',
  '/uebung/lineare-funktionen': 'WB Lineare Funktionen',
  '/uebung/lineare-gleichungssysteme': 'WB Lineare Gleichungssysteme',
  '/uebung/termumformungen': 'WB Termumformungen',
  '/uebung/exponentialfunktionen': 'WB Exponentialfunktionen',
  '/uebung/logarithmen': 'WB Logarithmen',
  '/uebung/wurzelrechnung': 'WB Wurzelrechnung',
  '/uebung/kreisgeometrie': 'WB Kreisgeometrie',
};
function wbLabelFromHref(href: string): string {
  return wbLabelByHref[href] ?? 'WB';
}
---

<div class="container-wide pt-10 pb-16" data-mu-massen-ui="wb-v2">
  <!-- mu-massen: Whiteboard-Vollbild nur mit Aufgaben; Vorbereitung-Banner ohne Overlay -->
  <script is:inline set:html={`globalThis.__UG_MASSEN_ALLOWED_IDS__=${ugMassenAllowedJson};`} />

  <header class="mb-8 print:hidden">
    <a
      href={backHref}
      class="text-sm text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-100"
    >
      ← Zurück zur Themenübersicht
    </a>
    <p class="mt-2 text-xs uppercase tracking-wide text-accent-700 dark:text-accent-100">
      {
        variant === 'bruchrechnung'
          ? 'Übungsgenerator · Klasse 5–6 · Mini-Whiteboard & Arbeitsblatt'
          : variant === 'negative-zahlen' ||
              variant === 'algebra' ||
              variant === 'lineare-gleichungen' ||
              variant === 'prozentrechnung' ||
              variant === 'stochastik'
            ? 'Übungsgenerator · Klasse 7–8 · Mini-Whiteboard & Arbeitsblatt'
            : variant === 'exponentialfunktionen' || variant === 'logarithmen'
              ? 'Übungsgenerator · Oberstufe · Mini-Whiteboard & Arbeitsblatt'
            : 'Übungsgenerator · Klasse 9–10 · Mini-Whiteboard & Arbeitsblatt'
      }
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-semibold text-ink-900 mt-1 dark:text-ink-50">
      {h1}
    </h1>
    {
      variant === 'pythagoras' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Wähle Aufgabentypen und Anzahl. Du erhältst zufällige Aufgaben – ideal für schnelle Whiteboard-Runden. Bei jedem
            Klick auf <em>Aufgaben erzeugen</em> kommt ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Längen als ganze Zahlen (ohne Einheit), Winkel in Grad. Wo kein „Sonderwinkel“ gemeint ist, auf eine
            Nachkommastelle runden.
          </p>
        </>
      ) : variant === 'trigonometrie' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu Sinus, Kosinus und Tangens im <strong>rechtwinkligen Dreieck</strong> – gleicher
            Ablauf wie beim Pythagoras-Whiteboarding: Anzahl wählen, Whiteboard oder Arbeitsblatt, bei jedem Klick auf{' '}
            <em>Aufgaben erzeugen</em> ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Längen als ganze Zahlen (ohne Einheit), Winkel in Grad. Sonderwinkel wie 30°, 45° und 60° kommen vor; sonst
            auf eine Nachkommastelle runden.
          </p>
        </>
      ) : variant === 'quadratische-funktionen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Parabeln</strong> (Scheitelpunktform, Nullstellen, Symmetrieachse) – gleicher
            Ablauf wie bei den anderen Whiteboard-Übungen: Typen und Anzahl wählen, Whiteboard oder Arbeitsblatt, bei jedem
            Klick auf <em>Aufgaben erzeugen</em> ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Koeffizienten und Koordinaten als ganze Zahlen. Zu jeder Aufgabe gibt es optional eine kleine Skizze der
            Parabel (Scheitel <em>S</em>).
          </p>
        </>
      ) : variant === 'quadratische-gleichungen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>quadratischen Gleichungen</strong> – Fokus auf Nullprodukt, Faktorisieren und
            das geschickte Auf-Null-Bringen. Wie gewohnt: Typen und Anzahl wählen, dann Whiteboard oder Arbeitsblatt.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Lösungen werden als reelle Zahlen angegeben; bei doppelten Lösungen wird das explizit genannt.
          </p>
        </>
      ) : variant === 'bruchgleichungen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Bruchgleichungen</strong> – mit Fokus auf Definitionsmenge, Hauptnenner und
            Kreuzprodukt. Wie gewohnt: Typen und Anzahl wählen, dann Whiteboard oder Arbeitsblatt.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Ohne grafische Elemente: Der Fokus liegt vollständig auf Algebra, Definitionsmenge und Lösungsprüfung.
          </p>
        </>
      ) : variant === 'bruchrechnung' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zur <strong>Bruchrechnung</strong> gleichnamiger Brüche, Erweitern und Kürzen,
            Multiplikation mit Raster sowie Größenvergleich – im gleichen Ablauf wie die anderen Whiteboards:
            Typen und Anzahl wählen, dann Arbeitsblatt oder Vollbild-Whiteboard.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Zu vielen Aufgaben gibt es kleine SVG-Hilfsbilder (Streifen, Raster). Du kannst sie optional ausblenden.
          </p>
        </>
      ) : variant === 'negative-zahlen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>ganzen Zahlen und Vorzeichen</strong> – Addition, Subtraktion,
            Multiplikation, Division, Größenvergleich auf dem Zahlenstrahl sowie Klammer- und Punkt-vor-Strich-Aufgaben.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Wo es passt, gibt es einen <strong>Zahlenstrahl</strong> mit Sprung oder zwei markierten Werten (A/B).
          </p>
        </>
      ) : variant === 'algebra' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Termen und Klammern</strong> – ausmultiplizieren, Minus vor der Klammer,
            ausklammern, wie in den Whiteboard-Beispielen des Themas.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Eine Aufgabenart nutzt ein <strong>Flächenmodell</strong> zum Distributivgesetz (nur positive Zahlen).
          </p>
        </>
      ) : variant === 'lineare-gleichungen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>linearen Gleichungen</strong> in einer Variablen – Äquivalenzumformungen,
            Klammern und einfache Bruch-Terme; alles mit ganzzahliger Lösung.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Optional: <strong>Koordinatensystem</strong> mit zwei Geraden und markiertem Schnittpunkt (x-Koordinate =
            Lösung). Skizzen lassen sich global oder pro Aufgabe ein- und ausblenden.
          </p>
          <section class="mt-4 max-w-3xl rounded-lg border border-ink-200 bg-ink-50/80 p-3.5 text-sm text-ink-700 mu-dark-glass-panel dark:text-ink-200">
            <h2 class="font-semibold text-ink-900 dark:text-ink-50">Barton-Workflow in dieser Route</h2>
            <ol class="mt-2 list-decimal space-y-1.5 pl-5">
              <li>
                <strong>Lernziel &amp; Menge:</strong> sichere Äquivalenzumformungen in den auswählbaren Sätzen
                (5/10/15/20 Aufgaben).
              </li>
              <li>
                <strong>Variation:</strong> vom Basismuster $x+a=b$ über $ax+b=c$ bis zu Klammer- und Bruchformen;
                pro Typ wird die Struktur gezielt variiert.
              </li>
              <li>
                <strong>Numerische Constraints:</strong> ganzzahlige Lösungen, keine Dezimal- oder Bruchlösungen.
              </li>
              <li>
                <strong>Technische Darstellung:</strong> deterministische Generatoren mit optionaler SVG-Skizze
                (Geradenschnitt als Lösungsbild).
              </li>
            </ol>
          </section>
        </>
      ) : variant === 'prozentrechnung' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zur <strong>Prozentrechnung</strong> – Prozentwert, Grundwert, Prozentsatz,
            Vermehrungsfaktor sowie Vorwärts- und Rückwärtsrechnen in Alltagskontexten.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Ohne Skizzen: Fokus auf den Beziehungen zwischen $G$, $W$, $p\\,\\%$ und dem passenden Faktor $q$.
          </p>
        </>
      ) : variant === 'stochastik' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Stochastik</strong> – Mittelwert und Median, Ausreißer-Effekte sowie
            einfache Wahrscheinlichkeiten (Würfel, Münzen, Komplementregel).
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Schwerpunkt auf Deutung: Unterschied zwischen sicher / unmöglich / wahrscheinlich und Bedeutung des Erwartungswerts.
          </p>
        </>
      ) : variant === 'binomische-formeln' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>binomischen Formeln</strong> – ausmultiplizieren und rückwärts faktorisieren
            im schnellen Whiteboard-Format.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Schwerpunkt: Vorzeichen sicher beherrschen und Strukturen $(a\\pm b)^2$, $(a+b)(a-b)$ erkennen.
          </p>
        </>
      ) : variant === 'lineare-funktionen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>linearen Funktionen</strong> – Steigung, Achsenabschnitt, Nullstelle,
            Funktionswert und Parallelen.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Mit optionalen Koordinatensystem-Skizzen zur direkten Verknüpfung von Term und Graph.
          </p>
        </>
      ) : variant === 'lineare-gleichungssysteme' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>linearen Gleichungssystemen</strong> – Additions-, Einsetzungs- und
            Gleichsetzungsverfahren plus Spezialfälle (keine / unendlich viele Lösungen).
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Teilweise mit Geradenskizze: Schnittpunkt entspricht dem Lösungspaar.
          </p>
        </>
      ) : variant === 'termumformungen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Termumformungen mit Bruchtermen</strong> – kürzen, Definitionsmenge,
            Hauptnenner sowie Addition und Multiplikation.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Ohne Skizzen: Fokus auf Faktorstruktur und sauberes Arbeiten mit Nennerbedingungen.
          </p>
        </>
      ) : variant === 'exponentialfunktionen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Exponentialfunktionen</strong> – Wachstum/Zerfall, Parameterdeutung,
            Vermehrungsfaktor, Faustregeln und einfache Exponentialgleichungen.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Ohne Skizzen: Fokus auf funktionale Deutung und sichere Umrechnung zwischen Prozentangaben und Faktor $q$.
          </p>
        </>
      ) : variant === 'logarithmen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Logarithmen</strong> – Umkehrung von Exponentialfunktionen, Regeln und
            Basiswechsel.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Schwerpunkt auf „Mit welcher Hochzahl?“ sowie dem sicheren Anwenden grundlegender Logarithmusgesetze.
          </p>
        </>
      ) : variant === 'wurzelrechnung' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zur <strong>Wurzelrechnung</strong> – Vereinfachen, typische Fehlvorstellungen und einfache
            Wurzelgleichungen im gleichen Whiteboarding-Ablauf wie bei den anderen Themen.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Ohne grafische Elemente: Schwerpunkt auf Termumformung, Betragsverständnis und Lösungsmenge.
          </p>
        </>
      ) : variant === 'kreisgeometrie' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zur <strong>Kreisgeometrie</strong> – Radius, Durchmesser, Umfang, Fläche und Sektoren.
            Wie gewohnt: Typen und Anzahl wählen, dann Whiteboard oder Arbeitsblatt.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Mit grafischen Skizzen im bekannten Format zur direkten Veranschaulichung.
          </p>
        </>
      ) : (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Strahlensätzen</strong> (V- und X-Figur, Schatten, Spiegel) – gleicher Ablauf
            wie bei den anderen Whiteboard-Übungen: Typen und Anzahl wählen, Whiteboard oder Arbeitsblatt, bei jedem Klick
            auf <em>Aufgaben erzeugen</em> ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Streckenlängen als ganze Zahlen (ohne Einheit), „LE“ steht für eine beliebige Längeneinheit in der
            Aufgabenstellung.
          </p>
        </>
      )
    }
  </header>

  <section
    id="ug-steuerung"
    aria-labelledby="ug-steuerung-titel"
    class="rounded-xl border border-accent-200/70 bg-gradient-to-br from-accent-50/80 via-surface to-teal-50/50 p-5 shadow-md shadow-accent-900/5 ring-1 ring-accent-100/60 md:p-6 mb-8 print:hidden text-ink-800 dark:border-accent-800/40 dark:from-ink-900/80 dark:via-accent-900/30 dark:to-teal-900/25 dark:shadow-black/30 dark:ring-accent-900/40 dark:text-ink-100 mu-katex-skip"
  >
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
      <h2
        id="ug-steuerung-titel"
        class="flex items-center gap-3 font-serif text-xl font-semibold text-ink-900 dark:text-ink-50"
      >
        <span
          class="h-9 w-1 shrink-0 rounded-full bg-gradient-to-b from-accent-500 via-teal-500 to-violet-500 shadow-sm"
          aria-hidden="true"></span>
        Aufgabentypen
      </h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          id="ug-alle"
          class="rounded-md border border-teal-300 bg-teal-50 px-3 py-1.5 text-sm font-medium text-teal-900 shadow-sm transition hover:border-teal-400 hover:bg-teal-100 dark:border-teal-600 dark:bg-teal-900/45 dark:text-teal-50 dark:hover:border-teal-500 dark:hover:bg-teal-800/55"
        >
          Alle auswählen
        </button>
        <button
          type="button"
          id="ug-keine"
          class="rounded-md border border-coral-300 bg-coral-50 px-3 py-1.5 text-sm font-medium text-ink-900 shadow-sm transition hover:border-coral-400 hover:bg-coral-100 dark:border-orange-700/80 dark:bg-orange-950/40 dark:text-orange-50 dark:hover:border-orange-600 dark:hover:bg-orange-900/50"
        >
          Alle abwählen
        </button>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      {
        variant === 'pythagoras' ? (
          <>
            <fieldset class="ug-gruppe min-w-0">
              <legend
                class="ug-steuerung-legend font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 pb-1 w-full"
              >
                Seiten benennen
              </legend>
              <div class="space-y-1.5 text-sm">
                <label class="flex items-center gap-2 cursor-pointer">
