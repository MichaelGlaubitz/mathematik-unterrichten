    const isDzMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'dezimalzahlen';
    const isBdpMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'bruch-dezimal-prozent';
    const isAlgMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'algebra';
    const isLgMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'lineare-gleichungen';
    const isPrMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'prozentrechnung';
    const isGraphenMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'graphen';
