    const isBinomischeFormelnMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'binomische-formeln';
    const isLineareFunktionenMassen = massenHost?.getAttribute('data-mu-massen-variant') === 'lineare-funktionen';
