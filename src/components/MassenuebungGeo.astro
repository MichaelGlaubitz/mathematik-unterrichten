                <span class="inline-flex items-center gap-1 rounded-md border border-ink-300 bg-surface px-1 py-0.5 dark:border-slate-600/55 dark:bg-slate-900/75" data-mu-diagram-zoom-for="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}" data-mu-diagram-loesung-grafik="true">
                  <button type="button" class="ug-task-diagram-zoom inline-flex h-7 w-7 items-center justify-center rounded text-base font-semibold text-ink-800 hover:bg-ink-100 dark:text-ink-100 dark:hover:bg-slate-800/85 disabled:opacity-35" data-mu-diagram-hash="${prefKey}" data-mu-diagram-zoom-step="-${DIAGRAM_SCALE_STEP}" aria-label="Skizze verkleinern" title="Skizze verkleinern">−</button>
