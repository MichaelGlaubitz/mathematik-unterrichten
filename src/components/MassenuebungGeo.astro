---
import {
  FRACTION_EQUATION_GENERATOR_IDS,
  PYTHAGORAS_GENERATOR_IDS,
  QUADRATIC_EQUATIONS_GENERATOR_IDS,
  QUADRATIC_FUNCTION_GENERATOR_IDS,
  ROOT_GENERATOR_IDS,
  STRAHLENSATZ_GENERATOR_IDS,
  TRIGONOMETRY_GENERATOR_IDS,
} from '../lib/pythagorasPracticeGenerators';

export interface Props {
  variant:
    | 'pythagoras'
    | 'trigonometrie'
    | 'strahlensaetze'
    | 'quadratische-funktionen'
    | 'quadratische-gleichungen'
    | 'bruchgleichungen'
    | 'wurzelrechnung';
  backHref: string;
  h1: string;
}

const { variant, backHref, h1 } = Astro.props;
const allowedIds =
  variant === 'pythagoras'
    ? PYTHAGORAS_GENERATOR_IDS
    : variant === 'trigonometrie'
      ? TRIGONOMETRY_GENERATOR_IDS
      : variant === 'quadratische-funktionen'
        ? QUADRATIC_FUNCTION_GENERATOR_IDS
        : variant === 'quadratische-gleichungen'
          ? QUADRATIC_EQUATIONS_GENERATOR_IDS
          : variant === 'bruchgleichungen'
            ? FRACTION_EQUATION_GENERATOR_IDS
            : variant === 'wurzelrechnung'
              ? ROOT_GENERATOR_IDS
        : STRAHLENSATZ_GENERATOR_IDS;
const ugMassenAllowedJson = JSON.stringify([...allowedIds]);
---

<div class="container-wide pt-10 pb-16" data-mu-massen-ui="wb-v2">
  <!-- mu-massen: Whiteboard-Vollbild nur mit Aufgaben; Vorbereitung-Banner ohne Overlay -->
  <script is:inline set:html={`globalThis.__UG_MASSEN_ALLOWED_IDS__=${ugMassenAllowedJson};`} />

  <header class="mb-8 print:hidden">
    <a
      href={backHref}
      class="text-sm text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-100"
    >
      ← Zurück zur Themenübersicht
    </a>
    <p class="mt-2 text-xs uppercase tracking-wide text-accent-700 dark:text-accent-100">
      Übungsgenerator · Klasse 9–10 · Mini-Whiteboard & Arbeitsblatt
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-semibold text-ink-900 mt-1 dark:text-ink-50">
      {h1}
    </h1>
    {
      variant === 'pythagoras' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Wähle Aufgabentypen und Anzahl. Du erhältst zufällige Aufgaben – ideal für schnelle Whiteboard-Runden. Bei jedem
            Klick auf <em>Aufgaben erzeugen</em> kommt ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Längen als ganze Zahlen (ohne Einheit), Winkel in Grad. Wo kein „Sonderwinkel“ gemeint ist, auf eine
            Nachkommastelle runden.
          </p>
        </>
      ) : variant === 'trigonometrie' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu Sinus, Kosinus und Tangens im <strong>rechtwinkligen Dreieck</strong> – gleicher
            Ablauf wie beim Pythagoras-Whiteboarding: Anzahl wählen, Whiteboard oder Arbeitsblatt, bei jedem Klick auf{' '}
            <em>Aufgaben erzeugen</em> ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Längen als ganze Zahlen (ohne Einheit), Winkel in Grad. Sonderwinkel wie 30°, 45° und 60° kommen vor; sonst
            auf eine Nachkommastelle runden.
          </p>
        </>
      ) : variant === 'quadratische-funktionen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Parabeln</strong> (Scheitelpunktform, Nullstellen, Symmetrieachse) – gleicher
            Ablauf wie bei den anderen Whiteboard-Übungen: Typen und Anzahl wählen, Whiteboard oder Arbeitsblatt, bei jedem
            Klick auf <em>Aufgaben erzeugen</em> ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Koeffizienten und Koordinaten als ganze Zahlen. Zu jeder Aufgabe gibt es optional eine kleine Skizze der
            Parabel (Scheitel <em>S</em>).
          </p>
        </>
      ) : variant === 'quadratische-gleichungen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>quadratischen Gleichungen</strong> – Fokus auf Nullprodukt, Faktorisieren und
            das geschickte Auf-Null-Bringen. Wie gewohnt: Typen und Anzahl wählen, dann Whiteboard oder Arbeitsblatt.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Lösungen werden als reelle Zahlen angegeben; bei doppelten Lösungen wird das explizit genannt.
          </p>
        </>
      ) : variant === 'bruchgleichungen' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Bruchgleichungen</strong> – mit Fokus auf Definitionsmenge, Hauptnenner und
            Kreuzprodukt. Wie gewohnt: Typen und Anzahl wählen, dann Whiteboard oder Arbeitsblatt.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Ohne grafische Elemente: Der Fokus liegt vollständig auf Algebra, Definitionsmenge und Lösungsprüfung.
          </p>
        </>
      ) : variant === 'wurzelrechnung' ? (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zur <strong>Wurzelrechnung</strong> – Vereinfachen, typische Fehlvorstellungen und einfache
            Wurzelgleichungen im gleichen Whiteboarding-Ablauf wie bei den anderen Themen.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Ohne grafische Elemente: Schwerpunkt auf Termumformung, Betragsverständnis und Lösungsmenge.
          </p>
        </>
      ) : (
        <>
          <p class="mt-3 max-w-3xl text-ink-700 leading-relaxed dark:text-ink-200">
            Zufällige Aufgaben zu <strong>Strahlensätzen</strong> (V- und X-Figur, Schatten, Spiegel) – gleicher Ablauf
            wie bei den anderen Whiteboard-Übungen: Typen und Anzahl wählen, Whiteboard oder Arbeitsblatt, bei jedem Klick
            auf <em>Aufgaben erzeugen</em> ein neuer Satz.
          </p>
          <p class="mt-2 max-w-3xl text-sm text-ink-600 dark:text-ink-400">
            Streckenlängen als ganze Zahlen (ohne Einheit), „LE“ steht für eine beliebige Längeneinheit in der
            Aufgabenstellung.
          </p>
        </>
      )
    }
  </header>

  <section
    id="ug-steuerung"
    aria-labelledby="ug-steuerung-titel"
    class="rounded-xl border border-ink-200 bg-white p-5 md:p-6 mb-8 print:hidden text-ink-800 dark:border-ink-700 dark:bg-ink-800/60 dark:text-ink-100 mu-katex-skip"
  >
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
      <h2 id="ug-steuerung-titel" class="font-serif text-xl font-semibold text-ink-900 dark:text-ink-50">
        Aufgabentypen
      </h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          id="ug-alle"
          class="rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm hover:bg-ink-50 dark:border-ink-600 dark:bg-ink-800 dark:text-ink-100 dark:hover:bg-ink-700"
        >
          Alle auswählen
        </button>
        <button
          type="button"
          id="ug-keine"
          class="rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm hover:bg-ink-50 dark:border-ink-600 dark:bg-ink-800 dark:text-ink-100 dark:hover:bg-ink-700"
        >
          Alle abwählen
        </button>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      {
        variant === 'pythagoras' ? (
          <>
            <fieldset class="ug-gruppe min-w-0">
              <legend
                class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
              >
                Seiten benennen
              </legend>
              <div class="space-y-1.5 text-sm">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" class="ug-typ accent-accent-600" value="seiten_hyp" checked />
                  <span>Hypotenuse aus zwei Seiten (Skizze mit ?)</span>
                </label>
              </div>
            </fieldset>
            <fieldset class="ug-gruppe min-w-0">
              <legend
                class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
              >
                Pythagoras
              </legend>
              <div class="space-y-1.5 text-sm">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" class="ug-typ accent-accent-600" value="hypotenuse" checked />
                  <span>Hypotenuse berechnen</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" class="ug-typ accent-accent-600" value="kathete" checked />
                  <span>Kathete berechnen</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" class="ug-typ accent-accent-600" value="erkennen" checked />
                  <span>Rechtwinklig? – Prüfen</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" class="ug-typ accent-accent-600" value="abstand" checked />
                  <span>Abstand zweier Punkte</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" class="ug-typ accent-accent-600" value="sachaufgabe" checked />
                  <span>Sachaufgabe</span>
                </label>
              </div>
            </fieldset>
          </>
        ) : variant === 'trigonometrie' ? (
          <fieldset class="ug-gruppe min-w-0 lg:col-span-2">
            <legend
              class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
            >
              Trigonometrie · Sinus, Kosinus, Tangens
            </legend>
            <div class="space-y-1.5 text-sm">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="trig_ratio" checked />
                <span>Sinus, Kosinus, Tangens aus Katheten und Hypotenuse</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="trig_sin_seite" checked />
                <span>Seite mit Sinus (Sonderwinkel)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="trig_cos_seite" checked />
                <span>Seite mit Kosinus (Sonderwinkel)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="trig_tan_seite" checked />
                <span>Seite mit Tangens (45°)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="trig_hyp_aus_gegen" checked />
                <span>Hypotenuse aus Gegenkathete und Winkel (30°)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="trig_winkel" checked />
                <span>Winkel aus zwei Seiten (30°, 45°)</span>
              </label>
            </div>
          </fieldset>
        ) : variant === 'quadratische-funktionen' ? (
          <fieldset class="ug-gruppe min-w-0 lg:col-span-2">
            <legend
              class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
            >
              Quadratische Funktionen
            </legend>
            <div class="space-y-1.5 text-sm">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qf_scheitel_form" checked />
                <span>Scheitel aus Scheitelpunktform $(x-p)^2+q$</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qf_scheitel_gestreckt" checked />
                <span>Scheitel und Öffnung bei $a(x-p)^2+q$</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qf_nullstellen" checked />
                <span>Nullstellen aus Linearfaktoren</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qf_funktionswert" checked />
                <span>Funktionswert $f(t)$ bei faktorisierter Form</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qf_oeffnung" checked />
                <span>Öffnung bei $ax^2+q$</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qf_symmetrieachse" checked />
                <span>Symmetrieachse bei $x^2+bx+c$</span>
              </label>
            </div>
          </fieldset>
        ) : variant === 'quadratische-gleichungen' ? (
          <fieldset class="ug-gruppe min-w-0 lg:col-span-2">
            <legend
              class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
            >
              Quadratische Gleichungen
            </legend>
            <div class="space-y-1.5 text-sm">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qg_faktorform" checked />
                <span>Faktorform direkt lösen: $(x-r)(x-s)=0$</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qg_ausklammern" checked />
                <span>Ausklammern: $x^2+bx=0$</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qg_binomisch" checked />
                <span>Binomische Form erkennen: $(x-p)^2=0$</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qg_differenz_von_quadraten" checked />
                <span>Differenz von Quadraten: $x^2-a^2=0$</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qg_auf_null_bringen" checked />
                <span>Erst auf Null bringen, dann faktorisieren</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="qg_anzahl_loesungen" checked />
                <span>Anzahl reeller Lösungen beurteilen</span>
              </label>
            </div>
          </fieldset>
        ) : variant === 'bruchgleichungen' ? (
          <fieldset class="ug-gruppe min-w-0 lg:col-span-2">
            <legend
              class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
            >
              Bruchgleichungen
            </legend>
            <div class="space-y-1.5 text-sm">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="bg_definitionsmenge" checked />
                <span>Definitionsmenge bestimmen</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="bg_einfach_linear" checked />
                <span>Einfache lineare Bruchgleichung</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="bg_hauptnenner" checked />
                <span>Mit Hauptnenner lösen</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="bg_kreuzprodukt" checked />
                <span>Zwei Brüche · Kreuzprodukt</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="bg_ausgeschlossene_loesung" checked />
                <span>Ausgeschlossene Lösung erkennen</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="bg_keine_loesung" checked />
                <span>Keine Lösung begründen</span>
              </label>
            </div>
          </fieldset>
        ) : variant === 'wurzelrechnung' ? (
          <fieldset class="ug-gruppe min-w-0 lg:col-span-2">
            <legend
              class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
            >
              Wurzelrechnung
            </legend>
            <div class="space-y-1.5 text-sm">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="wr_vereinfachen" checked />
                <span>Wurzelausdrücke vereinfachen</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="wr_add_sub" checked />
                <span>Wurzeln addieren / subtrahieren</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="wr_fehlschluss_summe" checked />
                <span>Fehlschluss: Wurzel über Summen</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="wr_gleichung_quadrat" checked />
                <span>Gleichung $x^2=a$ lösen</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="wr_betrag" checked />
                <span>Regel $\sqrt(x^2)=|x|$ anwenden</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="wr_keine_reelle" checked />
                <span>Keine reellen Lösungen erkennen</span>
              </label>
            </div>
          </fieldset>
        ) : (
          <fieldset class="ug-gruppe min-w-0 lg:col-span-2">
            <legend
              class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
            >
              Strahlensätze
            </legend>
            <div class="space-y-1.5 text-sm">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="strahl_zweiter_strecke" checked />
                <span>V-Figur: parallele Strecke (zweiter Strahlensatz)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="strahl_erster_strahl" checked />
                <span>V-Figur: Strecke auf dem zweiten Strahl (erster Strahlensatz)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="strahl_x_strecke" checked />
                <span>X-Figur: parallele Strecken</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="strahl_schatten" checked />
                <span>Schatten / gleiche Sonnenrichtung</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" class="ug-typ accent-accent-600" value="strahl_spiegel_mast" checked />
                <span>Spiegel &amp; Mast (ähnliche Dreiecke)</span>
              </label>
            </div>
          </fieldset>
        )
      }

      <fieldset class="ug-gruppe min-w-0 lg:col-span-2">
        <legend
          class="font-semibold text-sm text-ink-900 mb-3 dark:text-ink-50 border-b border-ink-200 pb-1 w-full dark:border-ink-600"
        >
          Anzahl &amp; Layout
        </legend>
        <p class="text-xs text-ink-600 mb-2 dark:text-ink-400">Wie viele Aufgaben? (klassisch fürs Whiteboard)</p>
        <div id="ug-anzahl" class="inline-flex flex-wrap gap-1.5 mb-4">
          <button
            type="button"
            data-anzahl="5"
            class="ug-anzahl rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm dark:border-ink-600 dark:bg-ink-800">{5}</button>
          <button
            type="button"
            data-anzahl="10"
            class="ug-anzahl rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm dark:border-ink-600 dark:bg-ink-800">{10}</button>
          <button
            type="button"
            data-anzahl="15"
            class="ug-anzahl rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm dark:border-ink-600 dark:bg-ink-800">{15}</button>
          <button
            type="button"
            data-anzahl="20"
            class="ug-anzahl rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm dark:border-ink-600 dark:bg-ink-800">{20}</button>
        </div>
        <p class="text-xs text-ink-600 mb-2 dark:text-ink-400">Darstellung</p>
        <div id="ug-layout" class="inline-flex flex-wrap gap-1.5">
          <button
            type="button"
            data-layout="arbeitsblatt"
            class="ug-layoutbtn rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm dark:border-ink-600 dark:bg-ink-800">{'Arbeitsblatt'}</button>
          <button
            type="button"
            data-layout="whiteboard"
            class="ug-layoutbtn rounded-md border border-ink-300 bg-white px-3 py-1.5 text-sm dark:border-ink-600 dark:bg-ink-800">{'Whiteboard'}</button>
        </div>
        {
          variant !== 'bruchgleichungen' && variant !== 'wurzelrechnung' && (
            <label class="mt-4 flex w-full min-w-0 cursor-pointer items-start gap-2 text-sm text-ink-800 dark:text-ink-200">
              <input
                type="checkbox"
                id="mu-practice-diagrams-checkbox"
                class="mt-0.5 shrink-0 accent-accent-600"
                aria-describedby="mu-practice-diagrams-hint"
              />
              <span class="min-w-0 flex-1">
