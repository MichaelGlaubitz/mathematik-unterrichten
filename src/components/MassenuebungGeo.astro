    bindPracticeDiagramCheckbox(
      document.getElementById('mu-practice-diagrams-checkbox') as HTMLInputElement | null
    );
    let layout = 'arbeitsblatt';
    let anzahl = 10;
    if (isBruchMassen) {
      anzahl = readBruchMassenAnzahl();
      layout = readBruchMassenLayout();
    } else if (isNzMassen) {
      anzahl = readNzMassenAnzahl();
      layout = readNzMassenLayout();
    } else if (isDzMassen) {
      anzahl = readDzMassenAnzahl();
      layout = readDzMassenLayout();
    } else if (isAlgMassen) {
