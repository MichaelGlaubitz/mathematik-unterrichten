  function initUgMassenGeo() {
    if (!document.body) {
      requestAnimationFrame(() => initUgMassenGeo());
      return;
    }
    if (!document.getElementById('ug-erzeugen')) {
      console.error('[MassenuebungGeo] Steuerung (#ug-erzeugen) fehlt – falsche Seite oder DOM noch nicht bereit.');
      return;
    }

    const allowedSet = new Set(readUgMassenAllowedIds());
    if (allowedSet.size === 0) {
      console.warn(
        '[MassenuebungGeo] Keine erlaubten Aufgaben-IDs (Prelude fehlt oder läuft nach diesem Skript). Seite neu laden.'
      );
    }

    const massenHost = document.querySelector('[data-mu-massen-ui="wb-v2"]');

    // Rolle der Seite. Merkt sich das Gerät, damit ein Klassensatz Tablets
    // nicht bei jedem Aufruf neu umgestellt werden muss.
    const MODUS_SCHLUESSEL = 'mu-uebung-modus';
    function modusSetzen(modus, merken) {
      const schueler = modus === 'schueler';
      massenHost?.setAttribute('data-mu-modus', schueler ? 'schueler' : 'lehrkraft');
      const kl = document.getElementById('ug-modus-lehrkraft');
      const ks = document.getElementById('ug-modus-schueler');
      const txt = document.getElementById('ug-modus-text');
      if (kl) kl.setAttribute('aria-pressed', schueler ? 'false' : 'true');
      if (ks) ks.setAttribute('aria-pressed', schueler ? 'true' : 'false');
      if (txt) {
        txt.textContent = schueler
          ? 'Ohne Lösungen. „Überprüfen“ sagt richtig oder falsch, verrät aber nichts.'
          : 'Mit Lösungen, Lösungs-PDF und allem, was zum Vorbereiten gehört.';
      }
      if (merken) {
        try { localStorage.setItem(MODUS_SCHLUESSEL, schueler ? 'schueler' : 'lehrkraft'); } catch { /* */ }
      }
    }
    document.getElementById('ug-modus-lehrkraft')?.addEventListener('click', () => modusSetzen('lehrkraft', true));
    document.getElementById('ug-modus-schueler')?.addEventListener('click', () => modusSetzen('schueler', true));
    try {
      modusSetzen(localStorage.getItem(MODUS_SCHLUESSEL) === 'schueler' ? 'schueler' : 'lehrkraft', false);
    } catch {
      modusSetzen('lehrkraft', false);
