    function readBdpTypenFromStorage() {
      try {
        const raw = JSON.parse(sessionStorage.getItem(BDP_KW_WB_STOR_KEY) || 'null');
        if (!Array.isArray(raw) || raw.length === 0) return allBdpIdsFiltered();
        if (typeof raw[0] === 'string' && raw[0].startsWith('bdp_')) {
          const ids = raw.filter((id) => allowedSet.has(id));
          return ids.length ? ids : allBdpIdsFiltered();
        }
        const fromKw = expandBdpWbStichworte(raw).filter((id) => allowedSet.has(id));
        return fromKw.length ? fromKw : allBdpIdsFiltered();
      } catch {
        return allBdpIdsFiltered();
      }
    }

