    border-color: theme('colors.teal.400');
  }
  #ug-steuerung .ug-layoutbtn:not(.ug--aktiv) {
    border-color: theme('colors.violet.200');
    background-color: theme('colors.violet.50');
    color: theme('colors.ink.900');
  }
  #ug-steuerung .ug-layoutbtn:not(.ug--aktiv):hover {
    background-color: theme('colors.violet.100');
    border-color: theme('colors.violet.400');
  }
  html.dark #ug-steuerung .ug-anzahl:not(.ug--aktiv) {
    border-color: theme('colors.teal.700');
    background-color: rgb(19 78 74 / 0.3);
    color: theme('colors.ink.50');
  }
  html.dark #ug-steuerung .ug-anzahl:not(.ug--aktiv):hover {
    background-color: rgb(19 78 74 / 0.45);
    border-color: theme('colors.teal.500');
  }
  html.dark #ug-steuerung .ug-layoutbtn:not(.ug--aktiv) {
    border-color: theme('colors.violet.600');
    background-color: rgb(76 29 149 / 0.25);
    color: theme('colors.ink.50');
  }
  html.dark #ug-steuerung .ug-layoutbtn:not(.ug--aktiv):hover {
    background-color: rgb(76 29 149 / 0.38);
    border-color: theme('colors.violet.400');
  }

  #ug-steuerung .ug-anzahl.ug--aktiv,
  #ug-steuerung .ug-layoutbtn.ug--aktiv {
    background-color: theme('colors.accent.600');
    border-color: theme('colors.accent.600');
    color: #fff;
  }
  html.dark #ug-steuerung .ug-anzahl.ug--aktiv,
  html.dark #ug-steuerung .ug-layoutbtn.ug--aktiv {
    background-color: theme('colors.accent.500');
    border-color: theme('colors.accent.600');
    color: #fff;
  }

  .mu-geo-diagram {
    --mu-geo-stroke: #1d4ed8;
    --mu-geo-stroke-soft: #2563eb;
    --mu-geo-accent: #dc2626;
    --mu-geo-accent-soft: rgba(220, 38, 38, 0.18);
    --mu-geo-fill-soft: rgba(29, 78, 216, 0.08);
    --mu-geo-second: #047857;
    --mu-geo-second-soft: rgba(4, 120, 87, 0.18);
    --mu-geo-third: #b45309;
    --mu-geo-grid: rgba(37, 99, 235, 0.22);
    --mu-geo-helper: #64748b;
    --mu-geo-text: #0f172a;
    --mu-geo-text-soft: #475569;
    --mu-geo-bg: #faf8f2;
  }
  html.dark .mu-geo-diagram {
    --mu-geo-stroke: #93c5fd;
    --mu-geo-stroke-soft: #60a5fa;
    --mu-geo-accent: #fca5a5;
    --mu-geo-accent-soft: rgba(252, 165, 165, 0.22);
    --mu-geo-fill-soft: rgba(147, 197, 253, 0.14);
    --mu-geo-second: #6ee7b7;
    --mu-geo-second-soft: rgba(110, 231, 183, 0.22);
    --mu-geo-third: #fcd34d;
    --mu-geo-grid: rgba(147, 197, 253, 0.24);
    --mu-geo-helper: #94a3b8;
    --mu-geo-text: #f1f5f9;
    --mu-geo-text-soft: #cbd5e1;
    --mu-geo-bg: #1e293b;
  }
  .mu-geo-diagram svg {
    display: block;
    max-width: min(100%, 300px);
    height: auto;
  }
  .mu-practice-diagram {
    --mu-diagram-scale: 1;
  }
  .mu-practice-diagram svg {
    display: block;
    width: min(100%, calc(300px * var(--mu-diagram-scale)));
    max-width: none;
    height: auto;
    margin-inline: auto;
    transition: width 120ms ease;
  }
  .mu-geo-diagram svg text {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 600;
  }

  html.mu-wb-overlay-open,
  html.mu-wb-overlay-open body {
    overflow: hidden;
    overscroll-behavior: none;
  }

  #ug-wb-overlay {
    isolation: isolate;
  }

  #ug-wb-overlay .ug-wb-scale-inner {
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Tailwind-Utilities wie .flex haben dieselbe Spezifität wie [hidden] und stehen später in
     der Kaskade, wodurch sie das HTML-Attribut hidden überschreiben. Ohne diese Regel würde
     das Overlay trotz [hidden] sichtbar (bzw. unsichtbar transparent) über der Seite liegen
     und alle Klicks abfangen. */
  #ug-wb-overlay[hidden],
  #ug-wb-vorbereitung[hidden],
  #ug-wb-controls[hidden],
  #ug-wb-content[hidden],
  #ug-wb-loesung[hidden],
  #ug-wb-leer[hidden],
  #ug-arbeitsblatt[hidden] {
    display: none !important;
  }

  @media print {
    #ug-wb-overlay,
    #ug-wb-vorbereitung,
    #ug-steuerung,
    #ug-wb-controls,
    .print\:hidden {
      display: none !important;
    }
    #ug-whiteboard[hidden],
    #ug-arbeitsblatt[hidden] {
      display: none !important;
    }
    #ug-arbeitsblatt:not([hidden]) {
      border: none !important;
      box-shadow: none !important;
    }
  }
</style>
