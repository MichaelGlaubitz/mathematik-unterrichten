      const loesungAnWhiteboardFrage =
        wbZeigeLoesung && inlineL && !cur.frageMitLoesungHighlight
          ? ` <span class="text-ink-800 dark:text-slate-100">${cur.loesung}</span>`
          : '';
      if (wbFrage) wbFrage.innerHTML = `${dia}${practiceFrageAnzeigeHtml(cur, wbZeigeLoesung)}${loesungAnWhiteboardFrage}</div>`;
      if (wbLoesungText) wbLoesungText.innerHTML = inlineL ? '' : aufgaben[wbIndex].loesung;
      if (wbLoesung) wbLoesung.hidden = !wbZeigeLoesung || inlineL;
      if (wbPrev) wbPrev.disabled = wbIndex === 0 && !wbZeigeLoesung;
      const istLetzte = wbIndex === aufgaben.length - 1;
      if (wbNext) {
        const neuMischen = wbZeigeLoesung && istLetzte;
        wbNext.textContent = wbZeigeLoesung
          ? istLetzte ? 'Neu mischen' : 'Nächste Aufgabe →'
          : 'Lösung zeigen';
        wbNext.className = neuMischen
          ? 'rounded-md bg-red-600 px-6 py-2.5 text-white font-semibold shadow-md shadow-red-900/25 hover:bg-red-700 dark:bg-red-600 dark:hover:bg-red-500 dark:shadow-lg dark:shadow-red-600/35 text-lg'
          : 'rounded-md bg-accent-600 px-6 py-2.5 text-white font-semibold shadow-md shadow-accent-900/25 hover:bg-accent-700 dark:bg-accent-500 dark:hover:bg-accent-400 dark:shadow-lg dark:shadow-accent-600/35 text-lg';
      }
    }


    anzahlBtns().forEach((b) =>
      b.addEventListener('click', () => {
        anzahl = Number(b.dataset.anzahl);
        if (isBruchMassen) writeBruchMassenAnzahl(anzahl);
        else if (isNzMassen) writeNzMassenAnzahl(anzahl);
        else if (isDzMassen) writeDzMassenAnzahl(anzahl);
        else if (isAlgMassen) writeAlgebraMassenAnzahl(anzahl);
        else if (isBdpMassen) writeBdpMassenAnzahl(anzahl);
        else if (isLgMassen) writeLgMassenAnzahl(anzahl);
        else if (isPrMassen) writePrMassenAnzahl(anzahl);
        else if (isGraphenMassen) writeGraphenMassenAnzahl(anzahl);
        else if (isStochastikMassen) writeStochastikMassenAnzahl(anzahl);
        else if (isBinomischeFormelnMassen) writeBfMassenAnzahl(anzahl);
        else if (isLineareFunktionenMassen) writeLfMassenAnzahl(anzahl);
        refreshAktiv();
      })
    );
    layoutBtns().forEach((b) =>
      b.addEventListener('click', () => {
        const next = b.dataset.layout;
        if (next !== 'arbeitsblatt' && next !== 'whiteboard') return;
        layout = next;
        if (isBruchMassen) writeBruchMassenLayout(layout);
        else if (isNzMassen) writeNzMassenLayout(layout);
        else if (isDzMassen) writeDzMassenLayout(layout);
        else if (isAlgMassen) writeAlgebraMassenLayout(layout);
        else if (isBdpMassen) writeBdpMassenLayout(layout);
        else if (isLgMassen) writeLgMassenLayout(layout);
        else if (isPrMassen) writePrMassenLayout(layout);
        else if (isGraphenMassen) writeGraphenMassenLayout(layout);
        else if (isStochastikMassen) writeStochastikMassenLayout(layout);
        else if (isBinomischeFormelnMassen) writeBfMassenLayout(layout);
        else if (isLineareFunktionenMassen) writeLfMassenLayout(layout);
        refreshAktiv();
        if (layout === 'arbeitsblatt') stopWbTimer();
        else if (aufgaben.length > 0) startWbTimer();
        render();
      })
    );
    erzeugenBtn?.addEventListener('click', erzeuge);

    btnAlle?.addEventListener('click', () => {
      typBoxen().forEach((c) => {
        c.checked = true;
      });
      if (isNzMassen || isAlgMassen || isLgMassen) persistWbSlotKeywordsFromTypCheckboxes();
    });
    btnKeine?.addEventListener('click', () => {
      typBoxen().forEach((c) => {
        c.checked = false;
      });
      if (isNzMassen || isAlgMassen || isLgMassen) persistWbSlotKeywordsFromTypCheckboxes();
    });

    btnDruck?.addEventListener('click', () => { window.print(); });
    document.getElementById('ug-wb-slot-ab-alle-zu')?.addEventListener('click', () => {
      liste?.querySelectorAll('.ug-task-details').forEach((d) => {
        if (d instanceof HTMLDetailsElement) d.open = false;
      });
      if (liste) syncBruchLoesungEyeButtons(liste);
      refreshBruchAbSheetStats();
    });
    document.getElementById('ug-wb-slot-ab-alle-auf')?.addEventListener('click', () => {
      liste?.querySelectorAll('.ug-task-details').forEach((d) => {
        if (d instanceof HTMLDetailsElement) d.open = true;
      });
      if (liste) syncBruchLoesungEyeButtons(liste);
      refreshBruchAbSheetStats();
      if (arbeitsblatt && typeof window.renderMathInElement === 'function') {
        try {
          window.renderMathInElement(arbeitsblatt, muPracticeKatexOpts());
        } catch {
          /* */
        }
      }
    });
    document.getElementById('ug-wb-slot-ab-neu')?.addEventListener('click', () => {
      erzeugenBtn?.click();
    });
    function downloadePdfDatei(pdf, filename) {
      const blob = new Blob([pdf], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.rel = 'noopener';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    function bruchAbDruckdialogAlsFallback(mitLoesungen) {
      if (!isWbSlotAbMassen || !liste) return;
      const sheet = document.getElementById('ug-arbeitsblatt');
      if (!(sheet instanceof HTMLElement)) return;
      if (sheet.hidden) {
        window.alert('Bitte wechseln Sie zuerst zur Arbeitsblatt-Ansicht, dann erneut „Drucken“ wählen.');
        return;
      }
      const detailsList = [...liste.querySelectorAll('.ug-task-details')];
      const savedOpen = detailsList.map((d) => (d instanceof HTMLDetailsElement ? d.open : false));
      detailsList.forEach((d) => {
        if (d instanceof HTMLDetailsElement) d.open = mitLoesungen;
      });
      syncBruchLoesungEyeButtons(liste);
      refreshBruchAbSheetStats();
      if (typeof window.renderMathInElement === 'function') {
        try {
          window.renderMathInElement(sheet, muPracticeKatexOpts());
        } catch {
          /* */
        }
      }
      const root = document.documentElement;
      root.classList.add('mu-print-wb-slot-ab-only');
      let cleaned = false;
      const mq = window.matchMedia('print');
      const onAfterPrint = () => {
        restore();
      };
      const onMq = () => {
        if (!mq.matches) restore();
      };
      const restore = () => {
        if (cleaned) return;
        cleaned = true;
        root.classList.remove('mu-print-wb-slot-ab-only');
        window.removeEventListener('afterprint', onAfterPrint);
        mq.removeEventListener('change', onMq);
        detailsList.forEach((d, i) => {
          if (d instanceof HTMLDetailsElement) d.open = savedOpen[i] ?? false;
        });
        syncBruchLoesungEyeButtons(liste);
        refreshBruchAbSheetStats();
      };
      window.addEventListener('afterprint', onAfterPrint);
      mq.addEventListener('change', onMq);
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          window.print();
        });
      });
    }

    function bruchAbStichworteZeileFuerPdf() {
      const labels = readSlotAbStichwortLabels();
      if (labels.length === 0) return 'alle Typen gemischt';
      const joined = labels.join(', ');
      return joined.length > 110 ? `${joined.slice(0, 108)}…` : joined;
    }

    async function bruchArbeitsblattAlsPdf(mitLoesungen) {
      const btnA = document.getElementById('ug-wb-slot-ab-druck');
      const btnL = document.getElementById('ug-wb-slot-ab-druck-loes');
      const busy = [btnA, btnL].filter(Boolean);
      if (!isWbSlotAbMassen || aufgaben.length === 0) return;
      busy.forEach((b) => {
        if (b instanceof HTMLButtonElement) {
          b.disabled = true;
          b.setAttribute('aria-busy', 'true');
        }
      });
      try {
        // Thema und Dateiname kommen aus der Registry: „WB Pythagoras“ → „Pythagoras“.
        const generator = uebungsgenerator(variantName);
        const meta = {
          thema: generator.titel.replace(/^WB\s+/, ''),
          stichworteZeile: bruchAbStichworteZeileFuerPdf(),
        };
        const diagramUiScale = (i) => readDiagramScale(diagramTaskPreferenceKey(aufgaben[i].frage, i));
        const r = isBruchMassen
          ? await erzeugeBruchArbeitsblattPdf({ aufgaben, meta, mitLoesungen, diagramUiScale })
          : await erzeugeStandardArbeitsblattPdf({ aufgaben, meta, mitLoesungen, diagramUiScale });
        if (!r.ok) {
          console.error('[WB-Arbeitsblatt PDF]', { message: r.message, log: r.log });
          const kurz = String(r.message || 'Unbekannter Fehler').slice(0, 400);
          const druck = window.confirm(
            'Das PDF konnte nicht erzeugt werden.\n\n' +
              `Kurzinfo: ${kurz}\n\n` +
              'Ursache ist meist ein kurzzeitiger Ausfall oder eine Überlastung des öffentlichen LaTeX-Dienstes.\n\n' +
              'Alternativ können Sie den Druckdialog Ihres Browsers öffnen und dort „Als PDF speichern“ wählen.\n\n' +
              'OK = Druckdialog öffnen\nAbbrechen = schließen'
          );
          if (druck) bruchAbDruckdialogAlsFallback(mitLoesungen);
          return;
        }
        const tag = new Date().toISOString().slice(0, 10);
        const base = generator.slug;
        const name = mitLoesungen ? `${base}-ab-mit-loesungen-${tag}.pdf` : `${base}-ab-${tag}.pdf`;
        downloadePdfDatei(r.pdf, name);
      } catch (e) {
        const msg = e instanceof Error ? e.message : String(e);
        window.alert(`PDF-Erstellung abgebrochen: ${msg}`);
      } finally {
        busy.forEach((b) => {
          if (b instanceof HTMLButtonElement) {
            b.disabled = false;
            b.removeAttribute('aria-busy');
          }
        });
      }
    }

    document.getElementById('ug-wb-slot-ab-druck')?.addEventListener('click', () => {
      void bruchArbeitsblattAlsPdf(false);
    });
    document.getElementById('ug-wb-slot-ab-druck-loes')?.addEventListener('click', () => {
      void bruchArbeitsblattAlsPdf(true);
    });

    const bruchCheckOverlay = document.getElementById('ug-wb-slot-ab-check-overlay');
    const bruchCheckStat = document.getElementById('ug-wb-slot-ab-check-stat');
    const bruchCheckMot = document.getElementById('ug-wb-slot-ab-check-mot');
    const bruchCheckBtn = document.getElementById('ug-wb-slot-ab-check');
    const bruchCheckSchliessen = document.getElementById('ug-wb-slot-ab-check-schliessen');
    function schliesseBruchAbCheckOverlay() {
      if (bruchCheckOverlay instanceof HTMLElement) bruchCheckOverlay.hidden = true;
      document.documentElement.classList.remove('mu-ab-wb-slot-check-open');
    }
    function oeffneBruchAbCheckOverlay(statText, motText) {
      if (bruchCheckStat) bruchCheckStat.textContent = statText;
      if (bruchCheckMot) bruchCheckMot.textContent = motText;
      if (bruchCheckOverlay instanceof HTMLElement) bruchCheckOverlay.hidden = false;
      document.documentElement.classList.add('mu-ab-wb-slot-check-open');
      if (bruchCheckSchliessen instanceof HTMLButtonElement) bruchCheckSchliessen.focus();
    }
    bruchCheckBtn?.addEventListener('click', () => {
      if (!liste || !isWbSlotAbMassen) return;
      const { richtig, gesamt } = wendeBruchAbCheckAufListeAn(liste, aufgaben);
      const statText = gesamt > 0 ? `${richtig} von ${gesamt} richtig.` : 'Keine Antwortfelder gefunden.';
      oeffneBruchAbCheckOverlay(statText, bruchAbMotivation(richtig, gesamt));
    });
    bruchCheckSchliessen?.addEventListener('click', () => schliesseBruchAbCheckOverlay());
    bruchCheckOverlay?.addEventListener('click', (e) => {
      if (e.target === bruchCheckOverlay) schliesseBruchAbCheckOverlay();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!document.documentElement.classList.contains('mu-ab-wb-slot-check-open')) return;
      e.preventDefault();
      schliesseBruchAbCheckOverlay();
    });

    routeSpeichernBtn?.addEventListener('click', saveWhiteboardRoute);
    wbRouteSpeichernBtn?.addEventListener('click', saveWhiteboardRoute);
    routeLadenBtn?.addEventListener('click', () => {
      routeDateiInput?.click();
    });
    routeDateiInput?.addEventListener('change', () => {
      const file = routeDateiInput.files?.[0];
      routeDateiInput.value = '';
      if (file) void loadWhiteboardRouteFile(file);
    });

    alleAufBtn?.addEventListener('click', () => {
      liste?.querySelectorAll('details').forEach((d) => { d.open = true; });
    });
    alleZuBtn?.addEventListener('click', () => {
      liste?.querySelectorAll('details').forEach((d) => { d.open = false; });
    });

    wbNext?.addEventListener('click', () => {
      if (!wbZeigeLoesung) {
        wbZeigeLoesung = true;
      } else if (wbIndex < aufgaben.length - 1) {
        wbIndex++;
        wbZeigeLoesung = false;
      } else {
        erzeuge();
        return;
      }
      render();
    });
    wbPrev?.addEventListener('click', () => {
      if (wbZeigeLoesung) {
        wbZeigeLoesung = false;
      } else if (wbIndex > 0) {
        wbIndex--;
        wbZeigeLoesung = true;
      }
      render();
    });

    wbVorbZuAb?.addEventListener('click', closeWhiteboardOverlay);
    wbOverlay?.addEventListener('click', (e) => {
      const t = (e.target as Element).closest('#ug-wb-overlay-schliessen, #ug-wb-zu-arbeitsblatt');
      if (t) {
        e.preventDefault();
        closeWhiteboardOverlay();
      }
    });

    document.addEventListener('click', (e) => {
      const zoomBtn = e.target && (e.target as Element).closest('button.ug-task-diagram-zoom');
      if (zoomBtn) {
        const hash = zoomBtn.getAttribute('data-mu-diagram-hash');
        const step = Number(zoomBtn.getAttribute('data-mu-diagram-zoom-step'));
        if (!hash || !Number.isFinite(step)) return;
        e.preventDefault();
        updateDiagramScale(hash, step);
        syncDiagramZoomUi(document.body);
        scheduleWbOverlayScaleFit();
        return;
      }
      const t = e.target && (e.target as Element).closest('button.ug-task-diagram-toggle');
      if (!t || !t.getAttribute('data-mu-diagram-hash')) return;
      const hash = t.getAttribute('data-mu-diagram-hash');
      if (!hash) return;
      const defaultHidden = t.getAttribute('data-mu-diagram-default-hidden') === 'true';
      const loesungGrafik = t.getAttribute('data-mu-diagram-loesung-grafik') === 'true';
      e.preventDefault();
      toggleDiagramForHash(hash, defaultHidden, loesungGrafik);
      syncPracticeDiagramUi(document.body);
      scheduleWbOverlayScaleFit();
    });

    document.addEventListener(
      'keydown',
      (e) => {
        if (layout !== 'whiteboard') return;
        if (e.target && /input|textarea|select/i.test((e.target as HTMLElement).tagName)) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeWhiteboardOverlay();
          return;
        }
        if (aufgaben.length === 0) return;
        if (e.target && (e.target as Element).closest('button.ug-task-diagram-toggle')) return;
        if (e.target && (e.target as Element).closest('#ug-wb-overlay button')) return;
        if (e.key === ' ' || e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); wbNext?.click(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); wbPrev?.click(); }
      },
      true
    );

    window.addEventListener('resize', scheduleWbOverlayScaleFit, { passive: true });
    if (typeof ResizeObserver !== 'undefined' && wbOverlay && wbCard) {
      const wbScaleRo = new ResizeObserver(() => scheduleWbOverlayScaleFit());
      wbScaleRo.observe(wbOverlay);
      wbScaleRo.observe(wbCard);
    }

    function runBruchAutoStartFromUrl() {
      if (!isWbSlotAbMassen) return;
      let stripTo = '';
      try {
        const u = new URL(window.location.href);
        if (u.searchParams.get('muAuto') !== '1') return;
        u.searchParams.delete('muAuto');
        const qs = u.searchParams.toString();
        stripTo = u.pathname + (qs ? `?${qs}` : '') + u.hash;
      } catch {
        return;
      }
      try {
        history.replaceState({}, '', stripTo);
      } catch {
        /* */
      }
      erzeuge();
      if (layout === 'arbeitsblatt') {
        requestAnimationFrame(() => {
          document.getElementById('ug-arbeitsblatt')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    }

    refreshAktiv();
    if (isNzMassen) {
      const nzIds = readNzTypenFromStorage();
      typBoxen().forEach((c) => {
        if (c instanceof HTMLInputElement) c.checked = nzIds.includes(c.value);
      });
    }
    if (isAlgMassen) {
      const algIds = readAlgebraTypenFromStorage();
      typBoxen().forEach((c) => {
        if (c instanceof HTMLInputElement) c.checked = algIds.includes(c.value);
      });
    }
    if (isBdpMassen) {
      const bdpIds = readBdpTypenFromStorage();
      typBoxen().forEach((c) => {
        if (c instanceof HTMLInputElement && c.value.startsWith('bdp_')) {
          c.checked = bdpIds.includes(c.value);
        }
      });
    }
    if (!consumeWindowNameRoute()) {
      /** Themenseite „Arbeitsblatt“ → /uebung/bruchrechnung?muAuto=1: kein Zwischen-Render mit leerem Satz (sonst kurz alter Voll-Chrome). */
      let skipInitialRender = false;
      if (isWbSlotAbMassen) {
        try {
          skipInitialRender = new URL(window.location.href).searchParams.get('muAuto') === '1';
        } catch {
          skipInitialRender = false;
        }
      }
      if (!skipInitialRender) {
        render();
      }
      runBruchAutoStartFromUrl();
      if (skipInitialRender && aufgaben.length === 0) {
        render();
      }
    }
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initUgMassenGeo(), { once: true });
    } else {
      requestAnimationFrame(() => requestAnimationFrame(() => initUgMassenGeo()));
    }
  }
</script>

