  const GEN = createPracticeGenerators(() => Math.random());

  function readUgMassenAllowedIds(): string[] {
    const g = globalThis as typeof globalThis & { __UG_MASSEN_ALLOWED_IDS__?: unknown };
    const a = g.__UG_MASSEN_ALLOWED_IDS__;
    return Array.isArray(a) && a.every((x) => typeof x === 'string') ? (a as string[]) : [];
  }

  function initUgMassenGeo() {
    if (!document.body) {
      requestAnimationFrame(() => initUgMassenGeo());
      return;
    }
    if (!document.getElementById('ug-erzeugen')) {
      console.error('[MassenuebungGeo] Steuerung (#ug-erzeugen) fehlt – falsche Seite oder DOM noch nicht bereit.');
      return;
    }

    const allowedSet = new Set(readUgMassenAllowedIds());
    if (allowedSet.size === 0) {
      console.warn(
        '[MassenuebungGeo] Keine erlaubten Aufgaben-IDs (Prelude fehlt oder läuft nach diesem Skript). Seite neu laden.'
      );
    }

    bindPracticeDiagramCheckbox(
      document.getElementById('mu-practice-diagrams-checkbox') as HTMLInputElement | null
    );
    let layout = 'arbeitsblatt';
    let anzahl = 10;
    let aufgaben = [];
    let wbIndex = 0;
    let wbZeigeLoesung = false;
    let wbSekunden = 0;
    let wbTimerId = null;
    let wbOverlayScaleRaf = 0;
    const DIAGRAM_SCALE_STEP = 0.1;
    const DIAGRAM_SCALE_MIN = 0.5;
    const DIAGRAM_SCALE_MAX = 2;
    const diagramScaleByHash = new Map();

    function clampDiagramScale(scale) {
      return Math.min(DIAGRAM_SCALE_MAX, Math.max(DIAGRAM_SCALE_MIN, Math.round(scale * 100) / 100));
    }
    function readDiagramScale(hash) {
      return diagramScaleByHash.get(hash) ?? 1;
    }
    function setDiagramScale(hash, scale) {
      diagramScaleByHash.set(hash, clampDiagramScale(scale));
    }
    function updateDiagramScale(hash, delta) {
      setDiagramScale(hash, readDiagramScale(hash) + delta);
    }
    function syncDiagramZoomUi(scope) {
      const root = scope ?? document;
      root.querySelectorAll('.mu-practice-diagram[data-mu-diagram-hash]').forEach((node) => {
        const hash = node.getAttribute('data-mu-diagram-hash');
        if (!hash) return;
        node.style.setProperty('--mu-diagram-scale', String(readDiagramScale(hash)));
      });
      root.querySelectorAll('[data-mu-diagram-zoom-label-for]').forEach((node) => {
        const hash = node.getAttribute('data-mu-diagram-zoom-label-for');
        if (!hash) return;
        node.textContent = `${Math.round(readDiagramScale(hash) * 100)}%`;
      });
      root.querySelectorAll('.ug-task-diagram-zoom[data-mu-diagram-hash]').forEach((btn) => {
        const hash = btn.getAttribute('data-mu-diagram-hash');
        const delta = Number(btn.getAttribute('data-mu-diagram-zoom-step'));
        if (!hash || !Number.isFinite(delta)) return;
        const atMin = readDiagramScale(hash) <= DIAGRAM_SCALE_MIN + 0.0001;
        const atMax = readDiagramScale(hash) >= DIAGRAM_SCALE_MAX - 0.0001;
        btn.toggleAttribute('disabled', (delta < 0 && atMin) || (delta > 0 && atMax));
      });
    }

    const typBoxen = () => Array.from(document.querySelectorAll('.ug-typ'));
    const anzahlBtns = () => Array.from(document.querySelectorAll('.ug-anzahl'));
    const layoutBtns = () => Array.from(document.querySelectorAll('.ug-layoutbtn'));
    const liste = document.getElementById('ug-liste');
    const arbeitsblatt = document.getElementById('ug-arbeitsblatt');
    const wbOverlay = document.getElementById('ug-wb-overlay');
    const wbScaleBox = document.getElementById('ug-wb-scale-box');
    const wbScaleInner = document.getElementById('ug-wb-scale-inner');
    const wbCard = document.getElementById('ug-whiteboard');
    const wbControls = document.getElementById('ug-wb-controls');
    const wbLeer = document.getElementById('ug-wb-leer');
    const wbContent = document.getElementById('ug-wb-content');
    const wbI = document.getElementById('ug-wb-i');
    const wbN = document.getElementById('ug-wb-n');
    const wbZeit = document.getElementById('ug-wb-zeit');
    const wbHeaderDiagramUi = document.getElementById('ug-wb-header-diagram-ui');
    const wbFrage = document.getElementById('ug-wb-frage');
    const wbLoesung = document.getElementById('ug-wb-loesung');
    const wbLoesungText = document.getElementById('ug-wb-loesung-text');
    const steuerung = document.getElementById('ug-steuerung');
    const wbPrev = document.getElementById('ug-wb-prev');
    const wbNext = document.getElementById('ug-wb-next');
    const errEl = document.getElementById('ug-fehler');
    const erzeugenBtn = document.getElementById('ug-erzeugen');
    const alleAufBtn = document.getElementById('ug-alle-aufdecken');
    const alleZuBtn = document.getElementById('ug-alle-zuklappen');
    const btnAlle = document.getElementById('ug-alle');
    const btnKeine = document.getElementById('ug-keine');
    const btnDruck = document.getElementById('ug-drucken');
    const routeSpeichernBtn = document.getElementById('ug-route-speichern');
    const wbRouteSpeichernBtn = document.getElementById('ug-wb-route-speichern');
    const routeLadenBtn = document.getElementById('ug-route-laden');
    const routeDateiInput = document.getElementById('ug-route-datei') as HTMLInputElement | null;
    const routeStatus = document.getElementById('ug-route-status');
    const wbVorbereitung = document.getElementById('ug-wb-vorbereitung');
    const wbVorbZuAb = document.getElementById('ug-wb-vorbereitung-zu-ab');

    liste?.addEventListener(
      'toggle',
      (e) => {
        const details = e.target;
        if (!(details instanceof HTMLDetailsElement) || !details.classList.contains('ug-task-details')) return;
        const li = details.closest('li');
        if (!li) return;
        const fr = li.querySelector('.ug-task-frage[data-mu-frage-highlight]');
        if (!(fr instanceof HTMLElement)) return;
        const encHi = fr.getAttribute('data-mu-frage-highlight');
        const encNeu = fr.getAttribute('data-mu-frage-neutral');
        if (!encHi || !encNeu) return;
        try {
          fr.innerHTML = details.open ? decodeURIComponent(encHi) : decodeURIComponent(encNeu);
        } catch {
          return;
        }
        if (typeof window.renderMathInElement === 'function') {
          try {
            window.renderMathInElement(fr, muPracticeKatexOpts());
          } catch (err) {
            console.warn('[MassenuebungGeo] KaTeX (Frage bei Lösung ein/aus):', err);
          }
        }
      },
      true
    );

    if (wbOverlay && wbOverlay.parentElement !== document.body) {
      document.body.appendChild(wbOverlay);
    }

    function setActive(btns, predicate) {
      btns.forEach((b) => {
        b.classList.toggle('ug--aktiv', predicate(b));
      });
    }
    function refreshAktiv() {
      setActive(anzahlBtns(), (b) => Number(b.dataset.anzahl) === anzahl);
      setActive(layoutBtns(), (b) => b.dataset.layout === layout);
    }

    function closeWhiteboardOverlay() {
      layout = 'arbeitsblatt';
      refreshAktiv();
      stopWbTimer();
      render();
    }

    function formatZeit(s) {
      const m = Math.floor(s / 60);
      const r = s % 60;
      return `${m}:${r.toString().padStart(2, '0')}`;
    }
    function startWbTimer() {
      stopWbTimer();
      wbSekunden = 0;
      if (wbZeit) wbZeit.textContent = formatZeit(0);
      wbTimerId = window.setInterval(() => {
        wbSekunden += 1;
        if (wbZeit) wbZeit.textContent = formatZeit(wbSekunden);
      }, 1000);
    }
    function stopWbTimer() {
      if (wbTimerId) {
        window.clearInterval(wbTimerId);
        wbTimerId = null;
      }
    }

    function wbOverlayInnerAvail(overlay) {
      const cs = getComputedStyle(overlay);
      const pl = parseFloat(cs.paddingLeft) || 0;
      const pr = parseFloat(cs.paddingRight) || 0;
      const pt = parseFloat(cs.paddingTop) || 0;
      const pb = parseFloat(cs.paddingBottom) || 0;
      return {
        w: Math.max(0, overlay.clientWidth - pl - pr),
        h: Math.max(0, overlay.clientHeight - pt - pb),
      };
    }

    function applyWbOverlayScaleFit() {
      if (!wbOverlay || wbOverlay.hidden || !wbScaleBox || !wbScaleInner || !wbCard) return;
      wbScaleInner.style.removeProperty('transform');
      wbScaleInner.style.removeProperty('transform-origin');
      wbScaleInner.style.removeProperty('width');
      wbScaleBox.style.removeProperty('width');
      wbScaleBox.style.removeProperty('height');
      const natW = wbCard.offsetWidth;
      const natH = wbCard.offsetHeight;
      if (natW < 1 || natH < 1) return;
      const { w: avW, h: avH } = wbOverlayInnerAvail(wbOverlay);
      if (avW < 1 || avH < 1) return;
      const s = Math.min(1, avW / natW, avH / natH);
      wbScaleBox.style.width = `${Math.max(1, Math.round(natW * s))}px`;
      wbScaleBox.style.height = `${Math.max(1, Math.round(natH * s))}px`;
      wbScaleInner.style.width = `${natW}px`;
      wbScaleInner.style.transform = `scale(${s})`;
      wbScaleInner.style.transformOrigin = 'top left';
    }

    function scheduleWbOverlayScaleFit() {
      if (!wbOverlay || wbOverlay.hidden) return;
      if (wbOverlayScaleRaf) cancelAnimationFrame(wbOverlayScaleRaf);
      wbOverlayScaleRaf = requestAnimationFrame(() => {
        wbOverlayScaleRaf = 0;
        requestAnimationFrame(() => {
          applyWbOverlayScaleFit();
        });
      });
    }

    function setRouteStatus(message, isError = false) {
      if (!routeStatus) return;
      routeStatus.textContent = message;
      routeStatus.classList.toggle('text-red-600', isError);
      routeStatus.classList.toggle('dark:text-red-300', isError);
      routeStatus.classList.toggle('text-ink-600', !isError);
      routeStatus.classList.toggle('dark:text-ink-300', !isError);
    }

    function comparablePath(path) {
      const p = String(path || '/').split('#')[0].split('?')[0] || '/';
      return p.length > 1 ? p.replace(/\/+$/, '') : p;
    }

    function currentRoutePageUrl() {
      return `${window.location.origin}${window.location.pathname}`;
    }

    function currentRouteVariant() {
      const parts = window.location.pathname.split('/').filter(Boolean);
      return parts[parts.length - 1] || '';
    }

    function collectDiagramScales() {
      const out = {};
      aufgaben.forEach((a, i) => {
        if (!a?.diagram && !a?.diagramLoesung) return;
        const prefKey = diagramTaskPreferenceKey(a.frage, i);
        const scale = readDiagramScale(prefKey);
        if (Math.abs(scale - 1) > 0.0001) out[prefKey] = scale;
      });
      return out;
    }

    function collectDiagramVisibility() {
      const byHash = {};
      aufgaben.forEach((a, i) => {
        if (!a?.diagram && !a?.diagramLoesung) return;
        const prefKey = diagramTaskPreferenceKey(a.frage, i);
        const wbLoesungGrafik =
          layout === 'whiteboard' &&
          wbZeigeLoesung &&
          i === wbIndex &&
          !!a.diagramLoesung;
        byHash[prefKey] = effectiveDiagramVisibleByHash(
          prefKey,
          a.diagramDefaultHidden === true,
          wbLoesungGrafik
        );
      });
      return { global: readShowPracticeDiagrams(), byHash };
    }

    function buildWhiteboardRouteState() {
      return {
        kind: WHITEBOARD_ROUTE_KIND,
        version: WHITEBOARD_ROUTE_VERSION,
        title: document.title || 'Whiteboard-Route',
        createdAt: new Date().toISOString(),
        pagePath: window.location.pathname,
        pageUrl: currentRoutePageUrl(),
        variant: currentRouteVariant(),
        selectedTaskTypes: aktiveTypen(),
        layout,
        anzahl,
        wbIndex,
        wbZeigeLoesung,
        tasks: aufgaben,
        diagramScales: collectDiagramScales(),
        diagramVisibility: collectDiagramVisibility(),
      };
    }

    function whiteboardRouteFilename() {
      const slug = currentRouteVariant().replace(/[^a-z0-9-]+/gi, '-').replace(/^-+|-+$/g, '') || 'whiteboard';
      const date = new Date().toISOString().slice(0, 10);
      return `whiteboard-route-${slug}-${date}.html`;
    }

    function saveWhiteboardRoute() {
      if (aufgaben.length === 0) {
        setRouteStatus('Erzeuge zuerst Aufgaben, dann kann die Route gespeichert werden.', true);
        return;
      }
      const route = buildWhiteboardRouteState();
      const html = serializeWhiteboardRouteHtml(route);
      const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = whiteboardRouteFilename();
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      setRouteStatus('Whiteboard-Route gespeichert. Die HTML-Datei oeffnet diese Route per Doppelklick.');
    }

    function applyTaskTypeSelection(selectedTaskTypes) {
      if (!Array.isArray(selectedTaskTypes) || selectedTaskTypes.length === 0) return;
      const selected = new Set(selectedTaskTypes);
      typBoxen().forEach((c) => {
        c.checked = selected.has(c.value);
      });
    }

    function applyDiagramSettingsFromRoute(route) {
      diagramScaleByHash.clear();
      const scales = route.diagramScales || {};
      const visMap = route.diagramVisibility?.byHash || {};
      (route.tasks || []).forEach((task, i) => {
        const prefKey = diagramTaskPreferenceKey(task.frage, i);
        const legacyH = hashPracticeTaskFrage(task.frage);
        const scale = scales[prefKey] ?? scales[legacyH];
        if (typeof scale === 'number') setDiagramScale(prefKey, scale);
        const visible = visMap[prefKey] ?? visMap[legacyH];
        if (typeof visible === 'boolean') {
          setDiagramEffectiveVisibleForHash(
            prefKey,
            visible,
            task.diagramDefaultHidden === true
          );
        }
      });
      writeShowPracticeDiagrams(route.diagramVisibility.global);
      const diagramCheckbox = document.getElementById('mu-practice-diagrams-checkbox') as HTMLInputElement | null;
      if (diagramCheckbox) diagramCheckbox.checked = route.diagramVisibility.global;
    }

    function applyWhiteboardRoute(route) {
      if (route.tasks.length === 0) {
        setRouteStatus('Die Route enthaelt keine Aufgaben.', true);
        return;
      }
      applyTaskTypeSelection(route.selectedTaskTypes);
      applyDiagramSettingsFromRoute(route);
      aufgaben = route.tasks;
      anzahl = route.anzahl;
      wbIndex = route.wbIndex;
      wbZeigeLoesung = route.wbZeigeLoesung;
      layout = route.layout;
      refreshAktiv();
      if (layout === 'whiteboard') startWbTimer();
      else stopWbTimer();
      render();
      setRouteStatus('Whiteboard-Route geladen.');
    }

    function openOrApplyWhiteboardRoute(route) {
      if (comparablePath(route.pagePath) !== comparablePath(window.location.pathname)) {
        window.name = createWhiteboardRouteWindowNamePayload(route);
        window.location.assign(route.pageUrl || route.pagePath);
        return;
      }
      applyWhiteboardRoute(route);
    }

    async function loadWhiteboardRouteFile(file) {
      try {
        const text = await file.text();
        const route = extractWhiteboardRouteFromText(text);
        if (!route) {
          setRouteStatus('Diese Datei enthaelt keine gueltige Whiteboard-Route.', true);
          return;
        }
        openOrApplyWhiteboardRoute(route);
      } catch (err) {
        console.warn('[MassenuebungGeo] Whiteboard-Route laden:', err);
        setRouteStatus('Die Whiteboard-Route konnte nicht gelesen werden.', true);
      }
    }

    function consumeWindowNameRoute() {
      const route = parseWhiteboardRouteFromWindowNamePayload(window.name || '');
      if (!route) return false;
      window.name = '';
      openOrApplyWhiteboardRoute(route);
      return true;
    }

    function shuffleTypen(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    /** Fragentext: optional `frageMitLoesungHighlight` erst, wenn die Lösung sichtbar ist (Whiteboard). */
    function practiceFrageAnzeigeHtml(a, loesungSichtbar) {
      return loesungSichtbar && a.frageMitLoesungHighlight ? a.frageMitLoesungHighlight : a.frage;
    }

    function muPracticeKatexOpts() {
      return {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
        ],
        ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option'],
        ignoredClasses: ['katex', 'mu-geo-diagram'],
        throwOnError: false,
      };
    }

    function aktiveTypen() {
      return typBoxen()
        .filter((c) => c.checked && allowedSet.has(c.value))
        .map((c) => c.value);
    }
    function erzeuge() {
      const typen = aktiveTypen();
      if (typen.length === 0) {
        if (errEl) errEl.hidden = false;
        return;
      }
      if (errEl) errEl.hidden = true;
      aufgaben = [];
      const pool = [];
      while (pool.length < anzahl) {
        for (const t of shuffleTypen(typen)) {
          if (pool.length < anzahl) pool.push(t);
        }
      }
      const usedFragen = new Set();
      for (const t of pool) {
        const gen = GEN[t];
        if (!gen) continue;
        let item;
        for (let k = 0; k < 40; k++) {
          item = gen();
          const key = item.frage.replace(/\s+/g, ' ').trim();
          if (!usedFragen.has(key)) {
            usedFragen.add(key);
            break;
          }
        }
        aufgaben.push(item);
      }
      wbIndex = 0;
      wbZeigeLoesung = false;
      if (layout === 'whiteboard') startWbTimer();
      else stopWbTimer();
      render();
    }

    function render() {
      const hat = aufgaben.length > 0;
      const wbOverlayAktiv = layout === 'whiteboard' && hat;
      if (alleAufBtn) alleAufBtn.hidden = !(hat && layout === 'arbeitsblatt');
      if (alleZuBtn) alleZuBtn.hidden = !(hat && layout === 'arbeitsblatt');
      if (btnDruck) btnDruck.hidden = !(hat && layout === 'arbeitsblatt');
      if (routeSpeichernBtn) routeSpeichernBtn.hidden = !hat;
      if (wbRouteSpeichernBtn) wbRouteSpeichernBtn.hidden = !hat;
      if (arbeitsblatt) arbeitsblatt.hidden = layout !== 'arbeitsblatt';
      if (wbOverlay) wbOverlay.hidden = !wbOverlayAktiv;
      document.documentElement.classList.toggle('mu-wb-overlay-open', wbOverlayAktiv);
      if (wbVorbereitung) wbVorbereitung.hidden = !(layout === 'whiteboard' && !hat);
      if (wbControls) wbControls.hidden = !(hat && layout === 'whiteboard');

      if (layout === 'arbeitsblatt') {
        stopWbTimer();
        renderArbeitsblatt();
      } else {
        renderWhiteboard();
      }

      if (typeof window.renderMathInElement === 'function') {
        const opts = muPracticeKatexOpts();
        try {
          if (steuerung) window.renderMathInElement(steuerung, opts);
          if (layout === 'arbeitsblatt') {
            if (arbeitsblatt) window.renderMathInElement(arbeitsblatt, opts);
          } else {
            if (wbFrage) window.renderMathInElement(wbFrage, opts);
            if (wbLoesungText) window.renderMathInElement(wbLoesungText, opts);
          }
        } catch (err) {
          console.warn('[MassenuebungGeo] KaTeX renderMathInElement:', err);
        }
      }
      syncPracticeDiagramUi(document.body);
      syncDiagramZoomUi(document.body);
      if (layout === 'whiteboard' && hat) {
        scheduleWbOverlayScaleFit();
      }
    }
    function renderArbeitsblatt() {
      if (!liste) return;
      liste.innerHTML = '';
      if (aufgaben.length === 0) {
        const li = document.createElement('li');
        li.className = 'text-ink-500 dark:text-ink-400 list-none';
        li.textContent = 'Noch keine Aufgaben erzeugt.';
        liste.appendChild(li);
        return;
      }
      aufgaben.forEach((a, idx) => {
        const li = document.createElement('li');
        li.className = 'pl-1';
        const prefKey = diagramTaskPreferenceKey(a.frage, idx);
        const diaDefHidden = a.diagramDefaultHidden === true ? 'true' : 'false';
        const diagramVis = effectiveDiagramVisibleByHash(prefKey, a.diagramDefaultHidden === true);
        const diaToggleLabel = practiceDiagramToggleAriaLabel(diagramVis);
        const diagramToggle = a.diagram || a.diagramLoesung
          ? `<div class="mb-2 print:hidden flex flex-wrap items-center gap-2">
              <button type="button" class="ug-task-diagram-toggle inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-ink-300 bg-surface hover:bg-ink-50 dark:border-slate-600/55 dark:bg-slate-900/75 dark:text-ink-100 dark:hover:bg-slate-800/85" data-mu-diagram-hash="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}" aria-pressed="${diagramVis ? 'true' : 'false'}" aria-label="${diaToggleLabel}" title="${diaToggleLabel}">${practiceDiagramToggleIconMarkup(diagramVis)}</button>
              <span class="inline-flex items-center gap-1 rounded-md border border-ink-300 bg-surface px-1 py-0.5 dark:border-slate-600/55 dark:bg-slate-900/75" data-mu-diagram-zoom-for="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}">
                <button type="button" class="ug-task-diagram-zoom inline-flex h-7 w-7 items-center justify-center rounded text-base font-semibold text-ink-800 hover:bg-ink-100 dark:text-ink-100 dark:hover:bg-slate-800/85 disabled:opacity-35" data-mu-diagram-hash="${prefKey}" data-mu-diagram-zoom-step="-${DIAGRAM_SCALE_STEP}" aria-label="Skizze verkleinern" title="Skizze verkleinern">−</button>
                <span class="min-w-[3rem] text-center text-xs font-medium text-ink-600 dark:text-ink-300" data-mu-diagram-zoom-label-for="${prefKey}">100%</span>
                <button type="button" class="ug-task-diagram-zoom inline-flex h-7 w-7 items-center justify-center rounded text-base font-semibold text-ink-800 hover:bg-ink-100 dark:text-ink-100 dark:hover:bg-slate-800/85 disabled:opacity-35" data-mu-diagram-hash="${prefKey}" data-mu-diagram-zoom-step="${DIAGRAM_SCALE_STEP}" aria-label="Skizze vergrößern" title="Skizze vergrößern">+</button>
              </span>
            </div>
            <div class="mu-practice-diagram mb-3 max-w-full" data-mu-diagram-hash="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}">${a.diagram ?? ''}</div>`
          : '';
        const inlineL = practiceAufgabeHatLoesungInlineNachFrage(a);
        const loesungImDetails = a.diagramLoesung
          ? `<div class="mu-practice-diagram mb-2 max-w-full" data-mu-diagram-hash="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}" data-mu-diagram-loesung-grafik="true">${a.diagramLoesung}</div>`
          : '';
        const loesungTextBlock =
          inlineL && a.frageMitLoesungHighlight
            ? ''
            : inlineL
              ? `<div class="mt-1 text-center text-ink-800 dark:text-ink-50">${a.loesung}</div>`
              : `<div class="mt-2 rounded-md border-l-4 border-accent-500 bg-accent-50 px-3 py-2 text-center text-ink-800 dark:border-teal-400 dark:bg-gradient-to-br dark:from-accent-900/45 dark:via-slate-950 dark:to-teal-900/35 dark:text-ink-100 dark:ring-1 dark:ring-inset dark:ring-teal-500/20">${a.loesung}</div>`;
        const frageHighlightAttrs =
          a.frageMitLoesungHighlight
            ? ` data-mu-frage-neutral="${encodeURIComponent(a.frage)}" data-mu-frage-highlight="${encodeURIComponent(a.frageMitLoesungHighlight)}"`
            : '';
        li.innerHTML = `
          ${diagramToggle}
          <div class="ug-task-frage text-ink-900 dark:text-ink-50 mb-2"${frageHighlightAttrs}>${a.frage}</div>
          <details class="group ug-task-details">
            <summary class="cursor-pointer text-sm text-accent-700 dark:text-accent-100 hover:underline">Lösung zeigen</summary>
            ${loesungImDetails}
            ${loesungTextBlock}
          </details>
        `;
        liste.appendChild(li);
      });
    }
    function renderWhiteboard() {
      if (!wbLeer || !wbContent) return;
      if (aufgaben.length === 0) {
        wbLeer.hidden = false;
        wbContent.hidden = true;
        if (wbHeaderDiagramUi) wbHeaderDiagramUi.innerHTML = '';
        stopWbTimer();
        return;
      }
      wbLeer.hidden = true;
      wbContent.hidden = false;
      if (wbN) wbN.textContent = String(aufgaben.length);
      if (wbI) wbI.textContent = String(wbIndex + 1);
      const cur = aufgaben[wbIndex];
      const prefKey = diagramTaskPreferenceKey(cur.frage, wbIndex);
      const diaDefHidden = cur.diagramDefaultHidden === true ? 'true' : 'false';
      const wbLoesungGrafik = wbZeigeLoesung && !!cur.diagramLoesung;
      const wbLoesungGrafikAttr = wbLoesungGrafik ? 'true' : 'false';
      const diagramVisWb = effectiveDiagramVisibleByHash(
        prefKey,
        cur.diagramDefaultHidden === true,
        wbLoesungGrafik
      );
      const diaToggleLabelWb = practiceDiagramToggleAriaLabel(diagramVisWb);
      const diagramSvg =
        wbZeigeLoesung && cur.diagramLoesung
          ? cur.diagramLoesung
          : (cur.diagram ?? '');
      if (wbHeaderDiagramUi) {
        if (cur.diagram || cur.diagramLoesung) {
          wbHeaderDiagramUi.innerHTML = `<button type="button" class="ug-task-diagram-toggle inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-ink-300 bg-surface hover:bg-ink-50 dark:border-slate-500 dark:bg-slate-800/90 dark:text-slate-100 dark:hover:border-slate-400 dark:hover:bg-slate-700/95 sm:h-9 sm:w-9" data-mu-diagram-hash="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}" data-mu-diagram-loesung-grafik="${wbLoesungGrafikAttr}" aria-pressed="${diagramVisWb ? 'true' : 'false'}" aria-label="${diaToggleLabelWb}" title="${diaToggleLabelWb}">${practiceDiagramToggleIconMarkup(diagramVisWb)}</button>
              <span class="inline-flex items-center gap-1 rounded-md border border-ink-300 bg-surface px-1 py-0.5 dark:border-slate-500 dark:bg-slate-800/90" data-mu-diagram-zoom-for="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}" data-mu-diagram-loesung-grafik="${wbLoesungGrafikAttr}">
                <button type="button" class="ug-task-diagram-zoom inline-flex h-7 w-7 items-center justify-center rounded text-base font-semibold text-ink-800 hover:bg-ink-100 dark:text-slate-200 dark:hover:bg-slate-700/90 disabled:opacity-35 sm:h-8 sm:w-8" data-mu-diagram-hash="${prefKey}" data-mu-diagram-zoom-step="-${DIAGRAM_SCALE_STEP}" aria-label="Skizze verkleinern" title="Skizze verkleinern">−</button>
                <span class="min-w-[3rem] text-center text-xs font-medium text-ink-600 dark:text-slate-400" data-mu-diagram-zoom-label-for="${prefKey}">100%</span>
                <button type="button" class="ug-task-diagram-zoom inline-flex h-7 w-7 items-center justify-center rounded text-base font-semibold text-ink-800 hover:bg-ink-100 dark:text-slate-200 dark:hover:bg-slate-700/90 disabled:opacity-35 sm:h-8 sm:w-8" data-mu-diagram-hash="${prefKey}" data-mu-diagram-zoom-step="${DIAGRAM_SCALE_STEP}" aria-label="Skizze vergrößern" title="Skizze vergrößern">+</button>
              </span>`;
        } else {
          wbHeaderDiagramUi.innerHTML = '';
        }
      }
      const dia = cur.diagram || cur.diagramLoesung
        ? `<div class="mu-practice-diagram mb-3 max-w-full print:hidden" data-mu-diagram-hash="${prefKey}" data-mu-diagram-default-hidden="${diaDefHidden}" data-mu-diagram-loesung-grafik="${wbLoesungGrafikAttr}">${diagramSvg}</div><div class="mt-2">`
        : '<div>';
      const inlineL = practiceAufgabeHatLoesungInlineNachFrage(cur);
      const loesungAnWhiteboardFrage =
        wbZeigeLoesung && inlineL && !cur.frageMitLoesungHighlight
          ? ` <span class="text-ink-800 dark:text-slate-100">${cur.loesung}</span>`
          : '';
      if (wbFrage) wbFrage.innerHTML = `${dia}${practiceFrageAnzeigeHtml(cur, wbZeigeLoesung)}${loesungAnWhiteboardFrage}</div>`;
      if (wbLoesungText) wbLoesungText.innerHTML = inlineL ? '' : aufgaben[wbIndex].loesung;
      if (wbLoesung) wbLoesung.hidden = !wbZeigeLoesung || inlineL;
      if (wbPrev) wbPrev.disabled = wbIndex === 0 && !wbZeigeLoesung;
      const istLetzte = wbIndex === aufgaben.length - 1;
      if (wbNext) {
        const neuMischen = wbZeigeLoesung && istLetzte;
        wbNext.textContent = wbZeigeLoesung
          ? istLetzte ? 'Neu mischen' : 'Nächste Aufgabe →'
          : 'Lösung zeigen';
        wbNext.className = neuMischen
          ? 'rounded-md bg-red-600 px-6 py-2.5 text-white font-semibold shadow-md shadow-red-900/25 hover:bg-red-700 dark:bg-red-600 dark:hover:bg-red-500 dark:shadow-lg dark:shadow-red-600/35 text-lg'
          : 'rounded-md bg-accent-600 px-6 py-2.5 text-white font-semibold shadow-md shadow-accent-900/25 hover:bg-accent-700 dark:bg-accent-500 dark:hover:bg-accent-400 dark:shadow-lg dark:shadow-accent-600/35 text-lg';
      }
    }

    anzahlBtns().forEach((b) => b.addEventListener('click', () => { anzahl = Number(b.dataset.anzahl); refreshAktiv(); }));
    layoutBtns().forEach((b) => b.addEventListener('click', () => {
      layout = b.dataset.layout;
      refreshAktiv();
      if (layout === 'arbeitsblatt') stopWbTimer();
      else if (aufgaben.length > 0) startWbTimer();
      render();
    }));
    erzeugenBtn?.addEventListener('click', erzeuge);

    btnAlle?.addEventListener('click', () => {
      typBoxen().forEach((c) => { c.checked = true; });
    });
    btnKeine?.addEventListener('click', () => {
      typBoxen().forEach((c) => { c.checked = false; });
    });

    btnDruck?.addEventListener('click', () => { window.print(); });
    routeSpeichernBtn?.addEventListener('click', saveWhiteboardRoute);
    wbRouteSpeichernBtn?.addEventListener('click', saveWhiteboardRoute);
    routeLadenBtn?.addEventListener('click', () => {
      routeDateiInput?.click();
    });
    routeDateiInput?.addEventListener('change', () => {
      const file = routeDateiInput.files?.[0];
      routeDateiInput.value = '';
      if (file) void loadWhiteboardRouteFile(file);
    });

    alleAufBtn?.addEventListener('click', () => {
      liste?.querySelectorAll('details').forEach((d) => { d.open = true; });
    });
    alleZuBtn?.addEventListener('click', () => {
      liste?.querySelectorAll('details').forEach((d) => { d.open = false; });
    });

    wbNext?.addEventListener('click', () => {
      if (!wbZeigeLoesung) {
        wbZeigeLoesung = true;
      } else if (wbIndex < aufgaben.length - 1) {
        wbIndex++;
        wbZeigeLoesung = false;
      } else {
        erzeuge();
        return;
      }
      render();
    });
    wbPrev?.addEventListener('click', () => {
      if (wbZeigeLoesung) {
        wbZeigeLoesung = false;
      } else if (wbIndex > 0) {
        wbIndex--;
        wbZeigeLoesung = true;
      }
      render();
    });

    wbVorbZuAb?.addEventListener('click', closeWhiteboardOverlay);
    wbOverlay?.addEventListener('click', (e) => {
      const t = (e.target as Element).closest('#ug-wb-overlay-schliessen, #ug-wb-zu-arbeitsblatt');
      if (t) {
        e.preventDefault();
        closeWhiteboardOverlay();
      }
    });

    document.addEventListener('click', (e) => {
      const zoomBtn = e.target && (e.target as Element).closest('button.ug-task-diagram-zoom');
      if (zoomBtn) {
        const hash = zoomBtn.getAttribute('data-mu-diagram-hash');
        const step = Number(zoomBtn.getAttribute('data-mu-diagram-zoom-step'));
        if (!hash || !Number.isFinite(step)) return;
        e.preventDefault();
        updateDiagramScale(hash, step);
        syncDiagramZoomUi(document.body);
        scheduleWbOverlayScaleFit();
        return;
      }
      const t = e.target && (e.target as Element).closest('button.ug-task-diagram-toggle');
      if (!t || !t.getAttribute('data-mu-diagram-hash')) return;
      const hash = t.getAttribute('data-mu-diagram-hash');
      if (!hash) return;
      const defaultHidden = t.getAttribute('data-mu-diagram-default-hidden') === 'true';
      const loesungGrafik = t.getAttribute('data-mu-diagram-loesung-grafik') === 'true';
      e.preventDefault();
      toggleDiagramForHash(hash, defaultHidden, loesungGrafik);
      syncPracticeDiagramUi(document.body);
      scheduleWbOverlayScaleFit();
    });

    document.addEventListener(
      'keydown',
      (e) => {
        if (layout !== 'whiteboard') return;
        if (e.target && /input|textarea|select/i.test((e.target as HTMLElement).tagName)) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeWhiteboardOverlay();
          return;
        }
        if (aufgaben.length === 0) return;
        if (e.target && (e.target as Element).closest('button.ug-task-diagram-toggle')) return;
        if (e.target && (e.target as Element).closest('#ug-wb-overlay button')) return;
        if (e.key === ' ' || e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); wbNext?.click(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); wbPrev?.click(); }
      },
      true
    );

    window.addEventListener('resize', scheduleWbOverlayScaleFit, { passive: true });
    if (typeof ResizeObserver !== 'undefined' && wbOverlay && wbCard) {
      const wbScaleRo = new ResizeObserver(() => scheduleWbOverlayScaleFit());
      wbScaleRo.observe(wbOverlay);
      wbScaleRo.observe(wbCard);
    }

    refreshAktiv();
    if (!consumeWindowNameRoute()) {
      render();
    }
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initUgMassenGeo(), { once: true });
    } else {
      requestAnimationFrame(() => requestAnimationFrame(() => initUgMassenGeo()));
    }
  }
</script>

<style is:global>
