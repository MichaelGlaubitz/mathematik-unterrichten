    function applyDiagramSettingsFromRoute(route) {
      diagramScaleByHash.clear();
      const scales = route.diagramScales || {};
      const visMap = route.diagramVisibility?.byHash || {};
      (route.tasks || []).forEach((task, i) => {
        const prefKey = diagramTaskPreferenceKey(task.frage, i);
        const legacyH = hashPracticeTaskFrage(task.frage);
        const scale = scales[prefKey] ?? scales[legacyH];
        if (typeof scale === 'number') setDiagramScale(prefKey, scale);
        else if (typeof task.diagramDefaultScale === 'number') setDiagramScale(prefKey, task.diagramDefaultScale);
        const visible = visMap[prefKey] ?? visMap[legacyH];
        if (typeof visible === 'boolean') {
          setDiagramEffectiveVisibleForHash(
            prefKey,
            visible,
            task.diagramDefaultHidden === true
          );
        }
      });
      writeShowPracticeDiagrams(route.diagramVisibility.global);
      const diagramCheckbox = document.getElementById('mu-practice-diagrams-checkbox') as HTMLInputElement | null;
      if (diagramCheckbox) diagramCheckbox.checked = route.diagramVisibility.global;
    }

    function applyWhiteboardRoute(route) {
      if (route.tasks.length === 0) {
        setRouteStatus('Die Route enthaelt keine Aufgaben.', true);
        return;
      }
      applyTaskTypeSelection(route.selectedTaskTypes);
      applyDiagramSettingsFromRoute(route);
      aufgaben = route.tasks;
      anzahl = route.anzahl;
      wbIndex = route.wbIndex;
      wbZeigeLoesung = route.wbZeigeLoesung;
      layout = route.layout;
      refreshAktiv();
      if (layout === 'whiteboard') startWbTimer();
      else stopWbTimer();
      render();
      setRouteStatus('Whiteboard-Route geladen.');
    }

    function openOrApplyWhiteboardRoute(route) {
      if (comparablePath(route.pagePath) !== comparablePath(window.location.pathname)) {
        window.name = createWhiteboardRouteWindowNamePayload(route);
        window.location.assign(route.pageUrl || route.pagePath);
        return;
      }
      applyWhiteboardRoute(route);
    }

    async function loadWhiteboardRouteFile(file) {
      try {
        const text = await file.text();
        const route = extractWhiteboardRouteFromText(text);
        if (!route) {
          setRouteStatus('Diese Datei enthaelt keine gueltige Whiteboard-Route.', true);
          return;
        }
        openOrApplyWhiteboardRoute(route);
      } catch (err) {
        console.warn('[MassenuebungGeo] Whiteboard-Route laden:', err);
        setRouteStatus('Die Whiteboard-Route konnte nicht gelesen werden.', true);
      }
    }

    function consumeWindowNameRoute() {
      const route = parseWhiteboardRouteFromWindowNamePayload(window.name || '');
      if (!route) return false;
      window.name = '';
      openOrApplyWhiteboardRoute(route);
      return true;
    }

    function shuffleTypen(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    /** Fragentext: optional `frageMitLoesungHighlight` erst, wenn die Lösung sichtbar ist (Whiteboard). */
    function practiceFrageAnzeigeHtml(a, loesungSichtbar) {
      return loesungSichtbar && a.frageMitLoesungHighlight ? a.frageMitLoesungHighlight : a.frage;
    }

    function muPracticeKatexOpts() {
      return {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
        ],
        ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option'],
        ignoredClasses: ['katex', 'mu-geo-diagram', 'mu-katex-skip'],
        throwOnError: false,
      };
    }

    function aktiveTypen() {
      if (isBruchMassen) return readBruchTypenFromStorage();
      if (isStochastikMassen) return readStochastikTypenFromStorage();
      if (isBinomischeFormelnMassen) return readBfTypenFromStorage();
      if (isLineareFunktionenMassen) return readLfTypenFromStorage();
      if (isNzMassen) return readNzTypenFromStorage();
      if (isDzMassen) return readDzTypenFromStorage();
      if (isAlgMassen) return readAlgebraTypenFromStorage();
      if (isBdpMassen) return readBdpTypenFromStorage();
      if (isLgMassen) return readLgTypenFromStorage();
      if (isPrMassen) return readPrTypenFromStorage();
      if (isGraphenMassen) return readGraphenTypenFromStorage();
      return typBoxen()
        .filter((c) => c.checked && allowedSet.has(c.value))
        .map((c) => c.value);
    }
    function erzeuge() {
      const typen = aktiveTypen();
      if (typen.length === 0) {
        if (errEl) errEl.hidden = false;
        return;
      }
      if (errEl) errEl.hidden = true;
      diagramScaleByHash.clear();
      aufgaben = [];
      const pool = [];
      while (pool.length < anzahl) {
        for (const t of shuffleTypen(typen)) {
          if (pool.length < anzahl) pool.push(t);
        }
      }
      const usedFragen = new Set();
      for (const t of pool) {
        const gen = GEN[t];
        if (!gen) continue;
        let item;
        for (let k = 0; k < 40; k++) {
          item = gen();
          const key = item.frage.replace(/\s+/g, ' ').trim();
          if (!usedFragen.has(key)) {
            usedFragen.add(key);
            break;
          }
        }
        aufgaben.push(item);
      }
      wbIndex = 0;
      wbZeigeLoesung = false;
      if (isWbSlotAbMassen && layout === 'arbeitsblatt') stopBruchAbSheetTimer();
      if (layout === 'whiteboard') startWbTimer();
      else stopWbTimer();
      render();
    }

    function render() {
      const hat = aufgaben.length > 0;
      if (steuerung instanceof HTMLDetailsElement && hat) {
        steuerung.open = false;
      }
      ensureDiagramScalesForAufgaben();
      const wbOverlayAktiv = layout === 'whiteboard' && hat;
      const meta = document.getElementById('ug-wb-slot-ab-meta');
      const foot = document.getElementById('ug-wb-slot-ab-actions');
      const slotAbSheet = isWbSlotAbMassen && hat && layout === 'arbeitsblatt';
      const fullChrome = document.getElementById('ug-wb-slot-ab-full-chrome');
      const abChrome = document.getElementById('ug-wb-slot-ab-chrome');
      if (meta) meta.hidden = !slotAbSheet;
      if (foot) foot.hidden = !slotAbSheet;
      // „Ueberpruefen“ braucht Antwortfelder im Aufgabentext. Die liefern noch
      // nicht alle Generatoren, also richtet sich der Knopf nach dem erzeugten
      // Aufgabensatz statt nach dem Thema – lieber kein Knopf als einer, der
      // „Keine Antwortfelder gefunden“ meldet.
      const checkBtn = document.getElementById('ug-wb-slot-ab-check');
      if (checkBtn instanceof HTMLElement) {
        const hatAntwortfelder = aufgaben.some(
          (a) => Array.isArray(a.abSlots) && a.abSlots.length > 0
        );
        checkBtn.hidden = !slotAbSheet || !hatAntwortfelder;
      }
      if (!slotAbSheet) {
        const chkOv = document.getElementById('ug-wb-slot-ab-check-overlay');
        if (chkOv instanceof HTMLElement) {
          chkOv.hidden = true;
          document.documentElement.classList.remove('mu-ab-wb-slot-check-open');
        }
      }
      if (fullChrome && abChrome) {
        if (slotAbSheet) {
          fullChrome.hidden = true;
          abChrome.hidden = false;
          refreshBruchAbStichworteUi();
        } else {
          fullChrome.hidden = false;
          abChrome.hidden = true;
        }
      }
      if (alleAufBtn) alleAufBtn.hidden = !(hat && layout === 'arbeitsblatt') || isWbSlotAbMassen;
      if (alleZuBtn) alleZuBtn.hidden = !(hat && layout === 'arbeitsblatt') || isWbSlotAbMassen;
      if (btnDruck) btnDruck.hidden = !(hat && layout === 'arbeitsblatt') || isWbSlotAbMassen;
      if (routeSpeichernBtn) routeSpeichernBtn.hidden = !hat;
      if (wbRouteSpeichernBtn) wbRouteSpeichernBtn.hidden = !hat;
      if (arbeitsblatt) arbeitsblatt.hidden = layout !== 'arbeitsblatt';
      if (wbOverlay) wbOverlay.hidden = !wbOverlayAktiv;
      document.documentElement.classList.toggle('mu-wb-overlay-open', wbOverlayAktiv);
      if (wbVorbereitung) wbVorbereitung.hidden = !(layout === 'whiteboard' && !hat);
      if (wbControls) wbControls.hidden = !(hat && layout === 'whiteboard');

      if (layout === 'arbeitsblatt') {
        stopWbTimer();
        renderArbeitsblatt();
      } else {
        renderWhiteboard();
      }

      if (typeof window.renderMathInElement === 'function') {
        const opts = muPracticeKatexOpts();
        try {
          if (steuerung) window.renderMathInElement(steuerung, opts);
          if (layout === 'arbeitsblatt') {
            if (arbeitsblatt) window.renderMathInElement(arbeitsblatt, opts);
          } else {
            if (wbFrage) window.renderMathInElement(wbFrage, opts);
            if (wbLoesungText) window.renderMathInElement(wbLoesungText, opts);
          }
        } catch (err) {
          console.warn('[MassenuebungGeo] KaTeX renderMathInElement:', err);
        }
      }
      syncPracticeDiagramUi(document.body);
      syncDiagramZoomUi(document.body);
      if (layout === 'whiteboard' && hat) {
        scheduleWbOverlayScaleFit();
      }
      if (isWbSlotAbMassen && hat && layout === 'arbeitsblatt') {
        if (!bruchAbSheetTimerId) resetAndStartBruchAbSheetTimer();
        refreshBruchAbSheetStats();
        if (liste) syncBruchLoesungEyeButtons(liste);
      } else {
        stopBruchAbSheetTimer();
      }
    }
