---
// Themenblock fuer die /themen-Uebersicht.
// View-Modell wird in der Seite vorberechnet (siehe themen/index.astro).
export interface TopicBlockProps {
  slug: string;
  titel: string;
  klassenstufenAnzeige: string;
  einfuehrung: string;
  fehlvorstellungen: string[];
  whiteboard: { frage: string; loesung: string; abbildungFrage?: string; abbildungLoesung?: string }[];
  aufgaben: any[];
  quizzes: any[];
  blog: any[];
  /** Optional: mehrere Links zu Zufallsübungen (z. B. Geometrie: Pythagoras + Strahlensätze). */
  generatorUebungen?: { href: string; label: string }[];
  /** Optional: Link zu einer Zufallsübungsseite (z. B. Pythagoras/Trigonometrie). */
  generatorUebungHref?: string;
  generatorUebungLabel?: string;
  /** Optional: Unterthemen in Clustern (Kurzüberblick zur inhaltlichen Spanne). */
  unterthemenBloecke?: { titel: string; beschreibung?: string; punkte: string[] }[];
}

const {
  slug,
  titel,
  klassenstufenAnzeige,
  einfuehrung,
  fehlvorstellungen,
  whiteboard,
  aufgaben,
  quizzes,
  blog,
  generatorUebungen,
  generatorUebungHref,
  generatorUebungLabel = 'Zufallsaufgaben (Whiteboard)',
  unterthemenBloecke,
} = Astro.props;

---

<article
  id={`thema-${slug}`}
  class="scroll-mt-32 rounded-xl border border-ink-200 bg-surface p-6 md:p-8 mu-dark-glass-panel"
>
  <header class="mb-4 flex flex-wrap items-baseline gap-3">
    <h3 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50">
      {titel}
    </h3>
    <span class="badge-accent">{klassenstufenAnzeige}</span>
  </header>

  <p class="prose-mathe text-ink-700 leading-relaxed mb-6 max-w-3xl dark:text-ink-200">
    {einfuehrung}
  </p>

  {unterthemenBloecke && unterthemenBloecke.length > 0 && (
    <section class="mb-8" aria-labelledby={`unterthemen-heading-${slug}`}>
      <h4
        id={`unterthemen-heading-${slug}`}
        class="font-semibold text-ink-900 dark:text-ink-50 mb-3 text-sm uppercase tracking-wide text-accent-700 dark:text-accent-100"
      >
        Unterthemen
      </h4>
      {slug === 'bruchrechnung' && generatorUebungHref && (
        <p class="text-xs text-ink-600 dark:text-ink-300 mb-3 max-w-3xl">
          Für <strong>WB Bruchrechnung</strong>: Stichworte anklicken — ausgewählte erscheinen invertiert. Ohne Auswahl
          werden dort alle Aufgabentypen gemischt.
        </p>
      )}
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {unterthemenBloecke.map((b) => (
          <div
            class="rounded-xl border border-ink-200 bg-ink-50/80 p-4 dark:border-slate-600/45 dark:bg-slate-950/40"
          >
            <h5 class="font-serif text-lg font-semibold text-accent-700 dark:text-accent-100 mb-1">
              {b.titel}
            </h5>
            {b.beschreibung && (
              <p class="text-xs text-ink-500 dark:text-ink-400 mb-3 leading-snug">{b.beschreibung}</p>
            )}
            <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
              {b.punkte.map((p) => (
                <li>
                  {slug === 'bruchrechnung' && generatorUebungHref ? (
                    <button
                      type="button"
                      class="mu-bruch-wb-kw inline-block max-w-full rounded-lg border border-accent-600/35 bg-surface px-2.5 py-1 text-left text-xs font-medium text-accent-800 shadow-sm transition hover:border-accent-600 hover:bg-accent-50 dark:border-accent-400/30 dark:bg-slate-900/60 dark:text-accent-50 dark:hover:border-accent-300 dark:hover:bg-slate-800/80"
                      data-stichwort={p}
                      aria-pressed="false"
                    >
                      {p}
                    </button>
                  ) : (
                    <span
                      class="inline-block rounded-lg border border-accent-600/35 bg-surface px-2.5 py-1 text-xs font-medium text-accent-800 dark:border-accent-400/30 dark:bg-slate-900/60 dark:text-accent-50"
                    >
                      {p}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {slug === 'bruchrechnung' && generatorUebungHref && unterthemenBloecke && unterthemenBloecke.length > 0 && (
    <>
      <div
        id="mu-bruch-thema-stripe"
        class="mu-bruch-thema-stripe mb-8 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border border-ink-200/90 bg-ink-50/90 px-3 py-2.5 text-sm shadow-sm dark:border-slate-600/50 dark:bg-slate-950/50"
        role="region"
        aria-label="Einstellungen für WB Bruchrechnung"
      >
      <div
        class="inline-flex flex-wrap items-center gap-1.5"
        role="group"
        aria-label="Anzahl Aufgaben"
        title="Wie viele Aufgaben? (klassisch fürs Whiteboard)"
      >
        {
          [5, 10, 15, 20, 30, 40, 50].map((n) => (
            <button
              type="button"
              class="mu-bruch-stripe-anzahl rounded-md border px-2.5 py-1 text-xs font-semibold tabular-nums transition-colors sm:px-3 sm:text-sm"
              data-anzahl={n}
            >
              {n}
            </button>
          ))
        }
      </div>
      <span class="hidden h-6 w-px shrink-0 bg-ink-200 dark:bg-slate-600 sm:inline-block" aria-hidden="true" />
      <div class="inline-flex flex-wrap items-center gap-1.5" role="group" aria-label="Darstellung">
        <button
          type="button"
          class="mu-bruch-stripe-layout rounded-md border px-2.5 py-1 text-xs font-semibold transition-colors sm:px-3 sm:text-sm"
          data-layout="arbeitsblatt"
        >
          Arbeitsblatt
        </button>
        <button
          type="button"
          class="mu-bruch-stripe-layout rounded-md border px-2.5 py-1 text-xs font-semibold transition-colors sm:px-3 sm:text-sm"
          data-layout="whiteboard"
        >
          Whiteboard
        </button>
      </div>
      <span class="hidden h-6 w-px shrink-0 bg-ink-200 dark:bg-slate-600 sm:inline-block" aria-hidden="true" />
      <label class="flex min-w-0 cursor-pointer items-center gap-2 text-xs text-ink-800 dark:text-ink-200 sm:text-sm">
        <input
          type="checkbox"
          id="mu-bruch-thema-diagrams-cb"
          class="shrink-0 accent-accent-600"
          aria-describedby="mu-bruch-thema-diagrams-hint"
        />
        <span class="min-w-0 leading-snug">
          <span class="font-medium text-ink-900 dark:text-ink-50">Grafiken / Skizzen</span>
          <span id="mu-bruch-thema-diagrams-hint" class="ml-1 hidden text-ink-600 dark:text-ink-400 xl:inline">
            (wie auf der Übungsseite; pro Aufgabe per Auge)
          </span>
        </span>
      </label>
      </div>

      <style is:global>
      /* Tailwind-Utilities auf den Buttons überschreiben — Auswahl muss sichtbar bleiben */
      #thema-bruchrechnung button.mu-bruch-wb-kw.mu-bruch-wb-kw--an {
        background-color: rgb(91 33 182) !important;
        border-color: rgb(91 33 182) !important;
        color: #fff !important;
      }
      html.dark #thema-bruchrechnung button.mu-bruch-wb-kw.mu-bruch-wb-kw--an {
        background-color: rgb(167 139 250) !important;
        border-color: rgb(167 139 250) !important;
        color: rgb(15 23 42) !important;
      }
      /* Kompaktzeile: gleiche Farblogik wie #ug-steuerung in MassenuebungGeo */
      #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-anzahl:not(.mu-bruch-stripe--aktiv) {
        border-color: theme('colors.teal.200');
        background-color: theme('colors.teal.50');
        color: theme('colors.ink.900');
      }
      #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-anzahl:not(.mu-bruch-stripe--aktiv):hover {
        background-color: theme('colors.teal.100');
        border-color: theme('colors.teal.400');
      }
      #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-layout:not(.mu-bruch-stripe--aktiv) {
        border-color: theme('colors.violet.200');
        background-color: theme('colors.violet.50');
        color: theme('colors.ink.900');
      }
      #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-layout:not(.mu-bruch-stripe--aktiv):hover {
        background-color: theme('colors.violet.100');
        border-color: theme('colors.violet.400');
      }
      html.dark #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-anzahl:not(.mu-bruch-stripe--aktiv) {
        border-color: theme('colors.teal.700');
        background-color: rgb(19 78 74 / 0.3);
        color: theme('colors.ink.50');
      }
      html.dark #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-anzahl:not(.mu-bruch-stripe--aktiv):hover {
        background-color: rgb(19 78 74 / 0.45);
        border-color: theme('colors.teal.500');
      }
      html.dark #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-layout:not(.mu-bruch-stripe--aktiv) {
        border-color: theme('colors.violet.600');
        background-color: rgb(76 29 149 / 0.25);
        color: theme('colors.ink.50');
      }
      html.dark #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-layout:not(.mu-bruch-stripe--aktiv):hover {
        background-color: rgb(76 29 149 / 0.38);
        border-color: theme('colors.violet.400');
      }
      #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-anzahl.mu-bruch-stripe--aktiv,
      #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-layout.mu-bruch-stripe--aktiv {
        background-color: theme('colors.accent.600');
        border-color: theme('colors.accent.600');
        color: #fff;
      }
      html.dark #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-anzahl.mu-bruch-stripe--aktiv,
      html.dark #thema-bruchrechnung .mu-bruch-thema-stripe .mu-bruch-stripe-layout.mu-bruch-stripe--aktiv {
        background-color: theme('colors.accent.500');
        border-color: theme('colors.accent.600');
        color: #fff;
      }
      .mu-fehlvorstellungen-acc .mu-fehlv-chevron {
        display: inline-block;
        transition: transform 0.15s ease;
      }
      .mu-fehlvorstellungen-acc[open] .mu-fehlv-chevron {
        transform: rotate(90deg);
      }
      </style>
    </>
  )}

  {fehlvorstellungen.length > 0 && (
    <details
      class="mu-fehlvorstellungen-acc mb-6 rounded-lg border-l-4 border-accent-500 bg-accent-50 p-4 dark:bg-accent-700/15 dark:border-accent-300"
      data-mu-fehlv-slug={slug}
    >
      <summary class="cursor-pointer list-none text-sm font-semibold text-accent-700 dark:text-accent-100 [&::-webkit-details-marker]:hidden">
        <span class="inline-flex w-full items-center justify-between gap-2">
          <span>Typische Fehlvorstellungen</span>
          <span class="mu-fehlv-chevron text-ink-500 text-xs font-normal dark:text-ink-400" aria-hidden="true">
            ▶
          </span>
        </span>
      </summary>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-800 dark:text-ink-100">
        {fehlvorstellungen.map((f) => <li>{f}</li>)}
      </ul>
    </details>
  )}


  <div class="grid gap-5 md:grid-cols-2">
    <!-- Aufgaben -->
    <div class="rounded-lg border border-ink-200 p-4 dark:border-slate-600/45 dark:bg-slate-950/30">
      <h4 class="font-semibold text-ink-900 mb-2 dark:text-ink-50 flex items-center gap-2">
        <span aria-hidden="true">📚</span> Aufgabenfolgen
      </h4>
      {aufgaben.length > 0 ? (
        <ul class="space-y-2 text-sm">
          {aufgaben.map((a) => (
            <li>
              <a
                href={`/aufgaben/${a.slug}`}
                class="text-accent-700 hover:underline dark:text-accent-100"
              >
                {a.data.titel}
              </a>
              <span class="text-ink-500 dark:text-ink-400">
                {' '}· Kl. {a.data.klassenstufe.join('/')} · {a.data.schwierigkeit}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ink-500 dark:text-ink-400 italic">
          Noch keine Aufgabenfolge – kommt.
        </p>
      )}
    </div>

    <!-- Quizzes -->
    <div class="rounded-lg border border-ink-200 p-4 dark:border-slate-600/45 dark:bg-slate-950/30">
      <h4 class="font-semibold text-ink-900 mb-2 dark:text-ink-50 flex items-center gap-2">
        <span aria-hidden="true">🎯</span> Diagnostische Fragen
      </h4>
      {quizzes.length > 0 ? (
        <ul class="space-y-2 text-sm">
          {quizzes.map((q) => (
            <li>
              <a
                href={`/quizzes/${q.id}`}
                class="text-accent-700 hover:underline dark:text-accent-100"
              >
                {q.data.titel}
              </a>
              <span class="text-ink-500 dark:text-ink-400">
                {' '}· Kl. {q.data.klassenstufe.join('/')}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ink-500 dark:text-ink-400 italic">
          Noch keine diagnostischen Fragen – kommen.
        </p>
      )}
    </div>

    <!-- Mini-Whiteboard -->
    <div class="rounded-lg border border-ink-200 p-4 dark:border-slate-600/45 dark:bg-slate-950/30">
      <div class="flex items-start justify-between gap-3 mb-2">
        <h4 class="font-semibold text-ink-900 dark:text-ink-50 flex items-center gap-2">
          <span aria-hidden="true">✏️</span> Mini-Whiteboard
        </h4>
        <div class="flex flex-wrap items-center gap-2 shrink-0 justify-end">
          {generatorUebungen && generatorUebungen.length > 0 ? (
            generatorUebungen.map((g) => (
              <a
                href={g.href}
                class="rounded-md border border-accent-600 px-3 py-1 text-xs font-semibold text-accent-700 hover:bg-accent-50 transition dark:border-accent-400 dark:text-accent-100 dark:hover:bg-accent-700/30"
                title="Zufällig erzeugte Aufgaben, Anzahl wählbar"
              >
                {g.label}
              </a>
            ))
          ) : (
            generatorUebungHref && (
              <a
                href={generatorUebungHref}
                class="rounded-md border border-accent-600 px-3 py-1 text-xs font-semibold text-accent-700 hover:bg-accent-50 transition dark:border-accent-400 dark:text-accent-100 dark:hover:bg-accent-700/30"
                title="Zufällig erzeugte Aufgaben, Anzahl wählbar"
              >
                {generatorUebungLabel}
              </a>
            )
          )}
          {whiteboard.length > 0 && (
            <a
              href={`/themen/${slug}/whiteboard`}
              class="inline-flex items-center justify-center rounded-md bg-accent-600 px-3 py-1 text-xs font-semibold text-white hover:bg-accent-700 transition dark:bg-accent-500 dark:hover:bg-accent-600"
              title="Aufgabe für Aufgabe an die Tafel projizieren"
              aria-label={`WB öffnen: ${titel}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3.5" y="4.5" width="17" height="11" rx="1.5"></rect>
                <path d="M8 20h8"></path>
                <path d="M12 15.5V20"></path>
                <path d="M7 9h10"></path>
              </svg>
            </a>
          )}
        </div>
      </div>
      {whiteboard.length > 0 ? (
        <ol class="space-y-2 text-sm list-decimal pl-5">
          {whiteboard.map((w) => (
            <li>
              <details class="group">
                <summary class="cursor-pointer text-ink-800 dark:text-ink-100 marker:text-ink-500">
                  {w.frage}
                </summary>
                <p class="mt-1 pl-1 text-ink-700 dark:text-ink-300">
                  <span class="font-semibold text-accent-700 dark:text-accent-100">Lösung:</span>{' '}
                  {w.loesung}
                </p>
              </details>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-sm text-ink-500 dark:text-ink-400 italic">
          Noch keine Whiteboard-Fragen.
        </p>
      )}
    </div>

    <!-- Blog -->
    <div class="rounded-lg border border-ink-200 p-4 dark:border-slate-600/45 dark:bg-slate-950/30">
      <h4 class="font-semibold text-ink-900 mb-2 dark:text-ink-50 flex items-center gap-2">
        <span aria-hidden="true">✍️</span> Verwandte Didaktik-Beiträge
      </h4>
      {blog.length > 0 ? (
        <ul class="space-y-2 text-sm">
          {blog.map((b) => (
            <li>
              <a
                href={`/blog/${b.slug}`}
                class="text-accent-700 hover:underline dark:text-accent-100"
              >
                {b.data.title}
              </a>
              <span class="text-ink-500 dark:text-ink-400">
                {' '}· {b.data.kategorie}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ink-500 dark:text-ink-400 italic">
          Noch keine passenden Beiträge verknüpft.
        </p>
      )}
    </div>
  </div>
</article>
