---
export interface UnterthemenBlock {
  titel: string;
  beschreibung?: string;
  punkte: string[];
}

interface Props {
  slug: string;
  generatorUebungHref?: string;
  unterthemenBloecke: UnterthemenBlock[];
  /**
   * Überschriftenstufe der Blocktitel. Voreinstellung 4 – das Raster steht
   * dann direkt unter der Themenüberschrift (h3). Steht darüber bereits eine
   * eigene h4, muss 5 gesetzt werden, sonst liegen zwei gleiche Stufen
   * ineinander.
   */
  stufe?: 4 | 5;
}

const { slug, generatorUebungHref, unterthemenBloecke, stufe = 4 } = Astro.props;
const Titel = `h${stufe}` as 'h4' | 'h5';
const isWbThemaKw =
  (slug === 'bruchrechnung' ||
    slug === 'negative-zahlen' ||
    slug === 'algebra' ||
    slug === 'dezimalzahlen' ||
    slug === 'bruch-dezimal-prozent' ||
    slug === 'lineare-gleichungen' ||
    slug === 'prozentrechnung' ||
    slug === 'graphen' ||
    slug === 'stochastik' ||
    slug === 'binomische-formeln' ||
    slug === 'lineare-funktionen') &&
  Boolean(generatorUebungHref);

---

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  {
    unterthemenBloecke.map((b) => (
      <div
        class:list={[
          'rounded-xl border border-ink-200 bg-ink-50/80 p-4 dark:border-slate-600/45 dark:bg-slate-950/40',
          isWbThemaKw && 'mu-wb-kw-cluster',
        ]}
      >
        <Titel class="font-serif text-lg font-semibold text-accent-700 dark:text-accent-100 mb-1">{b.titel}</Titel>
        {b.beschreibung && (
          <p class="text-xs text-ink-500 dark:text-ink-400 mb-3 leading-snug">{b.beschreibung}</p>
        )}
        {isWbThemaKw && (
          <div class="mb-2 flex flex-wrap gap-1.5" role="group" aria-label={`Stichwort-Auswahl: ${b.titel}`}>
            <button
              type="button"
              class="mu-wb-kw-bulk rounded-md px-2 py-0.5 text-[11px] font-semibold shadow-sm transition-colors sm:px-2.5 sm:text-xs"
              data-mu-wb-kw-bulk="cluster-select"
              aria-label={`Alle Stichwörter in „${b.titel}“ auswählen`}
            >
              Alle auswählen
            </button>
            <button
              type="button"
              class="mu-wb-kw-bulk rounded-md px-2 py-0.5 text-[11px] font-semibold shadow-sm transition-colors sm:px-2.5 sm:text-xs"
              data-mu-wb-kw-bulk="cluster-clear"
              aria-label={`Alle Stichwörter in „${b.titel}“ abwählen`}
            >
              Alle abwählen
            </button>
          </div>
        )}
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
          {b.punkte.map((p) => (
            <li>
              {isWbThemaKw ? (
                <button
                  type="button"
                  class="mu-wb-thema-kw inline-block max-w-full rounded-lg border border-accent-600/35 bg-surface px-2.5 py-1 text-left text-xs font-medium text-accent-800 shadow-sm transition hover:border-accent-600 hover:bg-accent-50 dark:border-accent-400/30 dark:bg-slate-900/60 dark:text-accent-50 dark:hover:border-accent-300 dark:hover:bg-slate-800/80"
                  data-stichwort={p}
                  aria-pressed="false"
                >
                  {p}
                </button>
              ) : (
                <span class="inline-block rounded-lg border border-accent-600/35 bg-surface px-2.5 py-1 text-xs font-medium text-accent-800 dark:border-accent-400/30 dark:bg-slate-900/60 dark:text-accent-50">
                  {p}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
