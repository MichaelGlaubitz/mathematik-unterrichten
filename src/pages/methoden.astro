---
import BaseLayout from '../layouts/BaseLayout.astro';
import { methoden, methodenFelder } from '../lib/methoden';

const feldFarbe: Record<string, string> = {
  Diagnose: 'from-amber-500 to-amber-400',
  Gesprächsführung: 'from-accent-600 to-accent-400',
  Aufgabenkultur: 'from-teal-600 to-teal-400',
  'Üben & Behalten': 'from-violet-600 to-violet-400',
  Unterrichtsdesign: 'from-rose-600 to-rose-400',
};

const feldText: Record<string, string> = {
  Diagnose: 'Herausfinden, was die Klasse gerade wirklich kann.',
  Gesprächsführung: 'Wer redet, wer denkt – und in welcher Reihenfolge.',
  Aufgabenkultur: 'Aufgaben, die mehr auslösen als eine Rechnung.',
  'Üben & Behalten': 'Damit im Februar noch da ist, was im Oktober dran war.',
  Unterrichtsdesign: 'Der Zuschnitt einer ganzen Stunde oder Reihe.',
};

const nachFeld = methodenFelder
  .map((feld) => ({ feld, liste: methoden.filter((m) => m.feld === feld) }))
  .filter((g) => g.liste.length > 0);
---

<BaseLayout
  sourceFile="src/pages/methoden.astro"
  title="Methodenkoffer"
  beschreibung="Sechzehn Unterrichtsmethoden für den Mathematikunterricht – jede mit drei Schritten für morgen früh, dem typischen Stolperstein und der Belegstelle aus der Forschung."
>
  <section class="container-wide pt-12 pb-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">Methodenkoffer</p>
    <h1 class="mt-2 font-serif text-4xl sm:text-5xl font-semibold tracking-tight text-ink-900 dark:text-ink-50">
      {methoden.length} Methoden, je <span class="bg-gradient-to-r from-accent-600 via-teal-600 to-violet-600 bg-clip-text text-transparent dark:from-sky-300 dark:via-teal-200 dark:to-fuchsia-300">drei Schritte</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-700 dark:text-ink-300">
      Kein Methodenlexikon, sondern eine Handlungsanweisung: Zu jeder Methode stehen hier
      genau drei Schritte, die Sie in der nächsten Stunde gehen können, dazu der
      Stolperstein, über den beim ersten Mal alle fallen, und die Stelle, an der die
      Forschung dazu steht.
    </p>

    <nav aria-label="Methodenfelder" class="mt-7 flex flex-wrap gap-2">
      {nachFeld.map(({ feld, liste }) => (
        <a
          href={`#feld-${feld.toLowerCase().replace(/[^a-zä-ü0-9]+/g, '-')}`}
          class="inline-flex items-center gap-2 rounded-full border border-ink-200/90 bg-surface/80 px-3.5 py-1.5 text-sm font-medium text-ink-700 transition hover:border-accent-300 hover:text-accent-800 dark:border-white/10 dark:bg-white/[0.04] dark:text-ink-200 dark:hover:border-teal-400/40"
        >
          {feld}
          <span class="text-xs text-ink-500 dark:text-ink-400">{liste.length}</span>
        </a>
      ))}
    </nav>
  </section>

  {nachFeld.map(({ feld, liste }) => (
    <section
      class="container-wide pb-12"
      id={`feld-${feld.toLowerCase().replace(/[^a-zä-ü0-9]+/g, '-')}`}
      style="scroll-margin-top: 5rem"
    >
      <header class="mb-5 border-b border-ink-200/80 pb-3 dark:border-white/10">
        <h2 class="font-serif text-2xl font-semibold text-ink-900 dark:text-ink-50">{feld}</h2>
        <p class="mt-1 text-ink-600 dark:text-ink-400">{feldText[feld]}</p>
      </header>

      <div class="space-y-5">
        {liste.map((m) => (
          <article
            id={m.slug}
            style="scroll-margin-top: 5rem"
            class="overflow-hidden rounded-2xl border border-ink-200/90 bg-surface/85 shadow-sm mu-dark-glass-panel"
          >
            <div class={`h-1 w-full bg-gradient-to-r ${feldFarbe[feld]}`} aria-hidden="true"></div>

            <div class="p-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-serif text-2xl font-semibold text-ink-900 dark:text-ink-50">{m.name}</h3>
                <span class="rounded-full bg-ink-100/80 px-2.5 py-0.5 text-xs font-medium text-ink-600 dark:bg-white/[0.07] dark:text-ink-300">
                  {m.dauer}
                </span>
              </div>
              <p class="mt-1.5 text-lg text-ink-800 dark:text-ink-200">{m.kurz}</p>

              <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
                <div>
                  <h4 class="text-xs font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">Wofür</h4>
                  <p class="mt-1.5 leading-relaxed text-ink-700 dark:text-ink-300" set:html={m.wofuer} />

                  <h4 class="mt-5 text-xs font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">Stolperstein</h4>
                  <p class="mt-1.5 rounded-lg border-l-4 border-rose-400 bg-rose-50/60 px-3 py-2 text-sm leading-relaxed text-ink-800 dark:border-rose-400/60 dark:bg-rose-950/25 dark:text-ink-200" set:html={m.stolperstein} />
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">
                    So starten Sie morgen früh
                  </h4>
                  <ol class="mt-2 space-y-2.5">
                    {m.schritte.map((s, i) => (
                      <li class="flex gap-3">
                        <span class={`mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-gradient-to-br ${feldFarbe[feld]} text-xs font-bold text-white`}>
                          {i + 1}
                        </span>
                        <span class="leading-relaxed text-ink-700 dark:text-ink-300" set:html={s} />
                      </li>
                    ))}
                  </ol>
                </div>
              </div>

              <div class="mt-5 border-t border-ink-200/70 pt-4 dark:border-white/10">
                <p class="text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  <span class="font-semibold text-ink-700 dark:text-ink-300">Woher wir das wissen: </span>
                  <span set:html={m.forschung} />
                </p>
                {m.links.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                    {m.links.map((l) => (
                      <a href={l.href} class="link-arrow">{l.text} </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="container-wide pb-20">
    <div class="rounded-2xl border border-accent-200/70 bg-accent-50/40 p-6 sm:p-8 dark:border-teal-400/20 dark:bg-teal-950/20">
      <h2 class="font-serif text-2xl font-semibold text-ink-900 dark:text-ink-50">Eine Methode reicht</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-700 dark:text-ink-300">
        Der häufigste Fehler beim Lesen solcher Listen ist, drei Dinge gleichzeitig ändern zu wollen.
        Nehmen Sie eine Methode, setzen Sie sie vier Wochen lang in jeder Stunde ein, bis sie
        Routine ist – und erst dann die nächste. Was hier steht, ist über Jahre entstanden,
        nicht über ein Wochenende.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/werkzeuge" class="inline-flex items-center gap-2 rounded-md bg-gradient-to-r from-accent-600 to-accent-500 px-4 py-2 font-medium text-white shadow-sm transition hover:brightness-105 dark:from-sky-500 dark:to-teal-400">
          Passende Werkzeuge <span aria-hidden="true">→</span>
        </a>
        <a href="/konzept" class="inline-flex items-center gap-2 rounded-md border border-ink-300 bg-surface/80 px-4 py-2 font-medium text-ink-800 transition hover:border-accent-400 dark:border-white/15 dark:bg-white/[0.04] dark:text-ink-100">
          Wie das im KLAR-Konzept zusammenspielt
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
