---
import BaseLayout from '../layouts/BaseLayout.astro';

const WEB3FORMS_KEY = '6d19f86f-7bbc-41cd-86e3-cf227fcf9a97';

const module = [
  {
    titel: 'Diagnose statt Bauchgefühl',
    dauer: 'halber Tag',
    fuer: 'Fachschaft Mathematik',
    inhalt:
      'Diagnostische Fragen bauen und einsetzen: Wie unterscheiden sich Distraktoren, die etwas verraten, von solchen, die nur falsch sind? Am Ende hat jede Person zwei einsatzfertige Fragen zum eigenen nächsten Thema.',
    mitnahme: 'Zwei eigene diagnostische Fragen, ein Vorgehen zur Auswertung in der Stunde.',
  },
  {
    titel: 'Aufgaben, die etwas erklären',
    dauer: 'halber Tag',
    fuer: 'Fachschaft Mathematik',
    inhalt:
      'Variation Theory in der Praxis: aus einer beliebigen Übungsseite eine Aufgabenfolge machen, in der die Reihenfolge selbst die Erklärung übernimmt. Wir arbeiten an Ihren eigenen Materialien.',
    mitnahme: 'Eine überarbeitete Aufgabenfolge je Teilnehmerin und Teilnehmer.',
  },
  {
    titel: 'Das denkende Klassenzimmer',
    dauer: 'halber Tag',
    fuer: 'Fachschaft oder Kollegium',
    inhalt:
      'Zufallsgruppen, senkrechte Flächen, mündliche Aufträge: die drei Bausteine nach Liljedahl – selbst erlebt, nicht nur beschrieben. Inklusive der Frage, was davon im eigenen Raum tatsächlich geht.',
    mitnahme: 'Ein Umsetzungsplan für die ersten vier Wochen.',
  },
  {
    titel: 'Das KLAR-Konzept',
    dauer: 'ganzer Tag',
    fuer: 'Fachschaft, Studienseminar',
    inhalt:
      'Der diagnosegeleitete Stundenablauf in vier Schritten: Klären, Lösen lassen, Abgleichen, Rückkoppeln. Wir planen gemeinsam eine vollständige Stunde vom mathematischen Kern her.',
    mitnahme: 'Eine fertige Stunde inklusive Diagnose, Verlaufsplan und Exit-Check.',
  },
  {
    titel: 'Prüfungsunterricht und Lehrproben',
    dauer: 'halber Tag',
    fuer: 'Studienseminar, Referendariat',
    inhalt:
      'Was eine gute Prüfungsstunde im Fach Mathematik ausmacht – Lernzielformulierung, Aufgabenauswahl vom Kern her, Verlaufsplanung, typische Fallen im Prüfungsgespräch.',
    mitnahme: 'Eine überarbeitete Entwurfsstruktur und eine Checkliste für den eigenen Entwurf.',
  },
  {
    titel: 'KI im Mathematikunterricht',
    dauer: 'halber Tag',
    fuer: 'Fachschaft oder Kollegium',
    inhalt:
      'Wo Sprachmodelle im Fach tatsächlich Zeit sparen und wo sie zuverlässig falsch liegen. Mit erprobten Prompts, Kontrollstrategien und den datenschutzrechtlichen Grenzen.',
    mitnahme: 'Eine Prompt-Sammlung für das eigene Fach und eine Handreichung für die Fachschaft.',
  },
];

const ablauf = [
  {
    titel: 'Vorgespräch',
    text: 'Ein Telefonat oder eine Videokonferenz von etwa 30 Minuten: Wo steht die Fachschaft, was ist schon versucht worden, was soll danach anders sein? Ohne dieses Gespräch gibt es keinen Termin.',
  },
  {
    titel: 'Zuschnitt',
    text: 'Ich passe Beispiele und Material an Ihre Schulform, Ihre Jahrgänge und Ihr Lehrwerk an. Sie bekommen den Ablaufplan vorab zur Rückmeldung.',
  },
  {
    titel: 'Der Termin',
    text: 'Gearbeitet wird an eigenem Material. Ein Vortragsanteil von höchstens einem Drittel, der Rest ist Werkstatt – wer abends nichts Fertiges mitnimmt, hat einen schlechten Tag gehabt.',
  },
  {
    titel: 'Danach',
    text: 'Alle Materialien digital, dazu eine Rückfragemöglichkeit per E-Mail für sechs Wochen. Auf Wunsch ein kurzer Folgetermin nach einem Halbjahr.',
  },
];
---

<BaseLayout
  sourceFile="src/pages/fortbildung.astro"
  title="Fortbildung"
  beschreibung="Fachdidaktische Fortbildungen für Mathematik-Fachschaften, Kollegien und Studienseminare: Diagnose, Aufgabenkultur, denkendes Klassenzimmer, KLAR-Konzept und KI im Mathematikunterricht."
>
  <section class="container-wide pt-12 pb-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">Für Schulen &amp; Seminare</p>
    <h1 class="mt-2 font-serif text-4xl sm:text-5xl font-semibold tracking-tight text-ink-900 dark:text-ink-50">
      Fortbildung, aus der man mit <span class="bg-gradient-to-r from-accent-600 via-teal-600 to-violet-600 bg-clip-text text-transparent dark:from-sky-300 dark:via-teal-200 dark:to-fuchsia-300">fertigem Material</span> herausgeht
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-700 dark:text-ink-300">
      Die meisten Fortbildungen scheitern nicht an den Inhalten, sondern an dem, was am
      Montag danach passiert – nämlich nichts. Deshalb wird bei mir an Ihrem eigenen Material
      gearbeitet: an Ihren Aufgaben, Ihren Themen, Ihrem nächsten Halbjahr.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="#anfrage" class="inline-flex items-center gap-2 rounded-md bg-gradient-to-r from-accent-600 to-accent-500 px-5 py-2.5 font-medium text-white shadow-md transition hover:brightness-105 dark:from-sky-500 dark:to-teal-400">
        Termin anfragen <span aria-hidden="true">→</span>
      </a>
      <a href="#module" class="inline-flex items-center gap-2 rounded-md border border-ink-300 bg-surface/80 px-5 py-2.5 font-medium text-ink-800 transition hover:border-accent-400 dark:border-white/15 dark:bg-white/[0.04] dark:text-ink-100">
        Die Module ansehen
      </a>
    </div>
  </section>

  <!-- Wer da kommt -->
  <section class="container-wide pb-12">
    <div class="flex flex-col gap-6 rounded-2xl border border-ink-200/90 bg-surface/80 p-6 sm:flex-row sm:items-center sm:p-8 mu-dark-glass-panel">
      <img
        src="/michael-glaubitz-avatar.jpg"
        alt="Dr. Michael Glaubitz"
        width="400"
        height="400"
        loading="lazy"
        decoding="async"
        class="h-28 w-28 flex-none rounded-full object-cover shadow-md ring-1 ring-ink-200/80 dark:ring-white/10"
      />
      <div>
        <p class="font-serif text-xl font-semibold text-ink-900 dark:text-ink-50">Dr. Michael Glaubitz</p>
        <p class="mt-2 leading-relaxed text-ink-700 dark:text-ink-300">
          Über 30 Jahre Mathematik und Physik an Gymnasien, Dozent in der universitären
          Lehrerausbildung für Primar- und Sekundarstufe, Fachleiter Mathematik am
          Studienseminar, schulfachlicher Koordinator, Schulleiter. Die Beispiele in meinen
          Fortbildungen stammen aus dem eigenen Unterricht – nicht aus der Literatur.
        </p>
        <p class="mt-3 text-sm">
          <a href="/ueber" class="link-arrow">Mehr zur Person </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Module -->
  <section class="container-wide pb-12" id="module" style="scroll-margin-top: 5rem">
    <h2 class="font-serif text-2xl font-semibold text-ink-900 dark:text-ink-50">Module</h2>
    <p class="mt-2 max-w-2xl text-ink-700 dark:text-ink-300">
      Einzeln buchbar oder als Reihe über ein Schuljahr. Jedes Modul lässt sich auf Ihre
      Schulform und Ihre Jahrgangsstufen zuschneiden.
    </p>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {module.map((m) => (
        <article class="flex flex-col rounded-xl border border-ink-200/90 bg-surface/85 p-5 shadow-sm mu-dark-glass-panel">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge-accent">{m.dauer}</span>
            <span class="text-xs text-ink-500 dark:text-ink-400">{m.fuer}</span>
          </div>
          <h3 class="mt-3 font-serif text-xl font-semibold text-ink-900 dark:text-ink-50">{m.titel}</h3>
          <p class="mt-2 flex-1 leading-relaxed text-ink-700 dark:text-ink-300">{m.inhalt}</p>
          <p class="mt-3 rounded-lg bg-teal-50/60 px-3 py-2 text-sm text-teal-900 dark:bg-teal-950/25 dark:text-teal-100">
            <span class="font-semibold">Mitnahme: </span>{m.mitnahme}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Ablauf -->
  <section class="container-wide pb-12">
    <h2 class="font-serif text-2xl font-semibold text-ink-900 dark:text-ink-50">Wie es abläuft</h2>
    <ol class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {ablauf.map((s, i) => (
        <li class="rounded-xl border border-ink-200/90 bg-surface/70 p-5 dark:border-white/[0.08] dark:bg-white/[0.02]">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-accent-600 to-teal-500 text-sm font-bold text-white">
            {i + 1}
          </span>
          <h3 class="mt-3 font-serif text-lg font-semibold text-ink-900 dark:text-ink-50">{s.titel}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-700 dark:text-ink-300">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Rahmen -->
  <section class="container-wide pb-12">
    <div class="grid gap-5 md:grid-cols-3">
      <div class="rounded-xl border border-ink-200/90 bg-surface/70 p-5 dark:border-white/[0.08] dark:bg-white/[0.02]">
        <h3 class="font-serif text-lg font-semibold text-ink-900 dark:text-ink-50">Format</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-700 dark:text-ink-300">
          In Präsenz an Ihrer Schule oder Ihrem Seminar; einzelne Module auch als
          Videokonferenz. Gruppengröße bis 30 Personen – darüber leidet der Werkstattanteil.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200/90 bg-surface/70 p-5 dark:border-white/[0.08] dark:bg-white/[0.02]">
        <h3 class="font-serif text-lg font-semibold text-ink-900 dark:text-ink-50">Was Sie brauchen</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-700 dark:text-ink-300">
          Einen Raum mit Beamer, Ihr eigenes Lehrwerk und Ihre Materialien. Alles Weitere
          bringe ich mit. Die eingesetzten Werkzeuge laufen offline im Browser –
          kein WLAN nötig.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200/90 bg-surface/70 p-5 dark:border-white/[0.08] dark:bg-white/[0.02]">
        <h3 class="font-serif text-lg font-semibold text-ink-900 dark:text-ink-50">Kosten</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-700 dark:text-ink-300">
          Nach Aufwand und Umfang, abhängig von Modulzahl, Gruppengröße und Anfahrt.
          Sie bekommen nach dem Vorgespräch ein schriftliches Angebot – ohne
          Verpflichtung und ohne versteckte Positionen.
        </p>
      </div>
    </div>
  </section>

  <!-- Anfrage -->
  <section class="container-wide pb-20" id="anfrage" style="scroll-margin-top: 5rem">
    <div class="rounded-2xl border border-accent-200/70 bg-accent-50/50 p-6 sm:p-8 dark:border-teal-400/20 dark:bg-teal-950/20">
      <h2 class="font-serif text-2xl font-semibold text-ink-900 dark:text-ink-50">Termin anfragen</h2>
      <p class="mt-2 max-w-2xl text-ink-700 dark:text-ink-200">
        Schreiben Sie kurz, um welche Schulform und welche Jahrgänge es geht und was
        danach anders sein soll. Ich melde mich mit einem Terminvorschlag für das
        Vorgespräch.
      </p>
      <p class="mt-2 max-w-2xl text-ink-700 dark:text-ink-200"><strong>ALLE TERMINE BIS JULI 2027 SIND AUSGEBUCHT.</strong></p>

      <form id="fb-form" class="mt-6 max-w-2xl" novalidate>
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="Fortbildungsanfrage über mathematik-unterrichten.de" />
        <input type="hidden" name="from_name" value="mathematik-unterrichten.de" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-ink-800 dark:text-ink-200">Name</span>
            <input name="name" type="text" required autocomplete="name"
              class="w-full rounded-md border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 dark:border-slate-600/55 dark:bg-slate-950/75 dark:text-ink-50" />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-ink-800 dark:text-ink-200">E-Mail</span>
            <input name="email" type="email" required autocomplete="email"
              class="w-full rounded-md border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 dark:border-slate-600/55 dark:bg-slate-950/75 dark:text-ink-50" />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-ink-800 dark:text-ink-200">Schule / Seminar</span>
            <input name="einrichtung" type="text"
              class="w-full rounded-md border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 dark:border-slate-600/55 dark:bg-slate-950/75 dark:text-ink-50" />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-ink-800 dark:text-ink-200">Gewünschtes Modul</span>
            <select name="modul"
              class="w-full rounded-md border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 dark:border-slate-600/55 dark:bg-slate-950/75 dark:text-ink-50">
              <option value="">noch offen</option>
              {module.map((m) => <option value={m.titel}>{m.titel}</option>)}
              <option value="Reihe über ein Schuljahr">Reihe über ein Schuljahr</option>
            </select>
          </label>
        </div>

        <label class="mt-4 block">
          <span class="mb-1 block text-sm font-medium text-ink-800 dark:text-ink-200">
            Worum geht es? Schulform, Jahrgänge, Anlass
          </span>
          <textarea name="message" rows="5" required
            class="w-full rounded-md border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 dark:border-slate-600/55 dark:bg-slate-950/75 dark:text-ink-50"></textarea>
        </label>

        <label class="mt-4 flex items-start gap-2.5 text-sm text-ink-700 dark:text-ink-300">
          <input name="datenschutz" type="checkbox" required
            class="mt-1 h-4 w-4 rounded border-ink-300 text-accent-600 focus:ring-accent-500 dark:border-slate-600/55 dark:bg-slate-950/75" />
          <span>Ich habe die <a href="/datenschutz" class="underline underline-offset-2 hover:text-accent-700 dark:hover:text-teal-200">Datenschutzhinweise</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung der Anfrage einverstanden.</span>
        </label>

        <div class="mt-5 flex flex-wrap items-center gap-4">
          <button type="submit"
            class="fb-submit inline-flex items-center justify-center rounded-md bg-accent-700 px-5 py-2.5 font-medium text-white transition hover:bg-accent-800 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 disabled:opacity-60 dark:bg-accent-600 dark:hover:bg-accent-700">
            <span class="fb-submit-label">Anfrage senden</span>
          </button>
          <a href="/kontakt" class="text-sm text-ink-600 underline underline-offset-2 hover:text-accent-700 dark:text-ink-400 dark:hover:text-teal-200">
            Lieber direkt schreiben
          </a>
        </div>

        <div class="fb-status mt-4 hidden rounded-md border-l-4 p-3 text-sm" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('fb-form') as HTMLFormElement | null;
  if (form) {
    const knopf = form.querySelector<HTMLButtonElement>('.fb-submit');
    const beschriftung = form.querySelector<HTMLElement>('.fb-submit-label');
    const status = form.querySelector<HTMLElement>('.fb-status');

    const setzeStatus = (art: 'success' | 'error' | 'info', text: string) => {
      if (!status) return;
      status.className = 'fb-status mt-4 rounded-md border-l-4 p-3 text-sm';
      const farben: Record<string, string> = {
        success: 'border-emerald-500 bg-emerald-50/60 text-emerald-900 dark:bg-emerald-900/25 dark:text-emerald-100',
        error: 'border-rose-500 bg-rose-50/60 text-rose-900 dark:bg-rose-900/25 dark:text-rose-100',
        info: 'border-ink-400 bg-ink-50 text-ink-800 dark:bg-slate-950/60 dark:text-ink-100',
      };
      status.classList.add(...farben[art].split(' '));
      status.textContent = text;
      status.classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const daten = new FormData(form);
      if (daten.get('botcheck')) {
        setzeStatus('success', 'Danke! Ihre Anfrage ist eingegangen.');
        form.reset();
        return;
      }
      if (knopf) knopf.disabled = true;
      if (beschriftung) beschriftung.textContent = 'Sende…';
      setzeStatus('info', 'Sende…');
      try {
        const inhalt: Record<string, string> = {};
        daten.forEach((wert, schluessel) => {
          inhalt[schluessel] = typeof wert === 'string' ? wert : '';
        });
        const antwort = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(inhalt),
        });
        const json = await antwort.json().catch(() => ({}));
        if (antwort.ok && (json as { success?: boolean }).success !== false) {
          setzeStatus('success', 'Danke! Ich melde mich in den nächsten Tagen mit einem Terminvorschlag.');
          form.reset();
        } else {
          setzeStatus('error', (json as { message?: string }).message ?? 'Das hat nicht geklappt. Bitte später erneut versuchen oder direkt schreiben.');
        }
      } catch (err) {
        setzeStatus('error', 'Netzwerkfehler – bitte prüfen Sie Ihre Verbindung und versuchen Sie es erneut.');
      } finally {
        if (knopf) knopf.disabled = false;
        if (beschriftung) beschriftung.textContent = 'Anfrage senden';
      }
    });
  }
</script>
