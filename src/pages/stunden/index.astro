---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const stunden = (await getCollection('stunden', ({ data }) => !data.entwurf)).sort((a, b) => {
  const zahl = (s: string[]) => Math.min(...s.map((x) => parseInt(x, 10)).filter(Number.isFinite));
  return zahl(a.data.klassenstufe) - zahl(b.data.klassenstufe)
    || a.data.titel.localeCompare(b.data.titel, 'de');
});

/** Klassenband aus der niedrigsten angegebenen Jahrgangsstufe ableiten. */
function band(stufen: string[]): string {
  const zahlen = stufen.map((s) => parseInt(s, 10)).filter((n) => Number.isFinite(n));
  const min = zahlen.length > 0 ? Math.min(...zahlen) : 11;
  if (min <= 6) return '5/6';
  if (min <= 8) return '7/8';
  if (min <= 10) return '9/10';
  return 'Oberstufe';
}

const baender = ['5/6', '7/8', '9/10', 'Oberstufe'];
const bandLabel: Record<string, string> = {
  '5/6': 'Klasse 5–6',
  '7/8': 'Klasse 7–8',
  '9/10': 'Klasse 9–10',
  Oberstufe: 'Oberstufe',
};
const vorhandene = baender.filter((b) => stunden.some((s) => band(s.data.klassenstufe) === b));
const dauern = [...new Set(stunden.map((s) => s.data.dauer))].sort((a, b) => a - b);

const schrittName: Record<string, string> = {
  K: 'Klären',
  L: 'Lösen lassen',
  A: 'Abgleichen',
  R: 'Rückkoppeln',
};
---

<BaseLayout
  sourceFile="src/pages/stunden/index.astro"
  title="Fertige Stundenverläufe"
  beschreibung={`${stunden.length} vollständig geplante Mathematikstunden nach dem KLAR-Ablauf: mit diagnostischer Einstiegsfrage, Minutenplan, Werkzeugen, Weichen für den Fall, dass die Diagnose anders ausfällt, Exit-Ticket und Differenzierung.`}
>
  <section class="container-wide pt-12 pb-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">Unterrichtsdesign</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-ink-900 sm:text-5xl dark:text-ink-50">
      Stunden, die man mitnehmen kann
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-700 dark:text-ink-300">
      {stunden.length} vollständig geplante Stunden nach dem <a href="/konzept" class="underline decoration-dotted underline-offset-2">KLAR-Ablauf</a>.
      Jede beginnt mit einer diagnostischen Frage, an der alle gleichzeitig antworten, und
      endet mit einem Exit-Ticket. Dazwischen: ein Minutenplan, die Werkzeuge zum Öffnen –
      und Weichen für den Fall, dass die Klasse etwas anderes kann als gedacht.
    </p>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
      <label class="flex-1">
        <span class="sr-only">Stundenverläufe durchsuchen</span>
        <input
          id="st-suche"
          type="search"
          autocomplete="off"
          placeholder="Suchen – z. B. Bruch, Steigung, Waage …"
          class="w-full rounded-lg border border-ink-300 bg-surface px-4 py-2.5 text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 dark:border-white/15 dark:bg-slate-950/60 dark:text-ink-50 dark:placeholder:text-ink-500"
        />
      </label>
      <div class="flex flex-wrap gap-2" id="st-band" role="group" aria-label="Nach Klassenstufe filtern">
        <button type="button" data-band="alle" aria-pressed="true" class="mu-chip">alle</button>
        {vorhandene.map((b) => (
          <button type="button" data-band={b} aria-pressed="false" class="mu-chip">{bandLabel[b]}</button>
        ))}
      </div>
      <div class="flex flex-wrap gap-2" id="st-dauer" role="group" aria-label="Nach Länge filtern">
        {dauern.map((m) => (
          <button type="button" data-dauer={String(m)} aria-pressed="false" class="mu-chip">{m} min</button>
        ))}
      </div>
    </div>
    <p id="st-status" class="mt-3 text-sm text-ink-500 dark:text-ink-400" role="status" aria-live="polite"></p>
  </section>

  <section class="container-wide pb-16">
    {stunden.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2">
        {stunden.map((s) => (
          <article
            class="st-eintrag relative flex flex-col rounded-2xl border border-ink-200/90 bg-surface p-6 shadow-sm transition hover:border-accent-300 hover:shadow-md dark:border-white/[0.08] dark:bg-white/[0.03] dark:hover:border-sky-400/30"
            data-band={band(s.data.klassenstufe)}
            data-dauer={String(s.data.dauer)}
            data-text={`${s.data.titel} ${s.data.thema} ${s.data.kurz} ${s.data.stundenziel} ${s.data.tags.join(' ')}`}
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">
              {s.data.thema} · Klasse {s.data.klassenstufe.join('/')} · {s.data.dauer} min
            </p>
            <h2 class="mt-2 font-serif text-xl font-semibold leading-snug text-ink-900 dark:text-ink-50">
              <a href={`/stunden/${s.slug}`} class="after:absolute after:inset-0">{s.data.titel}</a>
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-700 dark:text-ink-300">{s.data.kurz}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {['K', 'L', 'A', 'R'].filter((k) => s.data.phasen.some((f) => f.schritt === k)).map((k) => (
                <span
                  class="rounded-full bg-ink-100/80 px-2 py-0.5 font-mono text-[0.7rem] font-semibold text-ink-600 dark:bg-white/[0.06] dark:text-ink-300"
                  title={schrittName[k]}
                >
                  {k}
                </span>
              ))}
              <span class="ml-auto text-xs text-ink-500 dark:text-ink-400">
                {s.data.phasen.length} Phasen · {s.data.exitTicket.length} Exit-Fragen
              </span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="text-ink-600 dark:text-ink-300">
        Noch keine Stundenverläufe. Lege eine neue Datei unter
        <code class="rounded bg-ink-100 px-1.5 py-0.5 text-sm dark:bg-slate-800/85 dark:text-ink-100">src/content/stunden/</code> an.
      </p>
    )}
  </section>

  <section class="container-wide pb-20">
    <div class="rounded-2xl border border-ink-200/90 bg-gradient-to-br from-white to-ink-50/60 p-6 shadow-sm sm:p-8 dark:border-white/[0.08] dark:from-[rgb(26_22_35)] dark:to-[rgb(22_19_30)]">
      <h2 class="font-serif text-2xl font-semibold text-ink-900 dark:text-ink-50">Wie diese Pläne gemeint sind</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-700 dark:text-ink-300">
        Nicht als Drehbuch. Der Minutenplan ist die eine Variante, die erfahrungsgemäß trägt;
        die Weichen sind die anderen. Entscheidend ist die erste Frage: Was die Klasse dort
        antwortet, bestimmt, welcher Weg der richtige ist. Eine Diagnose, die den Plan nicht
        ändern darf, ist keine.
      </p>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/konzept" class="link-arrow">Das KLAR-Konzept </a>
        <a href="/methoden" class="link-arrow">Methodenkoffer </a>
        <a href="/fehlvorstellungen" class="link-arrow">Fehlvorstellungs-Katalog </a>
        <a href="/schnellstart" class="link-arrow">Schnellstart </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .mu-chip {
    @apply rounded-full border border-ink-200/90 bg-surface/80 px-3.5 py-1.5 text-sm font-medium text-ink-700 transition;
  }
  .mu-chip:hover {
    @apply border-accent-300 text-accent-800;
  }
  .mu-chip[aria-pressed='true'] {
    @apply border-accent-500 bg-accent-600 text-white;
  }
  .dark .mu-chip {
    @apply border-white/10 bg-white/[0.04] text-ink-200;
  }
  .dark .mu-chip[aria-pressed='true'] {
    @apply border-teal-400/60 bg-teal-500/80 text-teal-950;
  }
  .mu-aus {
    display: none !important;
  }
</style>

<script>
  const feld = document.getElementById('st-suche') as HTMLInputElement | null;
  const bandFilter = document.getElementById('st-band');
  const dauerFilter = document.getElementById('st-dauer');
  const status = document.getElementById('st-status');
  const eintraege = Array.from(document.querySelectorAll<HTMLElement>('.st-eintrag'));
  let band = 'alle';
  let dauer = 'alle';

  const normalisieren = (s: string) =>
    s.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss');

  function anwenden() {
    const suche = normalisieren(feld?.value.trim() ?? '');
    let sichtbar = 0;
    for (const e of eintraege) {
      const passtSuche = suche.length === 0 || normalisieren(e.dataset.text ?? '').includes(suche);
      const passtBand = band === 'alle' || e.dataset.band === band;
      const passtDauer = dauer === 'alle' || e.dataset.dauer === dauer;
      const zeigen = passtSuche && passtBand && passtDauer;
      e.classList.toggle('mu-aus', !zeigen);
      if (zeigen) sichtbar++;
    }
    if (status) {
      status.textContent =
        suche.length === 0 && band === 'alle' && dauer === 'alle'
          ? ''
          : sichtbar === 0
            ? 'Kein Stundenverlauf passt zu dieser Auswahl.'
            : `${sichtbar} von ${eintraege.length} Stundenverläufen`;
    }
  }

  /** Ein Chip in der Gruppe ist aktiv; ein zweiter Klick hebt die Auswahl auf. */
  function gruppe(wurzel: HTMLElement | null, attribut: string, setzen: (wert: string) => void) {
    wurzel?.addEventListener('click', (e) => {
      const knopf = (e.target as HTMLElement).closest<HTMLButtonElement>(`button[data-${attribut}]`);
      if (!knopf) return;
      const warAktiv = knopf.getAttribute('aria-pressed') === 'true';
      const wert = warAktiv ? 'alle' : (knopf.dataset[attribut] ?? 'alle');
      setzen(wert);
      wurzel
        .querySelectorAll<HTMLButtonElement>(`button[data-${attribut}]`)
        .forEach((k) =>
          k.setAttribute(
            'aria-pressed',
            String(wert === 'alle' ? k.dataset[attribut] === 'alle' : k === knopf)
          )
        );
      anwenden();
    });
  }

  feld?.addEventListener('input', anwenden);
  gruppe(bandFilter, 'band', (w) => { band = w; });
  gruppe(dauerFilter, 'dauer', (w) => { dauer = w; });
</script>
