---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiagnosticQuiz from '../../components/DiagnosticQuiz.astro';
import { abstimmungsLink } from '../../lib/abstimmung';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes', ({ data }) => !data.entwurf);
  return quizzes.map((q) => ({
    params: { id: q.id },
    props: { quiz: q },
  }));
}

const { quiz } = Astro.props;
const abstimmung = abstimmungsLink(quiz.data.titel, quiz.data.fragen);
const anzahl = quiz.data.fragen.length;
---

<BaseLayout sourceFile="src/pages/quizzes/[id].astro"
  title={quiz.data.titel}
  beschreibung={quiz.data.didaktischerKontext}
  githubEditPath={`src/content/quizzes/${quiz.id}`}
>
  <article class="container-prose py-12">
    <header class="mb-8 pb-6 border-b border-ink-200 dark:border-violet-500/20">
      <p class="text-sm text-accent-700 font-semibold uppercase tracking-wide mb-2 dark:text-accent-100">
        {quiz.data.thema} · Klasse {quiz.data.klassenstufe.join('/')}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 leading-tight mb-3 dark:text-ink-50">
        {quiz.data.titel}
      </h1>

      <aside class="mt-6 rounded-lg border-l-4 border-accent-500 bg-accent-50/40 p-4 dark:bg-accent-700/15">
        <p class="text-xs uppercase tracking-wide text-accent-700 font-semibold mb-1 dark:text-accent-100">Didaktischer Kontext</p>
        <p class="text-ink-800 text-sm leading-relaxed dark:text-ink-100">{quiz.data.didaktischerKontext}</p>
      </aside>
    </header>

    <DiagnosticQuiz fragen={quiz.data.fragen} id={quiz.id} titel={quiz.data.titel} />

    <section class="mt-10 prose prose-ink max-w-none dark:prose-invert">
      <h2>Hinweise zum Einsatz im Unterricht</h2>
      <p>
        Diagnostische Fragen entfalten ihre Wirkung nicht durch das Lösen, sondern durch das
        gemeinsame Auswerten. Projizieren Sie die Frage und lassen Sie alle
        <em>gleichzeitig</em> antworten – mit Abstimmkarten, Fingern oder Mini-Whiteboards,
        niemand meldet sich. Sie zählen mit, und erst danach wird die Verteilung gezeigt.
        Besprochen wird nicht die richtige Antwort, sondern die häufigste falsche: Welche
        Annahme muss jemand getroffen haben, um genau diese zu wählen?
      </p>
      <p>
        Zum Mitzählen und Projizieren gibt es die
        <a href="/werkzeuge/abstimmung.html">Abstimmung</a>. Dieses Quiz hier ist eine
        Selbstkontrolle für ein einzelnes Gerät – es sammelt <strong>keine</strong> Antworten
        ein und kann deshalb auch keine Klassenverteilung anzeigen.
      </p>
    </section>

    <aside class="mt-8 rounded-xl border border-accent-300/70 bg-accent-50/50 p-5 dark:border-accent-400/25 dark:bg-accent-700/10">
      <h2 class="font-serif text-xl font-semibold text-ink-900 m-0 dark:text-ink-50">
        Diese {anzahl} Fragen in der Abstimmung
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
        Frage und Antwortmöglichkeiten sind schon eingetragen – Sie tippen nur noch die
        Stimmen mit (<kbd class="rounded border border-ink-300 px-1 text-xs dark:border-slate-600">A</kbd>
        bis <kbd class="rounded border border-ink-300 px-1 text-xs dark:border-slate-600">D</kbd>),
        blättern mit den Pfeiltasten weiter und decken die Verteilung mit der Leertaste auf.
        Nichts wird übertragen: Der Fragensatz steht im Adressteil hinter dem <code>#</code> und
        bleibt im Browser.
      </p>
      <a
        href={abstimmung}
        class="mt-4 inline-flex items-center gap-2 rounded-md bg-accent-700 px-4 py-2 font-medium text-white transition hover:bg-accent-800 dark:bg-accent-600 dark:hover:bg-accent-500"
      >
        Abstimmung mit diesen Fragen öffnen
      </a>
    </aside>

    <footer class="mt-10 pt-6 border-t border-ink-200 flex justify-between text-sm dark:border-violet-500/20">
      <a href="/quizzes" class="link-arrow">Alle diagnostischen Fragen</a>
      <a href="#hauptinhalt" class="text-ink-500 hover:text-accent-700 dark:text-ink-400 dark:hover:text-accent-100">Nach oben ↑</a>
    </footer>
  </article>
</BaseLayout>
