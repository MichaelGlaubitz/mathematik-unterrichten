---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiagnosticQuiz from '../../components/DiagnosticQuiz.astro';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes', ({ data }) => !data.entwurf);
  return quizzes.map((q) => ({
    params: { id: q.id },
    props: { quiz: q },
  }));
}

const { quiz } = Astro.props;
---

<BaseLayout sourceFile="src/pages/quizzes/[id].astro"
  title={quiz.data.titel}
  beschreibung={quiz.data.didaktischerKontext}
  githubEditPath={`src/content/quizzes/${quiz.id}`}
>
  <article class="container-prose py-12">
    <header class="mb-8 pb-6 border-b border-ink-200 dark:border-violet-500/20">
      <p class="text-sm text-accent-700 font-semibold uppercase tracking-wide mb-2 dark:text-accent-100">
        {quiz.data.thema} · Klasse {quiz.data.klassenstufe.join('/')}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 leading-tight mb-3 dark:text-ink-50">
        {quiz.data.titel}
      </h1>

      <aside class="mt-6 rounded-lg border-l-4 border-accent-500 bg-accent-50/40 p-4 dark:bg-accent-700/15">
        <p class="text-xs uppercase tracking-wide text-accent-700 font-semibold mb-1 dark:text-accent-100">Didaktischer Kontext</p>
        <p class="text-ink-800 text-sm leading-relaxed dark:text-ink-100">{quiz.data.didaktischerKontext}</p>
      </aside>
    </header>

    <DiagnosticQuiz fragen={quiz.data.fragen} id={quiz.id} />

    <section class="mt-10 prose prose-ink max-w-none dark:prose-invert">
      <h2>Hinweise zum Einsatz im Unterricht</h2>
      <p>
        Diagnostische Fragen entfalten ihre Wirkung nicht durch das Lösen, sondern
        durch das gemeinsame Auswerten. Lass die Lernenden zunächst <em>still</em> abstimmen
        (digital oder mit Karten), zeige dann die Verteilung – und diskutiere die
        Distraktoren. Welche Annahme muss jemand getroffen haben, um genau diese
        Antwort zu wählen?
      </p>
    </section>

    <footer class="mt-10 pt-6 border-t border-ink-200 flex justify-between text-sm dark:border-violet-500/20">
      <a href="/quizzes" class="link-arrow">Alle Diagnose-Fragen</a>
      <a href="#hauptinhalt" class="text-ink-500 hover:text-accent-700 dark:text-ink-400 dark:hover:text-accent-100">Nach oben ↑</a>
    </footer>
  </article>
</BaseLayout>
