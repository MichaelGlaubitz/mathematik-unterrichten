---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicBlock from '../../components/TopicBlock.astro';

// --- Daten laden ----------------------------------------------------------
const themen = (await getCollection('themen', ({ data }) => !data.entwurf)).sort(
  (a, b) => a.data.ordnung - b.data.ordnung
);
const aufgaben = await getCollection('aufgaben', ({ data }) => !data.entwurf);
const quizzes = await getCollection('quizzes', ({ data }) => !data.entwurf);
const blog = await getCollection('blog', ({ data }) => !data.entwurf);

// --- Slug-Helfer ----------------------------------------------------------
function slugify(s) {
  return s
    .toLowerCase()
    .replace(/ä/g, 'ae')
    .replace(/ö/g, 'oe')
    .replace(/ü/g, 'ue')
    .replace(/ß/g, 'ss')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

// --- Cluster-Definition ---------------------------------------------------
const clusterReihenfolge = ['5/6', '7/8', '9/10', 'Oberstufe'];

const clusterLabel = {
  '5/6': 'Klasse 5–6',
  '7/8': 'Klasse 7–8',
  '9/10': 'Klasse 9–10',
  Oberstufe: 'Oberstufe',
};

const clusterSlug = {
  '5/6': 'klasse-5-6',
  '7/8': 'klasse-7-8',
  '9/10': 'klasse-9-10',
  Oberstufe: 'oberstufe',
};

// --- Verknüpfungen pro Thema ----------------------------------------------
function aufgabenZu(thema) {
  return aufgaben
    .filter((a) => a.data.thema === thema)
    .sort((a, b) => a.data.titel.localeCompare(b.data.titel, 'de'));
}
function quizzesZu(thema) {
  return quizzes
    .filter((q) => q.data.thema === thema)
    .sort((a, b) => a.data.titel.localeCompare(b.data.titel, 'de'));
}
function blogZu(thema, blogTags) {
  const aufgabenTags = aufgabenZu(thema).flatMap((a) => a.data.tags ?? []);
  const pool = new Set(
    [...blogTags, ...aufgabenTags].map((t) => t.toLowerCase())
  );
  if (pool.size === 0) return [];
  return blog
    .filter((b) =>
      (b.data.tags ?? []).some((tag) => pool.has(tag.toLowerCase()))
    )
    .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
}

// Themen pro Band mit ausgewerteten Verknuepfungen
const themenProBand = clusterReihenfolge
  .map((band) => ({
    band,
    label: clusterLabel[band],
    slug: clusterSlug[band],
    themen: themen
      .filter((t) => t.data.klassenstufeBand === band)
      .map((t) => ({
        slug: slugify(t.data.thema),
        titel: t.data.titel,
        klassenstufenAnzeige: t.data.klassenstufenAnzeige,
        einfuehrung: t.data.einfuehrung,
        fehlvorstellungen: t.data.fehlvorstellungen,
        whiteboard: t.data.whiteboardAufgaben,
        aufgaben: aufgabenZu(t.data.thema),
        quizzes: quizzesZu(t.data.thema),
        blog: blogZu(t.data.thema, t.data.blogTags),
        unterthemenBloecke: t.data.unterthemenBloecke,
      })),
  }))
  .filter((g) => g.themen.length > 0);
---

<BaseLayout sourceFile="src/pages/themen/index.astro"
  title="Themen"
  beschreibung="Mathematik-Themen der Sekundarstufe – Aufgaben, diagnostische Fragen, Mini-Whiteboard-Übungen und Didaktik-Beiträge, nach Klassenstufen-Clustern geordnet."
>
  <section class="container-wide pt-12 pb-6 md:pt-16">
    <div class="max-w-3xl">
      <p class="text-accent-700 font-semibold tracking-wide uppercase text-xs mb-3 dark:text-accent-100">
        Themen · Sekundarstufe I & Übergang Oberstufe
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-semibold leading-tight text-ink-900 mb-4 dark:text-ink-50">
        Themenübersicht
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed dark:text-ink-200">
        Für viele Themen gibt es hier kurze didaktische Einordnungen, typische Fehlvorstellungen,
        passende Aufgabenfolgen, diagnostische Fragen, Mini-Whiteboard-Fragen für
        die schnelle Abfrage und verwandte Blog-Beiträge.
      </p>
    </div>
  </section>

  <nav
    aria-label="Themen-Bereiche"
    class="sticky top-[64px] z-30 -mx-4 sm:mx-0 mb-8 border-y border-ink-200 bg-ink-50/85 backdrop-blur-md dark:border-violet-500/20 dark:bg-[rgb(26_22_35)] dark:backdrop-blur-none"
  >
    <div
      class="container-wide py-3 flex flex-wrap gap-2 text-sm dark:bg-[rgb(26_22_35)]"
    >
      <span class="text-ink-500 dark:text-ink-400 mr-1 hidden sm:inline">Springe zu:</span>
      {themenProBand.map((g) => (
        <a
          href={`#${g.slug}`}
          class="rounded-full border border-ink-300 bg-surface px-3 py-1 text-ink-700 hover:border-accent-500 hover:text-accent-700 transition-colors dark:border-slate-600/45 dark:bg-slate-950/55 dark:text-ink-200 dark:ring-1 dark:ring-sky-400/12 dark:hover:border-teal-400/40 dark:hover:text-accent-100"
        >
          {g.label}
        </a>
      ))}
    </div>
  </nav>

  <div class="container-wide pb-20">
    {themenProBand.map((gruppe) => (
      <section id={gruppe.slug} class="mb-16 scroll-mt-32">
        <header class="mb-6 flex items-end justify-between gap-4">
          <h2 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 dark:text-ink-50">
            {gruppe.label}
          </h2>
          <span class="text-sm text-ink-500 dark:text-ink-400">
            {gruppe.themen.length} {gruppe.themen.length === 1 ? 'Thema' : 'Themen'}
          </span>
        </header>

        <div class="mb-8 flex flex-wrap gap-2">
          {gruppe.themen.map((tv) => (
            <a
              href={`#thema-${tv.slug}`}
              class="rounded-md bg-ink-100 px-2.5 py-1 text-xs text-ink-700 hover:bg-accent-50 hover:text-accent-700 transition-colors dark:bg-slate-900/70 dark:text-ink-200 dark:ring-1 dark:ring-sky-400/12 dark:hover:bg-accent-700/25 dark:hover:text-accent-100"
            >
              {tv.titel}
            </a>
          ))}
        </div>

        <div class="space-y-10">
          {gruppe.themen.map((tv) => (
            <TopicBlock
              slug={tv.slug}
              titel={tv.titel}
              klassenstufenAnzeige={tv.klassenstufenAnzeige}
              einfuehrung={tv.einfuehrung}
              unterthemenBloecke={tv.unterthemenBloecke}
              fehlvorstellungen={tv.fehlvorstellungen}
              whiteboard={tv.whiteboard}
              aufgaben={tv.aufgaben}
              quizzes={tv.quizzes}
              blog={tv.blog}
              generatorUebungHref={
                tv.slug === 'pythagoras'
                  ? '/uebung/pythagoras'
                  : tv.slug === 'strahlensaetze'
                    ? '/uebung/strahlensaetze'
                    : tv.slug === 'kreisgeometrie'
                      ? '/uebung/kreisgeometrie'
                      : tv.slug === 'trigonometrie'
                        ? '/uebung/trigonometrie'
                        : tv.slug === 'quadratische-funktionen'
                          ? '/uebung/quadratische-funktionen'
                          : tv.slug === 'quadratische-gleichungen'
                            ? '/uebung/quadratische-gleichungen'
                            : tv.slug === 'bruchgleichungen'
                              ? '/uebung/bruchgleichungen'
                              : tv.slug === 'bruchrechnung'
                                ? '/uebung/bruchrechnung'
                                : tv.slug === 'negative-zahlen'
                                  ? '/uebung/negative-zahlen'
                                  : tv.slug === 'algebra'
                                    ? '/uebung/algebra'
                                    : tv.slug === 'lineare-gleichungen'
                                      ? '/uebung/lineare-gleichungen'
                                      : tv.slug === 'prozentrechnung'
                                        ? '/uebung/prozentrechnung'
                                        : tv.slug === 'stochastik'
                                          ? '/uebung/stochastik'
                                          : tv.slug === 'binomische-formeln'
                                            ? '/uebung/binomische-formeln'
                                            : tv.slug === 'lineare-funktionen'
                                              ? '/uebung/lineare-funktionen'
                                              : tv.slug === 'lineare-gleichungssysteme'
                                                ? '/uebung/lineare-gleichungssysteme'
                                                : tv.slug === 'termumformungen'
                                                  ? '/uebung/termumformungen'
                                                  : tv.slug === 'exponentialfunktionen'
                                                    ? '/uebung/exponentialfunktionen'
                                                    : tv.slug === 'logarithmen'
                                                      ? '/uebung/logarithmen'
                                      : tv.slug === 'wurzelrechnung'
                                        ? '/uebung/wurzelrechnung'
                                        : undefined
              }
              generatorUebungLabel={
                tv.slug === 'pythagoras'
                  ? 'WB Pythagoras'
                  : tv.slug === 'strahlensaetze'
                    ? 'WB Strahlensaetze'
                    : tv.slug === 'kreisgeometrie'
                      ? 'WB Kreisgeometrie'
                      : tv.slug === 'trigonometrie'
                        ? 'WB Trigonometrie'
                        : tv.slug === 'quadratische-funktionen'
                          ? 'WB Quadratische Funktionen'
                          : tv.slug === 'quadratische-gleichungen'
                            ? 'WB Quadratische Gleichungen'
                            : tv.slug === 'bruchgleichungen'
                              ? 'WB Bruchgleichungen'
                              : tv.slug === 'bruchrechnung'
                                ? 'WB Bruchrechnung'
                                : tv.slug === 'negative-zahlen'
                                  ? 'WB Negative Zahlen'
                                  : tv.slug === 'algebra'
                                    ? 'WB Algebra'
                                    : tv.slug === 'lineare-gleichungen'
                                      ? 'WB Lineare Gleichungen'
                                      : tv.slug === 'prozentrechnung'
                                        ? 'WB Prozentrechnung'
                                        : tv.slug === 'stochastik'
                                          ? 'WB Stochastik'
                                          : tv.slug === 'binomische-formeln'
                                            ? 'WB Binomische Formeln'
                                            : tv.slug === 'lineare-funktionen'
                                              ? 'WB Lineare Funktionen'
                                              : tv.slug === 'lineare-gleichungssysteme'
                                                ? 'WB Lineare Gleichungssysteme'
                                                : tv.slug === 'termumformungen'
                                                  ? 'WB Termumformungen'
                                                  : tv.slug === 'exponentialfunktionen'
                                                    ? 'WB Exponentialfunktionen'
                                                    : tv.slug === 'logarithmen'
                                                      ? 'WB Logarithmen'
                                      : tv.slug === 'wurzelrechnung'
                                        ? 'WB Wurzelrechnung'
                                        : 'Zufallsaufgaben (Whiteboard)'
              }
            />
          ))}
        </div>
      </section>
    ))}

    {themenProBand.length === 0 && (
      <p class="text-ink-600 dark:text-ink-300">
        Noch keine Themen veröffentlicht. Lege Themenbeschreibungen unter
        <code class="bg-ink-100 px-1.5 py-0.5 rounded text-sm dark:bg-slate-800/85 dark:text-ink-100">src/content/themen/</code> an.
      </p>
    )}
  </div>

  <!-- WB-Stichworte (Bruchrechnung, Negative Zahlen, Algebra): Skript hier, damit Astro es bündelt. -->
  <script>
    import { ALG_WB_STOR_KEY, canonicalAlgStichworteFuerGeneratorIds } from '../../lib/algebraWbKeywordMap';
    import {
      algebraThemaStichworteToBruchSessionKeywords,
      selectedAlgebraStichworteRoutenZuBruchrechnung,
    } from '../../lib/algebraBruchThemaRouting';
    import { BRUCH_WB_STOR_KEY, stichworteFuerBruchIds } from '../../lib/bruchrechnungWbKeywordMap';
    import { NZ_WB_STOR_KEY, stichworteFuerNzIds } from '../../lib/negativeZahlenWbKeywordMap';
    import {
      readBruchMassenAnzahl,
      readBruchMassenLayout,
      writeBruchMassenAnzahl,
      writeBruchMassenLayout,
    } from '../../lib/massenBruchrechnungPrefs';
    import {
      readAlgebraMassenAnzahl,
      readAlgebraMassenLayout,
      writeAlgebraMassenAnzahl,
      writeAlgebraMassenLayout,
    } from '../../lib/massenAlgebraPrefs';
    import {
      readNzMassenAnzahl,
      readNzMassenLayout,
      writeNzMassenAnzahl,
      writeNzMassenLayout,
    } from '../../lib/massenNegativeZahlenPrefs';
    import { readShowPracticeDiagrams, writeShowPracticeDiagrams } from '../../lib/practiceDiagramPreference';

    let wbThemaKwAbort: AbortController | null = null;

    const FEEHLV_STOR_PREFIX = 'mu-thema-fehlvorstellungen:';

    function bootFehlvorstellungenAccordion() {
      document.querySelectorAll<HTMLDetailsElement>('details.mu-fehlvorstellungen-acc[data-mu-fehlv-slug]').forEach((el) => {
        const slug = el.getAttribute('data-mu-fehlv-slug');
        if (!slug || el.dataset.muFehlvBound === '1') return;
        el.dataset.muFehlvBound = '1';
        const key = `${FEEHLV_STOR_PREFIX}${slug}`;
        try {
          el.open = localStorage.getItem(key) === '1';
        } catch {
          el.open = false;
        }
        el.addEventListener('toggle', () => {
          try {
            localStorage.setItem(key, el.open ? '1' : '0');
          } catch {
            /* */
          }
        });
      });
    }

    function stripeApplyWbThema(root: HTMLElement, slug: 'bruchrechnung' | 'negative-zahlen' | 'algebra') {
      const anzahl =
        slug === 'bruchrechnung'
          ? readBruchMassenAnzahl()
          : slug === 'negative-zahlen'
            ? readNzMassenAnzahl()
            : readAlgebraMassenAnzahl();
      const layout =
        slug === 'bruchrechnung'
          ? readBruchMassenLayout()
          : slug === 'negative-zahlen'
            ? readNzMassenLayout()
            : readAlgebraMassenLayout();
      root.querySelectorAll<HTMLButtonElement>('.mu-wb-stripe-anzahl').forEach((b) => {
        const n = Number(b.dataset.anzahl);
        b.classList.toggle('mu-wb-stripe--aktiv', Number.isFinite(n) && n === anzahl);
      });
      root.querySelectorAll<HTMLButtonElement>('.mu-wb-stripe-layout').forEach((b) => {
        const l = b.dataset.layout;
        b.classList.toggle('mu-wb-stripe--aktiv', l === layout);
      });
      const cb = root.querySelector<HTMLInputElement>(`#mu-wb-thema-diagrams-${slug}`);
      if (cb) cb.checked = readShowPracticeDiagrams();
    }

    function bootWbThemaStripe(slug: 'bruchrechnung' | 'negative-zahlen' | 'algebra') {
      const root = document.getElementById(`thema-${slug}`);
      if (!root) return;
      const stripe = root.querySelector<HTMLElement>('.mu-wb-thema-stripe');
      if (!stripe || stripe.dataset.muStripeBound === '1') return;
      stripe.dataset.muStripeBound = '1';
      stripeApplyWbThema(root, slug);
      const autoHref = stripe.dataset.muWbAutoHref?.trim() || '';
      stripe.addEventListener('click', (ev: MouseEvent) => {
        const az = (ev.target as HTMLElement | null)?.closest?.('button.mu-wb-stripe-anzahl');
        if (az && stripe.contains(az)) {
          const n = Number((az as HTMLButtonElement).dataset.anzahl);
          if (!Number.isFinite(n)) return;
          if (slug === 'bruchrechnung') writeBruchMassenAnzahl(n);
          else if (slug === 'negative-zahlen') writeNzMassenAnzahl(n);
          else writeAlgebraMassenAnzahl(n);
          stripeApplyWbThema(root, slug);
          return;
        }
        const ly = (ev.target as HTMLElement | null)?.closest?.('button.mu-wb-stripe-layout');
        if (ly && stripe.contains(ly)) {
          const l = (ly as HTMLButtonElement).dataset.layout;
          if (l !== 'arbeitsblatt' && l !== 'whiteboard') return;
          if (slug === 'bruchrechnung') writeBruchMassenLayout(l);
          else if (slug === 'negative-zahlen') writeNzMassenLayout(l);
          else writeAlgebraMassenLayout(l);
          stripeApplyWbThema(root, slug);
          if (l === 'arbeitsblatt' && slug === 'algebra') {
            const sel = Array.from(root.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw.mu-wb-thema-kw--an'))
              .map((b) => b.dataset.stichwort ?? '')
              .filter(Boolean);
            if (selectedAlgebraStichworteRoutenZuBruchrechnung(sel)) {
              const bruchKw = algebraThemaStichworteToBruchSessionKeywords(sel);
              try {
                sessionStorage.setItem(BRUCH_WB_STOR_KEY, JSON.stringify(bruchKw));
              } catch {
                /* sessionStorage blockiert */
              }
              window.location.assign('/uebung/bruchrechnung?muAuto=1');
              return;
            }
          }
          if (autoHref) window.location.assign(autoHref);
        }
      });
      const cb = root.querySelector<HTMLInputElement>(`#mu-wb-thema-diagrams-${slug}`);
      cb?.addEventListener('change', () => {
        writeShowPracticeDiagrams(!!cb.checked);
      });
    }

    function applyWbThemaKwVisual(root: HTMLElement, slug: 'bruchrechnung' | 'negative-zahlen' | 'algebra') {
      const storKey =
        slug === 'bruchrechnung' ? BRUCH_WB_STOR_KEY : slug === 'negative-zahlen' ? NZ_WB_STOR_KEY : ALG_WB_STOR_KEY;
      const idPrefix = slug === 'bruchrechnung' ? 'br_' : slug === 'negative-zahlen' ? 'nz_' : 'alg_';
      const stichworteFuerIds =
        slug === 'bruchrechnung'
          ? stichworteFuerBruchIds
          : slug === 'negative-zahlen'
            ? stichworteFuerNzIds
            : stichworteFuerAlgIds;
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'));
      let sel = new Set<string>();
      try {
        const raw = JSON.parse(sessionStorage.getItem(storKey) || 'null');
        if (Array.isArray(raw) && raw.length > 0 && typeof raw[0] === 'string' && raw[0].startsWith(idPrefix)) {
          sel =
            slug === 'algebra'
              ? new Set(canonicalAlgStichworteFuerGeneratorIds(raw as string[]))
              : new Set(stichworteFuerIds(raw as string[]));
        } else if (Array.isArray(raw)) {
          sel = new Set(raw.filter((x: unknown) => typeof x === 'string') as string[]);
        }
      } catch {
        sel = new Set();
      }
      const all = new Set(buttons.map((b) => b.dataset.stichwort ?? '').filter(Boolean));
      sel = new Set([...sel].filter((k) => all.has(k)));
      buttons.forEach((b) => {
        const k = b.dataset.stichwort ?? '';
        const on = sel.has(k);
        b.classList.toggle('mu-wb-thema-kw--an', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    function persistWbThemaKw(root: HTMLElement, slug: 'bruchrechnung' | 'negative-zahlen' | 'algebra') {
      const storKey =
        slug === 'bruchrechnung' ? BRUCH_WB_STOR_KEY : slug === 'negative-zahlen' ? NZ_WB_STOR_KEY : ALG_WB_STOR_KEY;
      const sel = Array.from(root.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw.mu-wb-thema-kw--an'))
        .map((b) => b.dataset.stichwort ?? '')
        .filter(Boolean);
      try {
        sessionStorage.setItem(storKey, JSON.stringify(sel));
      } catch {
        /* sessionStorage blockiert */
      }
    }

    function bootWbThemaKeywords() {
      wbThemaKwAbort?.abort();
      wbThemaKwAbort = new AbortController();
      const { signal } = wbThemaKwAbort;
      const bruchRoot = document.getElementById('thema-bruchrechnung');
      if (bruchRoot) applyWbThemaKwVisual(bruchRoot, 'bruchrechnung');
      const nzRoot = document.getElementById('thema-negative-zahlen');
      if (nzRoot) applyWbThemaKwVisual(nzRoot, 'negative-zahlen');
      const algRoot = document.getElementById('thema-algebra');
      if (algRoot) applyWbThemaKwVisual(algRoot, 'algebra');
      document.addEventListener(
        'click',
        (ev: MouseEvent) => {
          const rootEl = (ev.target as HTMLElement | null)?.closest?.('.mu-wb-unterthemen-root');
          if (!rootEl || !rootEl.id.startsWith('thema-')) return;
          const s = rootEl.id.replace(/^thema-/, '');
          if (s !== 'bruchrechnung' && s !== 'negative-zahlen' && s !== 'algebra') return;
          const bulk = (ev.target as HTMLElement | null)?.closest?.('[data-mu-wb-kw-bulk]') as HTMLButtonElement | null;
          if (bulk && rootEl.contains(bulk)) {
            ev.preventDefault();
            const action = bulk.getAttribute('data-mu-wb-kw-bulk');
            const setKw = (buttons: Iterable<HTMLButtonElement>, on: boolean) => {
              for (const btn of buttons) {
                btn.classList.toggle('mu-wb-thema-kw--an', on);
                btn.setAttribute('aria-pressed', on ? 'true' : 'false');
              }
            };
            if (action === 'all-select') {
              setKw(rootEl.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'), true);
            } else if (action === 'all-clear') {
              setKw(rootEl.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'), false);
            } else if (action === 'cluster-select' || action === 'cluster-clear') {
              const cluster = bulk.closest('.mu-wb-kw-cluster');
              if (!cluster || !rootEl.contains(cluster)) return;
              setKw(cluster.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'), action === 'cluster-select');
            }
            persistWbThemaKw(rootEl, s as 'bruchrechnung' | 'negative-zahlen' | 'algebra');
            return;
          }
          const t = (ev.target as HTMLElement | null)?.closest?.('button.mu-wb-thema-kw');
          if (!t || !rootEl.contains(t)) return;
          ev.preventDefault();
          t.classList.toggle('mu-wb-thema-kw--an');
          t.setAttribute('aria-pressed', t.classList.contains('mu-wb-thema-kw--an') ? 'true' : 'false');
          persistWbThemaKw(rootEl, s as 'bruchrechnung' | 'negative-zahlen' | 'algebra');
        },
        { signal }
      );
    }

    function scheduleWbThemaBoot() {
      requestAnimationFrame(() => {
        bootFehlvorstellungenAccordion();
        wbThemaKwAbort?.abort();
        bootWbThemaStripe('bruchrechnung');
        bootWbThemaStripe('negative-zahlen');
        bootWbThemaStripe('algebra');
        bootWbThemaKeywords();
      });
    }

    scheduleWbThemaBoot();
    document.addEventListener('astro:page-load', scheduleWbThemaBoot);
  </script>
</BaseLayout>
