          class="rounded-md border border-ink-300 bg-surface px-2.5 py-1 text-xs font-semibold text-ink-700 hover:border-accent-500 hover:text-accent-700 transition-colors dark:border-slate-600/45 dark:bg-slate-950/55 dark:text-ink-200 dark:ring-1 dark:ring-sky-400/12 dark:hover:border-teal-400/40 dark:hover:text-accent-100"
