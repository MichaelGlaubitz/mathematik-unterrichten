            />
          ))}
        </div>
      </section>
    ))}

    {themenProBand.length === 0 && (
      <p class="text-ink-600 dark:text-ink-300">
        Noch keine Themen veröffentlicht. Lege Themenbeschreibungen unter
        <code class="bg-ink-100 px-1.5 py-0.5 rounded text-sm dark:bg-slate-800/85 dark:text-ink-100">src/content/themen/</code> an.
      </p>
    )}
  </div>

  <!-- WB-Stichworte (Bruchrechnung, Dezimalzahlen, Negative Zahlen, Algebra): Skript hier, damit Astro es bündelt. -->
  <script>
    import { ALG_WB_STOR_KEY, stichworteFuerAlgIds } from '../../lib/algebraWbKeywordMap';
    import { BRUCH_WB_STOR_KEY, stichworteFuerBruchIds } from '../../lib/bruchrechnungWbKeywordMap';
    import { DZ_WB_STOR_KEY, stichworteFuerDzIds } from '../../lib/dezimalzahlenWbKeywordMap';
    import { NZ_WB_STOR_KEY, stichworteFuerNzIds } from '../../lib/negativeZahlenWbKeywordMap';
    import { LG_WB_STOR_KEY, stichworteFuerLgIds } from '../../lib/lineareGleichungenWbKeywordMap';
    import { BDP_KW_WB_STOR_KEY, stichworteFuerBdpIds } from '../../lib/bdpWbKeywordMap';
    import { PR_WB_STOR_KEY, stichworteFuerPrIds } from '../../lib/prozentrechnungWbKeywordMap';
    import { GRAPHEN_WB_STOR_KEY, stichworteFuerGraphenIds } from '../../lib/graphenWbKeywordMap';
    import { STOCHASTIK_WB_STOR_KEY, stichworteFuerStochastikIds } from '../../lib/stochastikWbKeywordMap';
    import { BF_WB_STOR_KEY, stichworteFuerBfIds } from '../../lib/binomischeFormelnWbKeywordMap';
    import { LF_WB_STOR_KEY, stichworteFuerLfIds } from '../../lib/lineareFunktionenWbKeywordMap';
    import {
      readBruchMassenAnzahl,
      readBruchMassenLayout,
      writeBruchMassenAnzahl,
      writeBruchMassenLayout,
    } from '../../lib/massenBruchrechnungPrefs';
    import {
      readAlgebraMassenAnzahl,
      readAlgebraMassenLayout,
      writeAlgebraMassenAnzahl,
      writeAlgebraMassenLayout,
    } from '../../lib/massenAlgebraPrefs';
    import {
      readNzMassenAnzahl,
      readNzMassenLayout,
      writeNzMassenAnzahl,
      writeNzMassenLayout,
    } from '../../lib/massenNegativeZahlenPrefs';
    import {
      readBdpMassenAnzahl,
      readBdpMassenLayout,
      writeBdpMassenAnzahl,
      writeBdpMassenLayout,
    } from '../../lib/massenBdpPrefs';
    import {
      readDzMassenAnzahl,
      readDzMassenLayout,
      writeDzMassenAnzahl,
      writeDzMassenLayout,
    } from '../../lib/massenDezimalzahlenPrefs';
    import {
      readLgMassenAnzahl,
      readLgMassenLayout,
      writeLgMassenAnzahl,
      writeLgMassenLayout,
    } from '../../lib/massenLineareGleichungenPrefs';
    import {
      readPrMassenAnzahl,
      readPrMassenLayout,
      writePrMassenAnzahl,
      writePrMassenLayout,
    } from '../../lib/massenProzentrechnungPrefs';
    import {
      readGraphenMassenAnzahl,
      readGraphenMassenLayout,
      writeGraphenMassenAnzahl,
      writeGraphenMassenLayout,
    } from '../../lib/massenGraphenPrefs';
    import {
      readStochastikMassenAnzahl,
      readStochastikMassenLayout,
      writeStochastikMassenAnzahl,
      writeStochastikMassenLayout,
    } from '../../lib/massenStochastikPrefs';
    import {
      readBfMassenAnzahl,
      readBfMassenLayout,
      writeBfMassenAnzahl,
      writeBfMassenLayout,
    } from '../../lib/massenBinomischeFormelnPrefs';
    import {
      readLfMassenAnzahl,
      readLfMassenLayout,
      writeLfMassenAnzahl,
      writeLfMassenLayout,
    } from '../../lib/massenLineareFunktionenPrefs';
    import { readShowPracticeDiagrams, writeShowPracticeDiagrams } from '../../lib/practiceDiagramPreference';

    let wbThemaKwAbort: AbortController | null = null;

    const FEEHLV_STOR_PREFIX = 'mu-thema-fehlvorstellungen:';

    function bootFehlvorstellungenAccordion() {
      document.querySelectorAll<HTMLDetailsElement>('details.mu-fehlvorstellungen-acc[data-mu-fehlv-slug]').forEach((el) => {
        const slug = el.getAttribute('data-mu-fehlv-slug');
        if (!slug || el.dataset.muFehlvBound === '1') return;
        el.dataset.muFehlvBound = '1';
        const key = `${FEEHLV_STOR_PREFIX}${slug}`;
        try {
          el.open = localStorage.getItem(key) === '1';
        } catch {
          el.open = false;
        }
        el.addEventListener('toggle', () => {
          try {
            localStorage.setItem(key, el.open ? '1' : '0');
          } catch {
            /* */
          }
        });
      });
    }

    function stripeApplyWbThema(
      root: HTMLElement,
      slug:
        | 'bruchrechnung'
        | 'dezimalzahlen'
        | 'negative-zahlen'
        | 'algebra'
        | 'bruch-dezimal-prozent'
        | 'lineare-gleichungen'
        | 'prozentrechnung'
        | 'graphen'
        | 'stochastik'
        | 'binomische-formeln'
        | 'lineare-funktionen'
    ) {
      const anzahl =
        slug === 'bruchrechnung'
          ? readBruchMassenAnzahl()
          : slug === 'dezimalzahlen'
            ? readDzMassenAnzahl()
            : slug === 'negative-zahlen'
              ? readNzMassenAnzahl()
              : slug === 'bruch-dezimal-prozent'
                ? readBdpMassenAnzahl()
                : slug === 'lineare-gleichungen'
                  ? readLgMassenAnzahl()
                  : slug === 'prozentrechnung'
                    ? readPrMassenAnzahl()
                    : slug === 'graphen'
                      ? readGraphenMassenAnzahl()
                      : slug === 'stochastik'
                        ? readStochastikMassenAnzahl()
                        : slug === 'binomische-formeln'
                          ? readBfMassenAnzahl()
                          : slug === 'lineare-funktionen'
                            ? readLfMassenAnzahl()
                            : readAlgebraMassenAnzahl();
      const layout =
        slug === 'bruchrechnung'
          ? readBruchMassenLayout()
          : slug === 'dezimalzahlen'
            ? readDzMassenLayout()
            : slug === 'negative-zahlen'
              ? readNzMassenLayout()
              : slug === 'bruch-dezimal-prozent'
                ? readBdpMassenLayout()
                : slug === 'lineare-gleichungen'
                  ? readLgMassenLayout()
                  : slug === 'prozentrechnung'
                    ? readPrMassenLayout()
                    : slug === 'graphen'
                      ? readGraphenMassenLayout()
                      : slug === 'stochastik'
                        ? readStochastikMassenLayout()
                        : slug === 'binomische-formeln'
                          ? readBfMassenLayout()
                          : slug === 'lineare-funktionen'
                            ? readLfMassenLayout()
                            : readAlgebraMassenLayout();
      root.querySelectorAll<HTMLButtonElement>('.mu-wb-stripe-anzahl').forEach((b) => {
        const n = Number(b.dataset.anzahl);
        b.classList.toggle('mu-wb-stripe--aktiv', Number.isFinite(n) && n === anzahl);
      });
      root.querySelectorAll<HTMLButtonElement>('.mu-wb-stripe-layout').forEach((b) => {
        const l = b.dataset.layout;
        b.classList.toggle('mu-wb-stripe--aktiv', l === layout);
      });
      const cb = root.querySelector<HTMLInputElement>(`#mu-wb-thema-diagrams-${slug}`);
      if (cb) cb.checked = readShowPracticeDiagrams();
    }

    function bootWbThemaStripe(
      slug:
        | 'bruchrechnung'
        | 'dezimalzahlen'
        | 'negative-zahlen'
        | 'algebra'
        | 'bruch-dezimal-prozent'
        | 'lineare-gleichungen'
        | 'prozentrechnung'
        | 'graphen'
        | 'stochastik'
        | 'binomische-formeln'
        | 'lineare-funktionen'
    ) {
      const root = document.getElementById(`thema-${slug}`);
      if (!root) return;
      const stripe = root.querySelector<HTMLElement>('.mu-wb-thema-stripe');
      if (!stripe || stripe.dataset.muStripeBound === '1') return;
      stripe.dataset.muStripeBound = '1';
      stripeApplyWbThema(root, slug);
      const autoHref = stripe.dataset.muWbAutoHref?.trim() || '';
      stripe.addEventListener('click', (ev: MouseEvent) => {
        const az = (ev.target as HTMLElement | null)?.closest?.('button.mu-wb-stripe-anzahl');
        if (az && stripe.contains(az)) {
          const n = Number((az as HTMLButtonElement).dataset.anzahl);
          if (!Number.isFinite(n)) return;
          if (slug === 'bruchrechnung') writeBruchMassenAnzahl(n);
          else if (slug === 'dezimalzahlen') writeDzMassenAnzahl(n);
          else if (slug === 'negative-zahlen') writeNzMassenAnzahl(n);
          else if (slug === 'bruch-dezimal-prozent') writeBdpMassenAnzahl(n);
          else if (slug === 'lineare-gleichungen') writeLgMassenAnzahl(n);
          else if (slug === 'prozentrechnung') writePrMassenAnzahl(n);
          else if (slug === 'graphen') writeGraphenMassenAnzahl(n);
          else if (slug === 'stochastik') writeStochastikMassenAnzahl(n);
          else if (slug === 'binomische-formeln') writeBfMassenAnzahl(n);
          else if (slug === 'lineare-funktionen') writeLfMassenAnzahl(n);
          else writeAlgebraMassenAnzahl(n);
          stripeApplyWbThema(root, slug);
          return;
        }
        const ly = (ev.target as HTMLElement | null)?.closest?.('button.mu-wb-stripe-layout');
        if (ly && stripe.contains(ly)) {
          const l = (ly as HTMLButtonElement).dataset.layout;
          if (l !== 'arbeitsblatt' && l !== 'whiteboard') return;
          if (slug === 'bruchrechnung') writeBruchMassenLayout(l);
          else if (slug === 'dezimalzahlen') writeDzMassenLayout(l);
          else if (slug === 'negative-zahlen') writeNzMassenLayout(l);
          else if (slug === 'bruch-dezimal-prozent') writeBdpMassenLayout(l);
          else if (slug === 'lineare-gleichungen') writeLgMassenLayout(l);
          else if (slug === 'prozentrechnung') writePrMassenLayout(l);
          else if (slug === 'graphen') writeGraphenMassenLayout(l);
          else if (slug === 'stochastik') writeStochastikMassenLayout(l);
          else if (slug === 'binomische-formeln') writeBfMassenLayout(l);
          else if (slug === 'lineare-funktionen') writeLfMassenLayout(l);
          else writeAlgebraMassenLayout(l);
          stripeApplyWbThema(root, slug);
          if (autoHref) window.location.assign(autoHref);
        }
      });
      const cb = root.querySelector<HTMLInputElement>(`#mu-wb-thema-diagrams-${slug}`);
      cb?.addEventListener('change', () => {
        writeShowPracticeDiagrams(!!cb.checked);
      });
    }

    function applyWbThemaKwVisual(
      root: HTMLElement,
      slug:
        | 'bruchrechnung'
        | 'dezimalzahlen'
        | 'negative-zahlen'
        | 'algebra'
        | 'lineare-gleichungen'
        | 'bruch-dezimal-prozent'
        | 'prozentrechnung'
        | 'graphen'
        | 'stochastik'
        | 'binomische-formeln'
        | 'lineare-funktionen'
    ) {
      const storKey =
        slug === 'bruchrechnung'
          ? BRUCH_WB_STOR_KEY
          : slug === 'dezimalzahlen'
            ? DZ_WB_STOR_KEY
            : slug === 'negative-zahlen'
              ? NZ_WB_STOR_KEY
              : slug === 'lineare-gleichungen'
                ? LG_WB_STOR_KEY
                : slug === 'bruch-dezimal-prozent'
                  ? BDP_KW_WB_STOR_KEY
                  : slug === 'prozentrechnung'
                    ? PR_WB_STOR_KEY
                    : slug === 'graphen'
                      ? GRAPHEN_WB_STOR_KEY
                      : slug === 'stochastik'
                        ? STOCHASTIK_WB_STOR_KEY
                        : slug === 'binomische-formeln'
                          ? BF_WB_STOR_KEY
                          : slug === 'lineare-funktionen'
                            ? LF_WB_STOR_KEY
                            : ALG_WB_STOR_KEY;
      const idPrefix =
        slug === 'bruchrechnung'
          ? 'br_'
          : slug === 'dezimalzahlen'
            ? 'dz_'
            : slug === 'negative-zahlen'
              ? 'nz_'
              : slug === 'lineare-gleichungen'
                ? 'lg_'
                : slug === 'bruch-dezimal-prozent'
                  ? 'bdp_'
                  : slug === 'prozentrechnung'
                    ? 'pr_'
                    : slug === 'graphen'
                      ? 'pg_'
                      : slug === 'stochastik'
                        ? 'st_'
                        : slug === 'binomische-formeln'
                          ? 'bf_'
                          : slug === 'lineare-funktionen'
                            ? 'lf_'
                            : 'alg_';
      const stichworteFuerIds =
        slug === 'bruchrechnung'
          ? stichworteFuerBruchIds
          : slug === 'dezimalzahlen'
            ? stichworteFuerDzIds
            : slug === 'negative-zahlen'
              ? stichworteFuerNzIds
              : slug === 'lineare-gleichungen'
                ? stichworteFuerLgIds
                : slug === 'bruch-dezimal-prozent'
                  ? stichworteFuerBdpIds
                  : slug === 'prozentrechnung'
                    ? stichworteFuerPrIds
                    : slug === 'graphen'
                      ? stichworteFuerGraphenIds
                      : slug === 'stochastik'
                        ? stichworteFuerStochastikIds
                        : slug === 'binomische-formeln'
                          ? stichworteFuerBfIds
                          : slug === 'lineare-funktionen'
                            ? stichworteFuerLfIds
                            : stichworteFuerAlgIds;
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'));
      let sel = new Set<string>();
      try {
        const raw = JSON.parse(sessionStorage.getItem(storKey) || 'null');
        if (Array.isArray(raw) && raw.length > 0 && typeof raw[0] === 'string' && raw[0].startsWith(idPrefix)) {
          sel = new Set(stichworteFuerIds(raw));
        } else if (Array.isArray(raw)) {
          sel = new Set(raw.filter((x: unknown) => typeof x === 'string') as string[]);
        }
      } catch {
        sel = new Set();
      }
      const all = new Set(buttons.map((b) => b.dataset.stichwort ?? '').filter(Boolean));
      sel = new Set([...sel].filter((k) => all.has(k)));
      buttons.forEach((b) => {
        const k = b.dataset.stichwort ?? '';
        const on = sel.has(k);
        b.classList.toggle('mu-wb-thema-kw--an', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    function persistWbThemaKw(
      root: HTMLElement,
      slug:
        | 'bruchrechnung'
        | 'dezimalzahlen'
        | 'negative-zahlen'
        | 'algebra'
        | 'lineare-gleichungen'
        | 'bruch-dezimal-prozent'
        | 'prozentrechnung'
        | 'graphen'
        | 'stochastik'
        | 'binomische-formeln'
        | 'lineare-funktionen'
    ) {
      const storKey =
        slug === 'bruchrechnung'
          ? BRUCH_WB_STOR_KEY
          : slug === 'dezimalzahlen'
            ? DZ_WB_STOR_KEY
            : slug === 'negative-zahlen'
              ? NZ_WB_STOR_KEY
              : slug === 'lineare-gleichungen'
                ? LG_WB_STOR_KEY
                : slug === 'bruch-dezimal-prozent'
                  ? BDP_KW_WB_STOR_KEY
                  : slug === 'prozentrechnung'
                    ? PR_WB_STOR_KEY
                    : slug === 'graphen'
                      ? GRAPHEN_WB_STOR_KEY
                      : slug === 'stochastik'
                        ? STOCHASTIK_WB_STOR_KEY
                        : slug === 'binomische-formeln'
                          ? BF_WB_STOR_KEY
                          : slug === 'lineare-funktionen'
                            ? LF_WB_STOR_KEY
                            : ALG_WB_STOR_KEY;
      const sel = Array.from(root.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw.mu-wb-thema-kw--an'))
        .map((b) => b.dataset.stichwort ?? '')
        .filter(Boolean);
      try {
        sessionStorage.setItem(storKey, JSON.stringify(sel));
      } catch {
        /* sessionStorage blockiert */
      }
    }

    function bootWbThemaKeywords() {
      wbThemaKwAbort?.abort();
      wbThemaKwAbort = new AbortController();
      const { signal } = wbThemaKwAbort;
      const bruchRoot = document.getElementById('thema-bruchrechnung');
      if (bruchRoot) applyWbThemaKwVisual(bruchRoot, 'bruchrechnung');
      const dzRoot = document.getElementById('thema-dezimalzahlen');
      if (dzRoot) applyWbThemaKwVisual(dzRoot, 'dezimalzahlen');
      const nzRoot = document.getElementById('thema-negative-zahlen');
      if (nzRoot) applyWbThemaKwVisual(nzRoot, 'negative-zahlen');
      const algRoot = document.getElementById('thema-algebra');
      if (algRoot) applyWbThemaKwVisual(algRoot, 'algebra');
      const lgRoot = document.getElementById('thema-lineare-gleichungen');
      if (lgRoot) applyWbThemaKwVisual(lgRoot, 'lineare-gleichungen');
      const bdpRoot = document.getElementById('thema-bruch-dezimal-prozent');
      if (bdpRoot) applyWbThemaKwVisual(bdpRoot, 'bruch-dezimal-prozent');
      const prRoot = document.getElementById('thema-prozentrechnung');
      if (prRoot) applyWbThemaKwVisual(prRoot, 'prozentrechnung');
      const pgRoot = document.getElementById('thema-graphen');
      if (pgRoot) applyWbThemaKwVisual(pgRoot, 'graphen');
      const stRoot = document.getElementById('thema-stochastik');
      if (stRoot) applyWbThemaKwVisual(stRoot, 'stochastik');
      const bfRoot = document.getElementById('thema-binomische-formeln');
      if (bfRoot) applyWbThemaKwVisual(bfRoot, 'binomische-formeln');
      const lfRoot = document.getElementById('thema-lineare-funktionen');
      if (lfRoot) applyWbThemaKwVisual(lfRoot, 'lineare-funktionen');
      document.addEventListener(
        'click',
        (ev: MouseEvent) => {
          const rootEl = (ev.target as HTMLElement | null)?.closest?.('.mu-wb-unterthemen-root');
          if (!rootEl || !rootEl.id.startsWith('thema-')) return;
          const s = rootEl.id.replace(/^thema-/, '');
          if (
            s !== 'bruchrechnung' &&
            s !== 'dezimalzahlen' &&
            s !== 'negative-zahlen' &&
            s !== 'algebra' &&
            s !== 'lineare-gleichungen' &&
            s !== 'bruch-dezimal-prozent' &&
            s !== 'prozentrechnung' &&
            s !== 'graphen' &&
            s !== 'stochastik' &&
            s !== 'binomische-formeln' &&
            s !== 'lineare-funktionen'
          )
            return;
          const bulk = (ev.target as HTMLElement | null)?.closest?.('[data-mu-wb-kw-bulk]') as HTMLButtonElement | null;
          if (bulk && rootEl.contains(bulk)) {
            ev.preventDefault();
            const action = bulk.getAttribute('data-mu-wb-kw-bulk');
            const setKw = (buttons: Iterable<HTMLButtonElement>, on: boolean) => {
              for (const btn of buttons) {
                btn.classList.toggle('mu-wb-thema-kw--an', on);
                btn.setAttribute('aria-pressed', on ? 'true' : 'false');
              }
            };
            if (action === 'all-select') {
              setKw(rootEl.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'), true);
            } else if (action === 'all-clear') {
              setKw(rootEl.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'), false);
            } else if (action === 'cluster-select' || action === 'cluster-clear') {
              const cluster = bulk.closest('.mu-wb-kw-cluster');
              if (!cluster || !rootEl.contains(cluster)) return;
              setKw(cluster.querySelectorAll<HTMLButtonElement>('.mu-wb-thema-kw'), action === 'cluster-select');
            }
            persistWbThemaKw(
              rootEl,
              s as 'bruchrechnung' | 'dezimalzahlen' | 'negative-zahlen' | 'algebra' | 'lineare-gleichungen' | 'bruch-dezimal-prozent' | 'prozentrechnung' | 'graphen' | 'stochastik' | 'binomische-formeln' | 'lineare-funktionen'
            );
            return;
          }
          const t = (ev.target as HTMLElement | null)?.closest?.('button.mu-wb-thema-kw');
          if (!t || !rootEl.contains(t)) return;
          ev.preventDefault();
          t.classList.toggle('mu-wb-thema-kw--an');
          t.setAttribute('aria-pressed', t.classList.contains('mu-wb-thema-kw--an') ? 'true' : 'false');
          persistWbThemaKw(
            rootEl,
            s as 'bruchrechnung' | 'dezimalzahlen' | 'negative-zahlen' | 'algebra' | 'lineare-gleichungen' | 'bruch-dezimal-prozent' | 'prozentrechnung' | 'graphen' | 'stochastik' | 'binomische-formeln' | 'lineare-funktionen'
          );
        },
        { signal }
      );
    }

    function bootCollapsibleTopics() {
      document.querySelectorAll('article.mu-dark-glass-panel').forEach((article) => {
        const header = article.querySelector('.mu-topic-header');
        if (!header || header.dataset.muCollapseBound === '1') return;
        header.dataset.muCollapseBound = '1';

        header.addEventListener('click', (ev: Event) => {
          if ((ev.target as HTMLElement).closest('a') || (ev.target as HTMLElement).closest('button:not(.mu-topic-chevron-btn)')) return;
          article.classList.toggle('mu-topic-collapsed');
        });
      });

      const btnExpandAll = document.getElementById('mu-btn-expand-all');
      if (btnExpandAll && btnExpandAll.dataset.muBound !== '1') {
        btnExpandAll.dataset.muBound = '1';
        btnExpandAll.addEventListener('click', () => {
          document.querySelectorAll('article.mu-dark-glass-panel').forEach((article) => {
            article.classList.remove('mu-topic-collapsed');
          });
        });
      }

      const btnCollapseAll = document.getElementById('mu-btn-collapse-all');
      if (btnCollapseAll && btnCollapseAll.dataset.muBound !== '1') {
        btnCollapseAll.dataset.muBound = '1';
        btnCollapseAll.addEventListener('click', () => {
          document.querySelectorAll('article.mu-dark-glass-panel').forEach((article) => {
            article.classList.add('mu-topic-collapsed');
          });
        });
      }

      function handleHash() {
        const hash = window.location.hash;
        if (!hash) return;
        const targetId = hash.replace(/^#/, '');
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;
        const article = targetEl.closest('article.mu-dark-glass-panel');
        if (article) {
          article.classList.remove('mu-topic-collapsed');
        }
      }

      document.addEventListener('click', (ev: MouseEvent) => {
        const link = (ev.target as HTMLElement).closest('a');
        if (link && link.hash) {
          const targetId = link.hash.replace(/^#/, '');
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            const article = targetEl.closest('article.mu-dark-glass-panel');
            if (article) {
              article.classList.remove('mu-topic-collapsed');
            }
          }
        }
      });

      handleHash();
      window.addEventListener('hashchange', handleHash);
    }

    function openAccordionFromHash() {
      try {
        const hash = window.location.hash;
        if (!hash) return;
        const targetId = hash.replace(/^#/, '');
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;
        const acc = targetEl.querySelector('details.mu-wb-unterthemen-acc');
        if (acc instanceof HTMLDetailsElement) {
          acc.open = true;
          requestAnimationFrame(() => {
            targetEl.scrollIntoView({ behavior: 'auto', block: 'start' });
          });
        }
      } catch (err) {
        console.warn('[Themen] Fehler beim Oeffnen des Akkordeons aus Hash:', err);
      }
    }

    function scheduleWbThemaBoot() {
      requestAnimationFrame(() => {
        bootFehlvorstellungenAccordion();
        bootCollapsibleTopics();
        wbThemaKwAbort?.abort();
        bootWbThemaStripe('bruchrechnung');
        bootWbThemaStripe('dezimalzahlen');
        bootWbThemaStripe('negative-zahlen');
        bootWbThemaStripe('algebra');
        bootWbThemaStripe('bruch-dezimal-prozent');
        bootWbThemaStripe('lineare-gleichungen');
        bootWbThemaStripe('prozentrechnung');
        bootWbThemaStripe('graphen');
        bootWbThemaStripe('stochastik');
        bootWbThemaStripe('binomische-formeln');
        bootWbThemaStripe('lineare-funktionen');
        bootWbThemaKeywords();
        openAccordionFromHash();
      });
    }

    scheduleWbThemaBoot();
    document.addEventListener('astro:page-load', scheduleWbThemaBoot);
  </script>
</BaseLayout>
