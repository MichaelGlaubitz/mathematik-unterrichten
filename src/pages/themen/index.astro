                    ? '/uebung/strahlensaetze'
                    : tv.slug === 'kreisgeometrie'
                      ? '/uebung/kreisgeometrie'
                      : tv.slug === 'trigonometrie'
                        ? '/uebung/trigonometrie'
                        : tv.slug === 'quadratische-funktionen'
                          ? '/uebung/quadratische-funktionen'
                          : tv.slug === 'quadratische-gleichungen'
                            ? '/uebung/quadratische-gleichungen'
                            : tv.slug === 'bruchgleichungen'
                              ? '/uebung/bruchgleichungen'
                              : tv.slug === 'bruchrechnung'
                                ? '/uebung/bruchrechnung'
                                : tv.slug === 'bruch-dezimal-prozent'
                                  ? '/uebung/bruch-dezimal-prozent'
                                : tv.slug === 'graphen'
                                  ? '/uebung/graphen'
                                : tv.slug === 'dezimalzahlen'
                                  ? '/uebung/dezimalzahlen'
                                  : tv.slug === 'negative-zahlen'
                                    ? '/uebung/negative-zahlen'
                                    : tv.slug === 'algebra'
                                      ? '/uebung/algebra'
                                      : tv.slug === 'lineare-gleichungen'
                                        ? '/uebung/lineare-gleichungen'
                                        : tv.slug === 'prozentrechnung'
                                          ? '/uebung/prozentrechnung'
                                          : tv.slug === 'stochastik'
                                            ? '/uebung/stochastik'
                                            : tv.slug === 'binomische-formeln'
                                              ? '/uebung/binomische-formeln'
                                              : tv.slug === 'lineare-funktionen'
                                                ? '/uebung/lineare-funktionen'
                                                : tv.slug === 'lineare-gleichungssysteme'
                                                  ? '/uebung/lineare-gleichungssysteme'
                                                  : tv.slug === 'termumformungen'
                                                    ? '/uebung/termumformungen'
                                                    : tv.slug === 'exponentialfunktionen'
                                                      ? '/uebung/exponentialfunktionen'
                                                      : tv.slug === 'logarithmen'
                                                        ? '/uebung/logarithmen'
                                                        : tv.slug === 'wurzelrechnung'
                                                          ? '/uebung/wurzelrechnung'
                                                          : undefined
              }
              generatorUebungLabel={
                tv.slug === 'pythagoras'
                  ? 'WB Pythagoras'
                  : tv.slug === 'strahlensaetze'
                    ? 'WB Strahlensaetze'
                    : tv.slug === 'kreisgeometrie'
                      ? 'WB Kreisgeometrie'
                      : tv.slug === 'trigonometrie'
                        ? 'WB Trigonometrie'
                        : tv.slug === 'quadratische-funktionen'
                          ? 'WB Quadratische Funktionen'
                          : tv.slug === 'quadratische-gleichungen'
                            ? 'WB Quadratische Gleichungen'
                            : tv.slug === 'bruchgleichungen'
                              ? 'WB Bruchgleichungen'
                              : tv.slug === 'bruchrechnung'
                                ? 'WB Bruchrechnung'
                                : tv.slug === 'bruch-dezimal-prozent'
                                  ? 'WB Bruch · Dezimal · Prozent'
                                : tv.slug === 'graphen'
                                  ? 'WB Graphen'
                                : tv.slug === 'dezimalzahlen'
                                  ? 'WB Dezimalzahlen'
                                  : tv.slug === 'negative-zahlen'
                                    ? 'WB Negative Zahlen'
                                    : tv.slug === 'algebra'
                                      ? 'WB Algebra'
                                      : tv.slug === 'lineare-gleichungen'
                                        ? 'WB Lineare Gleichungen'
                                        : tv.slug === 'prozentrechnung'
                                          ? 'WB Prozentrechnung'
                                          : tv.slug === 'stochastik'
                                            ? 'WB Stochastik'
                                            : tv.slug === 'binomische-formeln'
                                              ? 'WB Binomische Formeln'
                                              : tv.slug === 'lineare-funktionen'
                                                ? 'WB Lineare Funktionen'
                                                : tv.slug === 'lineare-gleichungssysteme'
                                                  ? 'WB Lineare Gleichungssysteme'
                                                  : tv.slug === 'termumformungen'
                                                    ? 'WB Termumformungen'
