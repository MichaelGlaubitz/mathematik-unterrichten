---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// --- slugify (gleich wie in index.astro) ---
function slugify(s: string): string {
  return s
    .toLowerCase()
    .replace(/ä/g, 'ae')
    .replace(/ö/g, 'oe')
    .replace(/ü/g, 'ue')
    .replace(/ß/g, 'ss')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

// --- Eine statische Seite pro Thema, das whiteboardAufgaben hat ---
export async function getStaticPaths() {
  const themen = await getCollection('themen', ({ data }) => !data.entwurf);
  return themen
    .filter((t) => (t.data.whiteboardAufgaben ?? []).length > 0)
    .map((t) => {
      const slug = t.data.thema
        .toLowerCase()
        .replace(/ä/g, 'ae')
        .replace(/ö/g, 'oe')
        .replace(/ü/g, 'ue')
        .replace(/ß/g, 'ss')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
      return {
        params: { thema: slug },
        props: { thema: t },
      };
    });
}

const { thema } = Astro.props;
const aufgaben = thema.data.whiteboardAufgaben;
const total = aufgaben.length;
const themaSlug = slugify(thema.data.thema);
---

<BaseLayout
  title={`Whiteboard · ${thema.data.titel}`}
  beschreibung={`Mini-Whiteboard-Aufgaben für ${thema.data.titel} – Klick für Klick: Aufgabe, Lösung, nächste Aufgabe.`}
>
  <div class="container-wide pt-8 pb-16">
    <!-- Kopfzeile -->
    <header class="flex flex-wrap items-center justify-between gap-3 mb-8">
      <div>
        <a
          href={`/themen#thema-${themaSlug}`}
          class="text-sm text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-100"
        >
          ← Zurück zur Themenübersicht
        </a>
        <div class="mt-1 flex items-center gap-2 text-accent-700 dark:text-accent-100">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3.5" y="4.5" width="17" height="11" rx="1.5"></rect>
            <path d="M8 20h8"></path>
            <path d="M12 15.5V20"></path>
            <path d="M7 9h10"></path>
          </svg>
          <span class="text-xs uppercase tracking-wide">{thema.data.klassenstufenAnzeige}</span>
        </div>
        <h1 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 mt-1 dark:text-ink-50">
          {thema.data.titel}
        </h1>
      </div>
      <div class="text-sm text-ink-500 dark:text-ink-400">
        <span class="wb-zaehler" data-total={total}>0 / {total}</span>
      </div>
    </header>

    <!-- Präsentations-Backdrop (hinter dem Fokus-Block, schließt bei Klick) -->
    <div
      id="wb-overlay-backdrop"
      class="fixed inset-0 z-[9998] bg-neutral-900/80 backdrop-blur-sm dark:bg-black/80 print:hidden pointer-events-auto"
      hidden
      aria-hidden="true"
    ></div>

    <!-- Fortschritt, Bühne, Steuerung (normal eingebettet oder als Vollbild-Overlay) -->
    <div
      id="wb-fokus-wrap"
      class="relative"
      role="region"
      aria-label="Mini-Whiteboard"
    >
      <div id="wb-fokus-inner" class="mx-auto flex w-full max-w-5xl flex-col">
        <div
          id="wb-overlay-bar"
          class="mb-4 hidden w-full flex flex-wrap items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white/95 px-4 py-3 text-ink-800 shadow-lg dark:border-ink-600 dark:bg-ink-800/95 dark:text-ink-100 print:hidden pointer-events-auto"
        >
          <span class="text-sm font-semibold">
            Mini-Whiteboard · {thema.data.titel}
            <span class="ml-2 font-normal text-ink-500 dark:text-ink-400">
              (<span class="wb-zaehler" data-total={total}>0 / {total}</span>)
            </span>
          </span>
          <button
            id="wb-overlay-close"
            type="button"
            class="rounded-md border border-ink-300 bg-ink-50 px-3 py-1.5 text-sm font-medium text-ink-800 hover:bg-ink-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 dark:border-ink-500 dark:bg-ink-700 dark:text-ink-50 dark:hover:bg-ink-600"
          >
            Schließen (Esc)
          </button>
        </div>

    <!-- Fortschritts-Punkte -->
    <ol id="wb-punkte" class="flex flex-wrap gap-1.5 mb-10 pointer-events-auto" aria-hidden="true">
      {aufgaben.map((_, i) => (
        <li
          data-index={i}
          class="h-1.5 w-8 rounded-full bg-ink-200 dark:bg-ink-700 transition-colors"
        ></li>
      ))}
    </ol>

    <!-- Buehne -->
    <section
      id="wb-buehne"
      class="wb-buehne-karte rounded-2xl border border-ink-200 bg-white p-8 md:p-14 lg:p-20 min-h-[50vh] flex flex-col items-center justify-center text-center dark:border-ink-700 dark:bg-ink-800/60 pointer-events-auto transition-shadow duration-200"
    >
      <!-- Intro -->
      <div id="wb-intro" class="space-y-4">
        <p class="text-ink-500 dark:text-ink-400 text-sm uppercase tracking-wide">
          {total} {total === 1 ? 'Aufgabe' : 'Aufgaben'} bereit
        </p>
        <p class="font-serif text-3xl md:text-5xl font-semibold text-ink-900 dark:text-ink-50">
          Mini-Whiteboard
        </p>
        <p class="text-ink-600 text-base md:text-lg max-w-xl mx-auto dark:text-ink-300">
          Frage einblenden – Schüler antworten auf dem Whiteboard – Lösung
          aufdecken – nächste Frage. Klick für Klick.
        </p>
      </div>

      <!-- Aufgaben-Schritte (alle ausgeblendet, JS schaltet um) -->
      {aufgaben.map((w, i) => (
        <div
          class="wb-step space-y-8 w-full"
          data-step={i}
          hidden
        >
          <p class="text-ink-500 dark:text-ink-400 text-sm uppercase tracking-wide">
            Aufgabe {i + 1} von {total}
          </p>
          <div class="wb-frage font-serif text-2xl md:text-4xl lg:text-5xl text-ink-900 dark:text-ink-50 leading-tight">
            {w.frage}
          </div>
          {w.abbildungFrage && (
            <div
              class="wb-abbildung mt-6 w-full flex justify-center px-2 [&_svg]:max-h-[min(14rem,45vh)] [&_svg]:w-auto [&_svg]:max-w-full [&_svg]:shrink-0"
              set:html={w.abbildungFrage}
            />
          )}
          <div
            class="wb-loesung mx-auto max-w-3xl rounded-xl border-l-4 border-accent-500 bg-accent-50 p-5 md:p-7 text-left dark:bg-accent-700/20 dark:border-accent-300"
            hidden
          >
            <p class="text-xs uppercase tracking-wide text-accent-700 font-semibold mb-2 dark:text-accent-100">
              Lösung
            </p>
            <div class="font-serif text-xl md:text-3xl text-ink-900 dark:text-ink-50">
              {w.loesung}
            </div>
            {w.abbildungLoesung && (
              <div
                class="wb-abbildung-loesung mt-5 flex justify-center [&_svg]:max-h-[min(12rem,40vh)] [&_svg]:w-auto [&_svg]:max-w-full"
                set:html={w.abbildungLoesung}
              />
            )}
          </div>
        </div>
      ))}

      <!-- Ende -->
      <div id="wb-ende" class="space-y-4" hidden>
        <p class="text-6xl" aria-hidden="true">✓</p>
        <p class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 dark:text-ink-50">
          Geschafft.
        </p>
        <p class="text-ink-600 dark:text-ink-300">
          {total} {total === 1 ? 'Aufgabe' : 'Aufgaben'} durchgegangen.
        </p>
      </div>
    </section>

    <!-- Steuerung -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 pointer-events-auto print:hidden">
      <button
        id="wb-overlay-toggle"
        type="button"
        class="rounded-md border border-accent-600 bg-accent-50 px-4 py-2 text-sm font-semibold text-accent-800 hover:bg-accent-100 dark:border-accent-400 dark:bg-accent-700/25 dark:text-accent-100 dark:hover:bg-accent-700/40"
        title="Vollbild mit abgedunkeltem Hintergrund (Beamer / Tafel)"
      >
        Präsentationsmodus (Vollbild)
      </button>
      <button
        id="wb-prev"
        type="button"
        class="rounded-md border border-ink-300 bg-white px-4 py-2 text-sm text-ink-700 hover:bg-ink-50 dark:border-ink-600 dark:bg-ink-800 dark:text-ink-200 dark:hover:bg-ink-700 disabled:opacity-40 disabled:pointer-events-none"
      >
        ← Zurück
      </button>
      <button
        id="wb-next"
        type="button"
        class="rounded-md bg-accent-600 px-6 py-2.5 text-white font-semibold hover:bg-accent-700 transition dark:bg-accent-500 dark:hover:bg-accent-600 text-lg"
      >
        Start ▶
      </button>
      <button
        id="wb-reset"
        type="button"
        class="rounded-md border border-ink-300 bg-white px-4 py-2 text-sm text-ink-700 hover:bg-ink-50 dark:border-ink-600 dark:bg-ink-800 dark:text-ink-200 dark:hover:bg-ink-700"
        hidden
      >
        Von vorn
      </button>
    </div>

    <p class="mt-6 text-center text-xs text-ink-500 dark:text-ink-400 pointer-events-auto print:hidden">
      Tipp: Mit der <kbd class="px-1.5 py-0.5 bg-ink-100 rounded text-[0.7rem] dark:bg-ink-800">Leertaste</kbd>
      oder <kbd class="px-1.5 py-0.5 bg-ink-100 rounded text-[0.7rem] dark:bg-ink-800">→</kbd> einen Schritt weiter,
      mit <kbd class="px-1.5 py-0.5 bg-ink-100 rounded text-[0.7rem] dark:bg-ink-800">←</kbd> zurück.
      Im Präsentationsmodus schließt <kbd class="px-1.5 py-0.5 bg-ink-100 rounded text-[0.7rem] dark:bg-ink-800">Esc</kbd> das Vollbild.
    </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  html.mu-themen-wb-overlay-open,
  html.mu-themen-wb-overlay-open body {
    overflow: hidden;
    overscroll-behavior: none;
  }
  #wb-overlay-backdrop[hidden] {
    display: none !important;
  }
</style>

<script is:inline define:vars={{ total }}>
  (function () {
    const intro = document.getElementById('wb-intro');
    const ende = document.getElementById('wb-ende');
    const buehne = document.getElementById('wb-buehne');
    const steps = Array.from(document.querySelectorAll('.wb-step'));
    const punkte = Array.from(document.querySelectorAll('#wb-punkte li'));
    const zaehlerEls = () => Array.from(document.querySelectorAll('.wb-zaehler'));
    const btnNext = document.getElementById('wb-next');
    const btnPrev = document.getElementById('wb-prev');
    const btnReset = document.getElementById('wb-reset');
    const backdrop = document.getElementById('wb-overlay-backdrop');
    const fokusWrap = document.getElementById('wb-fokus-wrap');
    const fokusInner = document.getElementById('wb-fokus-inner');
    const overlayBar = document.getElementById('wb-overlay-bar');
    const overlayToggle = document.getElementById('wb-overlay-toggle');
    const overlayClose = document.getElementById('wb-overlay-close');

    let overlayAuf = false;

    function setzeOverlay(aktiv) {
      overlayAuf = !!aktiv;
      if (backdrop) {
        backdrop.hidden = !overlayAuf;
        backdrop.setAttribute('aria-hidden', overlayAuf ? 'false' : 'true');
      }
      if (overlayBar) overlayBar.classList.toggle('hidden', !overlayAuf);
      if (overlayToggle) {
        overlayToggle.textContent = overlayAuf ? 'Vollbild beenden' : 'Präsentationsmodus (Vollbild)';
      }
      if (fokusWrap && fokusInner) {
        if (overlayAuf) {
          fokusWrap.className =
            'fixed inset-0 z-[9999] flex flex-col items-center overflow-y-auto overscroll-y-contain p-4 sm:p-6 pointer-events-none print:hidden';
          fokusInner.classList.add('pointer-events-auto');
          buehne?.classList.add('shadow-2xl', 'dark:shadow-black/50', 'ring-1', 'ring-ink-200/80', 'dark:ring-ink-600/80');
        } else {
          fokusWrap.className = 'relative';
          fokusInner.classList.remove('pointer-events-auto');
          buehne?.classList.remove('shadow-2xl', 'dark:shadow-black/50', 'ring-1', 'ring-ink-200/80', 'dark:ring-ink-600/80');
        }
      }
      document.documentElement.classList.toggle('mu-themen-wb-overlay-open', overlayAuf);
      reRenderMath();
    }

    backdrop?.addEventListener('click', function () {
      if (overlayAuf) setzeOverlay(false);
    });
    overlayToggle?.addEventListener('click', function (e) {
      e.stopPropagation();
      setzeOverlay(!overlayAuf);
    });
    overlayClose?.addEventListener('click', function (e) {
      e.stopPropagation();
      setzeOverlay(false);
    });

    // Phase-Encoding:
    //   -1            -> Intro
    //   2*i           -> Frage i sichtbar (Lösung verdeckt)
    //   2*i + 1       -> Frage i + Lösung sichtbar
    //   2*total       -> Ende
    let phase = -1;

    function render() {
      // Alles verstecken
      intro.hidden = true;
      ende.hidden = true;
      steps.forEach((s) => (s.hidden = true));

      if (phase === -1) {
        intro.hidden = false;
        btnNext.textContent = 'Start ▶';
        btnPrev.disabled = true;
        btnReset.hidden = true;
      } else if (phase >= 2 * total) {
        ende.hidden = false;
        btnNext.textContent = 'Von vorn ↺';
        btnPrev.disabled = false;
        btnReset.hidden = true;
      } else {
        const i = Math.floor(phase / 2);
        const zeigeLoesung = phase % 2 === 1;
        const step = steps[i];
        step.hidden = false;
        const loesung = step.querySelector('.wb-loesung');
        if (loesung) loesung.hidden = !zeigeLoesung;

        btnNext.textContent = zeigeLoesung
          ? i + 1 < total ? 'Nächste Aufgabe →' : 'Abschluss →'
          : 'Lösung zeigen';
        btnPrev.disabled = false;
        btnReset.hidden = false;
      }

      // Zähler und Punkte
      const text =
        phase === -1
          ? `0 / ${total}`
          : phase >= 2 * total
            ? `${total} / ${total}`
            : `${Math.floor(phase / 2) + 1} / ${total}`;
      zaehlerEls().forEach(function (el) {
        el.textContent = text;
      });
      punkte.forEach((p, i) => {
        p.classList.remove('bg-accent-500', 'bg-accent-300');
        if (phase >= 2 * total) {
          p.classList.add('bg-accent-500');
        } else if (phase === -1) {
          // alle grau
        } else {
          const cur = Math.floor(phase / 2);
          if (i < cur) p.classList.add('bg-accent-500');
          else if (i === cur) p.classList.add('bg-accent-300');
        }
      });
    }

    function next() {
      if (phase >= 2 * total) {
        phase = -1; // Von vorn
      } else {
        phase += 1;
      }
      render();
      reRenderMath();
    }

    function prev() {
      if (phase <= -1) return;
      phase -= 1;
      render();
      reRenderMath();
    }

    function reset() {
      phase = -1;
      render();
    }

    function reRenderMath() {
      // KaTeX wendet auf neu sichtbar gewordenen Inhalt erneut an
      if (typeof window.renderMathInElement === 'function') {
        window.renderMathInElement(buehne, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false },
          ],
          ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option'],
          ignoredClasses: ['katex'],
          throwOnError: false,
        });
      }
    }

    btnNext.addEventListener('click', next);
    btnPrev.addEventListener('click', prev);
    btnReset.addEventListener('click', reset);

    // Tastatur
    document.addEventListener('keydown', function (e) {
      if (e.target && /input|textarea|select/i.test(e.target.tagName)) return;
      if (e.key === 'Escape' && overlayAuf) {
        e.preventDefault();
        setzeOverlay(false);
        return;
      }
      if (e.key === ' ' || e.key === 'ArrowRight' || e.key === 'Enter') {
        e.preventDefault();
        next();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev();
      }
    });

    render();
  })();
</script>
