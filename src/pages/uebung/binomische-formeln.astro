---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MassenuebungGeo from '../../components/MassenuebungGeo.astro';
import { uebungsgenerator } from '../../lib/uebungsgeneratoren';

const generator = uebungsgenerator('binomische-formeln');
---

<BaseLayout sourceFile="src/pages/uebung/binomische-formeln.astro"
  githubEditPath="src/components/MassenuebungGeo.astro"
  title={generator.titel}
  beschreibung={generator.beschreibung}
>
  <MassenuebungGeo
    variant="binomische-formeln"
    backHref="/themen#thema-binomische-formeln"
    h1={generator.titel}
  />
</BaseLayout>
