---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MassenuebungGeo from '../../components/MassenuebungGeo.astro';

const themaBruch = await getEntry('themen', 'bruchrechnung');
const bruchAbUnterthemen = themaBruch?.data.unterthemenBloecke?.map((b) => b.titel) ?? [];
---

<BaseLayout sourceFile="src/pages/uebung/bruchrechnung.astro"
  githubEditPath="src/components/MassenuebungGeo.astro"
  title="WB Bruchrechnung"
  beschreibung="Zufallsgenerierte Aufgaben zur Bruchrechnung: Grundrechenarten (gleich- und ungleichnamig, Multiplikation, Division), Brüche mit ganzen Zahlen, Umgang mit Brüchen (u. a. gleichwertig, Ergänzen auf 1, gemischt/unecht, Vergleich) und einfache Sachaufgaben zu Bruchteilen – optional mit Streifen- und Rastergrafiken, Whiteboard oder Arbeitsblatt."
>
  <MassenuebungGeo
    variant="bruchrechnung"
    backHref="/themen#thema-bruchrechnung"
    h1="WB Bruchrechnung"
    bruchAbUnterthemen={bruchAbUnterthemen}
  />
</BaseLayout>
