import { uebungsgenerator } from '../../lib/uebungsgeneratoren';

const generator = uebungsgenerator('bruch-dezimal-prozent');
---

<BaseLayout sourceFile="src/pages/uebung/bruch-dezimal-prozent.astro"
  githubEditPath="src/components/MassenuebungGeo.astro"
  title={generator.titel}
  beschreibung={generator.beschreibung}
>
  <MassenuebungGeo
    variant="bruch-dezimal-prozent"
    backHref="/themen#thema-bruch-dezimal-prozent"
    h1={generator.titel}
  />
</BaseLayout>
