---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BruchDezimalProzentUebung from '../../components/BruchDezimalProzentUebung.astro';
---

<BaseLayout
  sourceFile="src/pages/uebung/bruch-dezimal-prozent.astro"
  githubEditPath="src/components/BruchDezimalProzentUebung.astro"
  title="Brüche, Dezimalzahlen, Prozent"
  beschreibung="Interaktive Übung: Umwandlung zwischen Brüchen, Dezimalzahlen und Prozentangaben – mit Kartenwahl, Raster und Lösungsblick."
>
  <div class="container-wide pt-8 print:hidden">
    <a
      href="/themen#thema-dezimalzahlen"
      class="text-sm text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-100"
    >
      ← Zurück zur Themenübersicht
    </a>
    <p class="mt-2 text-xs uppercase tracking-wide text-accent-700 dark:text-accent-100">
      Übungsgenerator · Klasse 5–7 · Umwandlung
    </p>
    <h1 class="mt-1 font-serif text-4xl font-semibold text-ink-900 dark:text-ink-50 md:text-5xl">
      Brüche · Dezimalzahlen · Prozent
    </h1>
    <p class="mt-3 max-w-3xl text-ink-700 dark:text-ink-200">
      Darstellung angelehnt an gängige Übungs-Oberflächen: drei Kartenblöcke für die drei Bezugspaare, darunter ein
      Aufgabenraster mit Eingabefeldern und Lösungsauge. Passend zu{' '}
      <a class="text-accent-700 underline underline-offset-2 hover:text-accent-800 dark:text-accent-100" href="/uebung/bruchrechnung">WB Bruchrechnung</a>,{' '}
      <a class="text-accent-700 underline underline-offset-2 hover:text-accent-800 dark:text-accent-100" href="/uebung/dezimalzahlen">WB Dezimalzahlen</a> und{' '}
      <a class="text-accent-700 underline underline-offset-2 hover:text-accent-800 dark:text-accent-100" href="/uebung/prozentrechnung">WB Prozentrechnung</a>.
    </p>
  </div>

  <BruchDezimalProzentUebung />
</BaseLayout>
