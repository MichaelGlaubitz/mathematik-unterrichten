---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MassenuebungGeo from '../../components/MassenuebungGeo.astro';
import { uebungsgenerator } from '../../lib/uebungsgeneratoren';

const generator = uebungsgenerator('exponentialfunktionen');
---

<BaseLayout sourceFile="src/pages/uebung/exponentialfunktionen.astro"
  githubEditPath="src/components/MassenuebungGeo.astro"
  title={generator.titel}
  beschreibung={generator.beschreibung}
>
  <MassenuebungGeo
    variant="exponentialfunktionen"
    backHref="/themen#thema-exponentialfunktionen"
    h1={generator.titel}
  />
</BaseLayout>
