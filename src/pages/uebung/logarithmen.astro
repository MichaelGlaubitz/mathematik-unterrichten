---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MassenuebungGeo from '../../components/MassenuebungGeo.astro';
import { uebungsgenerator } from '../../lib/uebungsgeneratoren';

const generator = uebungsgenerator('logarithmen');
---

<BaseLayout sourceFile="src/pages/uebung/logarithmen.astro"
  githubEditPath="src/components/MassenuebungGeo.astro"
  title={generator.titel}
  beschreibung={generator.beschreibung}
>
  <MassenuebungGeo
    variant="logarithmen"
    backHref="/themen#thema-logarithmen"
    h1={generator.titel}
  />
</BaseLayout>
