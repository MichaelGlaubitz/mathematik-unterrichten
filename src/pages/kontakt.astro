---
import BaseLayout from '../layouts/BaseLayout.astro';

// Web3Forms-Konfiguration:
// 1. Auf https://web3forms.com einen Access-Key holen (kostenlos, nur E-Mail nötig).
// 2. Den Key entweder hier direkt eintragen, oder besser als Umgebungsvariable
//    in deinem Hoster (Cloudflare Pages, Netlify, Vercel) als WEB3FORMS_KEY setzen.
const accessKey = import.meta.env.WEB3FORMS_KEY ?? 'DEIN-WEB3FORMS-ACCESS-KEY';
---

<BaseLayout
  title="Kontakt"
  beschreibung="Kontaktformular für Anfragen, Anregungen und Rückmeldungen zu mathematik-unterrichten.de"
>
  <article class="container-prose py-12">
    <h1 class="font-serif text-4xl font-semibold text-ink-900 mb-3">Kontakt</h1>
    <p class="text-ink-700 text-lg leading-relaxed mb-8">
      Anregungen, Materialwünsche, Hinweise auf Fehler – schreib mir gern über
      das Formular. Du bekommst eine Antwort, sobald ich Zeit habe (kein
      Versprechen auf 24-Stunden-Reaktion: das hier ist ein Privatprojekt).
    </p>

    <form
      id="kontakt-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="not-prose space-y-5 bg-white border border-ink-200 rounded-lg p-6 shadow-sm"
    >
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="Neue Nachricht über mathematik-unterrichten.de" />
      <input type="hidden" name="from_name" value="mathematik-unterrichten.de" />
      <input type="hidden" name="redirect" value="false" />

      {/* Honeypot gegen Spam-Bots: echte Menschen lassen das Feld leer. */}
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="name" class="block text-sm font-medium text-ink-800 mb-1">
          Name <span class="text-rose-600" aria-hidden="true">*</span>
        </label>
        <input
          type="text" id="name" name="name" required
          autocomplete="name"
          class="w-full rounded-md border border-ink-300 px-3 py-2 text-ink-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500 focus:outline-none"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-ink-800 mb-1">
          E-Mail <span class="text-rose-600" aria-hidden="true">*</span>
        </label>
        <input
          type="email" id="email" name="email" required
          autocomplete="email"
          class="w-full rounded-md border border-ink-300 px-3 py-2 text-ink-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500 focus:outline-none"
        />
      </div>

      <div>
        <label for="thema" class="block text-sm font-medium text-ink-800 mb-1">Thema</label>
        <select
          id="thema" name="thema"
          class="w-full rounded-md border border-ink-300 px-3 py-2 text-ink-900 bg-white focus:border-accent-500 focus:ring-2 focus:ring-accent-500 focus:outline-none"
        >
          <option value="Allgemein">Allgemeine Frage / Anregung</option>
          <option value="Materialwunsch">Materialwunsch</option>
          <option value="Fehler">Hinweis auf einen Fehler</option>
          <option value="Kooperation">Kooperation / Gastbeitrag</option>
          <option value="Sonstiges">Sonstiges</option>
        </select>
      </div>

      <div>
        <label for="nachricht" class="block text-sm font-medium text-ink-800 mb-1">
          Nachricht <span class="text-rose-600" aria-hidden="true">*</span>
        </label>
        <textarea
          id="nachricht" name="nachricht" rows="6" required
          class="w-full rounded-md border border-ink-300 px-3 py-2 text-ink-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500 focus:outline-none resize-y"
        ></textarea>
      </div>

      <div class="flex items-start gap-2">
        <input
          type="checkbox" id="datenschutz" name="datenschutz" required
          class="mt-1 h-4 w-4 rounded border-ink-300 text-accent-600 focus:ring-accent-500"
        />
        <label for="datenschutz" class="text-sm text-ink-700">
          Ich habe die <a href="/datenschutz" class="text-accent-700 underline">Datenschutzerklärung</a>
          gelesen und bin damit einverstanden, dass meine Angaben zur
          Bearbeitung der Anfrage verarbeitet werden. <span class="text-rose-600">*</span>
        </label>
      </div>

      <div class="flex items-center justify-between gap-4 pt-2">
        <p id="kontakt-status" class="text-sm" role="status" aria-live="polite"></p>
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-md bg-accent-600 px-5 py-2.5 text-white font-medium hover:bg-accent-700 disabled:opacity-50"
        >
          Absenden
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </form>

    <section class="mt-10 prose prose-ink max-w-none">
      <h2>Was passiert mit deinen Angaben?</h2>
      <p>
        Das Formular wird von <a href="https://web3forms.com" rel="external">Web3Forms</a>
        verarbeitet. Deine Nachricht landet als E-Mail in meinem Postfach. Sie wird nicht
        zu Werbezwecken genutzt und nicht an Dritte weitergegeben. Mehr in der
        <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
    </section>
  </article>
</BaseLayout>

<script>
  const form = document.getElementById('kontakt-form') as HTMLFormElement | null;
  const status = document.getElementById('kontakt-status');
  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Sende …';
      status.className = 'text-sm text-ink-600';
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      const formData = new FormData(form);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();
        if (result.success) {
          status.textContent = '✓ Vielen Dank, deine Nachricht ist angekommen.';
          status.className = 'text-sm text-emerald-700 font-medium';
          form.reset();
        } else {
          status.textContent = '✗ ' + (result.message || 'Da ist etwas schiefgelaufen. Bitte versuche es später noch einmal.');
          status.className = 'text-sm text-rose-700 font-medium';
        }
      } catch (err) {
        status.textContent = '✗ Verbindung fehlgeschlagen. Bitte versuche es später noch einmal.';
        status.className = 'text-sm text-rose-700 font-medium';
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
