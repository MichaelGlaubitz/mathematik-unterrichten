---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { gesetzt } from '../../../lib/formelsatz';
import {
  leseVariationsfolgen,
  SCHRITTE,
  LOESUNG_AB,
  PLENUM,
  TIEFER_BEAT,
  taktSchritte,
  PAAR_ZU_SCHRITT,
  PARTNER_UEBERSCHRIFT,
  SCHRITTE_PLENUM,
  PLENUM_UEBERSCHRIFT,
  TIEFER,
  TIEFER_UEBERSCHRIFT,
} from '../../../lib/variationsfolgen';

export async function getStaticPaths() {
  const aufgaben = await getCollection('aufgaben', ({ data }) => !data.entwurf);
  return aufgaben
    .map((a) => {
      const quelle = fs.readFileSync(
        path.join(process.cwd(), 'src/content/aufgaben', a.id),
        'utf8'
      );
      return { eintrag: a, fund: leseVariationsfolgen(quelle) };
    })
    .filter(({ fund }) => fund.folgen.length > 0)
    .map(({ eintrag, fund }) => ({
      params: { slug: eintrag.slug },
      props: { eintrag, folgen: fund.folgen, uebersprungen: fund.uebersprungen },
    }));
}

const { eintrag, folgen, uebersprungen } = Astro.props;

/* Formelsatz entsteht zur Bauzeit: An der Wand darf kein Dollarzeichen stehen
   und nichts nachladen. Der Bestand liefert die Mathematik in $…$; eine Zelle
   kann daneben gewöhnlichen Text enthalten. */


const folgenGesetzt = folgen.map((f) => ({
  ...f,
  aufgaben: f.aufgaben.map((a) => ({
    ...a,
    frageHtml: gesetzt(a.frage),
    loesungHtml: gesetzt(a.loesung),
    gesuchtHtml: a.gesucht ? gesetzt(a.gesucht) : '',
  })),
}));
const gesamt = folgen.reduce((n, f) => n + f.aufgaben.length, 0);
---

<BaseLayout
  sourceFile="src/pages/aufgaben/[slug]/folge.astro"
  title={`Folge projizieren · ${eintrag.data.titel}`}
  beschreibung={`Die Aufgabenfolge „${eintrag.data.titel}“ Aufgabe für Aufgabe an der Wand – mit Reflect, Expect, Check, Explain.`}
  githubEditPath={`src/content/aufgaben/${eintrag.id}`}
>
  <div class="container-wide pt-8 pb-16">
    <header class="mb-8 mu-folge-kopf">
      <a
        href={`/aufgaben/${eintrag.slug}`}
        class="text-sm text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-100"
      >
        ← Zurück zur Aufgabenfolge
      </a>
      <h1 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 mt-1 dark:text-ink-50">
        {eintrag.data.titel}
      </h1>
      <p class="mu-folge-rolle mt-3 inline-flex flex-wrap items-center gap-2 rounded-md border border-ink-300/90 bg-ink-50/60 px-3 py-1.5 text-sm text-ink-700 dark:border-white/15 dark:bg-white/[0.05] dark:text-ink-200">
        <span class="text-xs font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">Regie · zum Projizieren</span>
        <span>
          {folgen.length} {folgen.length === 1 ? 'Folge' : 'Folgen'} mit {gesamt} Aufgaben.
          Erst allein, dann zu zweit. Die vorherige Aufgabe bleibt mit ihrer Lösung stehen –
          sonst lässt sich nicht vergleichen.
        </span>
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <label class="text-sm text-ink-600 dark:text-ink-300" for="mu-folge-wahl">Folge:</label>
        <select
          id="mu-folge-wahl"
          class="mu-folge-wahl max-w-full min-w-0 flex-1 truncate rounded-md border border-ink-300 bg-surface px-2 py-1 text-sm dark:border-ink-500 dark:bg-slate-800 dark:text-ink-50"
        >
          {folgen.map((f, i) => (
            <option value={i}>{f.titel} ({f.aufgaben.length} Aufgaben)</option>
          ))}
        </select>
        <button
          id="mu-folge-start"
          type="button"
          class="rounded-md bg-accent-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-accent-700 dark:bg-accent-500 dark:hover:bg-accent-600"
        >
          Projizieren
        </button>
      </div>

      <!-- Erst denkt jede und jeder allein. Der Impuls fürs Gespräch zu zweit
           kommt danach – von selbst, damit die Lehrkraft nicht auf die Uhr
           sehen muss. Der Ton ist Beiwerk und standardmäßig aus: Ein
           unerwartetes Geräusch im Klassenzimmer stört mehr, als es hilft. -->
      <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-600 dark:text-ink-300">
        <label class="flex items-center gap-2">
          <span>Impuls „zu zweit" nach</span>
          <select
            id="mu-folge-dauer"
            class="rounded-md border border-ink-300 bg-surface px-2 py-1 dark:border-ink-500 dark:bg-slate-800 dark:text-ink-50"
          >
            <option value="0">sofort</option>
            <option value="30">30 Sekunden</option>
            <option value="45" selected>45 Sekunden</option>
            <option value="60">1 Minute</option>
            <option value="90">1½ Minuten</option>
            <option value="120">2 Minuten</option>
          </select>
        </label>
        <label class="flex items-center gap-2">
          <input id="mu-folge-ton" type="checkbox" class="h-4 w-4 rounded border-ink-400 accent-accent-600" />
          <span>mit Ton</span>
        </label>
        <button
          id="mu-folge-probe"
          type="button"
          class="rounded-md border border-ink-300 px-2.5 py-1 dark:border-ink-500 dark:text-ink-100"
        >
          Ton probieren
        </button>
      </div>
    </header>

    <div id="mu-folge-buehne" class="mu-folge-buehne rounded-xl border border-ink-200 bg-surface p-6 md:p-10 dark:border-slate-600/45 dark:bg-slate-950/40">
      <div class="mu-folge-kopfzeile flex flex-wrap items-baseline justify-between gap-3">
        <p id="mu-folge-abschnitt" class="text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100"></p>
        <p id="mu-folge-stand" class="text-sm font-semibold text-ink-700 dark:text-ink-200"></p>
      </div>

      <!-- Reflect braucht das Vorherige: ohne die Aufgabe davor ist
           „Was hat sich geändert?“ nicht beantwortbar. -->
      <div id="mu-folge-vorher" class="mu-folge-vorher mt-5 rounded-lg border border-ink-300 bg-ink-50 px-5 py-4 dark:border-slate-500 dark:bg-slate-900">
        <p class="mu-folge-etikett text-ink-700 dark:text-ink-200">Aufgabe davor</p>
        <p class="mu-folge-vorher-frage mt-1 text-ink-900 dark:text-ink-50"></p>
        <p class="mu-folge-vorher-loesung mt-1 font-semibold text-accent-800 dark:text-accent-100"></p>
      </div>

      <div id="mu-folge-aufgabe" class="mu-folge-aufgabe mt-8">
        <p class="mu-folge-etikett text-ink-700 dark:text-ink-200">
          Diese Aufgabe <span id="mu-folge-zaehler"></span>
        </p>
        <p id="mu-folge-frage" class="mu-folge-frage mt-2 text-ink-900 dark:text-ink-50"></p>
        <p id="mu-folge-gesucht" class="mu-folge-gesucht mt-1 text-ink-700 dark:text-ink-200" hidden>
          <span class="mu-folge-gesuchtmarke">Gesucht</span>
          <span id="mu-folge-gesuchttext"></span>
        </p>
        <p id="mu-folge-loesung" class="mu-folge-loesung mt-4 font-semibold text-accent-800 dark:text-accent-100" hidden></p>
      </div>

      <!-- Ein fester Platz für den Impuls: Schrittband, Plenum und „tiefer
           bohren" wechseln sich darin ab. Ohne festen Platz verrutscht die
           Aufgabe darüber von Schritt zu Schritt. -->
      <div id="mu-folge-impuls" class="mu-folge-impuls">
      <section id="mu-folge-schritt" class="mu-folge-schrittband mt-8 rounded-xl border-l-8 border-accent-600 bg-accent-50 px-6 py-5 dark:border-accent-400 dark:bg-accent-500/15">
        <p id="mu-folge-marke" class="mu-folge-marke text-accent-800 dark:text-accent-100"></p>
        <p id="mu-folge-auftrag" class="mu-folge-auftrag mt-1 text-ink-900 dark:text-ink-50"></p>
        <p id="mu-folge-punkte" class="mu-folge-punkte mt-3 text-ink-900 dark:text-ink-100"></p>
        <p id="mu-folge-paar" class="mu-folge-paar mt-4 border-t-2 border-violet-400/60 pt-3 text-ink-900 dark:border-violet-400/40 dark:text-ink-100">
          <span class="mu-folge-paarmarke text-violet-700 dark:text-violet-200">Zu zweit</span>
          <span id="mu-folge-paartext"></span>
        </p>
      </section>

      <section
        id="mu-folge-plenum"
        class="mu-folge-plenum mt-6 rounded-xl border-2 border-teal-500/70 bg-teal-50/50 p-5 dark:border-teal-400/40 dark:bg-teal-500/10"
        hidden
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-teal-800 dark:text-teal-200">
          {PLENUM_UEBERSCHRIFT}
        </p>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Kein Check mehr – geprüft ist geprüft. Hier geht es um den Zusammenhang.
        </p>
        <ol class="mt-4 space-y-2">
          {SCHRITTE_PLENUM.map((s) => (
            <li class="rounded-lg border border-teal-300/70 bg-surface/70 p-3 dark:border-teal-400/30 dark:bg-slate-900/40">
              <p class="text-xs font-semibold uppercase tracking-wide text-teal-800 dark:text-teal-200">{s.marke}</p>
              <ul class="mt-1.5 space-y-0.5 text-sm text-ink-800 dark:text-ink-200">
                {s.punkte.map((p) => <li>– {p}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <section
        id="mu-folge-tiefer"
        class="mu-folge-tiefer mt-6 rounded-xl border-2 border-amber-500/70 bg-amber-50/60 p-5 dark:border-amber-400/40 dark:bg-amber-500/10"
        hidden
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-amber-800 dark:text-amber-200">
          {TIEFER_UEBERSCHRIFT}
        </p>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Nicht mehr zu einer Aufgabe – zur ganzen Folge.
        </p>
        <ul class="mt-4 space-y-2 text-base text-ink-900 dark:text-ink-50">
          {TIEFER.map((p) => (
            <li class="rounded-lg border border-amber-300/70 bg-surface/70 px-3 py-2 dark:border-amber-400/30 dark:bg-slate-900/40">{p}</li>
          ))}
        </ul>
      </section>

      </div>

      <ol id="mu-folge-leiste" class="mu-folge-leiste mt-6 flex flex-wrap gap-2" aria-hidden="true">
        {SCHRITTE.map((s) => (
          <li class="mu-folge-punkt rounded-md border border-ink-400 px-3 py-1 text-sm font-semibold text-ink-700 dark:border-ink-400 dark:text-ink-200">{s.marke}</li>
        ))}
        <li class="mu-folge-punkt mu-folge-punkt--plenum rounded-md border border-teal-600 px-3 py-1 text-sm font-semibold text-teal-800 dark:text-teal-200">Plenum</li>
      </ol>

      <div class="mt-6 flex flex-wrap items-center gap-2 mu-folge-steuerung">
        <button id="mu-folge-zurueck" type="button" class="rounded-md border border-ink-300 px-3 py-1.5 text-sm dark:border-ink-500 dark:text-ink-100">← Zurück</button>
        <button id="mu-folge-weiter" type="button" class="rounded-md bg-accent-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-accent-700 dark:bg-accent-500">Weiter (Leertaste)</button>
        <button id="mu-folge-vollbild" type="button" class="rounded-md border border-ink-300 px-3 py-1.5 text-sm dark:border-ink-500 dark:text-ink-100">Vollbild</button>
        <span id="mu-folge-stand" class="text-sm text-ink-500 dark:text-ink-400"></span>
      </div>
    </div>

    {uebersprungen.length > 0 && (
      <p class="mu-folge-hinweis mt-6 text-sm text-ink-500 dark:text-ink-400">
        Nicht auf der Folie: {uebersprungen.length} Tabellen dieser Aufgabenfolge
        ({uebersprungen.map((u) => u.titel).filter(Boolean).join(', ')}) – {uebersprungen[0].grund}.
        Sie stehen vollständig auf der <a class="underline" href={`/aufgaben/${eintrag.slug}`}>Seite der Aufgabenfolge</a>.
      </p>
    )}
  </div>
</BaseLayout>

<script is:inline define:vars={{ folgen: folgenGesetzt, SCHRITTE, LOESUNG_AB, PLENUM, TIEFER_BEAT, PAAR_ZU_SCHRITT, takte: folgenGesetzt.map((f) => f.aufgaben.map((_, i) => taktSchritte(i, f.aufgaben.length))) }}>
  (function () {
    const wahl = document.getElementById('mu-folge-wahl');
    const buehne = document.getElementById('mu-folge-buehne');
    if (!wahl || !buehne) return;

    /* Im Vollbild darf nichts abgeschnitten werden – und nichts darf springen.
       Beides zusammen geht nur bereichsweise: Jeder Bereich hat seinen festen
       Platz, und nur sein eigener Inhalt wird verkleinert, wenn er dort nicht
       hineinpasst. Würde stattdessen die ganze Folie skaliert, änderte die
       Aufgabe ihre Größe, sobald der Impuls darunter länger wird – von
       Schritt zu Schritt, obwohl sich die Aufgabe gar nicht geändert hat. */
    function huelle(id, groesstens, ausserhalb) {
      const bereich = document.getElementById(id);
      if (!bereich) return null;
      // Zwei Hüllen: `innen` spannt den Bereich auf und richtet aus, `inhalt`
      // behält seine natürliche Höhe. Nur so lässt sich messen, wie groß der
      // Inhalt *wirklich* ist – und nicht bloß, wie groß sein Kasten ist.
      const bleibt = ausserhalb ? [...bereich.querySelectorAll(ausserhalb)] : [];
      const innen = document.createElement('div');
      innen.className = 'mu-folge-innen';
      const inhalt = document.createElement('div');
      inhalt.className = 'mu-folge-inhalt';
      while (bereich.firstChild) inhalt.appendChild(bereich.firstChild);
      innen.appendChild(inhalt);
      bereich.appendChild(innen);
      // Was nicht mitskaliert werden soll, wandert vor die Hülle zurück: Die
      // Zeile „Diese Aufgabe 3 von 6" ist Beschriftung. Mitskaliert schriee
      // sie lauter als die Mathematik, um die es geht.
      for (const el of bleibt) bereich.insertBefore(el, innen);
      return { bereich, innen, inhalt, groesstens, raum: bleibt.length ? innen : bereich };
    }
    /* Wie weit ein Bereich wachsen darf. Die Aufgabe soll ihre Spalte füllen:
       „2/5 + 2/5“ in derselben Größe wie eine dreizeilige Textaufgabe zu
       setzen verschenkt die halbe Wand. Die Regie daneben wächst nicht – sie
       ist Beiwerk und würde sonst lauter als die Mathematik. */
    const bereiche = [
      huelle('mu-folge-vorher', 1.8),
      huelle('mu-folge-aufgabe', 3, '.mu-folge-etikett'),
      huelle('mu-folge-impuls', 1),
    ].filter(Boolean);

    const abschnitt = document.getElementById('mu-folge-abschnitt');
    const vorher = document.getElementById('mu-folge-vorher');
    const vorherFrage = vorher.querySelector('.mu-folge-vorher-frage');
    const vorherLoesung = vorher.querySelector('.mu-folge-vorher-loesung');
    const frage = document.getElementById('mu-folge-frage');
    const loesung = document.getElementById('mu-folge-loesung');
    const gesuchtzeile = document.getElementById('mu-folge-gesucht');
    const gesuchttext = document.getElementById('mu-folge-gesuchttext');
    const zaehler = document.getElementById('mu-folge-zaehler');
    const stand = document.getElementById('mu-folge-stand');
    const marke = document.getElementById('mu-folge-marke');
    const auftrag = document.getElementById('mu-folge-auftrag');
    const punkte = document.getElementById('mu-folge-punkte');
    const schrittband = document.getElementById('mu-folge-schritt');
    const leiste = [...document.querySelectorAll('.mu-folge-punkt')];
    const paarzeile = document.getElementById('mu-folge-paar');
    const paartext = document.getElementById('mu-folge-paartext');
    const dauerWahl = document.getElementById('mu-folge-dauer');
    const tonWahl = document.getElementById('mu-folge-ton');

    /* Einstellungen bleiben auf dem Gerät. Es gibt keinen Server, der sie
       entgegennähme – und für zwei Werte braucht es auch keinen. */
    const SPEICHER = 'mu-folge-impuls';
    try {
      const merk = JSON.parse(localStorage.getItem(SPEICHER) || '{}');
      if (merk.dauer != null) dauerWahl.value = String(merk.dauer);
      if (merk.ton != null) tonWahl.checked = !!merk.ton;
    } catch { /* Kaputter oder gesperrter Speicher: Voreinstellung genügt. */ }
    const merken = () => {
      try {
        localStorage.setItem(SPEICHER, JSON.stringify({ dauer: Number(dauerWahl.value), ton: tonWahl.checked }));
      } catch { /* Speichern ist Komfort, kein Muss. */ }
    };

    /* Der Ton wird gerechnet, nicht geladen: keine Datei, kein Netz, und er
       klingt in jedem Schulnetz. */
    let klang = null;
    function klingeln() {
      try {
        klang = klang || new (window.AudioContext || window.webkitAudioContext)();
        if (klang.state === 'suspended') klang.resume();
        const t0 = klang.currentTime;
        for (const [hz, ab] of [[880, 0], [1320, 0.16]]) {
          const o = klang.createOscillator(), g = klang.createGain();
          o.type = 'sine';
          o.frequency.value = hz;
          g.gain.setValueAtTime(0.0001, t0 + ab);
          g.gain.exponentialRampToValueAtTime(0.22, t0 + ab + 0.02);
          g.gain.exponentialRampToValueAtTime(0.0001, t0 + ab + 0.5);
          o.connect(g); g.connect(klang.destination);
          o.start(t0 + ab); o.stop(t0 + ab + 0.55);
        }
      } catch { /* Ohne Ton läuft die Folie weiter. */ }
    }

    let uhr = null;
    /** Blendet den Partnerimpuls nach der eingestellten Zeit ein. */
    function paarPlanen(impulse) {
      clearTimeout(uhr);
      if (impulse.length === 0) { paarzeile.hidden = true; return; }
      const sekunden = Number(dauerWahl.value);
      if (!sekunden) { paarzeile.hidden = false; return; }
      paarzeile.hidden = true;
      uhr = setTimeout(() => {
        paarzeile.hidden = false;
        if (tonWahl.checked) klingeln();
        // Die Folie ist jetzt höher – im Vollbild muss neu eingepasst werden.
        einpassen();
      }, sekunden * 1000);
    }
    const plenumkarte = document.getElementById('mu-folge-plenum');
    const tieferkarte = document.getElementById('mu-folge-tiefer');

    // Welche Beats eine Aufgabe bekommt, steht in `takte` – berechnet zur
    // Bauzeit von taktSchritte(). Die erste Aufgabe einer Folge bekommt nur
    // Check und die Partnerphase: Sie ist der Bezugspunkt und hat selbst
    // nichts, womit sie sich vergleichen ließe.
    let folge = 0, nr = 0, takt = 0;
    const beats = () => takte[folge][nr];
    const schrittJetzt = () => beats()[takt];

    function zeichne() {
      const f = folgen[folge];
      const a = f.aufgaben[nr];
      const schritt = schrittJetzt();
      const imPlenum = schritt === PLENUM;
      const imTiefer = schritt === TIEFER_BEAT;
      const allein = schritt < PLENUM;

      abschnitt.textContent = f.titel;
      frage.innerHTML = a.frageHtml;
      loesung.innerHTML = a.loesungHtml;
      // Bei „Bruch | Dezimalzahl | Prozent" steht an der Wand nur der Bruch.
      // Ohne diese Zeile wüsste die Klasse nicht, was daraus werden soll.
      gesuchttext.innerHTML = a.gesuchtHtml;
      gesuchtzeile.hidden = !a.gesuchtHtml;
      // Erst bei Explain – siehe LOESUNG_AB. Bei Check wird gerechnet.
      loesung.hidden = schritt < LOESUNG_AB;
      zaehler.textContent = `${nr + 1} von ${f.aufgaben.length}`;

      const davor = nr > 0 ? f.aufgaben[nr - 1] : null;
      vorher.hidden = !davor;
      if (davor) {
        vorherFrage.innerHTML = davor.frageHtml;
        vorherLoesung.innerHTML = davor.loesungHtml;
      }

      // An der Wand steht nur der Schritt, der gerade dran ist.
      schrittband.hidden = !allein;
      if (allein) {
        const s = SCHRITTE[schritt];
        marke.textContent = s.marke;
        auftrag.textContent = s.titel;
        // Fließtext statt Zeile für Zeile: Die Beispiele sind Anregungen,
        // keine Liste zum Abarbeiten – und sie kosten so weniger Höhe.
        punkte.textContent = s.punkte.join('  ·  ');
        punkte.hidden = s.punkte.length === 0;

        // Der Impuls für das Gespräch zu zweit steht bei dem Schritt, zu dem
        // er gehört – nicht in einer eigenen Phase am Ende.
        const paar = PAAR_ZU_SCHRITT[schritt] ?? [];
        paartext.textContent = paar.join('  ·  ');
        paarPlanen(paar);
      } else {
        clearTimeout(uhr);
        paarzeile.hidden = true;
      }
      plenumkarte.hidden = !imPlenum;
      tieferkarte.hidden = !imTiefer;

      leiste.forEach((el, i) => {
        el.classList.toggle('mu-folge-punkt--jetzt', i === schritt);
        // Was diese Aufgabe nicht durchläuft, gehört auch nicht an die Wand.
        el.hidden = !beats().includes(i);
      });
      stand.textContent = imTiefer
        ? `Zum Schluss · ganze Folge`
        : imPlenum ? `Im Plenum · ${nr + 1}/${f.aufgaben.length}`
        : `Erst allein, dann zu zweit · ${nr + 1}/${f.aufgaben.length}`;

      einpassen();
    }

    function weiter(richtung) {
      const f = folgen[folge];
      let n = nr, i = takt + richtung;
      // Über das Ende der Beat-Liste hinaus: zur nächsten Aufgabe, dort von
      // vorn. Vor den Anfang: in den letzten Beat der Aufgabe davor.
      if (i >= takte[folge][n].length) {
        if (n + 1 < f.aufgaben.length) { n = n + 1; i = 0; }
        else i = takte[folge][n].length - 1;
      } else if (i < 0) {
        if (n > 0) { n = n - 1; i = takte[folge][n].length - 1; }
        else i = 0;
      }
      nr = n; takt = i;
      zeichne();
    }

    function einpassen() {
      const imVollbild = document.fullscreenElement === buehne;
      for (const { bereich, inhalt, groesstens, raum } of bereiche) {
        inhalt.style.transform = '';
        if (!imVollbild || bereich.hidden) continue;
        const hFrei = raum.clientHeight;
        const bFrei = raum.clientWidth;
        const hNoetig = inhalt.scrollHeight;
        const bNoetig = inhalt.scrollWidth;
        if (hFrei <= 0 || hNoetig <= 0 || bNoetig <= 0) continue;
        // Zwei Prozent Luft, damit ein Rundungsrest nicht doch abschneidet.
        // Der Faktor hängt nur am Inhalt des Bereichs, und der ist innerhalb
        // einer Aufgabe über alle Schritte gleich – die Aufgabe ändert ihre
        // Größe also nicht, während die Klasse an ihr arbeitet.
        const k = Math.min(groesstens, (hFrei / hNoetig) * 0.98, (bFrei / bNoetig) * 0.98);
        if (Math.abs(k - 1) > 0.005) inhalt.style.transform = `scale(${k})`;
      }
    }

    function einpassenNachLayout() {
      einpassen();
      requestAnimationFrame(() => requestAnimationFrame(einpassen));
    }
    document.addEventListener('fullscreenchange', einpassenNachLayout);
    window.addEventListener('resize', einpassenNachLayout);

    dauerWahl.addEventListener('change', () => { merken(); zeichne(); });
    tonWahl.addEventListener('change', merken);
    document.getElementById('mu-folge-probe').addEventListener('click', klingeln);

    document.getElementById('mu-folge-weiter').addEventListener('click', () => weiter(1));
    document.getElementById('mu-folge-zurueck').addEventListener('click', () => weiter(-1));
    wahl.addEventListener('change', () => { folge = Number(wahl.value); nr = 0; takt = 0; zeichne(); });
    document.getElementById('mu-folge-start').addEventListener('click', () => {
      if (!document.fullscreenElement) buehne.requestFullscreen?.();
    });
    document.getElementById('mu-folge-vollbild').addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else buehne.requestFullscreen?.();
    });
    document.addEventListener('keydown', (e) => {
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '')) return;
      if (e.key === ' ' || e.key === 'ArrowRight') { e.preventDefault(); weiter(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); weiter(-1); }
    });

    zeichne();
  })();
</script>

