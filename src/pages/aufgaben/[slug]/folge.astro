---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  leseVariationsfolgen,
  SCHRITTE,
  SCHRITTE_PARTNER,
  PARTNER_UEBERSCHRIFT,
  SCHRITTE_PLENUM,
  PLENUM_UEBERSCHRIFT,
  TIEFER,
  TIEFER_UEBERSCHRIFT,
} from '../../../lib/variationsfolgen';

export async function getStaticPaths() {
  const aufgaben = await getCollection('aufgaben', ({ data }) => !data.entwurf);
  return aufgaben
    .map((a) => {
      const quelle = fs.readFileSync(
        path.join(process.cwd(), 'src/content/aufgaben', a.id),
        'utf8'
      );
      return { eintrag: a, fund: leseVariationsfolgen(quelle) };
    })
    .filter(({ fund }) => fund.folgen.length > 0)
    .map(({ eintrag, fund }) => ({
      params: { slug: eintrag.slug },
      props: { eintrag, folgen: fund.folgen, uebersprungen: fund.uebersprungen },
    }));
}

const { eintrag, folgen, uebersprungen } = Astro.props;
const gesamt = folgen.reduce((n, f) => n + f.aufgaben.length, 0);
---

<BaseLayout
  sourceFile="src/pages/aufgaben/[slug]/folge.astro"
  title={`Folge projizieren · ${eintrag.data.titel}`}
  beschreibung={`Die Aufgabenfolge „${eintrag.data.titel}" Aufgabe für Aufgabe an der Wand – mit Reflect, Expect, Check, Explain.`}
  githubEditPath={`src/content/aufgaben/${eintrag.id}`}
>
  <div class="container-wide pt-8 pb-16">
    <header class="mb-8 mu-folge-kopf">
      <a
        href={`/aufgaben/${eintrag.slug}`}
        class="text-sm text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-100"
      >
        ← Zurück zur Aufgabenfolge
      </a>
      <h1 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 mt-1 dark:text-ink-50">
        {eintrag.data.titel}
      </h1>
      <p class="mu-folge-rolle mt-3 inline-flex flex-wrap items-center gap-2 rounded-md border border-ink-300/90 bg-ink-50/60 px-3 py-1.5 text-sm text-ink-700 dark:border-white/15 dark:bg-white/[0.05] dark:text-ink-200">
        <span class="text-xs font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">Regie · zum Projizieren</span>
        <span>
          {folgen.length} {folgen.length === 1 ? 'Folge' : 'Folgen'} mit {gesamt} Aufgaben.
          Erst allein, dann zu zweit. Die vorherige Aufgabe bleibt mit ihrer Lösung stehen –
          sonst lässt sich nicht vergleichen.
        </span>
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <label class="text-sm text-ink-600 dark:text-ink-300" for="mu-folge-wahl">Folge:</label>
        <select
          id="mu-folge-wahl"
          class="mu-folge-wahl max-w-full min-w-0 flex-1 truncate rounded-md border border-ink-300 bg-surface px-2 py-1 text-sm dark:border-ink-500 dark:bg-slate-800 dark:text-ink-50"
        >
          {folgen.map((f, i) => (
            <option value={i}>{f.titel} ({f.aufgaben.length} Aufgaben)</option>
          ))}
        </select>
        <button
          id="mu-folge-start"
          type="button"
          class="rounded-md bg-accent-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-accent-700 dark:bg-accent-500 dark:hover:bg-accent-600"
        >
          Projizieren
        </button>
      </div>
    </header>

    <div id="mu-folge-buehne" class="mu-folge-buehne rounded-xl border border-ink-200 bg-surface p-6 md:p-8 dark:border-slate-600/45 dark:bg-slate-950/30">
      <p id="mu-folge-abschnitt" class="text-xs font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100"></p>

      <!-- Reflect braucht das Vorherige. Ohne diesen Block ist die Frage
           „Was hat sich geändert?" nicht beantwortbar. -->
      <div id="mu-folge-vorher" class="mt-4 rounded-lg border border-ink-200/80 bg-ink-50/60 px-4 py-3 dark:border-slate-600/50 dark:bg-slate-900/50">
        <p class="text-[0.7rem] font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">Aufgabe davor</p>
        <p class="mu-folge-vorher-frage mt-1 font-mono text-lg text-ink-800 dark:text-ink-100"></p>
        <p class="mu-folge-vorher-loesung mt-0.5 font-mono text-lg font-semibold text-accent-700 dark:text-accent-100"></p>
      </div>

      <div class="mt-6">
        <p class="text-[0.7rem] font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">
          Diese Aufgabe <span id="mu-folge-zaehler" class="ml-1 font-normal normal-case tracking-normal"></span>
        </p>
        <p id="mu-folge-frage" class="mt-1 font-mono text-3xl md:text-4xl font-semibold text-ink-900 dark:text-ink-50"></p>
        <p id="mu-folge-loesung" class="mt-3 font-mono text-2xl md:text-3xl font-semibold text-accent-700 dark:text-accent-100" hidden></p>
      </div>

      <ol id="mu-folge-schritte" class="mt-8 grid gap-3 md:grid-cols-4">
        {SCHRITTE.map((s, i) => (
          <li
            class="mu-folge-schritt rounded-lg border border-ink-200 p-3 dark:border-slate-600/45"
            data-schritt={i}
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">{s.marke}</p>
            <p class="mt-1 text-sm font-semibold text-ink-900 dark:text-ink-50">{s.titel}</p>
            {s.punkte.length > 0 && (
              <ul class="mt-1.5 space-y-0.5 text-sm text-ink-700 dark:text-ink-300">
                {s.punkte.map((p) => <li>– {p}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>

      <section
        id="mu-folge-partner"
        class="mu-folge-partner mt-6 rounded-xl border-2 border-violet-400/70 bg-violet-50/50 p-5 dark:border-violet-400/40 dark:bg-violet-500/10"
        hidden
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-violet-700 dark:text-violet-200">
          {PARTNER_UEBERSCHRIFT}
        </p>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Eine genügt – wer alle durchgeht, macht aus dem Gespräch ein Formular.
        </p>
        <ol class="mt-4 grid gap-3 md:grid-cols-2">
          {SCHRITTE_PARTNER.map((s) => (
            <li class="rounded-lg border border-violet-300/70 bg-surface/70 p-3 dark:border-violet-400/30 dark:bg-slate-900/40">
              <p class="text-xs font-semibold uppercase tracking-wide text-violet-700 dark:text-violet-200">{s.marke}</p>
              <ul class="mt-1.5 space-y-0.5 text-sm text-ink-800 dark:text-ink-200">
                {s.punkte.map((p) => <li>– {p}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <section
        id="mu-folge-plenum"
        class="mu-folge-plenum mt-6 rounded-xl border-2 border-teal-500/70 bg-teal-50/50 p-5 dark:border-teal-400/40 dark:bg-teal-500/10"
        hidden
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-teal-800 dark:text-teal-200">
          {PLENUM_UEBERSCHRIFT}
        </p>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Kein Check mehr – geprüft ist geprüft. Hier geht es um den Zusammenhang.
        </p>
        <ol class="mt-4 space-y-2">
          {SCHRITTE_PLENUM.map((s) => (
            <li class="rounded-lg border border-teal-300/70 bg-surface/70 p-3 dark:border-teal-400/30 dark:bg-slate-900/40">
              <p class="text-xs font-semibold uppercase tracking-wide text-teal-800 dark:text-teal-200">{s.marke}</p>
              <ul class="mt-1.5 space-y-0.5 text-sm text-ink-800 dark:text-ink-200">
                {s.punkte.map((p) => <li>– {p}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <section
        id="mu-folge-tiefer"
        class="mu-folge-tiefer mt-6 rounded-xl border-2 border-amber-500/70 bg-amber-50/60 p-5 dark:border-amber-400/40 dark:bg-amber-500/10"
        hidden
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-amber-800 dark:text-amber-200">
          {TIEFER_UEBERSCHRIFT}
        </p>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Nicht mehr zu einer Aufgabe – zur ganzen Folge.
        </p>
        <ul class="mt-4 space-y-2 text-base text-ink-900 dark:text-ink-50">
          {TIEFER.map((p) => (
            <li class="rounded-lg border border-amber-300/70 bg-surface/70 px-3 py-2 dark:border-amber-400/30 dark:bg-slate-900/40">{p}</li>
          ))}
        </ul>
      </section>

      <div class="mt-6 flex flex-wrap items-center gap-2 mu-folge-steuerung">
        <button id="mu-folge-zurueck" type="button" class="rounded-md border border-ink-300 px-3 py-1.5 text-sm dark:border-ink-500 dark:text-ink-100">← Zurück</button>
        <button id="mu-folge-weiter" type="button" class="rounded-md bg-accent-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-accent-700 dark:bg-accent-500">Weiter (Leertaste)</button>
        <button id="mu-folge-vollbild" type="button" class="rounded-md border border-ink-300 px-3 py-1.5 text-sm dark:border-ink-500 dark:text-ink-100">Vollbild</button>
        <span id="mu-folge-stand" class="text-sm text-ink-500 dark:text-ink-400"></span>
      </div>
    </div>

    {uebersprungen.length > 0 && (
      <p class="mu-folge-hinweis mt-6 text-sm text-ink-500 dark:text-ink-400">
        Nicht projizierbar sind {uebersprungen.length} Tabellen dieser Aufgabenfolge
        ({uebersprungen.map((u) => u.titel).filter(Boolean).join(', ')}) – dort stehen mehrere
        Spalten nebeneinander, und es ist nicht entscheidbar, was Aufgabe und was Lösung ist.
        Sie stehen vollständig auf der <a class="underline" href={`/aufgaben/${eintrag.slug}`}>Seite der Aufgabenfolge</a>.
      </p>
    )}
  </div>
</BaseLayout>

<script is:inline define:vars={{ folgen }}>
  (function () {
    const wahl = document.getElementById('mu-folge-wahl');
    const buehne = document.getElementById('mu-folge-buehne');
    if (!wahl || !buehne) return;

    const abschnitt = document.getElementById('mu-folge-abschnitt');
    const vorher = document.getElementById('mu-folge-vorher');
    const vorherFrage = vorher.querySelector('.mu-folge-vorher-frage');
    const vorherLoesung = vorher.querySelector('.mu-folge-vorher-loesung');
    const frage = document.getElementById('mu-folge-frage');
    const loesung = document.getElementById('mu-folge-loesung');
    const zaehler = document.getElementById('mu-folge-zaehler');
    const stand = document.getElementById('mu-folge-stand');
    const schritte = [...document.querySelectorAll('.mu-folge-schritt')];

    let folge = 0;
    let nr = 0;      // welche Aufgabe
    // 0..3 = Reflect, Expect, Check, Explain (allein)
    // 4 = zu zweit, 5 = Plenum, 6 = tiefer bohren (nur nach der letzten Aufgabe)
    let schritt = 0;
    const PARTNER = 4, PLENUM = 5, TIEFER_S = 6;
    const partnerkarte = document.getElementById('mu-folge-partner');
    const plenumkarte = document.getElementById('mu-folge-plenum');
    const tieferkarte = document.getElementById('mu-folge-tiefer');

    function zeichne() {
      const f = folgen[folge];
      const a = f.aufgaben[nr];
      abschnitt.textContent = f.titel;
      frage.textContent = a.frage;
      loesung.textContent = a.loesung;
      // Die Lösung erscheint erst beim Check – vorher wäre die Erwartung wertlos.
      loesung.hidden = schritt < 2;
      zaehler.textContent = `(${nr + 1} von ${f.aufgaben.length})`;

      const davor = nr > 0 ? f.aufgaben[nr - 1] : null;
      vorher.hidden = !davor;
      if (davor) {
        vorherFrage.textContent = davor.frage;
        vorherLoesung.textContent = davor.loesung;
      }

      // Ab der Partnerphase steht keiner der vier Einzelschritte mehr im
      // Vordergrund: Erst sucht das Paar aus, dann führt die Lehrkraft.
      const imPartner = schritt === PARTNER;
      const imPlenum = schritt === PLENUM;
      const imTiefer = schritt === TIEFER_S;
      const allein = schritt < PARTNER;
      partnerkarte.hidden = !imPartner;
      plenumkarte.hidden = !imPlenum;
      tieferkarte.hidden = !imTiefer;
      schritte.forEach((el, i) => {
        el.classList.toggle('mu-folge-schritt--jetzt', allein && i === schritt);
        el.classList.toggle('mu-folge-schritt--vorbei', !allein || i < schritt);
      });
      stand.textContent = imTiefer
        ? `Zum Schluss · ganze Folge (${f.aufgaben.length} Aufgaben)`
        : imPlenum
          ? `Im Plenum · Aufgabe ${nr + 1}/${f.aufgaben.length}`
          : imPartner
            ? `Zu zweit · Aufgabe ${nr + 1}/${f.aufgaben.length}`
            : `Allein: ${['Reflect', 'Expect', 'Check', 'Explain'][schritt]} · Aufgabe ${nr + 1}/${f.aufgaben.length}`;
    }

    function weiter(richtung) {
      const f = folgen[folge];
      let s = schritt + richtung;
      let n = nr;
      const letzte = nr === f.aufgaben.length - 1;
      // „Tiefer bohren" fragt nach der ganzen Folge – das geht erst, wenn sie
      // durchlaufen ist. Vorher führt der Weg zur nächsten Aufgabe.
      if (s > PLENUM && !letzte) { s = 0; n = n + 1; }
      else if (s > TIEFER_S) { s = TIEFER_S; }
      // Zurück aus dem ersten Schritt: in die Plenumsphase der Aufgabe davor.
      if (s < 0) { s = PLENUM; n = Math.max(n - 1, 0); }
      // Die erste Aufgabe hat nichts, womit sie sich vergleichen ließe:
      // dort beginnt der Takt bei Expect.
      if (n === 0 && s === 0 && richtung > 0) s = 1;
      schritt = s; nr = n;
      zeichne();
    }

    document.getElementById('mu-folge-weiter').addEventListener('click', () => weiter(1));
    document.getElementById('mu-folge-zurueck').addEventListener('click', () => weiter(-1));
    wahl.addEventListener('change', () => { folge = Number(wahl.value); nr = 0; schritt = 1; zeichne(); });
    document.getElementById('mu-folge-start').addEventListener('click', () => {
      buehne.scrollIntoView({ behavior: 'smooth' });
    });
    document.getElementById('mu-folge-vollbild').addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else buehne.requestFullscreen?.();
    });
    document.addEventListener('keydown', (e) => {
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '')) return;
      if (e.key === ' ' || e.key === 'ArrowRight') { e.preventDefault(); weiter(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); weiter(-1); }
    });

    schritt = 1; // erste Aufgabe: Expect
    zeichne();
  })();
</script>

<style is:global>
  .mu-folge-schritt {
    opacity: 0.45;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }
  .mu-folge-schritt--vorbei { opacity: 0.7; }
  .mu-folge-schritt--jetzt {
    opacity: 1;
    border-color: theme('colors.accent.500');
    background: theme('colors.accent.50 / 45%');
  }
  html.dark .mu-folge-schritt--jetzt {
    background: theme('colors.accent.700 / 20%');
  }
  /* Ein <select> wird so breit wie seine längste Option. Ohne Begrenzung
     schiebt der Folgentitel die ganze Seite zur Seite. */
  .mu-folge-wahl { max-width: 100%; }
  #mu-folge-partner[hidden], #mu-folge-plenum[hidden], #mu-folge-tiefer[hidden] { display: none; }
  #mu-folge-vorher[hidden] { display: none; }
  #mu-folge-loesung[hidden] { display: none; }

  /* Im Vollbild zählt nur, was die Klasse sehen soll. */
  #mu-folge-buehne:fullscreen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4vh 5vw;
    background: theme('colors.white');
  }
  html.dark #mu-folge-buehne:fullscreen { background: rgb(15 23 42); }
  #mu-folge-buehne:fullscreen #mu-folge-frage { font-size: clamp(2.5rem, 7vw, 6rem); }
  #mu-folge-buehne:fullscreen #mu-folge-loesung { font-size: clamp(2rem, 5vw, 4.5rem); }
  #mu-folge-buehne:fullscreen .mu-folge-vorher-frage,
  #mu-folge-buehne:fullscreen .mu-folge-vorher-loesung { font-size: clamp(1.1rem, 2.2vw, 2rem); }
  #mu-folge-buehne:fullscreen .mu-folge-steuerung { opacity: 0.35; }

  @media print {
    .mu-folge-rolle, .mu-folge-steuerung, .mu-folge-hinweis { display: none; }
  }
</style>
