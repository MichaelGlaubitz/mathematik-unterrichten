---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const aufgaben = (await getCollection('aufgaben', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());

const themen = Array.from(new Set(aufgaben.map((a) => a.data.thema))).sort();

/** Eine Ebene: nach Thema gruppiert (alphabetisch), innerhalb des Themas nach Datum – so füllen sich Zeilen auf breiten Screens. */
const aufgabenReihenfolge = themen.flatMap((thema) =>
  aufgaben
    .filter((a) => a.data.thema === thema)
    .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
);
---

<BaseLayout title="Aufgabensammlung" beschreibung="Aufgaben und Aufgabenfolgen mit didaktischem Kommentar">
  <section class="container-wide pt-12 pb-10">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:gap-12 lg:items-start">
      <h1 class="font-serif text-4xl font-semibold text-ink-900 mb-3 dark:text-ink-50 lg:mb-0">
        Aufgabensammlung
      </h1>
      <p class="text-ink-700 text-lg leading-relaxed dark:text-ink-200">
        Aufgabenfolgen mit Lösungswegen und didaktischem Kommentar – orientiert an
        <em>Variation Theory</em>: Aufgaben, in denen sich nur ein Aspekt nach dem
        anderen ändert, damit Schüler das mathematische Muster aktiv erkennen. Nach
        Thema gruppiert; die erste Marke auf jeder Karte nennt das Themenfeld.
      </p>
    </div>
  </section>

  <section class="container-wide pb-16">
    {themen.length > 0 ? (
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {aufgabenReihenfolge.map((a) => (
          <PostCard
            href={`/aufgaben/${a.slug}`}
            titel={a.data.titel}
            teaser={a.data.didaktischerHinweis}
            badges={[a.data.thema, `Kl. ${a.data.klassenstufe.join('/')}`, a.data.schwierigkeit]}
          />
        ))}
      </div>
    ) : (
      <p class="text-ink-600 dark:text-ink-300">
        Noch keine Aufgaben veröffentlicht. Lege eine neue Aufgabenseite unter
        <code class="bg-ink-100 px-1.5 py-0.5 rounded text-sm dark:bg-ink-800">src/content/aufgaben/</code> an.
      </p>
    )}
  </section>
</BaseLayout>
