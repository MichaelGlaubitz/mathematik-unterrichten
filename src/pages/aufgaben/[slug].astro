---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import katex from 'katex';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { leseVariationsfolgen } from '../../lib/variationsfolgen';

export async function getStaticPaths() {
  const aufgaben = await getCollection('aufgaben', ({ data }) => !data.entwurf);
  return aufgaben.map((a) => {
    // Nicht jede Aufgabenfolge lässt sich projizieren: Wo mehrere Spalten
    // nebeneinander stehen, ist nicht entscheidbar, was Aufgabe und was
    // Lösung ist. Ohne Folge darf hier auch kein Link stehen.
    const quelle = fs.readFileSync(path.join(process.cwd(), 'src/content/aufgaben', a.id), 'utf8');
    // Der Ablauf muss jeden Abschnitt nennen, den die Folge hat – auch die,
    // die sich nicht projizieren lassen. Sonst fehlen in der Übersicht genau
    // die Teile, die im Unterricht als Erstes drankommen.
    const abschnitte = [...quelle.matchAll(/^## (Folge [^\n]+)$/gm)].map((m, i, alle) => {
      const start = quelle.indexOf(m[0]);
      const ende = i + 1 < alle.length ? quelle.indexOf(alle[i + 1][0]) : quelle.length;
      const zeilen = quelle.slice(start, ende).split('\n').filter((z) => /^\|\s*\d+\s*\|/.test(z));
      return { titel: m[1], anzahl: zeilen.length };
    });
    return {
      params: { slug: a.slug },
      props: { aufgabe: a, folgen: leseVariationsfolgen(quelle).folgen, abschnitte },
    };
  });
}

const { aufgabe, folgen, abschnitte } = Astro.props;
const hatFolge = folgen.length > 0;

/* Der Kopf steht im Frontmatter und geht deshalb an rehype-katex vorbei.
   Die Formeln darin werden hier zur Bauzeit gesetzt. */
function mitFormeln(text: string): string {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/\$([^$]+)\$/g, (_, f) => katex.renderToString(f, { throwOnError: false }));
}
const { Content } = await aufgabe.render();
---

<BaseLayout sourceFile="src/pages/aufgaben/[slug].astro"
  title={aufgabe.data.titel}
  beschreibung={aufgabe.data.didaktischerHinweis}
  githubEditPath={`src/content/aufgaben/${aufgabe.id}`}
>
  <article class="container-prose py-12">
    <header class="mb-8 pb-6 border-b border-ink-200 dark:border-violet-500/20">
      <p class="text-sm text-accent-700 font-semibold uppercase tracking-wide mb-2 dark:text-accent-100">
        {aufgabe.data.thema} · Klasse {aufgabe.data.klassenstufe.join('/')}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 leading-tight mb-3 dark:text-ink-50">
        {aufgabe.data.titel}
      </h1>
      <div class="flex flex-wrap gap-2 mt-3">
        <span class="badge-accent capitalize">{aufgabe.data.schwierigkeit}</span>
        {aufgabe.data.tags.map((t) => <span class="badge-ink">#{t}</span>)}
      </div>

      <!-- Advance Organizer: Wer die Folge zum ersten Mal öffnet, soll in
           dreißig Sekunden wissen, worauf sie hinausläuft, was von Zeile zu
           Zeile variiert und was er im Unterricht sagt. -->
      <section class="mu-nicht-drucken mt-6 rounded-xl border border-accent-300 bg-accent-50/60 p-5 dark:border-accent-400/40 dark:bg-accent-500/10">
        <p class="text-xs font-semibold uppercase tracking-wide text-accent-800 dark:text-accent-100">
          Für die Lehrkraft · in dreißig Sekunden
        </p>

        {aufgabe.data.ziel && (
          <p class="mt-3 text-lg font-semibold text-ink-900 dark:text-ink-50"><Fragment set:html={mitFormeln(aufgabe.data.ziel)} /></p>
        )}

        {aufgabe.data.variation && (
          <p class="mt-2 text-ink-800 dark:text-ink-100">
            <strong>Was variiert:</strong> <Fragment set:html={mitFormeln(aufgabe.data.variation)} />
          </p>
        )}

        {aufgabe.data.stolperstelle && (
          <p class="mt-2 text-ink-800 dark:text-ink-100">
            <strong>Stolperstelle:</strong> <Fragment set:html={mitFormeln(aufgabe.data.stolperstelle)} />
          </p>
        )}

        {abschnitte.length > 0 && (
          <div class="mt-4">
            <p class="text-sm font-semibold text-ink-900 dark:text-ink-50">Ablauf</p>
            <ol class="mt-1.5 space-y-1 text-sm text-ink-800 dark:text-ink-100">
              <li><strong>1.</strong> Vorbemerkung austeilen oder projizieren – zwei Minuten lesen lassen.</li>
              {abschnitte.map((f, i) => (
                <li>
                  <strong>{i + 2}.</strong> {f.titel} – {f.anzahl} Aufgaben.
                  Je Aufgabe: allein Reflect – Expect – Check – Explain, dann zu zweit, dann im Plenum.
                </li>
              ))}
              <li><strong>{abschnitte.length + 2}.</strong> Reflexionsfragen – schriftlich oder im Gespräch.</li>
            </ol>
          </div>
        )}


        {aufgabe.data.regie.length > 0 && (
          <div class="mt-4">
            <p class="text-sm font-semibold text-ink-900 dark:text-ink-50">Was Sie sagen können</p>
            <ul class="mt-1.5 space-y-1 text-sm text-ink-800 dark:text-ink-100">
              {aufgabe.data.regie.map((r) => <li>„<Fragment set:html={mitFormeln(r)} />"</li>)}
            </ul>
          </div>
        )}
        <p class="mt-4 border-t border-accent-300/60 pt-3 text-sm text-ink-800 dark:border-accent-400/30 dark:text-ink-100">
          Kommentar und Lösungen stehen mit auf dieser Seite – der Teil für die Klasse ist unten
          eigens markiert. Beim Drucken bleibt der Lehrerteil weg.
          <label class="ml-2 inline-flex items-center gap-1.5 whitespace-nowrap">
            <input type="checkbox" id="mu-druck-kommentar" class="h-3.5 w-3.5 rounded border-ink-400 accent-accent-600" />
            Kommentar mitdrucken
          </label>
        </p>
      </section>


      {hatFolge && (
      <a
        href={`/aufgaben/${aufgabe.slug}/folge`}
        class="mu-nicht-drucken mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-accent-200/90 bg-accent-50/50 p-4 transition hover:border-accent-400 dark:border-sky-400/25 dark:bg-sky-400/[0.07] dark:hover:border-sky-400/50"
      >
        <span aria-hidden="true" class="text-lg leading-none">📽️</span>
        <span class="min-w-0 flex-1">
          <span class="block text-xs font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-100">
            Regie · zum Projizieren
          </span>
          <span class="mt-0.5 block text-sm leading-relaxed text-ink-700 dark:text-ink-300">
            Aufgabe für Aufgabe an die Wand, im Takt Reflect – Expect – Check – Explain.
            Die vorherige Aufgabe bleibt mit ihrer Lösung stehen.
          </span>
        </span>
        <span class="link-arrow whitespace-nowrap text-sm">Folge projizieren </span>
      </a>
      )}

      <aside class="mt-4 rounded-lg border-l-4 border-accent-500 bg-accent-50/40 p-4 dark:bg-accent-700/15">
        <p class="text-xs uppercase tracking-wide text-accent-700 font-semibold mb-1 dark:text-accent-100">Didaktischer Hinweis</p>
        <p class="text-ink-800 text-sm leading-relaxed dark:text-ink-100">{aufgabe.data.didaktischerHinweis}</p>
      </aside>
    </header>

    <div class="prose prose-ink prose-mathe max-w-none dark:prose-invert mu-aufgabenfolge">
      <Content />
    </div>

    <footer class="mt-12 pt-6 border-t border-ink-200 flex justify-between text-sm dark:border-violet-500/20">
      <a href="/aufgaben" class="link-arrow">Alle Aufgaben</a>
      <a href="#hauptinhalt" class="text-ink-500 hover:text-accent-700 dark:text-ink-400 dark:hover:text-accent-100">Nach oben ↑</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /*
   * Eine Aufgabenfolge trägt zwei Leser: die Vorbemerkung und die Folgen sind
   * für die Klasse geschrieben, der Kommentar am Ende für die Lehrkraft. Beides
   * stand bisher ununterscheidbar untereinander. Die Abschnitte tragen feste
   * ids aus der Überschrift, daran lassen sich die Zonen markieren.
   */
  .mu-aufgabenfolge :is(#vorbemerkung-für-die-schüler, #reflexionsfragen, #reflexionsfragen-für-die-schüler)::before,
  .mu-aufgabenfolge #didaktischer-kommentar::before {
    content: 'Für die Klasse';
    display: block;
    font-family: theme('fontFamily.sans');
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: theme('colors.teal.700');
    margin-bottom: 0.3rem;
  }
  .mu-aufgabenfolge #didaktischer-kommentar::before {
    content: 'Nur für die Lehrkraft';
    color: theme('colors.accent.700');
  }
  /* Der Kommentar am Ende ist der Lehrerteil – abgesetzt bis zum Seitenende. */
  .mu-aufgabenfolge #didaktischer-kommentar {
    margin-top: 2.5rem;
    padding-top: 1.4rem;
    border-top: 2px solid theme('colors.accent.500 / 45%');
  }
  :global(.dark) .mu-aufgabenfolge :is(#vorbemerkung-für-die-schüler, #reflexionsfragen, #reflexionsfragen-für-die-schüler)::before {
    color: theme('colors.teal.300');
  }
  :global(.dark) .mu-aufgabenfolge #didaktischer-kommentar::before {
    color: theme('colors.accent.100');
  }

  /*
   * Auf Papier ist die Aufgabenfolge das Blatt für die Klasse. Der Lehrerteil
   * bleibt deshalb standardmäßig weg — wer ihn braucht, hakt „Kommentar
   * mitdrucken" an, bevor er druckt.
   */
  @media print {
    .mu-aufgabenfolge:not([data-mu-druck='mit-kommentar']) #didaktischer-kommentar,
    .mu-aufgabenfolge:not([data-mu-druck='mit-kommentar']) #didaktischer-kommentar ~ * {
      display: none !important;
    }
    .mu-aufgabenfolge :is(#vorbemerkung-für-die-schüler, #reflexionsfragen, #reflexionsfragen-für-die-schüler)::before,
    .mu-aufgabenfolge #didaktischer-kommentar::before {
      color: #000 !important;
    }
  }
</style>

<script is:inline>
  // Der Haken entscheidet nur, was auf Papier landet; am Bildschirm bleibt alles stehen.
  (function () {
    const haken = document.getElementById('mu-druck-kommentar');
    const folge = document.querySelector('.mu-aufgabenfolge');
    if (!haken || !folge) return;
    const setzen = () => {
      if (haken.checked) folge.setAttribute('data-mu-druck', 'mit-kommentar');
      else folge.removeAttribute('data-mu-druck');
    };
    haken.addEventListener('change', setzen);
    setzen();
  })();
</script>
