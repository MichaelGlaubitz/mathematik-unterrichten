---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.entwurf);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const datum = new Intl.DateTimeFormat('de-DE', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(post.data.datum);

const aktualisiert = post.data.aktualisiert
  ? new Intl.DateTimeFormat('de-DE', {
      day: 'numeric', month: 'long', year: 'numeric',
    }).format(post.data.aktualisiert)
  : null;
---

<BaseLayout
  title={post.data.title}
  beschreibung={post.data.teaser}
  editPath={`src/content/blog/${post.id}`}
>
  <article class="container-prose py-12">
    <header class="mb-8 pb-6 border-b border-ink-200 dark:border-ink-700">
      <p class="text-sm text-accent-700 font-semibold uppercase tracking-wide mb-2 dark:text-accent-100">
        {post.data.kategorie}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl font-semibold text-ink-900 leading-tight mb-3 dark:text-ink-50">
        {post.data.title}
      </h1>
      {post.data.untertitel && (
        <p class="font-serif text-xl text-ink-600 italic mb-4 dark:text-ink-300">{post.data.untertitel}</p>
      )}
      <p class="text-sm text-ink-600 dark:text-ink-300">
        Von <span class="font-medium text-ink-800 dark:text-ink-100">{post.data.autor}</span> ·
        <time datetime={post.data.datum.toISOString()}>{datum}</time>
        {aktualisiert && <> · aktualisiert am {aktualisiert}</>}
      </p>
      {post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 mt-4">
          {post.data.tags.map((t) => (
            <li class="badge-ink">#{t}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose prose-ink prose-mathe max-w-none dark:prose-invert">
      <Content />
    </div>

    <footer class="mt-12 pt-6 border-t border-ink-200 flex justify-between text-sm dark:border-ink-700">
      <a href="/blog" class="link-arrow">Alle Beiträge</a>
      <a href="#hauptinhalt" class="text-ink-500 hover:text-accent-700 dark:text-ink-400 dark:hover:text-accent-100">Nach oben ↑</a>
    </footer>
  </article>
</BaseLayout>
