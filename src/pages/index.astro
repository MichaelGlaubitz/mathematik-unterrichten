---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const blog = (await getCollection('blog', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const aufgaben = (await getCollection('aufgaben', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const quizzes = (await getCollection('quizzes', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);
---

<BaseLayout sourceFile="src/pages/index.astro" title="mathematik-unterrichten">
  <!-- Hero -->
  <section class="container-wide relative overflow-hidden pt-16 pb-12 md:pt-24 md:pb-20">
    <div class="pointer-events-none absolute -right-16 -top-28 h-80 w-80 rounded-full bg-accent-300/45 blur-3xl dark:bg-sky-500/30" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 top-24 h-72 w-72 rounded-full bg-violet-300/40 blur-3xl dark:bg-fuchsia-600/25" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-0 left-1/3 h-56 w-56 -translate-x-1/2 rounded-full bg-teal-300/35 blur-3xl dark:bg-teal-400/22" aria-hidden="true"></div>
    <div class="relative max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-accent-200/80 bg-surface/65 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent-800 shadow-sm backdrop-blur-sm dark:border-teal-400/35 dark:bg-gradient-to-r dark:from-sky-950/40 dark:to-violet-950/35 dark:text-teal-100 dark:shadow-teal-900/30">
        <span class="h-2 w-2 rounded-full bg-gradient-to-r from-accent-500 to-teal-500 dark:from-sky-400 dark:to-teal-300" aria-hidden="true"></span>
        Mathematik unterrichten · Didaktik · Diagnose
      </p>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.1] text-ink-900 mb-6 mt-5 dark:text-ink-50">
        So geht <span class="bg-gradient-to-r from-accent-600 via-teal-600 to-violet-600 bg-clip-text text-transparent dark:from-sky-300 dark:via-teal-200 dark:to-fuchsia-300">Mathematikunterricht</span>.
      </h1>
      <p class="text-lg md:text-xl text-ink-700 leading-relaxed mb-8 dark:text-ink-200">
        Was die Forschung über das Lernen von Mathematik weiß – und was Sie am
        Montag damit anfangen können.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/themen" class="inline-flex items-center gap-2 rounded-md bg-gradient-to-r from-accent-600 to-accent-500 px-5 py-2.5 font-medium text-white shadow-md shadow-accent-600/25 transition hover:brightness-105 dark:from-sky-500 dark:via-accent-500 dark:to-teal-400 dark:shadow-[0_6px_28px_-4px_rgba(56,189,248,0.45)]">
          Zu den Themen
          <span aria-hidden="true">→</span>
        </a>
        <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-violet-200/90 bg-surface/82 px-5 py-2.5 font-medium text-violet-900 shadow-sm backdrop-blur-sm transition hover:border-violet-300 hover:bg-violet-50 dark:border-fuchsia-400/40 dark:bg-fuchsia-950/25 dark:text-fuchsia-100 dark:shadow-fuchsia-950/25 dark:hover:border-teal-400/50 dark:hover:bg-teal-950/35">
          Zum Blog
        </a>
      </div>
    </div>
  </section>

  <!-- Vier Bereiche -->
  <section class="container-wide pb-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-ink-200/90 bg-gradient-to-br from-white to-amber-50/50 p-6 shadow-sm ring-1 ring-amber-100/70 dark:border-amber-400/25 dark:from-[rgb(26_22_35)/0.93] dark:to-amber-950/35 dark:ring-amber-400/20">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-amber-100/70 text-amber-700 dark:bg-amber-400/10 dark:text-amber-300">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
          </svg>
        </span>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-3 mb-2 dark:text-ink-50">Themen</h2>
        <p class="text-ink-700 text-sm leading-relaxed dark:text-ink-300">
          Didaktische Einordnung pro Thema – mit Aufgabenfolgen, diagnostischen Fragen und Blog-Beiträgen, nach Jahrgangs-Clustern sortiert.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200/90 bg-gradient-to-br from-white to-accent-50/40 p-6 shadow-sm ring-1 ring-accent-100/60 dark:border-sky-500/25 dark:from-[rgb(26_22_35)/0.93] dark:to-sky-950/35 dark:ring-sky-400/25">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-accent-100/70 text-accent-700 dark:bg-sky-400/10 dark:text-sky-300">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
            <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
            <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
          </svg>
        </span>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-3 mb-2 dark:text-ink-50">Aufgabensammlung</h2>
        <p class="text-ink-700 text-sm leading-relaxed dark:text-ink-300">
          Variation-Theory-inspirierte Aufgabenfolgen mit Lösungswegen und didaktischem Kommentar.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200/90 bg-gradient-to-br from-white to-teal-50/50 p-6 shadow-sm ring-1 ring-teal-100/70 dark:border-teal-400/30 dark:from-[rgb(26_22_35)/0.93] dark:to-teal-950/40 dark:ring-teal-400/30">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-teal-100/70 text-teal-700 dark:bg-teal-400/10 dark:text-teal-300">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        </span>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-3 mb-2 dark:text-ink-50">Diagnostische Fragen</h2>
        <p class="text-ink-700 text-sm leading-relaxed dark:text-ink-300">
          Multiple-Choice-Fragen mit gezielten Distraktoren – jeder Fehler hat einen Grund.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200/90 bg-gradient-to-br from-white to-violet-50/45 p-6 shadow-sm ring-1 ring-violet-100/70 dark:border-fuchsia-500/25 dark:from-[rgb(26_22_35)/0.93] dark:to-fuchsia-950/40 dark:ring-fuchsia-400/25">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-violet-100/70 text-violet-700 dark:bg-fuchsia-400/10 dark:text-fuchsia-300">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
          </svg>
        </span>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-3 mb-2 dark:text-ink-50">Didaktik-Blog</h2>
        <p class="text-ink-700 text-sm leading-relaxed dark:text-ink-300">
          Kurze Reflexionen zu Forschung, Methodik und Praxis – aus dem Klassenzimmer für das Klassenzimmer.
        </p>
      </div>
    </div>
  </section>

  <!-- Aktuelles aus dem Blog -->
  {blog.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50">Aus dem Blog</h2>
        <a href="/blog" class="link-arrow text-sm">Alle Beiträge </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {blog.map((post) => (
          <PostCard
            href={`/blog/${post.slug}`}
            titel={post.data.title}
            teaser={post.data.teaser}
            badges={[post.data.kategorie]}
            datum={post.data.datum}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Neue Aufgaben -->
  {aufgaben.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50">Aufgabensammlung</h2>
        <a href="/aufgaben" class="link-arrow text-sm">Alle Aufgaben </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {aufgaben.map((a) => (
          <PostCard
            href={`/aufgaben/${a.slug}`}
            titel={a.data.titel}
            teaser={a.data.didaktischerHinweis}
            badges={[a.data.thema, `Kl. ${a.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Diagnostische Fragen -->
  {quizzes.length > 0 && (
    <section class="container-wide pb-20">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50">Diagnostische Fragen</h2>
        <a href="/quizzes" class="link-arrow text-sm">Alle Quizzes </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {quizzes.map((q) => (
          <PostCard
            href={`/quizzes/${q.id}`}
            titel={q.data.titel}
            teaser={q.data.didaktischerKontext}
            badges={[q.data.thema, `Kl. ${q.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}
  <!-- Wer hier schreibt -->
  <section class="container-wide pb-20">
    <div class="flex flex-col items-start gap-5 rounded-xl border border-ink-200/90 bg-surface/70 p-6 shadow-sm sm:flex-row sm:items-center dark:border-slate-600/45 dark:bg-slate-950/45">
      <img
        src="/michael-glaubitz-avatar.jpg"
        alt="Dr. Michael Glaubitz am Mathematischen Forschungsinstitut Oberwolfach"
        class="h-20 w-20 flex-shrink-0 rounded-full object-cover shadow-md ring-1 ring-ink-200/80 dark:ring-white/10"
        width="400"
        height="400"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="font-serif text-lg font-semibold text-ink-900 dark:text-ink-50">
          Dr. Michael Glaubitz
        </p>
        <p class="mt-1 text-ink-700 dark:text-ink-300">
          Über 30 Jahre Mathematik und Physik – Klassenzimmer, universitäre
          Lehrerausbildung, Studienseminar, Schulleitung.
        </p>
        <a href="/ueber" class="link-arrow mt-2 inline-block text-sm">Über diese Seite </a>
      </div>
    </div>
  </section>
</BaseLayout>
