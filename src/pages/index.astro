---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const blog = (await getCollection('blog', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const aufgaben = (await getCollection('aufgaben', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const quizzes = (await getCollection('quizzes', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);
---

<BaseLayout title="mathematik-unterrichten">
  <!-- Hero -->
  <section class="container-wide relative overflow-hidden pt-16 pb-12 md:pt-24 md:pb-20">
    <div class="pointer-events-none absolute -right-16 -top-28 h-80 w-80 rounded-full bg-accent-300/45 blur-3xl dark:bg-sky-500/30" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 top-24 h-72 w-72 rounded-full bg-violet-300/40 blur-3xl dark:bg-fuchsia-600/25" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-0 left-1/3 h-56 w-56 -translate-x-1/2 rounded-full bg-teal-300/35 blur-3xl dark:bg-teal-400/22" aria-hidden="true"></div>
    <div class="relative max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-accent-200/80 bg-surface/65 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent-800 shadow-sm backdrop-blur-sm dark:border-teal-400/35 dark:bg-gradient-to-r dark:from-sky-950/40 dark:to-violet-950/35 dark:text-teal-100 dark:shadow-teal-900/30">
        <span class="h-2 w-2 rounded-full bg-gradient-to-r from-accent-500 to-teal-500 dark:from-sky-400 dark:to-teal-300" aria-hidden="true"></span>
        Mathematik unterrichten · Didaktik · Diagnose
      </p>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.1] text-ink-900 mb-6 mt-5 dark:text-ink-50">
        Besser unterrichten – mit Aufgaben, die <span class="bg-gradient-to-r from-accent-600 via-teal-600 to-violet-600 bg-clip-text text-transparent dark:from-sky-300 dark:via-teal-200 dark:to-fuchsia-300">Denken sichtbar machen</span>.
      </h1>
      <p class="text-lg md:text-xl text-ink-700 leading-relaxed mb-8 dark:text-ink-200">
        Eine Sammlung von Aufgaben, diagnostischen Fragen und didaktischen Reflexionen
        für alle, die Mathematik nicht nur erklären, sondern <em>Verstehen sichtbar machen</em>
        wollen.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/quizzes" class="inline-flex items-center gap-2 rounded-md bg-gradient-to-r from-accent-600 to-accent-500 px-5 py-2.5 font-medium text-white shadow-md shadow-accent-600/25 transition hover:brightness-105 dark:from-sky-500 dark:via-accent-500 dark:to-teal-400 dark:shadow-[0_6px_28px_-4px_rgba(56,189,248,0.45)]">
          Diagnose-Fragen ausprobieren
          <span aria-hidden="true">→</span>
        </a>
        <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-violet-200/90 bg-surface/82 px-5 py-2.5 font-medium text-violet-900 shadow-sm backdrop-blur-sm transition hover:border-violet-300 hover:bg-violet-50 dark:border-fuchsia-400/40 dark:bg-fuchsia-950/25 dark:text-fuchsia-100 dark:shadow-fuchsia-950/25 dark:hover:border-teal-400/50 dark:hover:bg-teal-950/35">
          Zum Blog
        </a>
      </div>
    </div>
  </section>

  <!-- Drei-Säulen-Erklärung -->
  <section class="container-wide pb-16">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-xl border border-ink-200/90 bg-gradient-to-br from-white to-accent-50/40 p-6 shadow-sm ring-1 ring-accent-100/60 dark:border-sky-500/25 dark:from-ink-800/90 dark:to-sky-950/35 dark:ring-sky-400/25">
        <p class="text-2xl">📚</p>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-2 mb-2 dark:text-ink-50">Aufgabensammlung</h2>
        <p class="text-ink-700 text-sm leading-relaxed dark:text-ink-300">
          Variation-Theory-inspirierte Aufgabenfolgen mit Lösungswegen und didaktischem Kommentar.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200/90 bg-gradient-to-br from-white to-teal-50/50 p-6 shadow-sm ring-1 ring-teal-100/70 dark:border-teal-400/30 dark:from-ink-800/90 dark:to-teal-950/40 dark:ring-teal-400/30">
        <p class="text-2xl">🎯</p>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-2 mb-2 dark:text-ink-50">Diagnose-Fragen</h2>
        <p class="text-ink-700 text-sm leading-relaxed dark:text-ink-300">
          Multiple-Choice-Fragen mit gezielten Distraktoren – jeder Fehler hat einen Grund.
        </p>
      </div>
      <div class="rounded-xl border border-ink-200/90 bg-gradient-to-br from-white to-violet-50/45 p-6 shadow-sm ring-1 ring-violet-100/70 dark:border-fuchsia-500/25 dark:from-ink-800/90 dark:to-fuchsia-950/40 dark:ring-fuchsia-400/25">
        <p class="text-2xl">✍️</p>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-2 mb-2 dark:text-ink-50">Didaktik-Blog</h2>
        <p class="text-ink-700 text-sm leading-relaxed dark:text-ink-300">
          Kurze Reflexionen zu Forschung, Methodik und Praxis – aus dem Klassenzimmer für das Klassenzimmer.
        </p>
      </div>
    </div>
  </section>

  <!-- Aktuelles aus dem Blog -->
  {blog.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50">Aus dem Blog</h2>
        <a href="/blog" class="link-arrow text-sm">Alle Beiträge </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {blog.map((post) => (
          <PostCard
            href={`/blog/${post.slug}`}
            titel={post.data.title}
            teaser={post.data.teaser}
            badges={[post.data.kategorie]}
            datum={post.data.datum}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Neue Aufgaben -->
  {aufgaben.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50">Aufgabensammlung</h2>
        <a href="/aufgaben" class="link-arrow text-sm">Alle Aufgaben </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {aufgaben.map((a) => (
          <PostCard
            href={`/aufgaben/${a.slug}`}
            titel={a.data.titel}
            teaser={a.data.didaktischerHinweis}
            badges={[a.data.thema, `Kl. ${a.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Diagnose-Fragen -->
  {quizzes.length > 0 && (
    <section class="container-wide pb-20">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900 dark:text-ink-50">Diagnose-Fragen</h2>
        <a href="/quizzes" class="link-arrow text-sm">Alle Quizzes </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {quizzes.map((q) => (
          <PostCard
            href={`/quizzes/${q.id}`}
            titel={q.data.titel}
            teaser={q.data.didaktischerKontext}
            badges={[q.data.thema, `Kl. ${q.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
