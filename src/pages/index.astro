---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const blog = (await getCollection('blog', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const aufgaben = (await getCollection('aufgaben', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const quizzes = (await getCollection('quizzes', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);
---

<BaseLayout title="mathematik-unterrichten">
  <!-- Hero -->
  <section class="container-wide pt-16 pb-12 md:pt-24 md:pb-20">
    <div class="max-w-3xl">
      <p class="text-accent-700 font-semibold tracking-wide uppercase text-xs mb-4">
        Mathematik unterrichten · Didaktik · Diagnose
      </p>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.1] text-ink-900 mb-6">
        Besser unterrichten – mit Aufgaben, die Denken sichtbar machen.
      </h1>
      <p class="text-lg md:text-xl text-ink-700 leading-relaxed mb-8">
        Eine Sammlung von Aufgaben, diagnostischen Fragen und didaktischen Reflexionen
        für alle, die Mathematik nicht nur erklären, sondern Verstehen <em>sichtbar machen</em>
        wollen.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/quizzes" class="inline-flex items-center gap-2 rounded-md bg-accent-600 px-5 py-2.5 text-white font-medium hover:bg-accent-700 transition">
          Diagnose-Fragen ausprobieren
          <span aria-hidden="true">→</span>
        </a>
        <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-ink-300 bg-white px-5 py-2.5 text-ink-800 font-medium hover:bg-ink-50 transition">
          Zum Blog
        </a>
      </div>
    </div>
  </section>

  <!-- Drei-Säulen-Erklärung -->
  <section class="container-wide pb-16">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-lg border border-ink-200 bg-white p-6">
        <p class="text-2xl">📚</p>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-2 mb-2">Aufgabensammlung</h2>
        <p class="text-ink-700 text-sm leading-relaxed">
          Variation-Theory-inspirierte Aufgabenfolgen mit Lösungswegen und didaktischem Kommentar.
        </p>
      </div>
      <div class="rounded-lg border border-ink-200 bg-white p-6">
        <p class="text-2xl">🎯</p>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-2 mb-2">Diagnose-Fragen</h2>
        <p class="text-ink-700 text-sm leading-relaxed">
          Multiple-Choice-Fragen mit gezielten Distraktoren – jeder Fehler hat einen Grund.
        </p>
      </div>
      <div class="rounded-lg border border-ink-200 bg-white p-6">
        <p class="text-2xl">✍️</p>
        <h2 class="font-serif text-xl font-semibold text-ink-900 mt-2 mb-2">Didaktik-Blog</h2>
        <p class="text-ink-700 text-sm leading-relaxed">
          Kurze Reflexionen zu Forschung, Methodik und Praxis – aus dem Klassenzimmer für das Klassenzimmer.
        </p>
      </div>
    </div>
  </section>

  <!-- Aktuelles aus dem Blog -->
  {blog.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900">Aus dem Blog</h2>
        <a href="/blog" class="link-arrow text-sm">Alle Beiträge </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {blog.map((post) => (
          <PostCard
            href={`/blog/${post.slug}`}
            titel={post.data.title}
            teaser={post.data.teaser}
            badges={[post.data.kategorie]}
            datum={post.data.datum}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Neue Aufgaben -->
  {aufgaben.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900">Aufgabensammlung</h2>
        <a href="/aufgaben" class="link-arrow text-sm">Alle Aufgaben </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {aufgaben.map((a) => (
          <PostCard
            href={`/aufgaben/${a.slug}`}
            titel={a.data.titel}
            teaser={a.data.didaktischerHinweis}
            badges={[a.data.thema, `Kl. ${a.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Diagnose-Fragen -->
  {quizzes.length > 0 && (
    <section class="container-wide pb-20">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-ink-900">Diagnose-Fragen</h2>
        <a href="/quizzes" class="link-arrow text-sm">Alle Quizzes </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {quizzes.map((q) => (
          <PostCard
            href={`/quizzes/${q.id}`}
            titel={q.data.titel}
            teaser={q.data.didaktischerKontext}
            badges={[q.data.thema, `Kl. ${q.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
