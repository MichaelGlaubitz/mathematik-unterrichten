---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const blog = (await getCollection('blog', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const aufgaben = (await getCollection('aufgaben', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);

const quizzes = (await getCollection('quizzes', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, 3);
---

<BaseLayout title="mathematik-unterrichten">
  <!-- Hero mit Image -->
  <section class="container-wide pt-8 pb-12 md:pt-12 md:pb-20">
    <div class="grid gap-12 md:grid-cols-2 md:items-center mb-12">
      <div>
        <p class="text-violet-700 font-semibold tracking-wide uppercase text-xs mb-4 dark:text-violet-200">
          Mathematik unterrichten · Didaktik · Diagnose
        </p>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.1] text-slate-900 mb-6 dark:text-slate-50">
          Besser unterrichten – mit Aufgaben, die Denken sichtbar machen.
        </h1>
        <p class="text-lg md:text-xl text-slate-700 leading-relaxed mb-8 dark:text-slate-300">
          Eine Sammlung von Aufgaben, diagnostischen Fragen und didaktischen Reflexionen
          für alle, die Mathematik nicht nur erklären, sondern Verstehen <em>sichtbar machen</em>
          wollen.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/quizzes" class="inline-flex items-center gap-2 rounded-md bg-violet-700 px-5 py-2.5 text-white font-medium hover:bg-violet-800 transition dark:bg-violet-600 dark:hover:bg-violet-700">
            Diagnose-Fragen ausprobieren
            <span aria-hidden="true">→</span>
          </a>
          <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-5 py-2.5 text-slate-800 font-medium hover:bg-slate-50 transition dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700">
            Zum Blog
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <div class="relative w-full h-auto overflow-hidden rounded-lg shadow-lg bg-slate-100 dark:bg-slate-800">
          <img
            src="https://d8j0ntlcm91z4.cloudfront.net/user_2vYQMZMFUnui5Q1BoHHHpZCbPKb/hf_20260511_110158_e7bd3ad1-3bfd-4db1-ac1c-f44bb7b7c87f.png"
            alt="Formative Assessment: Schulklasse zeigt Lehrerin Mini-Whiteboards mit der Antwort 24"
            class="w-full h-auto object-cover rounded-lg"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Drei-Säulen-Erklärung -->
  <section class="container-wide pb-16">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-gradient-to-br from-cyan-50 to-slate-50 p-6 dark:border-slate-700 dark:from-slate-800 dark:to-slate-900">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-cyan-500/20 mb-4">
          <span class="text-cyan-600 dark:text-cyan-300 text-xl">≈</span>
        </div>
        <h2 class="font-serif text-xl font-semibold text-slate-900 mt-2 mb-2 dark:text-slate-50">Aufgabensammlung</h2>
        <p class="text-slate-700 text-sm leading-relaxed dark:text-slate-300">
          Variation-Theory-inspirierte Aufgabenfolgen mit Lösungswegen und didaktischem Kommentar.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-gradient-to-br from-violet-50 to-slate-50 p-6 dark:border-slate-700 dark:from-slate-800 dark:to-slate-900">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-violet-500/20 mb-4">
          <span class="text-violet-600 dark:text-violet-300 text-xl">◆</span>
        </div>
        <h2 class="font-serif text-xl font-semibold text-slate-900 mt-2 mb-2 dark:text-slate-50">Diagnose-Fragen</h2>
        <p class="text-slate-700 text-sm leading-relaxed dark:text-slate-300">
          Multiple-Choice-Fragen mit gezielten Distraktoren – jeder Fehler hat einen Grund.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-gradient-to-br from-orange-50 to-slate-50 p-6 dark:border-slate-700 dark:from-slate-800 dark:to-slate-900">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-orange-500/20 mb-4">
          <span class="text-orange-600 dark:text-orange-300 text-xl">→</span>
        </div>
        <h2 class="font-serif text-xl font-semibold text-slate-900 mt-2 mb-2 dark:text-slate-50">Didaktik-Blog</h2>
        <p class="text-slate-700 text-sm leading-relaxed dark:text-slate-300">
          Kurze Reflexionen zu Forschung, Methodik und Praxis – aus dem Klassenzimmer für das Klassenzimmer.
        </p>
      </div>
    </div>
  </section>

  <!-- Aktuelles aus dem Blog -->
  {blog.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-slate-900 dark:text-slate-50">Aus dem Blog</h2>
        <a href="/blog" class="link-arrow text-sm text-violet-700 hover:text-violet-800 dark:text-violet-200 dark:hover:text-violet-300">Alle Beiträge </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {blog.map((post) => (
          <PostCard
            href={`/blog/${post.slug}`}
            titel={post.data.title}
            teaser={post.data.teaser}
            badges={[post.data.kategorie]}
            datum={post.data.datum}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Neue Aufgaben -->
  {aufgaben.length > 0 && (
    <section class="container-wide pb-16">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-slate-900 dark:text-slate-50">Aufgabensammlung</h2>
        <a href="/aufgaben" class="link-arrow text-sm text-violet-700 hover:text-violet-800 dark:text-violet-200 dark:hover:text-violet-300">Alle Aufgaben </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {aufgaben.map((a) => (
          <PostCard
            href={`/aufgaben/${a.slug}`}
            titel={a.data.titel}
            teaser={a.data.didaktischerHinweis}
            badges={[a.data.thema, `Kl. ${a.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Diagnose-Fragen -->
  {quizzes.length > 0 && (
    <section class="container-wide pb-20">
      <header class="flex items-end justify-between mb-6">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-slate-900 dark:text-slate-50">Diagnose-Fragen</h2>
        <a href="/quizzes" class="link-arrow text-sm text-violet-700 hover:text-violet-800 dark:text-violet-200 dark:hover:text-violet-300">Alle Quizzes </a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        {quizzes.map((q) => (
          <PostCard
            href={`/quizzes/${q.id}`}
            titel={q.data.titel}
            teaser={q.data.didaktischerKontext}
            badges={[q.data.thema, `Kl. ${q.data.klassenstufe.join('/')}`]}
          />
        ))}
      </div>
    </section>
  )}
