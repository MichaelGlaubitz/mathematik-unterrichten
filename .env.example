# Optional: anderes GitHub-Repo für Strg+Shift+E (Standard: MichaelGlaubitz/mathematik-unterrichten)
# PUBLIC_GITHUB_REPO=Owner/repo-name
# PUBLIC_GITHUB_BRANCH=main

# Admin-Editor Token (nur für Entwicklung)
# Mindestens 16 Zeichen, wird für den Editor unter /__admin-editor benötigt
ADMIN_EDIT_TOKEN=dein-geheimes-token-mindestens-16-zeichen

# Optional: Site-Konfiguration für lokale Entwicklung
# PUBLIC_ASTRO_SITE=https://mathematik-unterrichten.de
# PUBLIC_ASTRO_BASE=/

# Optional: eigener LaTeX-on-HTTP-Endpunkt (kompatibel zu YtoTech POST /builds/sync, JSON mit compiler + resources).
# Mehrere URLs: Leerzeichen oder Komma getrennt; werden vor latex.ytotech.com probiert.
# Hostinger-VPS: Schritt-für-Schritt deploy/hostinger-latex/README.md (Docker + Caddy, kein n8n).
# PUBLIC_MU_LATEX_HTTP_URL=https://latex.ihredomain.de/builds/sync
